msgctxt "field|ko|art_ko_fltka01|@kfltka01/068_3"
msgid "오오... 이것은 사랑의 향초가 아닙니까! 진정한 사랑이 싹튼 곳에서만 그 정기를 먹고 싹을 틔운다는 이 귀한 향신료!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltka01
msgctxt "field|ko|art_ko_fltka01|@kfltka01/069"
msgid "[ 요리사 카그 씨 ]/n감사합니다, 정말로 감사합니다! 대신 이것을 드리겠습니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltka01
msgctxt "field|ko|art_ko_fltka01|@kfltka01/069_3"
