msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/153"
msgid "[이올린]/n이걸로 내가 이론적으로 가르쳐 줄 수 있는 것은 자네에게 모두 알려주었네. 나머지는 실전을 통한 훈련 뿐…/n열심히 수련해서 아수라를 이겨 보게나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
