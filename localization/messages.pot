#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/001"
msgid "팬드래건의 개입이라니..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/002"
msgid "투르족과의 전쟁은 어쩌고... 이 쪽으로 아론다이트를 투입 시켰냔 말이다! 라시드!!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/002_3"
msgid "팬드래건의 개입이라니.../40d /n투르족과의 전쟁은 어쩌고... 이 쪽으로 아론다이트를 투입 시켰냔 말이다! 라시드!!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/003"
msgid "얼마전 부터 들리던 소문이 사실이었나 봅니다.../30d투르제국과 펜드래건이 잠정적인 휴전에 돌입했다는..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/004"
msgid "하필 이럴때 말인가?/30d 안돼... 너무 일러!/30d 우리 제국령은 아직 통일 되지 못했단 말이다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/005"
msgid "그보다, 추기경 각하. 이러고 있을 때가 아닙니다. 팬드래건이 개입한 이상 각하의 계획은.../40d 어서 이 자리를 벗어나야 합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/006"
msgid "아니야, 아직 방법은 있어... 이 내가 살아 있는 한, 반드시 제국은 내 손으로 통일 시키고 말것이다!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/007"
msgid "헛된 야망은 버리시오, 체사레 추기경. 사람이란 포기 할 시기를 알아야 하는 법."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/008"
msgid "할아버지... 더 이상... 그런 야욕을 위해 무고한 사람들을 죽이는 걸 용납 할 수 없어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/009"
msgid "제발 부탁이예요, 항복해 주세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/010"
msgid "그렇게는 할 수 없다. 내가 포기란 걸 할 것 같으냐!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/011"
msgid "포기해, 크리스티나. 저자는 더 이상 당신의 할아버지가 아니야. 악마야!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/012"
msgid "누가 감히 이 나를 악마라 하는가!! 이 나를!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/013"
msgid "물러나, 크리스티나!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/014"
msgid "....할아버지..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/015"
msgid "슬퍼하는 건가... 크리스티나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/016"
msgid "아니,/20d 슬프지 않아요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/017"
msgid "할아버지께 진정한 평화를 드릴 수 있게 되어 기뻐요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/018"
msgid "이제... 아버지와 어머니도 편히 잠드실 수 있을 거예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/019"
msgid "그리고.../30d 시라노 씨도..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/020"
msgid "그러고 보니, 마키아벨린가 하는 그 녀석은 어디 갔지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/021"
msgid "난 여기 있소. 도망가지 않을테니 걱정 할 필요는 없소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/022"
msgid "!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/023"
msgid "제법 담이 크군. 처음부터 끝까지 지켜 보고 있었나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/024"
msgid "그 자는 내가 놓아 줬습니다, 메디치."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/025"
msgid "클라우제비츠!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/026"
msgid "자네 정체가 대체 뭔가?/30d 클라우제비츠라는 이름도 진짜 자네 이름 맞나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/027"
msgid "대체 당신..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/028"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/029"
msgid "그렇지 않아도 여러분들에게 밝힐 것이 많습니다. 하지만 지금은 저희 할아버지께서 기다리고 계시니 일단 함께 가시죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/030"
msgid "그는 단지 자신의 사상을 통해 체사레와 우리에 대한 평가를 후세에 남기는 것만이 목적일 뿐입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21c
msgctxt "field|ko|art_ko_flmma21c|@kflmma21c/031"
msgid "아니 뭐, 그 자가 어떻게 되든 그런 것은 이제 관심 없어. 그 보다는..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21d
msgctxt "field|ko|art_ko_flmma21d|@kflmma21d/000"
msgid "[체사레]/n파괴신의 힘을 얻은 나는/30d 더 이상 인간이 아닌 신!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21d
msgctxt "field|ko|art_ko_flmma21d|@kflmma21d/001"
msgid "[체사레]/n내게 대항하려는 자, 신성을 모독한 것이니 죽음으로 속죄할지어다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21d
msgctxt "field|ko|art_ko_flmma21d|@kflmma21d/002"
msgid "할아버지...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/000"
msgid "폐하, 그간 별고 없으셨습니까."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/000_3"
msgid "[클라우제비츠]/n폐하, 그간 별고 없으셨습니까."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/001"
msgid "음, 오랜만이로구나./30d 그리고 메디치 자네도 오랜만일세."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/002"
msgid "아니, 총수 각하?!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/003"
msgid "총수님? 우리 제피르팰컨의?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/004"
msgid "총수님? 폐하? 대체 무슨 소리죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/005"
msgid "이 분이 바로 제 할아버님이시자, 제피르팰컨의 총수, 그리고 팬드래건의 국왕이시기도 한 라시드 팬드래건 1세 이십니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/005_3"
msgid "[클라우제비츠]/n이 분이 바로 제 할아버님이시자, 제피르팰컨의 총수, 그리고 팬드래건의 국왕이시기도 한 라시드 팬드래건 1세 이십니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/006"
msgid "예엣?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/007"
msgid "총수님이 바로 그 전설의 성왕, 라시드?!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/008"
msgid "그리고 클라우제비츠 당신의 할아버지라구요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/009"
msgid "그 동안 신분을 숨겨 죄송합니다. 제 본명은 라시드 클라우제비츠 팬드래건 3세, 팬드래건 제 1 왕자의 아들입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/010"
msgid "맙소사, 그러면 당신은 팬드래건의...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/011"
msgid "클라우제비츠, 샤른호스트에 이제는 라시드 3세라니... 어떤게 진짜 당신이죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/012"
msgid "하하, 글쎄요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/013"
msgid "3세야, 네가 일을 생각보다 잘 이끌어 주었지만 역시 무리수가 많았다./30d 이번의 아론다이트 건도 그렇고, 우리쪽 전쟁이 예상했던 것 보다 길어지기라도 했다면 어떻게 감당 할 수 있었겠느냐."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/013_3"
msgid "3세야, 네가 일을 생각보다 잘 이끌어 주었지만 역시 무리수가 많았다./30d 이번의 아론다이트 건도 그렇고, 우리쪽 전쟁이 휴전에 돌입하지 않았다면 어떻게 감당 할 수 있었겠느냐."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/014"
msgid "그리고, 제피르팰컨의 여러분."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/015"
msgid "예, 옛!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/016"
msgid "총수가 다른 나라의 국왕이라는 것이 기분 나쁠지도 모르겠지만, 여러분들은 자주적으로 제피르팰컨을 잘 이끌어 주었네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/017"
msgid "아... 예."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/018"
msgid "...그런데, 실례되는 말씀입니다만./30d 대륙 최강대국의 국왕이 왜 이런 비공식 단체를 조직해 다른 나라의 국정에 간섭한신 거죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmma21e
msgctxt "field|ko|art_ko_flmma21e|@kflmma21e/018_3"
