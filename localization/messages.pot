#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s01
msgctxt "field|ko|art_ko_fl11_s01|@kfl11_s01/030"
msgid "그 아이마저 없으면.../15d 난..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s01
msgctxt "field|ko|art_ko_fl11_s01|@kfl11_s01/031"
msgid "..당신이 그렇게까지 걱정을 하고 있는지는 몰랐구려. /15d /n그렇다면 이번 기회에 찾으러 나서야 겠군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s01
msgctxt "field|ko|art_ko_fl11_s01|@kfl11_s01/032"
msgid "실은 얼마전 장인어른께서 니코시아지방에 설립하신 교회가 제피르팰컨에 의해 파괴당한 것 같소. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s01
msgctxt "field|ko|art_ko_fl11_s01|@kfl11_s01/033"
msgid "이번 기회라뇨?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s01
msgctxt "field|ko|art_ko_fl11_s01|@kfl11_s01/034"
msgid "여보../15d 그 분은 저를 길러주신 분이세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s01
msgctxt "field|ko|art_ko_fl11_s01|@kfl11_s01/035"
msgid "또 반란이라니.../15d /n내가 보기에도 장인어른이 너무 평민들을 윽박지른 다는 생각이 드는걸."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s01
msgctxt "field|ko|art_ko_fl11_s01|@kfl11_s01/036"
msgid "아무리 장인어른의 말씀이라 해도 이건 좀 심한걸."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s01
msgctxt "field|ko|art_ko_fl11_s01|@kfl11_s01/037"
msgid "미안하오./15d /n당신때문에라도 장인어른은 내게 정말로 고마우신 분이시지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s01
msgctxt "field|ko|art_ko_fl11_s01|@kfl11_s01/038"
msgid "어찌되었든 제피르팰컨 녀석들도 요즈음 너무 무서운것 없이 날뛰기 때문에 한번쯤 쓴맛을 보여주는 것도 좋겠지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s01
msgctxt "field|ko|art_ko_fl11_s01|@kfl11_s01/039"
msgid "그럼, 원정을 떠나실 계획인가요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s01
msgctxt "field|ko|art_ko_fl11_s01|@kfl11_s01/040"
msgid "일단, 각지를 돌아다니며 제피르녀석들을 상대하고 크리스티나의 소식을 탐문해 보도록 하지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/000"
msgid "/2c제피르팰컨. 작전회의실."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/001"
msgid "다들 모이신것 같으니, 이번 작전을 설명해 드리겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/002"
msgid "이번 작전의 목표는, 프레데릭군의 도움으로 지방 영주들이 억류하고 있는 아군포로의 구출입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/003"
msgid "프리토리아, 멤피스, 보르도../10d이곳에 억류되어 있는 아군 포로를 구출해 주십시요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/004"
msgid "프리토리아는 아시다시피 제피르 팰컨 세력하의 도시였습니다만, 프레데릭의 지휘로 얼마전 새로운 영주가 들어섰다고 합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/005"
msgid "멤피스는 대륙 최남단에 있는 마을로, 게이시르 숲을 통과해야 합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/006"
msgid "보르도는 로우엔 시티의 북쪽에 위치하고 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/007"
msgid "로우엔 시티는 시민에 대한 신분 검색이 철저한 도시라 잠입이 불가능했었습니다만, 얼마전부터 외부인의 출입이 비교적 수월해졌다고 합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/008"
msgid "자..그럼 어서 출발하도록 합시다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/009"
msgid "가까운 프리토리아 마을까지 데려다 드릴까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/010"
msgid "카나의 4부대와 함께 프리토리아로 이동할 것인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/011"
msgid "카나와 함께 프리토리아로 간다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/012"
msgid "지리도 익힐겸 단독으로 움직인다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/013"
msgid "좋아요! 그럼 출발해요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/014"
msgid "쩝...할수 없죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/015"
msgid "프레드릭 장군이라......좋은 승부가 되겠는걸."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/016"
msgid "작전종료 후에는 모두 합류하도록 합시다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/017"
msgid "흥, 로우엔군 쯤이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/018"
msgid "..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/019"
msgid "프리토리아라면...제 병원에 들려볼 수 있겠군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/020"
msgid "한번에 세곳이라니!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/021"
msgid "저는 다른 임무가 있어서 같이가지 못하겠네요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/022"
msgid "좋아,카나와 함꼐 프리토리아로 가도록 하지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/023"
msgid "미안하지만,우리는 이 근방을 좀더 돌아보아야 겠어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/024"
msgid "이 기지 지하에는 이상한 던젼이 있다는 이야기를 들었어요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/025"
msgid "지난번, 리브레빌에서의 작전성공으로 제피르팰컨에게 커다란 후원자가 생겼습니다만, "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/026"
msgid "그동안 프레데릭의 로우엔군이 움직인 모양입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/027"
msgid "프리토리아, 멤피스, 보르도...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/028"
msgid "좀 좋은 창이 있으면 좋으련만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/029"
msgid "목표를 잊으시면 안돼요! /n프리토리아,멤피스,보르도...외우고 있는거죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/030"
msgid "그럼, 어서 출발할까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/031"
msgid "먼저 나가세요. /n금방 따라가겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/032"
msgid "저도 이젠 어엿한 제피르팰컨이죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/033"
msgid "먼저 나가시면 따라가겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/034"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/035"
msgid "요즘..얼굴도 보기 힘드네요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/036"
msgid "하하하."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/037"
msgid "아마도 긴 여정이 될 것입니다. /n길을 잃지 않도록 주의하십시오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/038"
msgid "불쌍한 프리토리아 사람들..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl11_s02
msgctxt "field|ko|art_ko_fl11_s02|@kfl11_s02/039"
msgid "길을 잃지 않도록 조심해야 해요!"
msgstr ""

