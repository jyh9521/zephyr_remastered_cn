#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/057"
msgid "[존]/n이봐, 이봐... 그냥 만나서 같이 점심을 먹었을 뿐이라고."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/057_3"
msgid "[ 존 ]/n이봐, 이봐... 그냥 만나서 같이 점심을 먹었을 뿐이라고."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/058"
msgid "[지나]/n점심, 점심! 하! 단지 점심 뿐이었단 말이지! /n내 친구 제인이 당신을 다른 곳에서 보았다던데도!"
