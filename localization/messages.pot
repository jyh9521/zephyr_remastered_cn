msgctxt "field|re|art_fl02_s01|@kfl02_s01/038"
msgid "그럴리가…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl02_s01
msgctxt "field|re|art_fl02_s01|@kfl02_s01/039"
msgid "그럴리가…/30d 없어…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl02_s01
msgctxt "field|re|art_fl02_s01|@kfl02_s01/040"
msgid "이건…/40d 분명히 뭔가 잘못된거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl02_s01
msgctxt "field|re|art_fl02_s01|@kfl02_s01/041"
msgid "메르세데스가…/45d/n당신이…/35d 그럴 리가 없잖아…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl02_s01
msgctxt "field|re|art_fl02_s01|@kfl02_s01/042"
