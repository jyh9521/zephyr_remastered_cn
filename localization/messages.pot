msgctxt "field|re|art_fl03_s05|@kfl03_s05/008"
msgid "[?????]/n자비로운 아비도스이시여…/40d/n저의 염원으로/15d 기적을…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s05
msgctxt "field|re|art_fl03_s05|@kfl03_s05/009"
msgid "……/60d!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s05
msgctxt "field|re|art_fl03_s05|@kfl03_s05/010"
msgid "[?????]/n자,/25d 이제 무리하지만 않으시면 괜찮으실 거예요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s05
msgctxt "field|re|art_fl03_s05|@kfl03_s05/011"
msgid "사막에서…/60d 저를 구해 주신겁니까…?"
msgstr ""

