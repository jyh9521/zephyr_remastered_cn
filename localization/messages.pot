msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/031"
msgid "꽃을 좋아하시나 봐요./45d/n이런 밤중에까지/15d 주무시지 않고/45d 제 화원에 들르신 걸 보면."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/032"
msgid "아아…/30d 네,/25d 좋아합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/033"
msgid "후훗…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/034"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/035"
msgid "전/40d 운이 좋은 모양이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/036"
msgid "네?/30d 아…/40d/n저희가 도와드리러 온 걸 말씀하시는 거군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/037"
msgid "그런 게 아니에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
