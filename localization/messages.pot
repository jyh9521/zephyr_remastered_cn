msgctxt "field|ko|art_ko_fl23_s05|@kfl23_s05/020"
msgid "마지막까지... 당신을 방해만... 하는.. 군요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s05
msgctxt "field|ko|art_ko_fl23_s05|@kfl23_s05/021"
msgid "미안.... 시라노..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s05
msgctxt "field|ko|art_ko_fl23_s05|@kfl23_s05/022"
msgid "[시라노]/n메르세데스..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s05
msgctxt "field|ko|art_ko_fl23_s05|@kfl23_s05/023"
msgid "시라노!! 파괴신이 다시 움직이고 있어요!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s05
msgctxt "field|ko|art_ko_fl23_s05|@kfl23_s05/024"
msgid "...끈질긴 녀석... 이제는 정말 끝장을 내버리겠다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/000"
msgid "자... 이제는 헤어져야 할 시간이 왔군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/001"
msgid "평소에 늦던 메디치가 웬일로 제시각에 맞춰 나왔는데 오늘은 주인공들이 늦네요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/002"
msgid "오늘 같은 날은 늦을 수 없지./30d 그 친구들, 오늘 보는게 마지막이 될지도 모르는데."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/003"
msgid "아, 저기들 오시는군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/004"
msgid "모두 기다리시게 해서 미안합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/005"
msgid "지금 바로 떠날 건가, 시라노?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/006"
msgid "글쎄, 바로 떠나려고 하는데.../30d 이별의 순간은 짧은 것이 좋다고 생각하네만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/007"
msgid "그동안 정말 고마웠어요, 모두들."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/008"
msgid "정말 아쉽군, 카나. 그래도 미운정 고운정 많이 들었었는데."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/009"
msgid "시라노, 우리를 떼어 놓고는 어디도 갈 수 없어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/010"
msgid "설마 저까지 떼어버리고 가실 생각은 아니셨겠죠, 시라노?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/011"
msgid "모두들, 생각은 고맙지만/30d 나는 이제 나를 모르는 새로운 곳으로 가, 그 곳에 정착해 살 생각이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/012"
msgid "그 곳은 어쩌면 대륙의 동부일지도 모르고 어쩌면 외딴 섬, 어쩌면 동방 대륙일지도 몰라."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/013"
msgid "여러분은 이제야 비로소 자신들의 노력의 대가를 받을 시간이 왔는데, 그 모든 것을 버리고 내 뒤를 따르겠다는 것은..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/014"
msgid "평안한 삶을 바랬다면 애초에 시라노 님을 따르지 않았을 것입니다./30d 제게는 시라노 님이 살아가는 의미 입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/015"
msgid "나는 삶에 의미 같이  거창한 것 까지 생각한 적은 없지만, 시라노가 좋기 때문에 따르려는 거예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/016"
msgid "나도 이제 더 이상 제피르팰컨이 아니니 나를 떼어 놓을 구실도 없죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/017"
msgid "모두 함께 가는 거예요, 시라노./30d 우리를 모르는 낯선 땅으로..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/018"
msgid "그래, 함께 떠나자./30d 불행했던 과거는 이 땅에 묻고 아름다운 추억들은 가슴에 묻은채로 이 땅을 떠나는 거다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/019"
msgid "시라노...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/020"
msgid "시라노 님...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/021"
msgid "제가 노력해 온 것은 모두 시라노를 위한 것./30d 제 일신의 평안을 바란 적은 한번도 없었어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl24_s01
msgctxt "field|ko|art_ko_fl24_s01|@kfl24_s01/022"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/000"
msgid "아버지... 제발 크리스티나 만은..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/001"
msgid "이 모든 것이 대의를 위한 것이니, 방해하지 마라."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/002"
msgid "게다가 봉인 해제의 의식을 막기에는 이미 늦었어. 지금 방해하려 하다간 오히려 크리스티나의 목숨이 위태로워 져."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/003"
msgid "아아... 크리스티나..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/004"
msgid "체사레! 봉인에서 물러나라!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/005"
msgid "흐음, 이 건 반란군의 수괴인 메디치와 그의 수하가 아닌가!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/006"
msgid "디아블로 님, 뒤를 부탁하겠소이다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/007"
msgid "후후후, 괜찮겠지. 파괴신 부활까지의 시간 때우기라 생각하고 잠깐 놀아 줄까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/008"
msgid "메디치 님, 먼저 저 봉인을 빼앗아야 해요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/009"
msgid "좋아!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/010"
msgid "안돼요!! 지금 크리스티나를 건드리면...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/011"
msgid "당신은 뭐야! 비켜!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/012"
msgid "아악!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/013"
msgid "[시라노]/n메르세데스!!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/014"
msgid "설마... 메르세데스 프레데릭?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/015"
msgid "메디치 오빠!!! 무슨 짓이예요!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/016"
msgid "카, 카나...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/017"
msgid "흥, 너희들은 또 메디치 님을 방해하려는 거냐?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/018"
msgid "메르세데스... 메르세데스를 네 놈들이!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/019"
msgid "용서 할 수 없다!!! 메디치!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/020"
msgid "없애버린다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/021"
msgid "아악!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/022"
msgid "에스테도데!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/023"
msgid "이렇게... 허무하게..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl25_s02
msgctxt "field|ko|art_ko_fl25_s02|@kfl25_s02/024"
msgid "죽인다!! 시라노!!"
msgstr ""

