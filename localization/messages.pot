msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/036"
msgid "이것이 체사레의 함정이라 해도…/65d 그 대가가 내 목숨이라 할지라도./60d/n나는/40d 그녀를 만나러 가야 한다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/037"
msgid "모두…/40d 잘 있어라."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/038"
msgid "실버…/55d/n그래,/40d 지금까지 나를 따라준 실버에게/40d 아무 말도 없이 갈 수는 없어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/039"
msgid "그녀라면/30d 내 생각을 이해해 줄 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/040"
msgid "[실버]/n시라노!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/041"
msgid "실버…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/042"
msgid "시라노,/25d 로우엔에 혼자 가시게 할 수는 없어요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/043"
msgid "클라우제비츠에게 들었나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/044"
msgid "어째서 저를 두고 가시려는거죠?/30d/n그곳에 가면 분명/20d 무사히 돌아올 수 없을 거예요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/045"
msgid "알고 있다./45d 그래서/30d 너와 함께 갈 수 없어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/046"
msgid "힘든 일도 많았을 텐데,/50d 지금까지/20d 정말 잘 따라주었다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/047"
msgid "무슨 말씀을 하시는 거예요!/35d 정말/25d 혼자 떠나시겠다는 건가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/048"
msgid "분명…/40d 무사히 돌아올 거라는 보장은 없어./40d/n그리고,/30d 만약 돌아온다 해도/45d 내게는/20d 너를 구속할 자격은 없어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/049"
msgid "그런 말…/30d 하지 마세요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/050"
msgid "마지막 부탁이다,/10d 실버./45d/n나를 잡지 마라."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/051"
msgid "그런 명령,/30d 따를 수 없습니다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/052"
msgid "그렇게까지 해서 로우엔에 가야 한다면,/40d 차라리/30d 제 시체를 밟고 가세요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/053"
msgid "실버…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/054"
msgid "어떻게 대답하겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/055"
msgid "네가 나를 벤다고 해도, 나는 가야해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/056"
msgid "알겠다, 실버. 가지 않겠다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/057"
msgid "나는 지금까지/25d 그녀를 만나기 위해 살아왔어./60d/n네가 나를 벤다고 해도,/40d 나는 가야해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/058"
msgid "미안하다,/10d 실버."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/059"
msgid "……!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/060"
msgid "시라노…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/061"
msgid "실버…/60d 이렇게까지 나를 생각해 주고 있을지는 몰랐다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/062"
msgid "내 생각만 해서/30d 너를 남겨두고 갈 수는 없어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/063"
msgid "시라노,/30d 그럼…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/064"
msgid "로우엔에는 가지 않겠어./45d 너와/20d 함께 하겠다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/065"
msgid "시라노…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/066"
msgid "무례를 용서하세요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/067"
msgid "무례라니,/35d 나를 걱정해서 한 일이었잖나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/068"
msgid "자,/35d 이제 다음 작전을 위한 준비를 하자."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/069"
msgid "알겠습니다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/070"
msgid "카나…/60d 이제 그녀를 볼 수 없겠지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/071"
msgid "카나를 위해서라도,/40d 그녀 곁을 떠나는 것이 더 나은 길일지도 모른다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/072"
msgid "[카나]/n시라노…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/073"
msgid "카나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/074"
msgid "프레데릭 부인의 연락을 받고,/35d 로우엔으로 떠난다는 말이/15d 사실이에요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/075"
msgid "클라우제비츠에게 들었나…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/076"
msgid "어째서…/30d 어째서 함정인 줄 알면서도/25d 스스로 뛰어드려는 거예요, 시라노!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/077"
msgid "그것이,/35d 내가 지금까지 살아온 이유이기 때문이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/078"
msgid "나를 막지 말아줘,/10d 카나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/079"
msgid "…/30d시라노…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/080"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/081"
msgid "시라노…/35d 당신이 없으면…/35d 난 살아갈 수 없을 거예요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/082"
msgid "사랑해요…/25d 시라노./40d/n제발…/25d 제발 가지 말아요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/083"
msgid "어떻게 대답하겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/084"
msgid "카나, 나는 가야만 해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/085"
msgid "카나… 네 말대로 가지 않겠어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/086"
msgid "비켜줘, 카나./35d 나는 가야만 해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/087"
msgid "시라노…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/088"
msgid "나같은 사람을 사랑해봐야/30d 너만 상처입게 될 뿐이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/089"
msgid "나는 잊고,/50d 행복하길 바란다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/090"
msgid "안돼요, 시라노!/35d 가지 말아요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/091"
msgid "…/30d그래,/20d 카나./45d 내게는 네가 있었어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/092"
msgid "네가 나를 필요로 한다면,/40d 나도 너의 곁에 있어주고 싶어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/093"
msgid "시라노…!/35d 그럼…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/094"
msgid "그곳에는 가지 않겠어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/095"
msgid "…/35d시라노…/30d 고마워요…"
msgstr ""

