msgid "저런 어린 아이들에게 까지... 어찌 그리 잔인할 수가...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/011"
msgid "그런데... 예전에 사이럽스 항에서 뵈었던 기억이 있는 것 같은데... "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/012"
msgid "아니, 저는 기억이 없군요. 아마 다른 사람을 착각하신 것 같습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/013"
msgid "그... 그런가요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/014"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/015"
msgid "아이들은 언제쯤이면 퇴원 할 수 있을까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/016"
msgid "아, 내일 오전 쯤이면 정신을 차릴 수 있을 거예요. 완치 되려면 조금 더..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/017"
msgid "그럼 우린 이만 실례하겠습니다. 이 아이들을 데리러 오도록 하죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/018"
msgid "그럼 내일 뵙겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/019"
msgid "계십니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/020"
msgid "뭔가 이상한 걸."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/021"
msgid "으음..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/022"
msgid "이봐, 정신 차려. 에스메랄다는 어디 갔지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/023"
msgid "어제의 손님 분들...! 제발 에스메랄다 님을 구해주세요, 예?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/024"
msgid "라몬 자작? 어째서 그가 그녀를?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/025"
msgid "악마의 힘으로 사람들을 치료했다는 말도 안되는 억지로 누명을 씌워 마녀로 몰았습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/026"
msgid "뭐야, 어째서 그런 짓을 하는 거지!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/027"
msgid "라몬 자작은... 평소 에스메랄다 님을 편모해 수 차례 구애 했지만, 끝내 거절 당하자 앙심을 품고 있었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/028"
msgid "지독히 옹졸한 녀석이로군!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/029"
msgid "시라노, 지금 당장 라몬을 쳐 에스메랄다 님을 구해야 해요. 권력을 이용해 무고한 사람을 괴롭히는 자를 그냥 둘 수 없어요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/030"
msgid "당장, 그녀를 구하러 가자."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/031"
msgid "좀 더 라몬의 추이를 살펴 보자."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/032"
msgid "무슨 수를 써서라도 그녀를 구해낼 것이오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/033"
msgid "실버, 곧바로 라몬 자작 저택으로 진입이다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/034"
msgid "예!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/035"
msgid "아직은 좀 더 준비가 필요하오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/036"
msgid "라몬의 추이를 살핀 후 쳐들어가도 늦지 않소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/037"
msgid "하지만, 그 동안 에스메랄다님은...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/038"
msgid "...알겠습니다, 시라노."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/039"
msgid "응급 처치를 잘 해주셔서 다행이었어요. 일단은 안심하셔도 될 것 같습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/040"
msgid "저어... 그런데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/041"
msgid "?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/042"
msgid "시라노 님이라고 하셨던가요?/30d 혹시 제가 예전에 시라노 님을 뵌일이 있지 않던가요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/043"
msgid "자, 어떻게 대답할까."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/044"
msgid "아, 기억 납니다. 사이럽스 시티에서..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/045"
msgid "글쎄요..다른 사람을 착각하신 게 아닌지요"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/046"
msgid "전에 사이럽스 시티, 아니 사막에서 저를 도와 주셨지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/047"
msgid "맞아요, 사이럽스. 2년 전 이었죠?/30d 몸이 건강하셔서 다행이네요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/048"
msgid "뭐예요, 두분 벌써 아는 사이셨어요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/049"
msgid "어쨌든, 오늘은 이만 가보고 내일 오전 중으로 다시 한번 들리겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/050"
msgid "아, 치료비는...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/051"
msgid "예, 그럼 또 들려 주세요, 시라노 님."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/052"
msgid "혹시, 2~3년 전 쯤 사이럽스에 가신 적 없으신가요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/053"
msgid "사이럽스에는 최근저에 한번 들렀을 뿐입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/054"
msgid "어쨌든, 에스메랄다님. 저희는 이만 가보고 내일 오전 중으로 다시 한번 들리겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/055"
msgid "다음날."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/056"
msgid "!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/057"
msgid "[간호사]/n도와주세요! 누가 좀 에스메랄다 님을...!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/058"
msgid "무슨 일이죠? 에스메랄다 님께 무슨 일이라도?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/059"
msgid "대체 무슨일인지 차근차근 얘기해 보시오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/060"
msgid "라몬 자작.. 라몬 자작의 병사들이 몰려와 에스메랄다 님을 끌고 가버렸어요...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/061"
msgid "라몬 자작이라면 이 곳의 영주? 어째서 그가 에스메랄다 님을?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s02
msgctxt "field|ko|art_ko_fl07_s02|@kfl07_s02/062"
msgid "  "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s04
msgctxt "field|ko|art_ko_fl07_s04|@kfl07_s04/000"
msgid "이제 좀 마음이 바뀌었나, 에스메랄다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl07_s04
msgctxt "field|ko|art_ko_fl07_s04|@kfl07_s04/001"
msgid "......"
msgstr ""

