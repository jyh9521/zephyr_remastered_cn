msgctxt "field|re|art_fl00_s12|@kfl00_s12/009"
msgid "명문 번스타인 가문의 장남이/n악마 숭배자일 줄이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s12
msgctxt "field|re|art_fl00_s12|@kfl00_s12/010"
msgid "가문에 먹칠을 해도 유분수지!"
msgstr ""

