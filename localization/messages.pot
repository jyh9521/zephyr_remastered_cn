msgid "당신의 뜻을 헛되이 하지 않을 거요, 에스메랄다!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s04
msgctxt "field|ko|art_ko_fl18_s04|@kfl18_s04/026"
msgid "각오해라, 파괴신!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/000"
msgid "휴우,/10d 가까스로 빠져 나온것 같군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/001"
msgid "/2c사이럽스. 수중 도시 입구."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/002"
msgid "시라노.../15d 카나,/20d 에스메랄다 님..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/003"
msgid "[크리스티나]/n우응..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/004"
msgid "[크리스티나]/n샤른.../10d호스트...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/005"
msgid "정신이 들었군요, 크리스티나 양."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/006"
msgid "여기는... 수중도시 입구?/15d 그리고, 샤른호스트 당신은...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/007"
msgid "더 이상 숨길 필요는 없겠지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/008"
msgid "!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/009"
msgid "맙소사!/15d 책벌레 클라우제비츠가 괴도 샤른호스트였다니!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/010"
msgid "사정이 있어서 정체를 숨긴채 활동하고 있었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/011"
msgid "당신이 저를 수중도시에서 데리고 나온 건가요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/012"
msgid "어디까지 기억나십니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/013"
msgid "파괴신과 합체한 후 시라노 씨를 공격했던 기억까지는 있는데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/014"
msgid "크리스티나 양은 에스메랄다 님의 희생으로 파괴신으로부터 분리된 후,/30d 그에 이은 시라노 님의 희생으로 살아난 것입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/015"
msgid "에스메랄다 언니와 시라노 씨가..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/016"
msgid "하지만, 믿을 수 없어요./30d 왜 시라노 씨는 자신을 죽이려고 했던 저를 구해주신 거죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/017"
msgid "그 이유는 저도 알수 없지만 최근 한가지는 분명해졌습니다./30d 시라노 님은 크리스티나 양의 부모님들을 직접해하지는 않았다는 것입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/018"
msgid "시라노씨에게 살해당하셨다고 알려진 프레데릭경의 시체를 상세히 조사한 결과/40d 체사레 추기경의 수하인 암흑살수의 흔적이 발견되었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/019"
msgid "뭐라고요?/20d 그럼 할아버지가 아버지를...?!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/020"
msgid "그뿐 아니라, 프레데릭 부인도 시라노 님과의 만남 이후에 돌아가신 것은 틀림 없습니다만, 저희 측 정보에 의하면 사인은 중독사라고 하더군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/021"
msgid "시라노 님이 한낱 여인을 죽이는데 독을 사용했을까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/022"
msgid "...설마... 어머니도...?/30d 그럴리가... 없어요./20d 어머니는 할아버지의 하나뿐인 딸이란 말이예요...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/023"
msgid "시라노 님이 돌아가신 이상 모든 일은 미궁에 빠져버리긴 했습니다만, 분명한 것은 이 일에 체사레 추기경이 개입되어 있다는 사실입니다. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/024"
msgid "하긴... 어머니도 시라노 씨를 잘 알고 있는 것 같았어요./20d 전의 그 피아노곡도 그렇고..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/025"
msgid "저한테 그 곡을 가르켜 주시며 그 곡을 아는 사람은 이젠 저와 당신밖에 없다고 말씀 하시며 뭔가 그리워 하시는 듯한 표정이셨거든요./50d 하지만, 시라노 씨도 그 곡을 알고 있었고..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/026"
msgid "사실, 저도 시라노 님을 단독으로 초대한 메르세데스님의 행동도 이해가 되지 않았고,/40d 초대를 받아들여 단신으로 사지를 찾아가던 시라노 님의 행동 역시 이해가 되지 않았습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/027"
msgid "짐작컨데, 두분은 단순하지 않은 과거의 인연을 지니고 계셨던 것 같습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/028"
msgid "아무리 그렇다고는 해도.../20d 어째서 자신의 생명을 버리면서까지 저를..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/029"
msgid "글쎄요... 정확히는 모르겠지만, 제게 크리스티나 양의 뒤를 보필해달라는 부탁의 말씀까지 남기신 걸 보면..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/030"
msgid "역시, 시라노 님은 크리스티나 양을 남으로 생각하지 않았던 모양입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/031"
msgid "...할아버지는 이 모든일의 내막을 알고 계실거예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/032"
msgid "게다가 저는 아버지와 어머니 그리고, 시라노 씨를 대신해서 할아버지의 헛된 야망을 저지할 책임이 있어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/033"
msgid "아마, 체사레 추기경은 다시 비프로스트의 원군을 요청하기 위해 직접 나섰을 것입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/034"
msgid "비프로스트의 재 침공으로부터 이 땅을 지켜내기 위해서는, 프레데릭 가문의 정통 후계자인 크리스티나 양이 알프레드 프레데릭 경의 유지를 물려받아 우리 제피르팰컨과 힘을 합쳐야 합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/035"
msgid "알았어요, 클라우제비츠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/036"
msgid "그럼, 우리는 먼저 분열된 제피르팰컨을 재 집결시키기 위해 메디치 님을 찾도록 해야겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/037"
msgid "메디치님은 어디 계실까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s05
msgctxt "field|ko|art_ko_fl18_s05|@kfl18_s05/038"
msgid "글쎄...평소 성격으로 봐서는 여기저기의 술집을 전전하지 않을까 생각되는군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/000"
msgid "모두 꺼져 버려!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/001"
msgid "응? 무슨 일이지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/002"
msgid "이거 원, 불안해서 술 마실 맛 나겠나./30d 이젠 여기도 올 곳이 못되는 구만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/003"
msgid "결국 로우엔까지 돌아오고 말았군요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/004"
msgid "메디치 님이 설마 제국령을 떠나지는 않았을텐데 찾을 수가 없다니... 대체 어디에..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/005"
msgid "??"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/006"
msgid "에잇, 재수가 없으려니까 별..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/007"
msgid "클라우제비츠, 설마...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/008"
msgid "그러고 보니... 로우엔의 술집에는 들려본 적이 없군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/009"
msgid "이봐 주인장, 내가 누군지 알아? 응?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/010"
msgid "어서 들어가 봐요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/011"
msgid "손님이 누군신지 제가 어찌 알겠습니까.. 돈은 받지 않을테니 진정하시고 그만 가주세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/012"
msgid "뭐야? 이 메디치가 돈이나 떼어 먹을 인간으로 밖에 안보이나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/013"
msgid "메디치, 역시 메디치였군요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/014"
msgid "뭐야, 너희들은."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/015"
msgid "군사, 크리스티나...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/016"
msgid "이자벨 님, 메디치 님은 어떠십니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/017"
msgid "보시다시피... 그리 좋다고 할 수가 없네요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/018"
msgid "메디치, 정말 한심하군요. 이러고도 로베르토 데 메디치의 이름이 아깝지 않나요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/019"
msgid "로베르토 데 메디치...의 이름..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/020"
msgid "젠장... 이제와서... 내게 대체 뭘 바라는 거야... 이 무능한 내게 뭘 바라냔 말이야..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/021"
msgid "시라노... 그의 죽음도 내게 책임이 있어... 내게..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/022"
msgid "시라노... 그의 죽음은 저 때문이예요, 저를 살리기 위해 스스로 희생을 선택한 거예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/023"
msgid "그래요, 당신 생각대로라면. 그의 생명을 댓가로 살아난 나는 그를 볼 면목이 없어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/024"
msgid "하지만, 그의 희생이 의미 없는 것이 되어서는 안되기에, 저는 오늘 하루도 최선을 다해 살아가려고 노력하고 있어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/025"
msgid "아직 늦지 않았어요, 메디치./30d 함께, 우리 손으로 제피르팰컨을 다시 일으키는 거예요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/026"
msgid "내가.../40d 해낼 수 있을까...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/027"
msgid "당신은 제피르팰컨의 실질적 리더, 로베르토 데 메디치예요./30d 당신은 해낼 수 있어요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s01
msgctxt "field|ko|art_ko_fl19_s01|@kfl19_s01/028"
msgid "그래, 해 보겠어... 그의 죽음을 헛되게 할 수는 없지...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s02
msgctxt "field|ko|art_ko_fl19_s02|@kfl19_s02/000"
msgid "/2c비프로스트. 어전."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s02
msgctxt "field|ko|art_ko_fl19_s02|@kfl19_s02/001"
msgid "흥미로운 제안이군요. 체사레 추기경."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s02
msgctxt "field|ko|art_ko_fl19_s02|@kfl19_s02/002"
msgid "지난번의 출병때에 당한 치욕을 그대로 남길 생각은 없으시겠지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s02
msgctxt "field|ko|art_ko_fl19_s02|@kfl19_s02/003"
msgid "이번 기회야말로 반란군들과 그에 동조하는 영주들을 처치할 좋은 기회입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s02
msgctxt "field|ko|art_ko_fl19_s02|@kfl19_s02/004"
msgid "흐음.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s02
msgctxt "field|ko|art_ko_fl19_s02|@kfl19_s02/005"
msgid "또한 발굴에 성공한 아스카론의 성능도 시험에 보아야 되지 않겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s02
msgctxt "field|ko|art_ko_fl19_s02|@kfl19_s02/006"
msgid "호오, 대단하시군요. 그 사실은 1급 비밀로 분류되어 있을텐데요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s02
msgctxt "field|ko|art_ko_fl19_s02|@kfl19_s02/007"
msgid "무엇을 망설이십니까. /n/10d나를 도와 제국통일에 협조한다면 전 제국 영토의 반을 공여하지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s02
msgctxt "field|ko|art_ko_fl19_s02|@kfl19_s02/008"
msgid "추기경 각하!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s02
msgctxt "field|ko|art_ko_fl19_s02|@kfl19_s02/009"
msgid "여기까지 온 이상 어쩔수 없네. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s02
msgctxt "field|ko|art_ko_fl19_s02|@kfl19_s02/010"
msgid "역시, 체사레 추기경은 문제의 요지를 지적하시는군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s02
msgctxt "field|ko|art_ko_fl19_s02|@kfl19_s02/011"
msgid "좋습니다. 그렇다면, 저희 군대와 아스카론을 움직이도록 하겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s02
msgctxt "field|ko|art_ko_fl19_s02|@kfl19_s02/012"
msgid "저는 팬드래건에 사절을 보내 제국이 반란군에 의해 통제불능상태에 빠져있어 귀국에 도움을 요청했다는 서한을 전하도록 하겠소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s02
msgctxt "field|ko|art_ko_fl19_s02|@kfl19_s02/013"
msgid "아무리 팬드래건이라 해도 내정문제인 이상 쉽사리 개입은 하지 못할 것이외다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl19_s02
msgctxt "field|ko|art_ko_fl19_s02|@kfl19_s02/014"
msgid "후후, 그렇지 않다고 해도 최근 팬드래건은 투르족과의 전쟁으로 바쁜 모양이니 그들로서도 어쩔수 없을 겁니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/000"
msgid "/2c제피르팰컨. 작전회의실."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/001"
msgid "돌발사태가 발생했습니다. /10d/n체사레 추기경의 요청으로 비프로스트군이 다시한번 군대를 일으켰습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/002"
msgid "그 놈들, 아직도 혼이 덜 났군. 이번기회에 아주 박살을..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/003"
msgid "이번의 침공은 그리 만만하지 않습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/004"
msgid "얼마전 발굴에 성공한 1급 마장기, 아스카론이 투입된다고 합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/005"
msgid "서..설마, 아스카론이..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/006"
msgid "1급 마장기는 사기와 전력에 절대적인 영향을 줍니다. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/007"
msgid "정상적인 전법으로는 통용되지 않는 상대지요"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/008"
msgid "그래서, 작전은?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/009"
msgid "적의 본진이 주둔하고 있는 망티고아봉으로 출병할 것을 제안합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/010"
msgid "적의 본진을!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/011"
msgid "소수 정예부대를 조직하여 적의 사령부를 일거에 제압한다면 승산은 충분이 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/012"
msgid "그렇다고 하더라도...아스카론은 누가 상대하지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/013"
msgid "그점은 걱정하지 않으셔도 될겁니다. /n이미 몇가지 대안을 강구해 놓은 상태입니다"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/014"
msgid "그리고 이번 작전이 제피르팰컨 최후의 작전이 될 것입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/015"
msgid "성공 여부에 따라 비프로스트와 교회연합군, 그리고 제피르팰컨의 존립이 걸려 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/016"
msgid "마지막까지...힘을 내어 싸워주시기 바랍니다"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/017"
msgid "여러분, 우리는 지난번 전투에서 너무나도 많은 전우들을 잃었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/018"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/019"
msgid "아, 그리고 메디치님에게 칼을 한자루 드리겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/020"
msgid "음..? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/021"
msgid "코드네임 PSX-9, '아르마다' 입니다. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/022"
msgid "'아르마다'라면 펜드래건에서 비밀리에 테스트하고 있다는 차세대 제식검 아닌가? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s01
msgctxt "field|ko|art_ko_fl20_s01|@kfl20_s01/023"
msgid "그렇습니다. 전에드린 '블릿츠'의 후계모델로 경합중인 크리사오르의 신형검입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s02
msgctxt "field|ko|art_ko_fl20_s02|@kfl20_s02/000"
msgid "오랜만이군요, 프레데릭 각하."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s02
msgctxt "field|ko|art_ko_fl20_s02|@kfl20_s02/001"
msgid "라시드 왕자... 3년 만이던가요. 벌써 그렇게 되었죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s02
msgctxt "field|ko|art_ko_fl20_s02|@kfl20_s02/002"
msgid "제국을 훌륭히 이끌고 계신 것 같더군요./30d 정말 감탄했습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s02
msgctxt "field|ko|art_ko_fl20_s02|@kfl20_s02/003"
msgid "메디치 경의 도움이 없었다면 힘들었을 거예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s02
msgctxt "field|ko|art_ko_fl20_s02|@kfl20_s02/004"
msgid "아, 메디치 경... 그렇군요. 물론 메디치 부인도 안녕하시겠지요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s02
msgctxt "field|ko|art_ko_fl20_s02|@kfl20_s02/005"
msgid "이자벨도 잘 지내고 있지요. 그녀에게도 역시 많은 도움을 받고 있어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s02
msgctxt "field|ko|art_ko_fl20_s02|@kfl20_s02/006"
msgid "프레데릭 가문과 메디치 가문... 이제는 정말 제국령이 안정세에 들어 간 것 같아 마음이 놓입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s02
msgctxt "field|ko|art_ko_fl20_s02|@kfl20_s02/007"
msgid "사실, 이렇게 될 수 있었던 초석은 라시드 왕자가 놓아준 것이잖아요. 진심으로 감사하고 있어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s02
msgctxt "field|ko|art_ko_fl20_s02|@kfl20_s02/008"
msgid "제가... 그렇지 않습니다. 약간은 그럴지 몰라도 제가 전력을 다해 도와드린 것은 아니었기 때문에 감사를 받을 자격은 없습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s02
msgctxt "field|ko|art_ko_fl20_s02|@kfl20_s02/009"
msgid "진정으로 잊지 않고 감사를 드려야 할 사람은..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s02
msgctxt "field|ko|art_ko_fl20_s02|@kfl20_s02/010"
msgid "시라노..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s02
msgctxt "field|ko|art_ko_fl20_s02|@kfl20_s02/011"
msgid "예, 시라노 번스타인. 그야말로 현재의 제국령을 이끄시는 두분의 은인이자 우리에게 깨우침을 준 사람..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s02
msgctxt "field|ko|art_ko_fl20_s02|@kfl20_s02/012"
msgid "가장 큰 희생으로 진정한 의미의 초석이 되어 주신 그 분의 뜻, 평생 잊지 않을 거예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s02
msgctxt "field|ko|art_ko_fl20_s02|@kfl20_s02/013"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s02
msgctxt "field|ko|art_ko_fl20_s02|@kfl20_s02/014"
msgid "팬드래건으로는 언제 돌아가시죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl20_s02
msgctxt "field|ko|art_ko_fl20_s02|@kfl20_s02/015"
