#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/006"
msgid "뻔한 누명임을 알면서 그에게 책임을 묻겠다는 말씀이십니까, 메디치 님?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/007"
msgid "누명인지 아닌지 알게 뭔가!/20d 그리고, 난 우리 제피르팰컨의 명성이 손상되는 것을 원치 않아."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/008"
msgid "메디치 오빠,/10d 오빠가 언제 부터 그런 것에 연연했었죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/009"
msgid "그리고.../30d 시라노는.../25d 실버마저 잃었단 말이예요.../30d 그런데.../20d 그런..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/010"
msgid "모두 나 때문에 싸우는 건 그만 두시오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/011"
msgid "시라노 님, 일어나셨군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/012"
msgid "시라노...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/013"
msgid "메디치의 생각, 충분히 이해할 수 있소. 난 더 이상 제피르팰컨에 몸담을 수 없소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/014"
msgid "이제는 내게 시간이 얼마 남지 않았소./40d 내게 주어진 시간의 끝에 다다르기 전에 체사레와의 업을 모두 청산하고 싶소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/015"
msgid "이번에는 반드시 그를 만나 모든 일을 매듭짓고 말겠소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/016"
msgid "메디치 님, 저는 시라노 님을 지원하기 위해 병력을 이끌고 게이시르 대성당으로 향할 것입니다./50d 메디치 님은 어떻게 하시겠습니까."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/017"
msgid "저는 그를 따르겠어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/018"
msgid ".../20d 난 이 곳에 남겠어./30d 그런 자와 함께 행동할 바에야, 차라리 제피르팰컨을 그만 두겠단 말이오!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/019"
msgid "유감입니다, 메디치 님./20d 후회하실 말씀이 아니었기를 바랄 뿐입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/020"
msgid "....."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/021"
msgid "무슨 말을 하는 거예요, 카나 양./20d 실버씨의 죽음도 시라노, 그가 자초한게 아니던가요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/022"
msgid "시라노는 우리의 동료예요./20d 오빠에게는 동료보다 명예가 중요하다고 생각하나요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/023"
msgid "에스테!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/024"
msgid "클라우제비츠 군사도 너무해요.../20d 그렇게 시라노를 놓치지 않으려는 건 순전히 그의 힘때문이죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/025"
msgid "어떻게 사람이 그렇게 계산적일수가 있죠?/20d 그런 당신들이 메디치님을 비방할 자격이 있다고 생각해요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/026"
msgid "...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/027"
msgid "에스테..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/028"
msgid "메데치님..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/029"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/030"
msgid "/2c리브레빌. 에스테도데 저택."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/031"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/032"
msgid "메디치.../20d 설마 가지는 않겠죠...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s01
msgctxt "field|ko|art_ko_fl17_s01|@kfl17_s01/033"
msgid "가요, 클라우제비츠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/000"
msgid "이스카리옷..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/001"
msgid "후후... 시라노./20d 항상 네 소중한 것을 앗아가게 되서 미안하군./30d /n지난번 그 여자는 실버라고 했던가?/15d 너무 고지식한 여자였어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/002"
msgid "그 더러운 입에 실버의 이름을 담지 말아라."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/003"
msgid "너도 옛날과 달라진 바가 없이 너무 고지식해.../20d 설마 메르세데스를 정말로 찾아갈 줄이야./10d 쿠쿠쿠..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/004"
msgid "후후후, 시라노./15d 착각하지마라./30d 나는 달라졌다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/005"
msgid "너에게 패배감만 느끼던 옛날의 내가 아니란 말이다, 시라노!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/006"
msgid "이 정도로는 나를 막을 수 없다, 이스카리옷."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/007"
msgid "역시... 정상적인 힘으로는 너를 이길 수 없어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/008"
msgid "하지만, 내가 얻은 궁극의 힘이라면 이야기가 틀리다!/40d 각오해라, 시라노!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/009"
msgid "후후... 시라노... 최강의 힘을 손에 넣었구나. 내가 얻은 힘보다 훨씬 강한..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/010"
msgid "이스카리옷... 그렇게 흉칙한 괴물이 되어가면서 까지 힘을 얻고 싶었나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/011"
msgid "그렇기 때문에 자네를 배신할 수 있었던 것 아니겠나...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/012"
msgid "자네도 결국 나와 마찬가지로 괴물이야... 사람들과 공생할 수 없는 사회의 격리자..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/013"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/014"
msgid "나는 그래도... 이렇게 자네 손에 죽을 수 있지만... 자네는... "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/015"
msgid "체사레는 어디 있나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/016"
msgid "수중..도시..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/017"
msgid "사이럽스의 수중도시?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/018"
msgid "파괴신.../20d 부활..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/019"
msgid "파괴신을 부활시키기 위해 수중도시로 갔단 말인가!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s03
msgctxt "field|ko|art_ko_fl17_s03|@kfl17_s03/020"
msgid "체사레의 개, 이스카리옷.../20d 너의 목숨으로 실버의 영령을 위로하겠다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s04
msgctxt "field|ko|art_ko_fl17_s04|@kfl17_s04/000"
msgid "/2c수중 도시 중심부"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s04
msgctxt "field|ko|art_ko_fl17_s04|@kfl17_s04/001"
msgid "이 수중도시의 봉인이 지상에 남은 유일한 파괴신이지. 자네는 정말 운이 좋은 거야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s04
msgctxt "field|ko|art_ko_fl17_s04|@kfl17_s04/002"
msgid "후후, 운이 좋다니 너무한 말이오. 내가 이 파괴 신을 찾아내기 위해 얼마나 많은 노고를 쏟아부었는지 모르는군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s04
msgctxt "field|ko|art_ko_fl17_s04|@kfl17_s04/003"
msgid "하지만 조심해야 하네. 파괴신의 그 힘은 막대하지만, 우리들 조차도 제대로 제어 할 수 없기 때문에 자칫하다가는 오히려 우리가 당하고 말거야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s04
msgctxt "field|ko|art_ko_fl17_s04|@kfl17_s04/004"
msgid "그러니까, 제가 여기 있는거 아니겠어요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s04
msgctxt "field|ko|art_ko_fl17_s04|@kfl17_s04/005"
msgid "허허, 그래 그래. 크리스티나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s04
msgctxt "field|ko|art_ko_fl17_s04|@kfl17_s04/006"
msgid "하지만 내 부탁을 그렇게 쉽게 들어 줄 줄은 정말 몰랐구나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s04
msgctxt "field|ko|art_ko_fl17_s04|@kfl17_s04/007"
msgid "시라노 그 원수를 제 손으로 죽일 수 있다면 무슨 짓이라도 할 거예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s04
msgctxt "field|ko|art_ko_fl17_s04|@kfl17_s04/008"
msgid "조금도 지체 하고 싶지 않으니, 우리 어서 의식을 시작해요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s04
msgctxt "field|ko|art_ko_fl17_s04|@kfl17_s04/009"
msgid "각오가 좋은 걸. 슬슬 시작해 볼까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl17_s3t
msgctxt "field|ko|art_ko_fl17_s3t|@kfl17_s3t/000"
msgid "[이스카리옷]/n이것이 위대한 그리마의 힘이다. 시라노!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/000"
msgid "메디치 오빠?/20d 설마 리델하트가...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/001"
msgid "제가 어떻게든 손을 써보겠어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/002"
msgid "에... 에스테도데... 그녀가 리델을..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/003"
msgid "에스테도데가?!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/004"
msgid "[에스테도데]/n호호호!/30d 애초에 동료를 배반한 당신 잘못이지. 그 탓을 내게 뒤집어 씌우다니, 정말 어리석군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/005"
msgid "에스테도데, 지금이라도 늦지 않았으니 그를 뒤쫓아가 용서를 구하시오. 나도 당신을 용서하겠소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/006"
msgid "그렇지 않은가요? 디아블로 님?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/007"
msgid "후후후, 벌레만도 못한 것이!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/008"
msgid "괜찮소, 메디치?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/009"
msgid "디아블로... 그리고 체사레 보르자!/40d 나와 내 스승님의 원수를 이렇게 한자리에서 만나게 되다니."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/010"
msgid "하지만, 크리스티나를 얌전히 돌려준다면 목숨만은 살려줄 용의가 있다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/011"
msgid "이거 섭섭하군, 시라노 번스타인군./n생명의 은인을 원수라고 부르다니. 하마터면 통구이가 될뻔했던 자네를, 내가 선처해 주지 않았던가!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/012"
msgid "게다가 디아블로 님께도 그 무슨 망언인가!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/013"
msgid "됐네, 체사레 추기경. 내 감이 틀림 없다면 저녀석의 몸에서 풍기는 기운은 데이모스의 그 것과 같아."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/014"
msgid "어쩐지 몇년 전부터 데이모스의 기운이 느껴지지 않는다 했더니, 네 녀석과 융합한 것이었군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/015"
msgid "흐흐흐, 네 녀석이 크리스티나의 뭐길래 남의 손녀딸을 내 놓으라 말아라 하는 거냐."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/016"
msgid "긴 말은 필요 없다./20d 얌전히 크리스티나를 내놓으면 고통스럽지 않은 죽음을 선사하겠다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/017"
msgid "디아블로 님, 저 녀석은 독에 중독되어 얼마 남지 않은 목숨이니 벌레만도 못한 녀석입니다. 상관치 마시고 의식을 계속 해나가시는 것이..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/018"
msgid "언제까지 망언을 계속 할 수 있나 보겠다, 체사레! 각오해라!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/019"
msgid "같이 죽자! 에스테도데!!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/020"
msgid "우웃!!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/021"
msgid "아니!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/022"
msgid "네 놈은...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/023"
msgid "어딜 감히!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/024"
msgid "왜... 왜 나를 구한거요!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/025"
msgid "생명의 은인이 눈앞에서 죽는 모습을  볼 수 는 없는 일 아니겠소?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/026"
msgid "내가... 당신의...? 은인?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/027"
msgid "3년전 인페르노에서 당신과 함께 탈출한 죄수를 아직까지 기억할런지는 모르겠소만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/028"
msgid "시라노 당신이, 그때 그...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/029"
msgid "그때 당신의 눈은 빛나고 있었소. 그런데 지금은 저런 요녀에게 홀려 광채를 잃어가고 있소./60d 당신의 모습을 보시오, 메디치!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/030"
msgid "으으...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/031"
msgid "메디치!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/032"
msgid "호호, 저런 겁쟁이를 위해서 몸을 내던지다니, 시라노 님도 어지간히 바보로군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/033"
msgid "웃기는 소리도 적당히 해야지, 뭐? 용서를 빌라구?/50d 호호호!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/034"
msgid "디아블로 님이 나를 지켜 주실거다! 용서 같은건 너희들이나 빌어라!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/035"
msgid "디아블로라... 당신이 바로 디아블로였군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/036"
msgid "크리스티나가...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/037"
msgid "이미 늦어 버렸어! 파괴신이... 부활하고 있어요!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/038"
msgid "에스메랄다가 희생해가면서 까지 구해낸 크리스티나가...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/039"
msgid "틀렸어요... 크리스티나의 숨이 점점 약해지고 있어요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/040"
msgid "크리스티나는...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/041"
msgid "수중 도시가 붕괴하고 있으니 우선 이 자리를 피해야 합니다!"
