#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma11
msgctxt "field|ko|art_ko_fldma11|@kfldma11/000"
msgid "<< 크리스탈 유니콘 >>/n/n천공의 유니콘은 순결의 상징./n가장 순결하고 고귀한 혼을 지닌자만이 그의 마음을 얻을수 있네./n/n모험가 라르고  "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/000"
msgid "당신... 이곳에서 무엇을 하고 있는 것이죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/001"
msgid "나? 글쎄.... 과연 내가 누구지..../n엇! 당신 이상한 칼을 갖고 있군!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/002"
msgid "무슨 뜻이지? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/003"
msgid "이상한 검의 기가 느껴진다... 그 베낭안에 있는 것을 한번 보여줄 수 없겠나? /n.. 이것은 엑스칼리버! 어디서 이 명검을...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/004"
msgid "좋은 칼이긴 하지만, 상당히 낡았기 때문에..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/005"
msgid "그 명검을... 명검을 이렇게 보관했다니! 잠시 기다려 보게!내가 고쳐줄 테니."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/006"
msgid "엑스칼리버가 수리되었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/007"
msgid "당신... 혹시 파즈라는 사람인가? 정말 고맙다, 이 칼을 고쳐주어서."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/008"
msgid "내 이름을 아나보군. 괜찮다. 이 명검을 고쳤다는 것 만으로도.... 잘 가게나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/009"
msgid "나? 글쎄.... 과연 내가 누구지..../n엇! 당신 이상한 칼을 갖고 있군!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/010"
msgid "이런 외지고 위험한 곳에서.... 무엇을 하고 계신 것입니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/011"
msgid "[파즈]/n흠... 나 말인가. 파즈라고 하네. 평생동안 검을 수리하면서 다녔지만, 세상에 허무를 느끼고 이곳에 와서 지내고 있다네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/012"
msgid "하지만, 이런곳에서... 외롭거나 무섭지 않으세요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/013"
msgid "[파즈]/n무섭냐고? 하하하... 나도 옛날에는 이름난 검사였지. 이곳의 몬스터들은 절대로 나를 해치지 못해."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/014"
msgid "[파즈]/n하지만, 단지... 가끔가다 정말로 좋은 칼이 보고 싶을 때가 있다네. 이올린 팬드래건의 엑스칼리버라던지, 팬드래건 가문의 바리사다나, 혹은 투르족이 쓴다는 광선검..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/015"
msgid "엑스칼리버... 그 낡은 칼 말인가? 그게 그렇게 명검이었단 말인가.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/016"
msgid "[파즈]/n당신... 그 칼을 갖고 있단 말인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/017"
msgid "그 엑스칼리버가 상당히 낡은 칼을 말한다면 갖고 있습니다만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/018"
msgid "[파즈]/n그 칼을 갖고 있다면, 잠깐 보여줄 수 없겠나. 이 늙은이의 소원일쎄."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/019"
msgid "좋습니다. 어려운 것도 아닌데요. 너무 낡아서 더이상 쓰지 않는 칼인데."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/020"
msgid "낡은 엑스칼리버를 꺼냈다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/021"
msgid "[파즈]/n이것은... 그 전설의 칼 엑스칼리버가 아닙니까, 신이시여.../n 그런데, 상당히 낡았군... 자네, 내가 이 칼을 고쳐도 되겠나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fldma17
msgctxt "field|ko|art_ko_fldma17|@kfldma17/022"
msgid "그 낡은 칼을 고치시겠다고요? 너무 낡아서 아무도 고칠 생각을 안하던 칼이었는데... 좋습니다. 못쓰던 칼이 쓸만 해 진다면 저도 좋지요."
msgstr ""

