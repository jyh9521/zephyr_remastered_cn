msgctxt "field|re|art_fl15_s05|@kfl15_s05/010"
msgid "그럴 리 있겠습니까./35d/n하지만/30d 지금 상황에서 부인이 보낸 편지라면,/40d 내용은 쉽게 상상할 수 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
msgctxt "field|re|art_fl15_s05|@kfl15_s05/011"
msgid "지극히 감정에 치우친 내용이든지,/50d 아니면 매우 간략하고/20d 냉정한 내용이든지…/50d/n둘 중 하나일 테지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s05
