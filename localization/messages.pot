msgid "…메르세데스, 절대 용서할 수 없어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
