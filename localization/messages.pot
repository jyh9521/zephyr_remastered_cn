msgid "?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/039"
msgid "사실/50d 저는 매일 이 시간이면/35d/n이 화원에 들러/35d 꽃들을 한 번씩 둘러보거든요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/040"
msgid "그런 제 습관 때문에/40d 이렇게/30d 밤중에 메디치 님과/30d/n단둘이서만 있을 수도 있게 되고…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/041"
msgid "에스테 님…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/042"
msgid "어머,/15d 죄송해요./35d/n기분 상하셨나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/043"
msgid "아,/15d 아뇨./20d 기분 상하다니요./25d/n에스테 님의 그 농담 덕분에/20d 오히려 기분이 좋아졌는걸요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/044"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/045"
msgid "……?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/046"
msgid "…농담이 아니에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/047"
msgid "네에?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/048"
msgid "동경해 오고 있었어요,/45d 저는./50d/n메디치 님/50d 당신을…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/049"
msgid "에스테 님…/15d 저는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/050"
msgid "알고 있어요…/55d/n저를/25d 가벼운 여자로 보시는 거죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/051"
msgid "그런 건…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/052"
msgid "그래요./30d 오늘 처음 뵌 분께/35d 이런 고백을 하다니…/45d/n우습게 보여도 어쩔 수 없겠죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/053"
msgid "하지만,/25d 메디치 님./35d 이렇게 당신을 눈앞에서 보니/45d/n제 마음을 주체할 수 없어서…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/054"
msgid "에스테 님…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/055"
msgid "에스테라고…/40d 불러주세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/056"
msgid "에스테…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/057"
msgid "제 방까지…/45d 에스코트는/20d 해 주시겠죠…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/058"
msgid "물론이오,/30d 에스테."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/059"
msgid "나는 우리의…/35d/n우리 모두의 좋은 관계를 깨뜨리고 싶지 않아요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
