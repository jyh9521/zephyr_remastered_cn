msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/012"
msgid "돌파?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/013"
msgid "적이 공격을 하면 방어자는 그 공격을 막으려고 하는 것이 본성이네. 물론 적의 공격을 백퍼센트 다 막을 수 있는 사람은 존재하지를 않지만, 여기서는 그렇다고 가정을 해 보세."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/014"
msgid "그런 경우의 적의 공격은 일단 방어자의 무기에 막히게 되지. 즉, 무기는 적의 공격을 일차적으로 막는 방어벽 역할을 한단 말일쎄. 그런데 세상 모든것이 그렇듯이 여기서도 어떤쪽이 강한지가 결과를 결정하지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/015"
msgid "그렇다면 검이 깨어진 것도 같은 이유에서라는 말씀이십니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/016"
msgid "그렇지. 공격력이 방어자의 무기 한계력보다 클 경우에 무기는 손상을 입게되고 방어자는 공격력에서 자기 무기의 방어력을 뺀 만큼의 피해를 입게되지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/017"
msgid "이렇게 적의 공격이 방어자의 무기를 넘어서 뛰어들었을 때를 \"돌파당했다\"라고 표현하지. 이렇게 무기가 돌파당하게 되면 무기 HP가 1 감소하게 되네. 만약 무기 HP가 0이되면 그 무기는 파괴되는 것이라네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/018"
msgid "세검은 공격력을 극대화시킨 검인 반면에 무기 한계력이 극도로 낮고, 대부분 무기 HP가 1 또는 2 라네. 그러니까 전투중에 그렇게 쉽게 깨어지게 되는 것이지. 물론, 무기는 파괴되지 않는 이상 수리할 수가 있다네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/019"
msgid "그렇다면 세검은 실전에서 쓸모가 없다는 말입니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/020"
msgid "아니. 세검은 주로 장거리 공격을 하는데 사용하면 적에게 타격을 입힐 수 있다네. 특히 혼자가 아니라 다수가 싸울때는 역할 분담용 무기로 큰 역할을 할 수 있지. 하지만 혼자 여럿을 상대해야 할 때에는 적절치 않은 무기라 생각되네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/021"
msgid "자, 개념이 이해 되었는가? 그럼 다시 실전을 통해 지금 익힌것을 몸으로 체득해 보게. 이번에는 아까보다 조금 더 멀리나가야 할 것이야. 아, 그리고 다음번수업은 세검에 반대되는 검인 중검에 대한 설명과 더불어 방어의 고급을 알려주겠네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/022"
msgid "경험치 40이 증가했습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/023"
msgid "다녀왔습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/024"
msgid "그런가? 이리오게."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/025"
msgid "5장 : 중급방어 "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/026"
msgid "4장 : 초급방어"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/027"
msgid "이제 자네도 중급 이상의 검술을 익혔군. 그럼 중검과 방어에 대한 이론을 총 정리 해 보세."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/028"
msgid "아까 돌파개념을 설명하면서 \"방어자는 공격자의 공격을 백퍼센트 방어한다\"고 가정한 상태에서 강의했네. 그러나 실전에서는 적의 공격을 백퍼센트 방어할 수는 없지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/029"
msgid "예. 적의 공격을 모두 막을 수는 없었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/030"
msgid "적의 공격을 얼마만큼이나 막을 수 있느냐는 사용 무기의 종류와 방어자의 민첩성과 관련이 있지. 세검의 경우는 무기 자체가 막기에 적합하지 않기 때문에 상당히 많은 공격을 막지 못하고, 중검의 경우는 무기 특성이 적의 공격을 막을 확률을 올려주게 된다네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/031"
msgid "또한, 방어력이란 개념이 있지. 적의 공격을 막았을 때 무기의 특성에 따라 적의 공격력은 일정 퍼센트 떨어뜨려주게 된다네. 역시 세검은 방어력이 낮고 중검은 방어력이 높기 때문에 똑같은 공격을 막았을 때 한계력이 같다고 해도 대체로 중검이 휠씬 덜 피해를 입게 되는 것이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/032"
msgid "그럼, 중검을 사용하는 것이 현명하다는 것입니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/033"
msgid "대체로는. 물론 검에는 세검과 중검만 있는 것은 아니지. 하지만, 검사의 레벨이 낮거나 다수의 적을 혼자서 상대해야할 때, 혹은 좁은 공간에서 싸울대는 중검을 사용하는 것이 검사가 살아남는데 도움을 주겠지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/034"
msgid "이제 방어자세에 대해 알려주겠네. 적의 공격이 집중된 상황에서 아군의 도움을 기다리거나 적의 눈을 끌어야 할 때, 상당히 유용하지. 방어자세를 취한 상태에서는 적의 공격을 막을 확률이 두배가 되지. 만약 자네가 중검을 갖고 있는 상황이라면 방어자세는 자네의 목숨을 살려줄 것이라네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/035"
msgid "알겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/036"
msgid "이제 설명도 끝나가는군. 이번에는 동굴 속까지 들어가보지 않겠나? 지금 배운것을 잘 생각하면서 이 칼을 사용하게."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/037"
msgid "그라디우스를 얻었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/038"
msgid "가장 초보적인 중검이지. 하지만 이 섬의 동굴 녀석들의 공격은 막아낼 수 있다네. 다음 수업은 여러 사람과 같이 싸울때 필요한 전술에 대한 설명과 무기 교체에 대한 설명일쎄."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/039"
msgid "6장 : 전술과 장비교체"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/040"
msgid "자네도 이제 혼자 하는 싸움에 대해서는 어느정도 감을 잡은 것 같군. 하지만 전쟁은 수많은 사람들이 싸우는 것. 지내다 보면 자네도 동료와 함께 싸우게 될 것이네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/041"
msgid "동료와 함께 싸울때는 역할 분담을 하는 것이 중요하지. 일단 중검을 든 동료는 적진으로 돌격시켜 적의 공격을 막음과 동시에 적의 시선을 끌어서 다른 아군의 공격을 원활하게 하는 역할을 주고,"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/042"
msgid "동시에 세검이나 공격력이 강한 검을 가진 동료와 마법이나 총등을 사용하는 동료는 앞에 나간 동료가 시선을 끈 적들을 후방에서 공격해서 일망타진 하는 전법이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/043"
msgid "앞으로 돌격한 쪽이 위험하지 않을까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/044"
msgid "실제적으로 중검류의 방어력이 상당하기 때문에 적이 압도적으로 강하지 않다면 그다지 위험하지는 않지. 단, 중검일 경우 이쪽에서 피해 입히기도 어렵기 때문에 싸움에서 \"이기기\"위해서는 동료들의 도움이 필요한 것이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/045"
msgid "알겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/046"
msgid "그리고 장비교체에 대해서일쎄. 양손을 제외하고, 두개의 보조 장비를 착용할 수 있는 것은 잘 알고 있을 테지. 전투중에 손에 든 무기와 보조장비는 교환이 가능하네. 보통은 무기가 파손된 경우를 대비한 \"보조\"용이나, 이것을 이용하면 혼자 싸우면서도 여럿이 같이 싸우는 효과를 낼 수 있지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/047"
msgid "특징이 다른 두가지 이상의 무기를 동시에 사용하는 방법인가요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/048"
msgid "경험치 50이 상승했다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/049"
msgid "그렇지. 보통때는 중검과 세검을 같이 들고 다니면서 적이 적거나 충분히 멀리 떨어져 있으면 세검을, 적에게 근접해야 할 상황이 닥치면 중검으로 바꿔쥐고 싸우는 것이네. 검을 바꿔쥔 다음에도 이동과 공격이 가능하므로 아주 유용한 방법이라고 볼 수 있지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/050"
msgid "특히나 세검은 적이 어느정도 제압이 된 뒤에 마무리용으로 사용하면 아주 좋지. 중검을 사용할 때는 검에의한 공격보다는 마법이 효과적일 수 있다는 것을 잊지말고."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/051"
msgid "이제, 일반적인 공격에 대한 설명은 모두 다 했네. 마지막으로 검의 궁극적 기술이라는 필살기에 대한 설명만 남았군. 필살기를 적절히 사용하면 아무리 강한 적도 자네 상대가 아니라는 것을 알게될 것이야. 이번에는 좀 더 동굴 깊숙히 갔다 오게나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/052"
msgid "경험치 50이 상승했다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/053"
msgid "어떤가. 공부를 시작할 마음의 준비는 되었나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/054"
msgid "지금 당장부터라도 시작할 수 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/055"
msgid "그럼, 내가 오늘부터 자네에게 전법에 대해 설명해주겠네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/056"
msgid "나의 가르침만으로 모든 것이 해결되는 것은 아니지만 이론을 무시해서는 안되는 법이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/057"
msgid "먼저 칼이라는 무기의 체계에 관해 대략적으로 설명해 주겠네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/058"
msgid "칼의 종류는 세검, 중검, 장검, 대검으로 분류할 수 있다네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/059"
msgid "세검은 가볍고 날카롭고 가는 검을 말하며, 중검은 비교적 짧고 무겁고 두터운 검, 장검은 길고 가장 일반적인 검, 대검은 그야말로 길고 넓고 커다란 검들을 말하는 것이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/060"
msgid "이 검들중 가장 쓰기 편한것은 물론 일반적인 장검류이지만 전술적으로 더 중요한 것은 세검과 중검들이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/061"
msgid "대검은 일단 사용할 여건만 된다면 최강의 검이지만 좋은 대검들은 얻기가 쉽지 않을걸세."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/062"
msgid "세검과 중검이 전술적으로 중요하다는 것은 그 검들의 뚜렷한 개성 때문인데,/15d 세검은 공격에서, 중검은 방어에서 그 위력을 발휘한다네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/063"
msgid "검에 분류에 대해서는 이정도 기본적으로만 알아두고 세검과 중검에 대해서는 나중에 따로 자세히 설명하겠네. 이제 실전에 필요한 간단한 몇가지 주의사항만 익히도록 하고 오늘 공부는 끝내기로 하겠네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/064"
msgid "첫째로 적과의 거리와 방향을 항상 염두에 두게나./15d 이건 검술뿐 아니라 어떤 전투방법에도 통용되는 얘기라네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/065"
msgid "항상 상대와의 거리를 염두에 두고 상대에게 뒤를 보이지 말게나./20d 자신보다 낮은 수준의 상대가 예측된 공격을 한다면 뒤로부터의 공격도 피해낼 수 있겠지만 진정한 검사는 일전일전을 항상 자신보다 강한 상대와의 싸움이라 생각하고 전투에 임해야하네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/066"
msgid "기사의 도를 생각한다면 상대의 뒤를 노리는 비겁한 짓은 해서는 않되지만 살아남는 것을 중요시한다면 상대의 뒤를 노리는 것도 간과할 수 없는 전술중 하나라 할 수 있지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/067"
msgid "두번째로 중요한 것은 적의 강점과 약점을 아는 것이야./20d 말은 쉽게 들리겠지만 정작 전투에서 제대로 적용하기가 쉽지는 않지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/068"
msgid "적의 강점을 아는 것은 방어의 방법을 단순화 시켜 적의 공격을 막아낼 확률을 높일 수 있고, 적의 약점을 아는 것은 공격을 성공시킬 확률을 높일 수 있는 것이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/069"
msgid "대표적인 예로 마법사들은 마법에 대한 내성이 뛰어나서 일반적인 마법 공격으로는 이기기 힘드네만 검이나 총탄앞에는 무력하지. 또, 사수들은 총을 사용하기 때문에 사정거리가 길고 공격력은 뛰어나지만 반대로 방어력은 마법사와 크게 다를 바 없고 더구나 마법공격에는 턱없이 약하다네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/070"
msgid "그런 것 외에도 약점은 여러가지 형태로 표출 되기 때문에 실전과 병행되는 많은 공부가 필요하지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/071"
msgid "일단 이 두가지를 잊지 않도록하고. 다음부터는 전투의 기술에 대해 좀 더 세분화해서 설명해주겠네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/072"
msgid "조금 실전을 쌓고 돌아오게나. 그러면 마법에 대해 설명해주지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/073"
msgid "처음에는 너무 욕심부리지 말고 조금씩 경험을 쌓도록하게나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/074"
msgid "경험치 10이 상승했습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/075"
msgid "1장 : 검의 종류와 전투의 개념"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/076"
msgid "2장 : 마법"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/077"
msgid "실전도 조금은 경험한 것 같으니, 이제 마법에 대해 설명해주지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/078"
msgid "전에 약점에 대해서도 간단히 이야기 했지만 다양한 공격 방법을 익히는 것은 한가지 기술에 통달하는 것 만큼이나 중요한 일이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/079"
msgid "자네는 마법을 조금 사용할 줄 아는 것 같던데... 어떤 마법들을 사용할 줄 아는가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/080"
msgid "데이모스님에게 전수 받은 암흑 마법을 조금 할 줄 압니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/081"
msgid "그럼 내 마법을 익히는 것도 어렵지 않을걸세. 자네에게는 빙한 계열 마법을 전수해주지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/082"
msgid "아, 마법의 전수 이전에 이 땅에 존재하는 마법의 체계에 대해 잠깐 설명해주겠네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/083"
msgid "마법은 크게 6가지 계열로 나뉘는데/15d 일명 삼원소 마법이라 불리는 화염, 빙한, 전격계 의 세가지 계열과 암흑신의 힘이 원천이라는 암흑마법, 주신의 힘에서 유래했다는 신성마법, 그리고 신성마법에서 유래됐다고 알려져 있는 보조 마법이 있지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/084"
msgid "이중에 삼원소 마법은 서로 물고 물리는 관계로, 화염은 빙한에 약하고 빙한은 전격에, 전격은 화염에 약하지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/085"
msgid "그리고 암흑과 신성 마법은 삼원소 마법과는 독자적으로 서로 상극인 마법이지. 즉, 공격하는 쪽이 압도적으로 유리하다네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/086"
msgid "보조 마법은 시공을 건드리는 마법으로, 다른 5계열 마법들과는 어떠한 상관 관계도 갖지 않아."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/087"
msgid "더구나 이 마법 계열들은 굳이 마법 뿐 아니라 다른 물질들의 속성으로 부여되는 경우가 있기 때문에 반드시 기억하고 있어야하네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/088"
msgid "대표적으로 가까이서 느낄 수 있는 것은 몬스터들의 속성이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/089"
msgid "예를 들어 화염속성을 가진 몬스터라면 빙한속성의 마법이나 무기로 공격하면 두배의 피해를 입힐 수 있지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/090"
msgid "반대로 같은 계열인 화염으로 공격하면 피해를 체력으로 흡수해 회복하게 되고, 전격으로 공격하면 피해를 전혀 입지 않으니 주의하게나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/091"
msgid "자, 그럼 이제 빙한 계열의 마법을 전수해 주겠네. 실전에서 유용하게 써보게나. 그리고 다음 수업 주제는 세검일쎄."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/092"
msgid "빙한계열마법을 배웠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/093"
msgid "3장 : 세검"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/094"
msgid "그럼 이번에는 검의 공격과 세검에 대해 설명해 주지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/095"
msgid "지난번에 세검과 중검에 대해 잠깐 설명해준적이 있지?/15d 세검의 특징은 내가 뭐라고 했던지 기억 나는가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/096"
msgid "공격력 중시의 가벼운 검이지만 방어에 약하다고 하셨지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/097"
msgid "그렇지, 일단 가벼워서 다루기 쉽고 적의 급소를 확실히 공격할 수 있기 때문에 뛰어난 공격력을 지니고 크리티컬의 확률도 높지./30d 하지만 반대로 방어를 하기에는 너무 가늘고 가벼워서 적의 공격을 방어하다보면 검만 망가지고 공격은 저지되지 않기 일수야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/098"
msgid "차라리 방어를 하지 않는 쪽이 나을 수도 있겠군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/099"
msgid "극단적으로 말하면 그렇지./10d 대신 공격력이 워낙 뛰어나기 때문에 선제 공격을 잘만하면 오히려 적이 제대로 공격하기도 전에 전투를 끝내 버릴 수도 있지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/100"
msgid "도박성이 강하다고도 할 수 있지만 가격에 비해 공격력이 월등하기 때문에 돈만 충분하다면 많이 가지고 다니면서 소모품처럼 써버리는 것도 괜찮은 전법중에 하나라네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/101"
msgid "소모품이라..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/102"
msgid "검의 교체에 대해서는 다음번에 더 자세히 설명해 주겠네./20d 일단은 내가 준 어설트 소드로 세검의 기본적인 전법을 익혀보게나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/103"
msgid "어설트 소드를 얻었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/104"
msgid "경험치 30이 증가했습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/105"
msgid "마지막장 : 필살기"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/106"
msgid "안타리아의 검술을 대표하는 검술에는 크게 두가지 줄기가 있다네. 팬드래건 왕국을 중심으로한 검법과 게이시르 제국을 중심으로한 검법, 일명 왕국검법과 제국검법이라고 하는데, 왕국검법은 속도를, 제국검법은 힘을 중요시한다네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/107"
msgid "제국검법의 필살기들은 적의 가드를 힘으로 뚫고 일격필살을 노린다면, 왕국검법의 필살기는 적의 의표를 찌르는 빠른 연속공격으로 적을 제압하지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/108"
msgid "학자였던 자네가 사용하기에는 힘보다 기술을 중요시 하는 왕국검법이 유리할걸세."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/109"
msgid "일단 왕국검법의 기본 필살기라 할 수 있는 진공수라인을 예를 들어 보겠네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/110"
msgid "진공수라인을 비롯해 각종 필살기를 사용하려면 그에 상응하는 기력(/2cXP/5c)이 필요하지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/111"
msgid "기력은 마법을 사용하는데 필요한 마력과도 비슷하지만 공격이나 방어시, 적을 쓰러뜨릴때마다 조금씩 상승하고 공격력 방어력도 그에 비례해 상승하지. 기력이 필살기를 사용한다고해서 줄거나 하지는 않을걸세."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/112"
msgid "다만, 기력이 충만해진 상태에서는 몸이 오래 버티기 힘들기 때문에 일정시간이 지나면 자연히 기력이 소멸될걸세."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/113"
msgid "필살기의 수준에 따라 필요로 하는 기력에 차이가 있으니 다른 필살기들은 실전을 겪으며 익혀보게나. 그리고... 이건 내가 옛날에 쓰던 칼인데, 도움이 될 거야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/114"
msgid "낡은 엑스칼리버를 얻었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/115"
msgid "경험치가 100 상승하였습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/116"
msgid "이제 이걸로 자네는 내게서 이론적으로 배울것은 다 배웠네. 나머지는 실전을 통한 훈련 뿐... 부디 열심히 익혀서 아수라를 이겨 보게나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/117"
msgid "그리고, 여기 단검 한자루를 줄테니 장착하는 것을 잊지 말게나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/118"
msgid "단검을 입수하였습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo01
msgctxt "field|ko|art_ko_fliyo01|@kfliyo01/119"
msgid "경험치 10이 상승했습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo02
msgctxt "field|ko|art_ko_fliyo02|@kfliyo02/000"
msgid "어서오세요 시라노님. 이올린님께서 항상 시라노님의 잠자리를 봐 두라는 분부를 받았습니다. 주무시겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo02
msgctxt "field|ko|art_ko_fliyo02|@kfliyo02/001"
msgid "편안히 쉬세요. 이곳 폭풍도에서 수련하기 위해서는 많은 휴식이 필요합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo02
msgctxt "field|ko|art_ko_fliyo02|@kfliyo02/002"
msgid "너무 수련에 무리하지는 마세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fliyo02
msgctxt "field|ko|art_ko_fliyo02|@kfliyo02/003"
msgid "안녕히 주무셨나요? 오늘도 상쾌한 하루입니다. 피로해지면 언제라도 오세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmat01
msgctxt "field|ko|art_ko_flmat01|@kflmat01/000"
msgid "안타 나나리보 지방"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmat01
msgctxt "field|ko|art_ko_flmat01|@kflmat01/001"
msgid "마키아벨리는 안타나나리보를 통해 망티고아산을 넘어가려고 한다는 정보이다."
