msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltbo01
msgctxt "field|ko|art_ko_fltbo01|@kfltbo01/030"
msgid "루치아 씨 말이죠? 정말 이상한 가족들이에요. 한 가족이란 사람들이 서로 그렇게 서먹서먹한가요?/20d 아무래도 이상해요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltbo01
msgctxt "field|ko|art_ko_fltbo01|@kfltbo01/030_3"
msgid "루치아씨 말이죠? 정말 이상한 가족들이에요. 한 가족이란 사람들이 서로 그렇게 서먹서먹한가요? 수상해요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltbo01
msgctxt "field|ko|art_ko_fltbo01|@kfltbo01/031"
msgid "루치아 씨 댁에 대한 사람들의 의견은 반반이예요./20d 루치아 씨 댁 가족들은 사이가 안 좋은 집안이다, 혹은 그들은 실제 가족들이 아니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltbo01
msgctxt "field|ko|art_ko_fltbo01|@kfltbo01/031_3"
msgid "사람들의 의견은 반반 이에요. 루치아씨 댁 가족들은 사이가 안 좋은 집안이다, 혹은 그들은 실제 가족들이 아니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltbo01
msgctxt "field|ko|art_ko_fltbo01|@kfltbo01/032"
msgid "저는 그들이 실제 가족들이 아니라고 생각해요. 무엇보도 루치아 씨 부부가 손을 잡고 다니는 것을 본 적이 없다니까요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltbo01
msgctxt "field|ko|art_ko_fltbo01|@kfltbo01/032_3"
