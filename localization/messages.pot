msgid "그럴 수는 없습니다, 프레데릭 부인."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/058"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/059"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/060"
msgid "후후후…/85d 잘도 버티는구나./70d 하지만,/30d 장난은 여기까지다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/061"
msgid "젠장…/45d 이게/20d 우리의 한계인가…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/062"
msgid "시라노…/40d 그가 있었다면…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/063"
msgid "죽어라!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/064"
msgid "으윽!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/065"
msgid "아니!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/066"
msgid "네놈은…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/067"
msgid "모두 괜찮나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/068"
msgid "왜…/40d 왜 우리를 구한 거요?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/069"
msgid "당신은/20d 더 이상 제피르 팰컨도 아니지 않소!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/070"
msgid "제피르 팰컨이든 아니든 상관없소./50d/n우리는 함께 목숨을 걸고 싸운 동료였잖소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/071"
msgid "동료가 위험에 빠진 걸 못 본 체할 수는 없지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/072"
msgid "시라노…/55d 미안했소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/073"
msgid "내가…/50d 내가 너무 형편 없어서/40d 무슨 말을 해야할지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/074"
msgid "시라노,/30d 우리를 버린 게 아니었군요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/075"
msgid "과거의 일은 잠시 접어두고,/30d 눈앞의 적을 쓰러트려야할 때야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/076"
msgid "네가 시라노인가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/077"
msgid "과연/30d 데이모스의 영혼을 이어받은 자는/45d/n조무래기들과는 다르군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/078"
msgid "네놈이군./40d 데이모스의 두 번째 원수가."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/079"
msgid "호오,/45d 날 알아보는건가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/080"
msgid "창세전쟁에서 살아남은 암흑신 중,/45d 이루스…/30d/n아니,/30d 파멸의 유스타시아는 내 손으로 쓰러트렸다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/081"
msgid "남은 건/30d 달의 디아블로 네놈뿐이다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/082"
msgid "저 자가/30d 암흑신?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/083"
msgid "그리고 체사레…/45d 모든 악의 근원!/60d 내 손으로 제거하겠다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/084"
msgid "재회의 인사 치고는/30d 너무 살벌한 소리를 하는군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/085"
msgid "화형대의 한 줌 재가 될 뻔한 자네를,/50d/n목숨이라도 부지하게 해 준 생명의 은인이 바로 나 아니던가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/086"
msgid "헛소리는 그만 둬라,/10d 체사레!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/087"
msgid "나는 복수를 위해 여기 온 것이 아니야./45d/n악의 뿌리를 끊기 위해 온 것이다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/088"
msgid "허허,/45d 자네는 아직도 어리석은 고정관념에서 벗어나지/n못하는군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/089"
msgid "나의 행동은 모두 조국을 위한 것이다./70d/n이해를 바랄 생각은 없지만,/45d 오해는 없었으면 하네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/090"
msgid "마키아벨리에게 들어 당신의 이상은 이미 알고 있다./70d/n하지만 그건 잘못된 생각이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/091"
msgid "그릇된 수단으로 세계를 통일해도/40d 아무런 의미가 없어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/092"
msgid "인간은/30d 시행착오와 실패를 반복한 끝에 성공하여 성장하는 것이다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/093"
msgid "역사를 억지로 이끈다고 해도,/45d 결국 퇴보를 의미하게 될 뿐이야!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/094"
msgid "이런 곳에서 자네와 사상에 대해 토론을 벌이게 될 줄은/n몰랐네만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/095"
msgid "역사는 이미 흐르고 있어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/096"
msgid "닥쳐라!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/097"
msgid "시간이 없어요!/15d 이러다가는 파괴신의 부활이…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/098"
msgid "시라노,/25d 함께 저들을 물리칩시다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/099"
msgid "누구와 함께 싸우겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/100"
msgid "메디치, 당신의 힘이 필요해!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s02
msgctxt "field|re|art_fl23_s02|@kfl23_s02/101"
