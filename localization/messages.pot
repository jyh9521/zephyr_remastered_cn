#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltka01
msgctxt "field|ko|art_ko_fltka01|@kfltka01/026"
msgid "[ 요리사 카그 ]/n진정한 요리란, 좋은 재료, 요리사의 실력, 그리고 정성에서 나오게 되지. 혹시 좋은 재료를 구해 온다면 사례는 후하게 하겠네. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltka01
msgctxt "field|ko|art_ko_fltka01|@kfltka01/027"
msgid "[요리사 카그] /n좋은 재료가 없으면 아무리 좋은 요리 솜씨도 소용이 없단 말이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltka01
msgctxt "field|ko|art_ko_fltka01|@kfltka01/028"
msgid "[요리사 카그]/n아직도 좋은 재료를 찾지 못했단 말이야? 정말이지..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltka01
msgctxt "field|ko|art_ko_fltka01|@kfltka01/029"
msgid "[요리사 카그]/n우리 집안은 요리사 집안이지. 내 형제들은 이곳저곳에 많이 퍼져있지. 만나게 되면 안부좀 전해 주게나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltka01
msgctxt "field|ko|art_ko_fltka01|@kfltka01/030"
