#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s05
msgctxt "field|re|art_fl03_s05|@kfl03_s05/014"
msgid "구해주셔서 감사합니다./45d/n저는 시라노라고 하는데,/40d 실례지만 성함이… "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s05
msgctxt "field|re|art_fl03_s05|@kfl03_s05/015"
msgid "지금은 보답할 것이 없습니다만,/45d/n이 은혜는/25d 언젠가 꼭 갚겠습니다. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s05
msgctxt "field|re|art_fl03_s05|@kfl03_s05/016"
msgid "보답이라니요,/30d 신경쓰지 마세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s05
msgctxt "field|re|art_fl03_s05|@kfl03_s05/017"
msgid "저는/20d 일이 있어서/20d 그만 가봐야하니…/35d/n부디 몸 조심하세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s05
msgctxt "field|re|art_fl03_s05|@kfl03_s05/018"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s05
msgctxt "field|re|art_fl03_s05|@kfl03_s05/019"
msgid "다카마항으로 가는 배를 찾아봐야겠군…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s05
msgctxt "field|re|art_fl03_s05|@kfl03_s05/020"
msgid "아,/10d 잠시…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s05
msgctxt "field|re|art_fl03_s05|@kfl03_s05/021"
msgid "폭풍도라면,/45d 대륙 동부에서/15d 남쪽으로 한참 밑에 있으니/45d/n여기서 바로 가는 배는 없을 거예요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s05
msgctxt "field|re|art_fl03_s05|@kfl03_s05/022"
msgid "다카마항이라…/50d 고맙습니다. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s05
msgctxt "field|re|art_fl03_s05|@kfl03_s05/023"
msgid "그럼/20d 이만 가보겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s05
msgctxt "field|re|art_fl03_s05|@kfl03_s05/024"
msgid "혹시/15d 여기서 폭풍도로 가는 방법을 아십니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s05
msgctxt "field|re|art_fl03_s05|@kfl03_s05/025"
msgid "일단/15d 다카마항으로 가셔서/30d 다른 배로 갈아타셔야겠네요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/000"
msgid "다카마항, 부두"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/001"
msgid "이 배는/20d 폭풍도로 향하는/20d 팬드래건의 연락선이오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/002"
msgid "미안하지만/15d 탑승할 수는 없소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/003"
msgid "(이 배가 폭풍도로 떠나는 연락선인데… 이제 어떻게 한다…)"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/004"
msgid "이보게들!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/005"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/006"
msgid "아, 선장님."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/007"
msgid "출항 준비는 잘 되어가나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/008"
msgid "네,/20d 거의 마쳤습니다./30d/n예정대로 내일 새벽에는 출항할 수 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/009"
msgid "좋아./30d 다들 수고했네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/010"
msgid "그런데,/20d 식사들은 했나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/011"
msgid "아,/20d 아직…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/012"
msgid "그럼 출항 기념으로 한턱낼 테니,/45d 주점으로 가자구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/013"
msgid "그럼 이곳은…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/014"
msgid "하하,/35d 폭풍도에 가려는 사람이 있을 리가 없지./60d/n걱정 말고 가세나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/015"
msgid "(좋아,/20d 지금이 기회군.)"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/016"
msgid "(이 배가 폭풍도로 떠나는 연락선인데…/50d/n이제 어떻게 한다…)"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/017"
msgid "어떻게 하겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/018"
msgid "선원에게 사정을 말해 본다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/019"
msgid "숨어서 기회를 엿본다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/020"
msgid "별 수 없지…/40d 선원에게 사정을 잘 이야기하면 태워줄지도."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/021"
msgid "미안합니다만,/35d 폭풍도까지 태워줄 수 없겠습니까?/40d/n저는/15d 꼭 그곳에 가야만 합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/022"
msgid "응?/30d 이 배를 타고 싶다고?/40d/n안되지,/25d 이 배는 폭풍도에 계신…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/023"
msgid "잠깐./35d 안 그래도 심심하던 차인데/25d/n이 사람에게도 기회를 한번 줘 보자구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/024"
msgid "기회라니?/20d 어떻게 말이야?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/025"
msgid "내가 문제를 몇 개 낼 테니/20d 한번 맞춰 보겠나?/40d/n제대로 답하면 폭풍도까지 태워다 주지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/026"
msgid "선택의 여지가 없지 않겠소?/45d/n그곳까지 태워만 준다면/30d 뭐든 해보겠소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/027"
msgid "흐음…/30d 거 괜찮은 생각인걸!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/028"
msgid "좋아,/25d 문제를 잘 맞히면/25d 우리 두 사람이 책임지고/25d/n폭풍도까지 태워 주겠어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/029"
msgid "그럼/25d 시작하네!/25d 문제를 잘 듣고 답해보라구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/030"
msgid "과거 창세전쟁 당시 팬드래건, 아스타니아, 다갈, 커티스의/n동부 4개국 연합의 명칭은 무엇이었는지 아는가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/031"
msgid "다크아머 연합"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/032"
msgid "실버애로우 연합"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/033"
msgid "두 번째 문제는/15d 내가 내 보지./25d 셋 중에 골라보라구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/034"
msgid "창세전쟁의 원흉인 베라딘은 암흑신의 전인이었지./n그는 무엇을 관장하는 암흑신의 전인이었는지 아는가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/035"
msgid "음모"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/036"
msgid "파멸"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/037"
msgid "전쟁"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/038"
msgid "저런,/15d 틀려버렸군./35d 다크아머는/20d 게이시르,/20d 트리시스,/20d/n가라드/15d 서부 3개국의/15d 제국 연합을 일컫는 것이었어./50d/n검은 깃발이라고도 불렸지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/039"
msgid "동부 4개국 연합은/30d 실버애로우라는 이름으로,/30d/n팬드래건을 중심으로 이루어진 연합이었지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/040"
msgid "상식인데 모르고 있었구만./45d/n다음 문제는 잘 생각해서 맞혀보라구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/041"
msgid "역시 맞혔네./45d 뭐,/15d 문제가 쉬웠으니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/042"
msgid "다크아머가/20d 게이시르,/20d 트리시스,/20d 가라드/10d 서부 3개국의/10d/n제국 연합을 일컫는 것이라는 것도/30d 물론 알고 있겠지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/043"
msgid "두 번째 문제부터는/30d 난도를 조금 높여야겠는걸?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/044"
msgid "호오,/20d 단번에 맞혀버리는군./30d/n그렇지,/20d 베라딘은 암흑신/35d '음모의 베라모드'의 전인이었지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/045"
msgid "문제가 조금 어려웠나?/40d 파멸을 관장하는 암흑신은/30d/n'파멸의 유스타시아'라네./35d 베라딘과는 상관없을걸?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/046"
msgid "다음 문제는/15d 조금 쉬워질 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/047"
msgid "저런,/30d 전쟁을 관장하는 신은/30d '전쟁의 샤크바리' 여신이야./35d/n애초에 암흑신도 아니지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/048"
msgid "좀 잘 해보라구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/049"
msgid "이번에는/20d 커티스 쪽이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/050"
msgid "대륙 유일의 공화정을 펼치고 있는/n커티스의 초대 대통령의 이름이 뭔지 아는가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/051"
msgid "아리아나"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/052"
msgid "아리아나 주니어"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/053"
msgid "아르시아"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/054"
msgid "아르시아 주니어"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/055"
msgid "흐음, 잘 알고있군. 커티스의 초대 대통령은 아르시아./20d 아리아나와 아리아나 쥬니어는 그를 뒷받침해준 인물이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/056"
msgid "아리아나는/25d 당시 신궁이라 불렸던 사람으로,/45d/n커티스 공화국의 초석이 된 사람이긴 하지만 말이야./60d/n대통령 자리에 오른 적은 없다구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/057"
msgid "근대사라서 쉬울 줄 알았는데,/35d 헷갈렸나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/058"
msgid "아리아나 주니어는/30d 신궁 아리아나의 아들이자/30d/n커티스 공화정을 이끈 주요 인물이지만,/40d/n공화국 건립 당시에는 아직 어렸다구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/059"
msgid "아쉽지만/15d 틀렸어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/060"
msgid "하하하,/40d 설마/20d 이런 함정에 속을 줄은 몰랐는걸?/50d/n아르시아 주니어라는 인물은 없다구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/061"
msgid "착각한 모양이지만,/25d 어쨌든 틀렸네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/062"
msgid "이번 문제를 모르면/30d 폭풍도에 태워다 주는 게/n꺼려지겠는걸./40d 이번엔 꼭 맞혀보라구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/063"
msgid "폭풍도에 계신 이올린 님은/n우리 팬드래건의 라시드 폐하와 어떤 관계인 분인지 알고 있나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/064"
msgid "라시드 폐하의 어머니"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/065"
msgid "라시드 폐하의 누님"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/066"
msgid "라시드 폐하의 누이동생"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/067"
msgid "라시드 폐하의 따님"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/068"
msgid "역시 맞혔네./50d 하긴,/30d 이올린 님이/15d 라시드 폐하의 누님이라는 것을 모르는 사람은 드물겠지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/069"
msgid "자,/15d 그럼/10d 마지막 문제까지 잘 해보라구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/070"
msgid "저런,/40d 라시드 폐하의 따님이/25d 50년이나 전부터/25d 폭풍도에/n계실 리가 없잖아./50d 라시드 폐하의 장녀는/30d 아직 마흔도 되지 않았다구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/071"
msgid "이렇게나 이올린 님에 대해서 잘 모르는데…/45d/n폭풍도까지 데려가기가 좀 꺼려지는걸."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/072"
msgid "저런저런…/55d 라시드 폐하의 양친은 모두/50d/n창세전쟁 초기/25d 그라테스 회전에서 전사하셨어./40d/n지금까지 살아계실 리가 없잖나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/073"
msgid "으음…/30d 자네는 예상외의 답을 하는군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/074"
msgid "맞았어./40d 아르시아는/15d 커티스 공화국의 초대 대통령이지./50d/n아리아나와 아리아나 주니어는/30d 그를 뒷받침해 준/n인물이고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/075"
msgid "근대사는 생각보다 잘 알고 있네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/076"
msgid "으음…/30d 두 분이 남매 사이인 건 맞지만,/35d/n이올린 님이 손 윗분이시라구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/077"
msgid "쯧쯧."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/078"
msgid "이번이 마지막 문제야./30d 쉽지는 않을 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/079"
msgid "창세전쟁 당시에는/40d 전대륙 최강의 검사라고 불린/35d/n4명의 검사가 있었지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/080"
msgid "게이시르 제국의 흑태자,/45d/n팬드래건 왕국의 라시드 팬드래건,/45d/n제국 7용사이자/30d 4천왕이었던 칼스 대장군,/50d/n그리고 방랑 검객 크로우."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/081"
msgid "이 4명을 두고/30d 사람들은/15d 각자의 성격과 검술에 어울리는/30d 칭호를 붙여 부르기 시작했지./55d 자, 그럼/10d 여기서/10d 문제!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/082"
msgid "창세전쟁의 4대 검사중 칼스 대장군이 불렸던 호칭은 무엇인지 답해보게나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/083"
msgid "검황"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/084"
msgid "검귀"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/085"
msgid "검성"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/086"
msgid "검마"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/087"
msgid "맙소사,/45d 검황은/30d 패왕 흑태자를 일컫는 말이었어./50d/n칼스 대장군은/30d 흑태자의 제자이자 부하였는데,/35d/n군주를 모시는 사람이/30d 황제라는 이름으로 불릴 수 있겠나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/088"
msgid "안됐지만,/20d 틀렸다네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/089"
msgid "검귀…/30d 는 아니지./40d/n검귀는/30d 귀신같은 방랑 검객/35d 크로우를 일컫는 말이었어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/090"
msgid "마지막 문제는/30d 아쉽게도 틀렸구만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/091"
msgid "저런,/25d 검성이야말로/30d 우리 '성왕 라시드 폐하'를 위해/n만들어진 호칭이 아니겠나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/092"
msgid "칼스는 위대한 검사이긴 했지만/40d 성인이라고 불리진/n않았어./45d 오히려 조금은 어두운 면이 있었다고 해야겠지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/093"
msgid "검마!/30d 그래,/10d 맞았어!/25d 칼스는 인간의 검이라기보다/45d/n마검의 경지에 이른 자였지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/094"
msgid "사용하던 검도/30d 멸살지옥검이라는/35d/n무시무시한 이름이었다구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/095"
msgid "이름만 무서운 게 아니야./40d/n흑태자의 아수라와 더불어/30d 전설적인 마검이었다고 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
msgctxt "field|re|art_fl03_s06|@kfl03_s06/096"
msgid "아무튼,/20d 마지막 문제는 잘 맞혔네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s06
