msgctxt "field|re|art_fl10_s07|@kfl10_s07/000"
msgid "그럼,/15d 시라노 님은/20d 안타나나리보에 가셔서 영주 저택의 조사를 부탁드립니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s07
msgctxt "field|re|art_fl10_s07|@kfl10_s07/001"
msgid "실종된 마을 사람들의 구출을 우선시해 주시길 바랍니다."
