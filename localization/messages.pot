msgctxt "field|re|art_fl12_s02|@kfl12_s02/034"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/035"
msgid "[이자벨]/n보물 찾기라…/50d/n뭐,/25d 임무라고 하면 임무라고 할 수 있지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/036"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/037"
msgid "[실버]/n군사는/20d 역시 사람을 잘 다룰 줄 아는군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/038"
msgid "[실버]/n보물 찾기라…/45d/n오랜만에 해적의 피가 끓는 느낌이네요./45d 하핫."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/039"
msgid "[크리스]/n보물 찾기라니…/30d 조금 부러운데요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/040"
msgid "[에스메랄다]/n앞으로의 활동에/35d 신의 인도와 축복이 있기를…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/041"
msgid "그럼…/15d/n군사 말은,/30d 체사레가 비프로스트의 군대를/25d 제국으로 끌어들이려 한다는 것인가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/042"
msgid "지금까지의 정보로 판단해 보면/30d 거의 확실합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/043"
msgid "오래전부터/40d 비프로스트와 교회간의 비밀스런 움직임은/30d 포착하고 있었습니다만,/35d/n체사레의 오른팔인 마키아벨리가/50d 비프로스트로 떠났다는 것은 심상찮은 일입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/044"
msgid "마키아벨리?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/045"
msgid "아는 사람입니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/046"
msgid "마키아벨리는/30d 학자들 사이에서는 유명한 이름입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/047"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/048"
msgid "새로운 사상을 연구하여/30d 이름을 날리고 있지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/049"
msgid "…/30d어릴 때 절친한 친구였지./45d/n그 친구가 체사레 밑에서 일한다니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/050"
msgid "우리 군사와 함께/25d 제국의 두 현자로 유명해요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/051"
msgid "제가 현자라니요,/30d 당치도 않은 말씀입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/052"
msgid "저는/25d 전략과 전사에 관심이 많은 반면,/45d/n그는 사상과 역사학의 권위자라고 할 수 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/053"
msgid "[에스메랄다]/n클라우제비츠 군사는/25d 정말 겸손하신 분인 것 같아요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/054"
msgid "그런 자가/35d 직접 비프로스트로 향하고 있는 이상,/35d/n내버려 둘 수는 없습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/055"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/056"
msgid "저도/10d 함께 갈게요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/057"
msgid "아닙니다./30d/n카나 님께는/25d 따로 부탁드릴 일이 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/058"
msgid "부탁이요…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/059"
msgid "얼마 전/35d 우연찮게 보물 지도를 입수했습니다./40d/n감식 결과/35d 과거 용병 집단 카슈미르가 남긴/45d/n진짜 보물 지도로 밝혀졌습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/060"
msgid "그 보물을 발견한다면,/40d 최근 프레데릭 경에게 타격을 받은/20d/n자금과 장비 문제는 해결할 수 있을 것입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/061"
msgid "좋아,/30d 내가 그를 뒤쫓도록 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/062"
msgid "가난한 집안 출신이라 야심에 불타고 있었지만,/55d/n어려서부터 천재 소리를 들었지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/063"
msgid "응?/25d 나도 가야한다고?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/064"
msgid "네,/30d 이번에는/25d 카나 님과 동행해 주시기 바랍니다./35d/n보물 찾기에는 익숙하시죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/065"
msgid "그럼 시라노가 마키아벨리를 쫓는 동안,/45d 우리는 보물 찾기나 하고 있어야 하나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/066"
msgid "언니가 같이 가면/20d 나도 안심이에요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/067"
msgid "…뭐,/20d 때로는 잠시 쉬는 것도 좋겠지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/068"
msgid "그리고, 리델 님은/25d 시라노 님과 함께/25d/n마키아벨리를 추적해 주십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/069"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/070"
msgid "리델 부대장님./40d 이것은/25d 우리에게 중요한 임무입니다./45d/n사적인 감정은 뒤로하고,/36d 반드시 임무를 성공시켜 주시기 바랍니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/071"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/072"
msgid "그럼,/30d 회의는 이것으로 마치겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/073"
msgid "내가 시라노와?!/35d/n군사,/20d 다시 한번 생각을…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/074"
msgid "마키아벨리가/15d 체사레 밑에서 일하고 있었다니…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/075"
msgid "제피르 팰컨, 작전회의실"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/076"
msgid "비프로스트는/15d 리브레빌을 거쳐서 가야 해요./30d/n카라카스 숲까지 바래다 줄까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/077"
msgid "카나와 함께 카라카스 숲까지 이동하겠습니까?/n(함께 이동하면 카라카스 숲으로 자동으로 이동합니다.)"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/078"
msgid "카나와 함께 이동한다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/079"
msgid "근처의 던전들을 탐색해 본다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/080"
msgid "그래,/30d 카나와 함께 카라카스까지 가도록 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/081"
msgid "좋아요!/15d 그럼 출발해요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/082"
msgid "나는/25d 근처의 던전을/25d 조금 더 탐색해 보고 가겠어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/083"
msgid "그래요…?/35d 그럼/10d 임무 힘내요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/084"
msgid "[클라우제비츠]/n틈이 난다면,/35d/n한번 탐색해 보는 것도 좋을지 모르겠군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/085"
msgid "[루이]/n팬드래건의 크리사오르사에서 개발한/30d/n신형 검에 대해서 알고 계시나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/086"
msgid "[루이]/n비싸지 않은 가격에도/20d 기존 양산검을 능가하는 성능이라/35d 팬드래건의 제식검으로 채택되었다고 합니다./30d/n제국령에는 아직 보급되진 않았지만,/35d 검사들 사이에서는 화제의 대상이네요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/087"
msgid "[메디치]/n팬드래건의 신형 검?/40d PS-7 '블릿츠' 말인가?/40d/n투르족의 광검에 대항하기 위해 제작되었다는군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/088"
msgid "[메디치]/n일반 금속이 아닌 특수 합금으로 만들어져서/35d/n열이나 충격에 강한 데다,/35d 방어력과 공격력이 뛰어난/15d/n최고의 무기라고 하던데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/089"
msgid "그리고,/30d 이 임무에는/20d 실버 님이 도움을 주시는 것이/25d/n효율적이라고 판단했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/090"
msgid "[크리스]/n어떤 보물이 있을지/15d 설렐 것 같아서요./20d 하하."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/091"
msgid "[크리스]/n하지만 임무도 중요하니!/35d 빨리 길을 떠나시지요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/092"
msgid "[실버]/n그런데,/40d 저 없이도 괜찮으시겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/093"
msgid "[카나]/n이쪽은 맡겨줘요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/094"
msgid "[에스메랄다]/n이렇게 뛰어난 분들과 함께 할 수 있어서,/45d/n저도 많이 배우고 있답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/095"
msgid "그야 뭐…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/096"
msgid "[보르스]/n아!/15d 맞아./20d 비프로스트라면/30d 역시 정예 부대인/n발키리가 유명하죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/097"
msgid "[보르스]/n비프로스트 최강 검사도/30d 그 발키리의 대장이라던데./30d/n알고 계셨나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/098"
msgid "이자벨 님과/25d 메디치 님께도 부탁드리겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/099"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/000"
msgid "!!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/001"
msgid "[이자벨]/n이얏!!/20d 고속광룡탄!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/002"
msgid "하아,/20d 열받아!/35d/n개구리 주제에 왜 이렇게 날렵한거야?! "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/003"
msgid "내가 저 개구리를 못 잡으면…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/004"
msgid "[카나]/n이자벨 언니!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/005"
msgid "!!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/006"
msgid "왜 그래요?/15d 갑자기 뛰어가 버리고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/007"
msgid "너 아직 눈치 못 챘어?/30d/n저 개구리가…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/008"
msgid "앗!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/009"
msgid "이런…/50d 완전히 놓쳐버렸잖아!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/010"
msgid "개구리는 왜요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/011"
msgid "너,/20d 정말 둔하구나./40d/n주머니를 한번 뒤져보렴."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/012"
msgid "어…/20d 어…?/20d 어엇?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/013"
msgid "없어졌어!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/014"
msgid "으아앗!/20d 어제 겨우 산 장비들이/15d 다…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/015"
msgid "대체 어떻게 된 거에요,/15d 언니?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/016"
msgid "아까 개구리 뱃속에 있을거야…/40d 아마도."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/017"
msgid "에에?/30d 그럼 설마/20d 그 개구리가?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/018"
msgid "물건을 훔쳐서 판다는/15d 개구리 소문은 들었지만,/50d/n설마 진짜로 있을 줄이야…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/019"
msgid "아~/20d 진짜!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/020"
msgid "없어?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/021"
msgid "미스릴 탄을 산다고/20d 내가 얼마나 고생을 했는데…/30d/n으윽!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/022"
msgid "[메디치]/n하하하!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/023"
msgid "메디치 오빠!/20d 웃을 일이 아니잖아요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/024"
msgid "걱정하지 마!/30d/n보물만 찾으면/25d 그깟 탄알 몇 개쯤은 문제도 아니니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/025"
msgid "아무리 그래도…/30d 으으!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/026"
msgid "하하!/50d 도둑맞은 건 잊어버려, 카나./35d/n빨리 보물을 찾아서 만회하자구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/027"
msgid "보물 지도에 따르면,/30d/n보물은/20d 게이시르 숲 중앙의 화룡굴에 있는 것 같은데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/028"
msgid "에잇!/20d 이렇게 된 이상/15d 빨리 보물을 찾아내고 말겠어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s03
msgctxt "field|re|art_fl12_s03|@kfl12_s03/029"
msgid "일단/25d 게이시르 시티를 통과해서 숲으로 가야겠네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/000"
msgid "비프로스트 궁, 조세핀의 방"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/001"
msgid "오랜만이군,/25d 조세핀."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/002"
msgid "호호,/35d 당신도 여전하시군요./25d 학자 나리."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/003"
msgid "체사레 각하의 안목은/30d 정말 대단해./55d 한낱 시골 농부의/15d/n딸에 불과했던 당신을/35d 이렇게 변신시켜 놓다니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/004"
msgid "흥,/30d 우린 서로 거래를 할 뿐이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/005"
msgid "당신들은/10d 당신들이 원하는 것을 얻고,/50d/n나는 내가 원하는 것을 얻을 뿐이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/006"
msgid "일은 잘 되어가고 있나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/007"
msgid "걱정 말아요./30d 공왕은 이미 뜻을 굳혔으니까요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/008"
msgid "오호,/55d 그럼 제국으로 병력을 파견하겠다는 것인가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/009"
msgid "공왕은/30d 어려서 제국에 수모를 당했었죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/010"
msgid "원로원 늙은이들의/20d 보수주의에 가로막혀/50d/n지금껏 참고 있었지만,/55d 당신들이 보낸 살수가/30d/n고위 원로들을 제거한 지금은/50d 아무 장애물도 없죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/011"
msgid "좋아. /10d그럼 내일 회담은 어렵지 않겠군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/012"
msgid "그렇군…/45d/n그런데,/35d 지난번 발굴한다던 그건 어떻게 되었나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/013"
msgid "아스카론 말씀이시군요./55d/n그건 아직 멀었어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/014"
msgid "위치는 대충 찾은 것 같은데,/50d/n발굴에 엄청난 시간과 인원이 투입되어야 한다나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/015"
msgid "뭐,/25d 비프로스트의 대군이 있다면/35d/n마장기까지 내보낼 필요는 없겠지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/016"
msgid "발키리들이 동원되면/30d 제피르 팰컨이나/25d/n프레데릭의 대포 부대 정도는/35d 간단히 처리할 거예요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/017"
msgid "오히려/30d 그들에게 제국을 빼앗기지 않도록/25d/n조심해야 할걸요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/018"
msgid "후후,/35d 그 점에 대해서는/30d 추기경 각하께서도/25d/n이미 복안을 마련해 두셨지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/019"
msgid "그럼,/30d 나는 이만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/020"
msgid "후후후…/35d 당신 말대로군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/021"
msgid "비프로스트의 파병이/45d 곧 제국의 멸망으로 이어질 것을/35d/n모르는 저들이 불쌍하군요./40d 호호…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/022"
msgid "이번 파병은/30d 추기경의 요청에 의한 것이니,/40d/n팬드래건에서도 어쩔 수 없을걸."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/023"
msgid "중립국을 표방하는 우리로서는/45d 더없이 좋은 기회지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/024"
msgid "하지만,/35d 체사레 추기경은 만만치 않은 인물이에요./50d/n공왕 폐하도 조심해야 할걸요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/025"
msgid "하하,/25d 내가 그렇게 우습게 보이나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/026"
msgid "우스운 인물인지 아닌지,/50d 어디 한번 보여줄까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s07
msgctxt "field|re|art_fl12_s07|@kfl12_s07/027"
msgid "우훗…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/000"
msgid "비프로스트 궁, 객실"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/001"
msgid "음…?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/002"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/003"
msgid "마키아벨리!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/004"
msgid "뭐하는 놈들이냐!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/005"
msgid "우리는 제피르 팰컨이다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/006"
msgid "여기까지 찾아올 줄이야…/45d/n소문대로 대단한 놈들이군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/007"
msgid "이렇게 되었으니/15d 별 도리가 없겠군…/60d/n나는 학자에 불과해./45d 저항할 생각은 없으니 마음대로 해라."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/008"
msgid "흥,/25d 그렇게 나오면 목숨을 부지할 수 있을 줄 알았나?/55d/n고통없이 저 세상으로 보내주지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/009"
msgid "잠깐!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/010"
msgid "뭐야?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/011"
msgid "마키아벨리,/30d 나를 알아보겠나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/012"
msgid "쓸데없는 소리를 하는군./50d/n반란군 나부랭이에 내가 아는 사람은 없다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/013"
msgid "하긴…/40d 벌써 15년이나 지났으니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/014"
msgid "나는/30d 한때 시라노 번스타인이라 불리던 사람이다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/015"
msgid "시라노…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/016"
msgid "후후,/45d 악운이 강한 모양이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/017"
msgid "하지만 절친한 친구였던 자네가/50d/n체사레의 수족이 되어버린 걸 보니,/30d 별로 유쾌하지는 않군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/018"
msgid "나는 학자야./45d/n친분보다는 내 사상을 따르는 게 우선이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/019"
msgid "나는 나의 철학에 따라/20d 추기경 각하를 따르고 있네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/020"
msgid "체사레의 철학이라고?/45d/n음모를 꾸며 친구의 아들에게 누명을 씌우는 것이?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/021"
msgid "권력을 잡기 위해/15d 자신의 딸을 도구로 이용하는 것이?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/022"
msgid "아니면,/30d 이렇게 조국에 외세를 끌어들이는 것을 말하는건가?/45d/n대답해라! 마키아벨리!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/023"
msgid "지금 제국에는 황제가 없네./50d/n그렇기 때문에 더욱 각하같은 분이 필요한 것이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/024"
msgid "제국을 통일할 수 있는 인물은/30d 추기경 각하밖에는 없어./45d/n자네도 잘 알고 있지 않나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/025"
msgid "역사는 개인의 손에 좌우되는 것이 아니야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/026"
msgid "왜 제국이/30d 그에 의해 통일되어야 하지?/25d/n어째서 수많은 사람들이/20d 그를 위해서 피를 흘려야 하냔 말이다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/027"
msgid "역사는/35d 스스로 흘러가는 법이 아닌가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/028"
msgid "물론 수십 년,/15d 수백 년 시간이 흐르면,/40d/n지금과 같은 제국의 혼란은 진정되겠지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/029"
msgid "하지만,/35d 그때까지 얼마나 많은 전쟁이 벌어지겠나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/030"
msgid "또/25d 얼마나 많은 사람들이 희생되고?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/031"
msgid "현세의 사람들은/15d 추기경 각하를 비난한다 해도,/35d/n후대의 역사가는/25d 각하 덕분에 수많은 사람들의/n고통이 덜어졌음을/30d 감사하게 생각할거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/032"
msgid "시라노 씨,/20d 서둘러야 해요./25d/n발키리들이 포위망을 완성하면 빠져나갈 수 없어요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/033"
msgid "이런 놈은 빨리 처치하고 도망갑시다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/034"
msgid "나는 학자로서의 신념에 충실했을 뿐./75d/n오늘 명이 다한다 해도 후회는 없네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/035"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/036"
msgid "마키아벨리,/50d 네 생각은 알겠다./65d/n오늘만은 너를 용서하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/037"
msgid "대신/40d 체사레에게 전해라."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/038"
msgid "이 시라노가/40d 그 썩은 목을 받으러 갈 것이라고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/039"
msgid "이봐,/10d 시라노!/20d 이 자식을 살려둘 생각이야?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/040"
msgid "부탁하지./45d/n이 자는 죽이기에는 너무 아까운 사람이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/041"
msgid "어쨌든,/25d 빨리 여기서 빠져나가시죠!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/042"
msgid "모든 사적인 감정을 버리고/15d 잔혹한 수단을 써서라도,/45d/n제국을 통일하고/20d 평화를 되찾을 군주가 필요하단 말일세."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/043"
msgid "이것이야말로/20d 대의라네./35d/n더 많은 피를 흘리지 않기 위한 것인데,/35d/n무엇이 잘못되었다는 건가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s08
msgctxt "field|re|art_fl12_s08|@kfl12_s08/044"
msgid "시라노 번스타인이라고?!/60d/n자네가 아직 살아있었다니…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/000"
msgid "로우엔, 프레데릭의 집무실"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/001"
msgid "장군님!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/002"
msgid "무슨 일인가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/003"
msgid "비프로스트가…/25d/n대군을 이끌고 제국령을 넘어왔다는 보고입니다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/004"
msgid "그래…/25d 역시 왔는가."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/005"
msgid "더구나/25d 이번 파병은 체사레 추기경이…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/006"
msgid "알고 있다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/007"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/008"
msgid "장군님,/25d 어떻게 하시겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/009"
msgid "전군,/15d 전투 태세에 들어간다!/50d/n비프로스트군이 제국 땅을 밟게 할 수는 없다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/010"
msgid "출발은 내일 정오./40d/n일정에 차질이 없도록 철저히 준비해라."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/011"
msgid "알겠습니다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/012"
msgid "역시 장인어른이/35d 마키아벨리를 비프로스트로 보낸 것은 이것 때문이었나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/013"
msgid "외세의 힘을 빌린다는 것은/40d 제국의 자존심을 짓밟는 일!/55d/n이번만큼은 두고 볼 수 없어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/014"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/015"
msgid "문제는 비프로스트의 발키리 부대인데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/016"
msgid "우선은/35d 제피르 팰컨의 클라우제비츠에게/35d 전령을 보내야겠군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/017"
msgid "제 13 장"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s01
msgctxt "field|re|art_fl13_s01|@kfl13_s01/018"
msgid "어제의 적, 오늘의 동지"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s02
msgctxt "field|re|art_fl13_s02|@kfl13_s02/000"
msgid "게이시르 대성당, 추기경 집무실"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s02
msgctxt "field|re|art_fl13_s02|@kfl13_s02/001"
msgid "…/15d알겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s02
msgctxt "field|re|art_fl13_s02|@kfl13_s02/002"
msgid "그 점은 걱정하지 않으셔도 될 겁니다./60d/n제가 알아서 하지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s02
msgctxt "field|re|art_fl13_s02|@kfl13_s02/003"
msgid "정보 감사합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s02
msgctxt "field|re|art_fl13_s02|@kfl13_s02/004"
msgid "프레데릭의 출병이라…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s02
msgctxt "field|re|art_fl13_s02|@kfl13_s02/005"
msgid "비프로스트군도 예상대로 움직여 주는군./40d/n모두 계획 대로야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s02
msgctxt "field|re|art_fl13_s02|@kfl13_s02/006"
msgid "프레데릭이 얼마나 버텨주는지 한번 볼까?/75d/n재미있겠어…/40d 큭큭."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s02
msgctxt "field|re|art_fl13_s02|@kfl13_s02/007"
msgid "이제 곧,/30d 제국은 물론/20d 비프로스트,/15d 팬드래건,/15d 아스타니아…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s02
msgctxt "field|re|art_fl13_s02|@kfl13_s02/008"
msgid "아니,/30d 안타리아 대륙이/30d 강력한 하나의 국가로 다시 태어나는 것이다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s02
msgctxt "field|re|art_fl13_s02|@kfl13_s02/009"
msgid "후…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl13_s02
msgctxt "field|re|art_fl13_s02|@kfl13_s02/010"
msgid "당신이 세상을 뜬지도/35d 30년이나 지났군…/70d/n이제 우리의 한을 풀 순간이/50d 점차 다가오고 있소."
msgstr ""

