#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/036"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/037"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/038"
msgid "…실버의 빈 자리는/35d 내가 채우겠어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/039"
msgid "무슨 말을 하는 거예요,/20d 카나 씨."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/040"
msgid "리델!/20d 그게 무슨 말이에요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/041"
msgid "제 17 장"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/042"
msgid "괴물"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/043"
msgid "……!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/000"
msgid "이스카리옷…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/001"
msgid "후후…/35d 시라노,/45d 항상 네 소중한 것을 빼앗아버려서 미안하군./110d/n지난번 그 여자,/35d 실버라고 했던가?/75d 너처럼 고지식한 여자였어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/002"
msgid "그 더러운 입으로 실버의 이름을 말하지 마라!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/003"
msgid "너도 옛날과 달라진 게 없어./75d/n설마,/35d 정말로 메르세데스를 찾아갈 줄이야./55d 큭큭큭…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/004"
msgid "후후후…/60d 시라노 번스타인,/60d 착각하지 마라."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/005"
msgid "나는 변했다!/60d 너에게 열등감만 느끼던/55d 옛날의 내가 아니란 말이다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/006"
msgid "이 정도로 나를 막을 수 있을 줄 알았나,/20d 이스카리옷!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/007"
msgid "크크…/65d 역시/20d 인간의 힘으로는 무리였나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/008"
msgid "하지만/15d 내가 만들어 낸 궁극의 힘이라면 이야기가 다르다!/80d/n똑똑히 봐 둬라,/40d 시라노!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/009"
msgid "시라노…/60d 최강의 힘을 손에 넣었군./80d/n내가 만들어 낸 힘보다/60d 훨씬 강한…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/010"
msgid "이스카리옷…/50d/n그렇게 추악한 괴물이 되면서까지/56d 힘을 얻고 싶었나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/011"
msgid "큭,/35d 너한테 그런 말을 듣다니…/110d/n그래,/45d 그러기 위해서/30d 너를 배신한 거다…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/012"
msgid "하지만…/30d 너도 결국/20d 나와 같은…/25d 괴물이야…/60d/n평범한 사람들과/20d 공생할 수 없는…/50d 사회의 격리자…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/013"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/014"
msgid "나는 그래도…/45d 이렇게 네 손에 죽을 수 있지만…/75d/n불쌍하게도/25d 너는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/015"
msgid "체사레는 어디에 있나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/016"
msgid "수중…/30d 도시…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/017"
msgid "사이럽스의 수중도시?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/018"
msgid "파괴신…/50d 부활…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/019"
msgid "파괴신을 부활시키기 위해 수중도시로 갔단 말인가?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/020"
msgid "체사레의 개,/20d 이스카리옷…/45d/n너의 목숨으로/40d 실버의 영령을 위로하겠다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s03
msgctxt "field|re|art_fl17_s03|@kfl17_s03/021"
msgid "체사레…/35d 무슨 짓을!/50d 바로 쫓는다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s04
msgctxt "field|re|art_fl17_s04|@kfl17_s04/000"
msgid "/2c수중 도시 중심부"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s04
msgctxt "field|re|art_fl17_s04|@kfl17_s04/001"
msgid "이 수중도시의 봉인이 지상에 남은 유일한 파괴신이지. 자네는 정말 운이 좋은 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s04
msgctxt "field|re|art_fl17_s04|@kfl17_s04/002"
msgid "후후, 운이 좋다니 너무한 말이오. 내가 이 파괴 신을 찾아내기 위해 얼마나 많은 노고를 쏟아부었는지 모르는군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s04
msgctxt "field|re|art_fl17_s04|@kfl17_s04/003"
msgid "하지만 조심해야 하네. 파괴신의 그 힘은 막대하지만, 우리들 조차도 제대로 제어 할 수 없기 때문에 자칫하다가는 오히려 우리가 당하고 말거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s04
msgctxt "field|re|art_fl17_s04|@kfl17_s04/004"
msgid "그러니까, 제가 여기 있는거 아니겠어요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s04
msgctxt "field|re|art_fl17_s04|@kfl17_s04/005"
msgid "허허, 그래 그래. 크리스티나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s04
msgctxt "field|re|art_fl17_s04|@kfl17_s04/006"
msgid "하지만 내 부탁을 그렇게 쉽게 들어 줄 줄은 정말 몰랐구나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s04
msgctxt "field|re|art_fl17_s04|@kfl17_s04/007"
msgid "시라노 그 원수를 제 손으로 죽일 수 있다면 무슨 짓이라도 할 거예요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s04
msgctxt "field|re|art_fl17_s04|@kfl17_s04/008"
msgid "조금도 지체 하고 싶지 않으니, 우리 어서 의식을 시작해요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s04
msgctxt "field|re|art_fl17_s04|@kfl17_s04/009"
msgid "각오가 좋은 걸. 슬슬 시작해 볼까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s3t
msgctxt "field|re|art_fl17_s3t|@kfl17_s3t/000"
msgid "[이스카리옷]/n이것이 위대한 그리마의 힘이다!/60d/n자,/10d 덤벼라!/25d 시라노 번스타인!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/000"
msgid "메디치 오빠?/35d/n설마/5d 리델이…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/001"
msgid "에…/40d 에스테…/40d/n에스테가/30d 리델을…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/002"
msgid "에스테라고?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/003"
msgid "[에스테]/n어머,/45d 제 탓을 하시는 건가요?/50d/n호호호…/45d 모든 씨앗은 당신이 뿌린 게 아닌가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/004"
msgid "[에스테]/n동료를 등진 그 순간부터,/40d/n이 모든 건 예견된 일이었죠./45d/n어리석은 건…/25d 바로 당신이랍니다. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/005"
msgid "같이 죽자!/15d 에스테!!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/006"
msgid "후후후… 가소롭군!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/007"
msgid "으윽!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/008"
msgid "아니!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/009"
msgid "네놈은…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/010"
msgid "메디치,/25d 괜찮소?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/011"
msgid "…/50d왜…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/012"
msgid "왜 나를 구한거요?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/013"
msgid "…/50d생명의 은인이 눈앞에서 죽는 모습을/40d 두고만 볼 수는 없지 않겠소?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/014"
msgid "내가…/35d 당신의/35d 은인?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/015"
msgid "3년 전,/45d 제피르 팰컨이 인페르노 감옥을 습격한 날."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/016"
msgid "그 지옥에서/35d 당신과 함께 탈출한 죄수를 기억하시오?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/017"
msgid "시라노…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/018"
msgid "당신이/35d 그때/20d 그…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/019"
msgid "로베르토 데 메디치,/55d 그때 당신의 눈은 빛나고 있었소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/020"
msgid "하지만 지금은 저런 요녀에게 홀려/20d 광채를 잃어가고 있소./40d/n자신의 모습을 보시오!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/021"
msgid "으으……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/022"
msgid "메디치!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/023"
msgid "호호호…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/024"
msgid "저런 겁쟁이를 위해 몸을 내던지다니./45d/n시라노,/20d 당신도 어리석군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/025"
msgid "에스테,/35d 지금이라도 늦지 않았다./35d/n그에게 용서를 구하면/35d 나도 당신을 용서하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/026"
msgid "뭐?/30d 용서를 빌라구?/45d/n웃기는 소리도 적당히 해야지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/027"
msgid "디아블로 님이 나를 지켜 주실 거야!/40d/n용서 같은 건/20d 너희들이나 빌어라!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/028"
msgid "어리석은 인간이군…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/029"
msgid "디아블로…/50d 당신이 바로 디아블로였군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/030"
msgid "디아블로,/40d 그리고 체사레 보르자!/40d/n나와 스승님의 원수를/25d 이렇게 한자리에서 만나게 되다니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/031"
msgid "이거 유감이네,/40d 시라노 번스타인 군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/032"
msgid "생명의 은인을 원수라고 부르다니./55d/n통구이가 될 처지였던 자네를,/40d 내가 목숨만은 살려주지 않았던가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/033"
msgid "게다가,/30d 디아블로 님께도/15d 그 무슨 망언인가!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/034"
msgid "그랬군…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/035"
msgid "내 감각이/20d 틀림없다면…/60d/n저놈의 몸에서 피어오르는 기운은/35d 데이모스의 것이다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/036"
msgid "몇 년 전부터/25d 데이모스의 기운이 느껴지지 않는다 했더니,/70d/n네놈과 융합하고 있었던 것이로군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/037"
msgid "이제/40d 사명의 때가 왔는가…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/038"
msgid "긴 말은 필요 없다./55d/n얌전히 크리스티나를 내놓으면/45d 고통스럽지 않은 죽음을 선사하겠다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/039"
msgid "하,/30d 네 녀석이 뭐길래/25d 크리스티나를 내놓으라는 거냐?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/040"
msgid "디아블로 님,/25d/n놈은 독을 마셔 얼마 남지 않은 목숨입니다./45d/n상관하지 마시고 의식을 이어 나가시지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/041"
msgid "언제까지 헛소리를 계속할 수 있을지 두고 보자./65d/n각오해라!/5d 체사레!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/042"
msgid "[에스메랄다]/n크리스티나가…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/043"
msgid "늦어버렸어!/30d 파괴신이…/25d 부활하고 있어요!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/044"
msgid "크리스티나는…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/045"
msgid "안 돼…!/20d 크리스티나의 숨이 약해지고 있어요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/046"
msgid "에스메랄다가 목숨을 던지면서까지 구해냈어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/047"
msgid "반드시…/30d 살릴 것이다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/048"
msgid "!!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/049"
msgid "수중도시가 붕괴하기 시작했습니다!/35d/n빨리 여기서 탈출해야 합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/050"
msgid "그 사이에/15d 크리스티나는 숨이 끊어질 거에요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/051"
msgid "다른 방법이 없습니다./30d/n크리스티나는/15d 제가 어떻게든 데리고 나가 보겠습니다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/052"
msgid "아니…/45d 그런 방법으로는/50d 크리스티나를 구할 수 없소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/053"
msgid "네…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/054"
msgid "데이모스 님…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/055"
msgid "이제야…/55d 당신의 마음을/25d 이해할 수 있을 것 같습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/056"
msgid "설마…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/057"
msgid "부탁이 있소,/10d 샤른호스트."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/058"
msgid "부탁이라니요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/059"
msgid "내 아수라를/55d 맡아주시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/060"
msgid "시라노,/40d 저는 그 검을 받을 자격이 없습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/061"
msgid "아니,/45d 이 검을 맡길 수 있는 건/45d 당신밖에 없소./75d/n내 스승과 같은 검법을 쓰는 당신이라면,/65d 분명/45d 믿을 수 있을 것이오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/062"
msgid "…알겠습니다./55d 이미 제 정체를 알고 계신듯 하니,/40d/n저를 믿고 맡기신다는 뜻을 받아/55d 소중히 보관하겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/063"
msgid "그리고…/60d 크리스티나를 부탁하겠소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/064"
msgid "그럼,/50d 부탁하오!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/065"
msgid "데이모스!!/50d 당신의 생명을/40d 이 아이에게 허락해 주십시오!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/066"
msgid "뒤를…/50d 부탁하오…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/067"
msgid "시라노!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/068"
msgid "으… 으응…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/069"
msgid "시라노,/25d 그녀가 살아났습니다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/070"
msgid "샤른호스트…/50d 시라노는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/071"
msgid "시라노는…!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/072"
msgid "자신의 생명으로/55d 크리스티나를…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/073"
msgid "!!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/074"
msgid "카나!/25d 도시의 붕괴가 심해지고 있습니다./25d/n크리스티나는 제가 맡을테니/35d 빨리 여기서 탈출합시다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/075"
msgid "…나는/35d 여기에 남을거에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/076"
msgid "여기,/30d 시라노 옆에 있어주고 싶어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/077"
msgid "카나!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/078"
msgid "그는 평생동안…/35d 사랑하는 사람의 그림자만을 쫓아온/45d/n고독한 사람이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/079"
msgid "그는 이제야 비로소/40d 쉴 곳을 찾은 거죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/080"
msgid "…그런 그의 곁에 남고 싶어요./50d 영원히…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/081"
msgid "…/65d알겠습니다./50d/n그것이 당신의 행복이라면,/50d 제게 방해할 권리는 없겠지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/082"
msgid "…진정한 행복이/55d 당신을 찾아오기를 바라겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/083"
msgid "시라노…/40d 들려요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/084"
msgid "크리스티나는 살았어요./55d/n이제 더…/15d 걱정할 건 없어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s01
msgctxt "field|re|art_fl18_s01|@kfl18_s01/085"
msgid "시라노…/55d 이젠 함께예요…/55d/n언제까지나…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s02
msgctxt "field|re|art_fl18_s02|@kfl18_s02/000"
msgid "[디아블로]/n수백년만에/35d 내 본 모습을 드러나게 한 이상/75d/n너희들의 목숨은 없다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s02
msgctxt "field|re|art_fl18_s02|@kfl18_s02/001"
msgid "[디아블로]/n각오해라,/40d 데이모스의 전승자여!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s03
msgctxt "field|re|art_fl18_s03|@kfl18_s03/000"
msgid "…/40d이것이…/25d 파괴신의 본모습인가…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s03
msgctxt "field|re|art_fl18_s03|@kfl18_s03/001"
msgid "아아…/30d 크리스티나가…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s03
msgctxt "field|re|art_fl18_s03|@kfl18_s03/002"
msgid "크리스티나가 있는 중심부를 피해서 공격한다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s03
msgctxt "field|re|art_fl18_s03|@kfl18_s03/003"
msgid "이제 파괴신은/20d 진정되는건가…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s03
msgctxt "field|re|art_fl18_s03|@kfl18_s03/004"
msgid "아니에요!/15d 아직…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s03
msgctxt "field|re|art_fl18_s03|@kfl18_s03/005"
msgid "으윽!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s03
msgctxt "field|re|art_fl18_s03|@kfl18_s03/006"
msgid "…/40d역시…/35d 중심부의 크리스티나를 피해서는/40d/n파괴신을 쓰러트릴 수 없는 것인가!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s03
msgctxt "field|re|art_fl18_s03|@kfl18_s03/007"
msgid "…방법이 없네요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s03
msgctxt "field|re|art_fl18_s03|@kfl18_s03/008"
msgid "지금까지/25d 여러분과 함께했던 시간…/35d/n영원히 잊지 못할 거에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s03
msgctxt "field|re|art_fl18_s03|@kfl18_s03/009"
msgid "에스메랄다…?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s03
msgctxt "field|re|art_fl18_s03|@kfl18_s03/010"
msgid "[에스메랄다]/n전능하신 마나여,/35d 우리의 염원을 들어주소서. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s03
msgctxt "field|re|art_fl18_s03|@kfl18_s03/011"
msgid "[에스메랄다]/n나의 생명으로 바라오니,/40d 여기에/15d 큰 기적을 베푸소서…!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s04
msgctxt "field|re|art_fl18_s04|@kfl18_s04/000"
msgid "…/35d에스메랄다 님이/20d 희생을…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s04
msgctxt "field|re|art_fl18_s04|@kfl18_s04/001"
msgid "아아... 크리스티나가..."
msgstr ""

