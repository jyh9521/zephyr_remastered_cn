msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/023"
msgid "[간호사]/n아,/10d 어제 손님 분들…!/35d/n제발/20d 에스메랄다 님을 구해주세요!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/024"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/025"
msgid "[간호사]/n악마의 힘을 빌려서 사람들을 치료했다고…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/026"
msgid "어째서 그런 짓을 하는 거지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/027"
msgid "[간호사]/n라몬 자작은/30d 에스메랄다 님에게/n일방적으로 구애하고 있었어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/028"
msgid "하,/30d 사내라는 녀석이 옹졸하군!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/029"
msgid "시라노,/20d 빨리 구하러 가야겠어요./25d/n이런 사람은 무슨 짓을 저지를지 모릅니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/030"
msgid "그래,/30d 바로 구하러 가자."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/031"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/032"
msgid "무슨 수를 써서라도 그녀를 구해낼 것이오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/033"
msgid "실버, 곧바로 라몬 자작 저택으로 진입이다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/034"
msgid "예!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/035"
msgid "아직은 좀 더 준비가 필요하오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/036"
msgid "라몬의 추이를 살핀 후 쳐들어가도 늦지 않소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/037"
msgid "하지만, 그 동안 에스메랄다님은...!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/038"
msgid "...알겠습니다, 시라노."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/039"
msgid "응급 처치를 잘 해주셔서 다행이었어요./65d/n일단은 안심하셔도 될 것 같습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/040"
msgid "저…/20d 그런데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/041"
msgid "?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/042"
msgid "왠지/15d 낯이 익어서…/45d/n혹시/25d 전에 저와 만났던 적이/35d 없으신가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/043"
msgid "어떻게 대답할까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/044"
msgid "맞습니다. 사이럽스 시티에서…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/045"
msgid "글쎄요…/40d 다른 사람을 착각하신게 아닌지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/046"
msgid "사이럽스 시티,/30d 아니/25d 사막에서 구해주신 시라노입니다./55d/n그때는 정말 감사했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/047"
msgid "맞아요,/25d 시라노 님이라 하셨었지요./40d 벌써 2년 가까이 지났네요./50d/n건강하신 것 같아 다행입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/048"
msgid "뭐야,/20d 아는 사이였어요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/049"
msgid "아무튼,/30d 오늘은 이만 가보고/30d/n내일 다시 상황을 보러 오겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/050"
msgid "글쎄요… 다른 사람을 착각하신게 아닌지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/051"
msgid "네,/30d 그럼/10d 또 들러 주세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/052"
msgid "그…/25d 2년 정도 전에/30d 사이럽스에선가 만났던 것 같아서…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/053"
msgid "사이럽스에는/30d 최근에 한 번 들렀을 뿐입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/054"
msgid "그럼/20d 저희는 이만 가볼게요./30d/n내일 다시 상황을 보러 올테니/20d 아이들을 잘 부탁드려요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/055"
msgid "다음날"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/056"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/057"
msgid "[간호사]/n도와주세요!/30d 누가…/15d 누가 좀!/30d/n에스메랄다 님이…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/058"
msgid "왜 그래요?/20d 에스메랄다 님께 무슨 일이라도?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/059"
msgid "진정하고,/30d 대체 무슨 일인지 차근차근 얘기해 보시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/060"
msgid "[간호사]/n라몬 자작이…/45d/n갑자기 라몬 자작의 병사들이 몰려와서…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/061"
msgid "라몬 자작이라면/30d 이곳의 영주잖아./25d/n영주가 왜 에스메랄다 님을?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/062"
msgid "  "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/063"
msgid "휴우,/15d 다행이다…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/064"
msgid "[간호사]/n말도 안 되는 억지를 부려/40d/n마녀라고 누명을 씌운 거예요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/065"
msgid "[간호사]/n그렇게도 훌륭하신 분을…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/066"
msgid "[간호사]/n몇 번이고 거절당해서,/30d 앙심을 품고 있었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/067"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/068"
msgid "[간호사]/n에스메랄다 님을 끌고 가버렸어요…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s02
msgctxt "field|re|art_fl07_s02|@kfl07_s02/069"
msgid "권력을 이용해 무고한 사람을 괴롭히다니…!/40d/n제피르 팰컨의 이름으로 용서할 수 없어요!/35d 같이 가요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s04
msgctxt "field|re|art_fl07_s04|@kfl07_s04/000"
msgid "어때,/35d 이제 좀 마음이 바뀌었나?/45d 에스메랄다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s04
msgctxt "field|re|art_fl07_s04|@kfl07_s04/001"
msgid "…/45d…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s04
msgctxt "field|re|art_fl07_s04|@kfl07_s04/002"
msgid "이제는 대꾸도 하지 않겠다는 건가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s04
msgctxt "field|re|art_fl07_s04|@kfl07_s04/003"
msgid "이것 봐,/35d 내 말만 잘 들으면/30d 부귀영화를 누리며/n호강할 수 있단 말이다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s04
msgctxt "field|re|art_fl07_s04|@kfl07_s04/004"
msgid "이 귀하신 몸이/15d 너를 사랑해 주겠다는데,/40d/n왜 그걸 그렇게 거부하는 거지?/40d 응?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s04
msgctxt "field|re|art_fl07_s04|@kfl07_s04/005"
msgid "불쌍한 사람…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s04
msgctxt "field|re|art_fl07_s04|@kfl07_s04/006"
msgid "뭐라고?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s04
msgctxt "field|re|art_fl07_s04|@kfl07_s04/007"
msgid "당신은/40d 불쌍한 사람이에요…/65d/n사람의 마음을/30d 돈으로 살 수 있다고 생각하나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s04
msgctxt "field|re|art_fl07_s04|@kfl07_s04/008"
msgid "이…/45d 이런 발칙한…/50d/n감히 누구 앞에서…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s04
msgctxt "field|re|art_fl07_s04|@kfl07_s04/009"
msgid "한 번만 더 함부로 입을 놀리면/50d/n평생 동안 말 한마디 할 수 없게 만들어 주겠다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/000"
msgid "당신이 라몬 자작인가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/001"
msgid "뭐,/15d 뭐야,/10d 네 놈은?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/002"
msgid "경비병!/20d 뭣들 하고 있나!/25d/n침입자를 잡아라!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/003"
msgid "정말 감사합니다,/35d 여러분."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/004"
msgid "에스메랄다 님,/20d 괜찮으세요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/005"
msgid "네,/40d 덕분에 살았습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/006"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/007"
msgid "라몬도 혼쭐이 났으니,/35d 이제 에스메랄다 님을 괴롭히지는 못할 거예요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/008"
msgid "어라?/25d 샤른호스트는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/009"
msgid "조용히 가버렸군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/010"
msgid "에잇…/15d 또 사라져 버렸네!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/011"
msgid "저렇게 정체를 숨기고 다니는 자를 믿어도 되는 거야?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/012"
msgid "벌써 여러 번 도움을 받았다니까요?/40d/n나뿐이 아니고,/15d 저번엔 이자벨 언니도 도와줬고…/35d 아앗!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/013"
msgid "아차…/30d 완전 잊고 있었네…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/014"
msgid "다른 부대장들과 합류하기로 했는데 깜빡했어요./45d/n빨리 약속 장소에 가야 해요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/015"
msgid "아~/15d 음…/30d/n일단/10d 모두 같이 가지 않을래요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/016"
msgid "무슨 일이라도 있나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_s06
msgctxt "field|re|art_fl07_s06|@kfl07_s06/017"
msgid "부대장이라고?/30d 무슨 말이지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/000"
msgid "…너무해…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/001"
msgid "실버,/20d 상태는?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/002"
msgid "…/55d아쉽지만 이미…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/003"
msgid "…/35d그런가…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/004"
msgid "흑…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/005"
msgid "이런 아이에게…/30d/n무슨 죄가 있다는거야…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/006"
msgid "제발…/30d 제발 눈을 떠봐…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/007"
msgid "카나…/25d 그만해./20d/n이미 늦었…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/008"
msgid "으…으으…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/009"
msgid "!!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/010"
msgid "둘 다 아직 숨이 붙어있어요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/011"
msgid "부탁이야…/20d 힘을 내!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/012"
msgid "…중상입니다./30d 힘들 거예요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/013"
msgid "제길…/40d 방법이 없나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/014"
msgid "아!/10d 그렇지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/015"
msgid "산 너머에 있는 프리토리아 마을에/30d/n에스메랄다라는 유명한 의사가 있어요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/016"
msgid "에스메랄다라면…/50d/n성녀라고까지 불리는 여의사지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/017"
msgid "그래요!/15d/n그분이라면 분명 구해주실 수 있을 거예요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/018"
msgid "실버!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/019"
msgid "예!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/020"
msgid "이 망토로/20d 아이의 몸이 차가워지지 않게 감싸줘."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/021"
msgid "알겠습니다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/022"
msgid "OK!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/023"
msgid "카나는 프리토리아까지 가는 길 안내를 부탁하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/024"
msgid "좋아요!/15d 이쪽이에요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/025"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl07_te1
msgctxt "field|re|art_fl07_te1|@kfl07_te1/026"
msgid "…어떻게/20d 이런 짓을…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/000"
msgid "카라카스 근방, 숲"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/001"
msgid "카나 부대장님이 도착하셨습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/002"
msgid "카나 님 치고는 늦으셨군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/003"
msgid "미안,/5d 미안!/20d 모두 모여 있었네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/004"
msgid "그런데,/35d 메디치 오빠는?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/005"
msgid "메디치 형님이 벌써 도착할 리가 있겠어?/45d/n또 어디서 곤란한 사람을 돕고 있겠지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/006"
msgid "그건 그렇고…/35d 카나!/10d 정신이 있는 거야?!/20d/n부대원들을 놔두고 자리를 비우다니!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/007"
msgid "하아…/30d 루벤 공작이/15d 그렇게 빨리 돌아올 줄은/n생각 못 해서…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/008"
msgid "지금 들어온 정보에 의하면,/30d/n루벤 공작은/30d 이 근방에 주둔하고 있던 이루스 장군을 찾아간 모양입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/009"
msgid "예상 밖의 일이니,/30d 카나 님만 탓할 건 아닙니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/010"
msgid "이유가 어떻든,/20d 부대원을 희생시킨 것은 모두 대장의 책임이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/011"
msgid "이 일이 해결된 후에는/20d 다른 부대장들과 상의해서 적절한 문책이 있을 거야./55d/n불만은 없겠지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/012"
msgid "언니…/30d 미안해요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/013"
msgid "그런데,/30d 같이 오신 분들은?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/014"
msgid "아, 그렇지!/15d/n이번 일에 크게 도움을 주신 분들이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/015"
msgid "카나!/15d 외부인을 데려오다니…/20d/n제정신이야?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/016"
msgid "하지만,/25d 이분들 덕분에 라몬 자작도 혼내주고,/40d/n프리토리아도 해방시킬 수 있었단 말이에요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/017"
msgid "저도 그 이야기는 들었습니다만…/50d/n단 세 분이서/35d 자작 저택을 습격했다는 것이 사실입니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/018"
msgid "진짜 대단한 분들이에요!/40d/n영주의 병사들을 추풍낙엽처럼 쓰러트렸다니까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/019"
msgid "실력은 그렇다고 해도,/30d/n우리 집결지에 누군지도 모르는 외부인을 함부로 데려온 것은 경솔한 행동이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/020"
msgid "뭐가 그렇게 대단한 분들이신지 모르겠지만,/45d/n집안싸움은 알아서들 하시라고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/021"
msgid "우리도 그쪽 일에는 관심 없으니까 말이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/022"
msgid "그러지./25d 그럼 실례하겠소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/023"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/024"
msgid "에스메랄다 님은/15d 여기 남는 게 좋을 것 같네요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/025"
msgid "아니요./30d/n불편하지 않으시다면/25d 저도 시라노 님과 함께 행동했으면 합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/026"
msgid "실례합니다만…/40d/n혹시/30d 프리토리아의 성녀라고 불리는/35d 에스메랄다 님이 아니십니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/027"
msgid "성녀라니요./45d 일개 의사에 불과하답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/028"
msgid "에스메랄다 님은/35d 저희가 여러 번 모시려고 했던/25d/n제국령 최고의 명의이십니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/029"
msgid "이런 곳에서 뵐 줄은…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/030"
msgid "클라우제비츠 님의 편지는/20d 여러 번 받아봤지만,/40d/n곁을 지켜야 할 환자들이 있어서 자리를 뜰 수 없었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/031"
msgid "에스메랄다 님,/35d 괜찮으시다면/30d 저희가 선생님을 보호해 드리겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/032"
msgid "감사합니다./40d/n하지만/15d 저는 이분들에게 큰 은혜를 입었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/033"
msgid "저도/15d 이분들을 따라 이곳을 떠나겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/034"
msgid "에스메랄다 님,/30d 우리는 신경쓰지 말고/20d 여기 남으시지요./40d/n그게 더 안전합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/035"
msgid "성녀 에스메랄다 님과/30d 카나 부대장님의 믿음이 있는/n분들이라면/35d 저희도 신용할 수 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/036"
msgid "쳇,/25d 뭐야./40d/n갑자기 태도가 바뀌었군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/037"
msgid "이쪽도 할 일이 있소./40d/n미안하지만/25d 이만 실례하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/038"
msgid "[메디치]/n여어!/15d 여러분./25d 늦어서 미안하군!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/039"
msgid "형님은 또 지각이군요!/50d/n이번에는 무슨 일이 있었던 거죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/040"
msgid "이번에도 위험했다구요./35d/n불이 나서 다 타들어 가는 집에 뛰어들어서/15d/n4남매를 구해냈다니까요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/041"
msgid "…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/042"
msgid "메디치,/35d 너는 제피르 팰컨의 실질적인 총 대장이잖아./50d/n그러다가 사고라도 나면…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/043"
msgid "뭐,/45d 그래도/25d 곤경에 빠진 사람들을 모른체할 수는 없잖아?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/044"
msgid "하하하,/50d 역시나/25d 로베르토 데 메디치 다운 말씀이시군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/045"
msgid "…/55d로베르토 데 메디치…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/046"
msgid "그래…/30d 로베르토 데 메디치…/50d/n제피르 팰컨…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/047"
msgid "왜 그러시죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/048"
msgid "아아…/35d 아니야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/049"
msgid "그나저나,/10d 카나의 부대는 어때?/30d/n루벤을 쫓는 사이에 이루스 장군이 와서 곤경에 빠지지 않았나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/050"
msgid "네,/30d 이루스 장군이 개입한 모양입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/051"
msgid "오히려/15d 카나가 그 자리에 없었던 것이/30d 불행 중 다행이었을지도 모르겠군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/052"
msgid "아무래도/25d 이루스 장군은/30d 메디치 님이 맡아주시는 것이 좋겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/053"
msgid "아무리 나라도/25d 구 제국 4천왕의 상대가 될지는/n모르겠군…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/054"
msgid "오빠,/20d 미안해요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/055"
msgid "하하하,/45d 신경 쓰지 마./40d/n그래도/15d 카나의 부대원들을 그대로 놔둘 수는 없지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/056"
msgid "그런데…/35d 못 보던 사람들이 있군?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/057"
msgid "우리가 영입하려던/15d 에스메랄다 님과,/30d/n카나 부대장님을 도와주신 분들입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/058"
msgid "다시 한번 청하겠습니다./50d/n저희에게/30d 힘을 보태주시지 않겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/059"
msgid "조금 전 일은/35d 제가 사과드리겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/060"
msgid "흥,/25d 이미 늦었…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/061"
msgid "좋소./40d/n일단은 같이 행동하도록 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/062"
msgid "?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/063"
msgid "좋아요!/15d/n시라노 님은 우리 4부대에서/25d 나와 함께 움직이도록 하죠!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/064"
msgid "이상입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/065"
msgid "그럼 시간이 없으니,/30d/n바로 카라카스 공격 작전을 설명드리겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/066"
msgid "먼저,/20d 이자벨 님이 이끄는 제2부대와/20d 리델 님의 제3부대는/25d 마을 양쪽을 동시에 공격,/30d/n적을 교란시켜 주십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/067"
msgid "잠입에 성공하면/25d 메디치 님의 제1부대는/30d 영주 저택 정면에서 공격을 개시합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/068"
msgid "메디치 님이 이루스 장군을 상대하는 사이,/30d/n카나 님의 제4부대는/20d 지하 수로를 이용해 저택 지하로 진입,/40d/n붙잡힌 포로들을 구출합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/069"
msgid "역시/15d 클라우제비츠 군사,/40d 빈틈없는 작전이군!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/070"
msgid "자, 그럼/30d 구 제국 4천왕 님의 솜씨를 보러 가볼까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/071"
msgid "그게 형님의 좋은 점이지만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/072"
msgid "카나/30d 너는,/20d 부대장으로서의 자각이 너무 없는 거 아니야?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/073"
msgid "저기 말이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/074"
msgid "시라노,/25d 이만 가시죠!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/075"
msgid "죄송합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/076"
msgid "어떻습니까?/40d/n여러분도/30d 저희 제피르 팰컨에/30d 힘을 보태주시지 않겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/077"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/078"
msgid "이루스 장군이라면/30d 제국 최고의 맹장으로,/45d/n과거/25d 제국 4천왕으로 꼽히던 전설적인 인물입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/079"
msgid "전설의/25d 이루스 장군의 등장인가."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/080"
msgid "좋아,/30d 이루스 장군에게 본때를 보여주자고!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/081"
msgid "제 8 장"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s01
msgctxt "field|re|art_fl08_s01|@kfl08_s01/082"
msgid "악연"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/000"
msgid "저택 내부"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/001"
msgid "후후,/65d 예전의 공부벌레 모습은/35d 흔적도 없이 사라졌더군./35d/n시라노 번스타인."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/002"
msgid "설마/35d 4천왕의 한 명인/30d 이루스 장군을 격파할 줄이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/003"
msgid "루벤…/45d 오랜만이군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/004"
msgid "시라노,/45d 오늘 같은 날이/25d 언젠가는 올 줄 알았다./40d/n15년 전부터."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/005"
msgid "왜 그랬지?/35d 왜 재판에서 거짓을 말했나?/45d/n왜 형제나 다름없던 네가,/30d 나를 배신한 거지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/006"
msgid "…/55d형제나 다름없다라…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/007"
msgid "그게…/35d 무슨 말이지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/008"
msgid "다음 이야기는/30d 당신이 나를 쓰러트릴 수 있다면/n계속하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/009"
msgid "시라노 번스타인,/30d/n당신을 위해서/30d 장난감을 하나 준비했어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/010"
msgid "머신 건이라는 무기를 들어봤나?/50d/n동방에서 건너온 물건인데,/55d 위력이 대단하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/011"
msgid "…왔군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/012"
msgid "어디,/30d 암흑신을 죽인 실력 좀 볼까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/013"
msgid "네가 어떻게/15d 이루스가 암흑신인 것을…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/014"
msgid "나를 그렇게 과소평가했었다니,/55d 실망인걸."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/015"
msgid "이런,/25d 말이 너무 길어졌군./40d/n조심하라고,/30d 이 장난감은 위험하니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/016"
msgid "불멸의 육체도/30d 산산조각 내버릴 정도로!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/017"
msgid "크윽…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/018"
msgid "루벤…/45d 대체 왜…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/019"
msgid "이건…/65d 내가 원한 길…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/020"
msgid "15년 전부터/45d 이날이 오기를 기다렸어…/60d/n아버지가/25d 돌아가신 그날부터…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/021"
msgid "…/60d형…/45d 나에게도/35d 아버지…/35d/n루크 번스타인의 피가 흐르고 있어…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/022"
msgid "뭐…라고?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/023"
msgid "형은 몰랐겠지만…/55d 우린/40d 배다른 형제야./45d/n모두/30d 아버지인/30d 루크 번스타인의 피가 섞인."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/024"
msgid "그런데/10d 대체 왜…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/025"
msgid "내가…/45d 천한 신분이었기 때문이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/026"
msgid "……!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/027"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/028"
msgid "형이…/55d 형이/40d 부러웠어./55d/n형은/35d 늘 밝은 곳에서/40d 화려하게 빛나는 사람이었지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/029"
msgid "그런데/25d 나는…/50d 어머니가 다르다는 이유로/50d/n늘 어두운 곳에 있어야만 했어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/030"
msgid "질투났어…/40d 형이…/55d/n그래서…/40d 형이/20d 사라졌으면 했어./45d/n그러면/45d 아버지도/25d 나를 다시 보시겠지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/031"
msgid "그땐…/45d 그런 바보 같은 생각을 했지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/032"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/033"
msgid "하…/55d 그런데…/55d 죽기 직전이 되니…/50d/n왜 그렇게까지/30d 발악하며 살았나 싶네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/034"
msgid "형…/40d 그거 알아?/50d/n아버지는 형을 구하기 위해…/40d 추기경에게 맞섰어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/035"
msgid "그리고 결국/40d 프레데릭과의 결투에서…/45d/n돌아가셨지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/036"
msgid "……!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/037"
msgid "영지를 하사받고…/55d 번스타인의 이름까지 쓰게 됐지만…/90d/n이젠/30d 아무런 의미가 없네./60d 죽으면 다 끝인 걸…/110d 허무하네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/038"
msgid "…/45d이제…/35d 좀 쉬고 싶어…/95d/n형…/65d 미안했어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/039"
msgid "정신 차려! 루벤!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/040"
msgid "…/45d형…/40d 체사레를 조심해…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/041"
msgid "형을 함정에 빠뜨린 것은…/70d/n체사레 추기경이야…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/042"
msgid "이스카리옷도…/40d 나도…/55d/n모두/25d 그의…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/043"
msgid "으윽…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/044"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/045"
msgid "…/55d모든 원흉이 체사레라는 건가…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/046"
msgid "체사레 보르자…/55d/n이 피비린내 나는 악연…/45d 반드시 내 손으로 거두어 주마."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s03
msgctxt "field|re|art_fl08_s03|@kfl08_s03/047"
msgid "그래,/45d 당신이 나의 진짜 형이 아니었다면…/50d/n절대로 배신하지 않았을 거야!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/000"
msgid "저택 앞"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/001"
msgid "아,/20d 무사하셨군요!/35d/n루벤 공작은 어떻게 되었습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/002"
msgid "…숨을 거두었소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/003"
msgid "과연 대단한 실력이군!/35d/n정말 고마웠소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/004"
msgid "천만에./45d 운이 좋았을 뿐이오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/005"
msgid "흥!/25d 메디치 형님을 구해줬다고/15d 생색이라도 낼 생각은 아니겠지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/006"
msgid "나는 메디치 경을 조금 거들었을 뿐이오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/007"
msgid "아니,/25d 덕분에 목숨을 건졌소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/008"
msgid "샤른호스트라는 괴도와/15d 당신이 없었다면,/35d/n우리 제피르 팰컨은 전멸당했을지도 모르지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/009"
msgid "!!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/010"
msgid "!!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/011"
msgid "!!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/012"
msgid "아…/35d 샤른호스트가 또 나타났구나?/40d/n이제 우리들 대부분이 샤른호스트의 도움을 받은 셈이네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/013"
msgid "그런데,/25d 시라노 님은/20d 앞으로 어떻게 하시겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/014"
msgid "무슨 말이지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/015"
msgid "이렇게 된 이상,/30d 우리 제피르 팰컨과 행동을 함께 하는 것이/40d/n시라노 님을 위해서도 좋을 거라고 생각합니다만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/016"
msgid "이번 일로 교회는/30d 당신을 제피르 팰컨의 일원으로 여기게 되었을 터./65d/n당신도 우리와 같은 반역자로 낙인이 찍힌 셈입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/017"
msgid "반역자라는 낙인은 붙은 지 오래지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/018"
msgid "게다가/15d 당신의 몸과 검,/60d/n그 마력의 정체를 밝히려/30d 교회 세력이 혈안이 되어 당신을 찾아내려 하겠죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/019"
msgid "교회의 추격망을 빠져나가기엔,/40d 당신들 만으로는 행동에 많은 제약이 따를 겁니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/020"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/021"
msgid "어떻습니까?/50d/n이 기회에/30d 저희와 함께 행동하는 것이 좋지 않겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/022"
msgid "우리 제피르 팰컨의 정보 수집 능력이라면/45d 당신의 목적에도 분명 도움이 될 겁니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/023"
msgid "…/50d자네도 보통은 아니군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/024"
msgid "시라노,/30d 어떻게 하시겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/025"
msgid "서로의 목적이 어떻든,/45d 추기경을 적으로 돌리고 있다는 점에서/25d 같은 입장이라는 거로군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/026"
msgid "알겠소./40d 같이 행동하기로 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/027"
msgid "좋습니다./40d/n일단은/15d 이번 사건으로 전력이 약화된/30d 카나 님의 제4부대에 소속해 주시겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/028"
msgid "좋아요!/20d/n그럼 이제부터는 정식으로 함께 행동할 수 있겠네요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_s04
msgctxt "field|re|art_fl08_s04|@kfl08_s04/029"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/000"
msgid "…/25d그 친구는 어떤가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/001"
msgid "으으…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/002"
msgid "다행히 치명상은 아닌 것 같습니다./40d/n결정적인 순간에/25d 반사적으로 몸을 틀었던 모양이군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/003"
msgid "다행이군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/004"
msgid "그건 그렇고…/55d/n당신의 검법…/45d 상당히 특이하네요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/005"
msgid "자네야말로/15d 흑영의 후예라면서/40d 팬드래건 검법을 사용하는 이유는 뭐지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/006"
msgid "후…/35d 서로 숨기는 것이 많은 신세군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/007"
msgid "그럼,/20d 다음 기회에…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/008"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/009"
msgid "[실버]/n시라노!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/010"
msgid "갑자기 뛰어가 버리시고…/35d 어떻게 된 거죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/011"
msgid "다른 사람들은?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/012"
msgid "아직 저택을 완전히 장악하지 못했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/013"
msgid "에스메랄다 님은 부상자를 치료하고 있고,/35d/n카나는 다른 부대의 지원을 나갔습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/014"
msgid "나는 저택으로 들어간다./50d/n루벤이 나를 기다리고 있을 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/015"
msgid "저는…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/016"
msgid "메디치를 부탁한다./35d 치명상은 아니지만/25d/n아직 정신을 못 차리고 있으니 살펴봐줘."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/017"
msgid "혼자 가셔도…/40d 괜찮겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/018"
msgid "루벤과는/15d 둘이서 끝을 내야만 할 일이 있지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/019"
msgid "…알겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/020"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/021"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/022"
msgid "루벤과 결판을 내야 해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/023"
msgid "[제피르 팰컨 보급병]/n필요한 물건이 있으시면 보급해 드리겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/024"
msgid "제피르 팰컨 보급병"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/025"
msgid "몸조심 하십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/026"
msgid "!!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl08_te1
msgctxt "field|re|art_fl08_te1|@kfl08_te1/027"
msgid "바바리안을 획득하였습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/000"
msgid "[카나]/n빨리 떠나자구요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/001"
msgid "[메디치]/n당신처럼 실력있는 동료를 맞이할 수 있어서 기쁘군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/002"
msgid "[클라우제비츠]/n우리 제피르 팰컨에 참여를 진심으로 환영합니다./50d/n여러분의 활약을 기대합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/003"
msgid "[보르스]/n여기는 제피르 팰컨의 작전 회의실입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/004"
msgid "[루이]/n니코시아는 게이시르 남쪽의 작은 마을입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/005"
msgid "[리델]/n도와준 건 고맙지만,/20d/n공을 세웠다고 잘난 척할 생각은 말라구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/006"
msgid "[리델]/n뭐,/20d 그래도 니코시아 임무는 잘 마치기를 바라주지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/007"
msgid "[카나]/n당신과 함께라면/25d 왠지 마음이 든든한걸요?/20d 신참씨!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/008"
msgid "[클라우제비츠]/n첫 임무는 니코시아 지방의 정보 수집입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/009"
msgid "[이자벨]/n…미리 말해두지만,/40d 나는 당신이 마음에 안 들어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/010"
msgid "[이자벨]/n임무와 관련된 게 아니라면 말 걸지 말아 주겠어?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/011"
msgid "[리델]/n(…이자벨은 아무리 봐도 미인이란 말이야…)/60d/n음?/20d 당신 왜 내 얘기를 엿듣고 있는 거야!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/012"
msgid "제피르 팰컨, 작전회의실"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/013"
msgid "무슨 움직임이라도 있었나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/014"
msgid "아,/15d 시라노 님./10d 오셨습니까./35d/n이제 다 모였군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/015"
msgid "여러분,/15d 일이 생겼습니다./40d/n체사레 추기경이/15d 니코시아 지방에서 일을 꾸미고 있는 것 같습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/016"
msgid "체사레가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/017"
msgid "니코시아 지방에 요새를 세우고/30d/n무언가를 준비하고 있다는 정보입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/018"
msgid "하지만 경비가 삼엄해서,/35d/n우리 정보원들을 들여보내는 데는 실패했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/019"
msgid "나와 함께 그곳에 가서/25d/n무슨 일을 벌이는지 조사하는 임무예요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/020"
msgid "니코시아 지방은 알고 계십니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/021"
msgid "니코시아 지방은/15d 게이시르 시티를 지나 남쪽이죠./45d/n꽤 먼 길이 되겠네요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/022"
msgid "게이시르 시티라…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/023"
msgid "가본 적은 있소?/30d 옛 제국 시절의 수도였지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/024"
msgid "지금도 여전히 제국 제일의 도시지만,/40d/n최근에는 프레데릭 공의 로우엔이 더 활기찬 것 같던데요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/025"
msgid "로우엔 지방은/20d 현 제국 최강인/25d 프레데릭 공의 영지니까요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/026"
msgid "우리 제피르 팰컨의 정보망도/35d 아직 닿지 않는 곳이지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/027"
msgid "그럼/20d 출발하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/028"
msgid "변동 사항이 있으면/20d/n전령을 통해 연락드리도록 하겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/029"
msgid "앗!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/030"
msgid "음…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
