msgid "이 녀석만이 아니야./35d/n인페르노의 유황굴은 몬스터들의 천국이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flinf2f
msgctxt "field|re|art_flinf2f|@kflinf2f/009"
