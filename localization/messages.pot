msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/005"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/006"
msgid "앗.../30d /n저, 예..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/007"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/008"
msgid "시라노 님 말씀이 갑작스러워 부담을 드린 모양입니다만, 저희는 에스테도데 님을 한시라도 빨리 돕고 싶은 마음에서 드린 말씀이니 허물없이 고민을 말씀해 주십시오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/009"
msgid "아니예요, 조금 당황했지만 시라노 님 말씀이 맞는걸요.../n오히려 그렇게 말씀해 주시니 부담이 줄어드네요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/010"
msgid "그럼 여러분들을 모시게 된 바로 그 문제에 대해 말씀드리겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/011"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/012"
msgid "부끄러운 이야기입니다만 저희 리브레빌은 제국령에서 두번째로 살기 좋은 고장으로 평가 받고 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/013"
msgid "당연하죠! 아니 여기는 제국령 최고라고 해도 될 겁니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/014"
msgid "리델!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/015"
msgid "윽......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/016"
msgid "선대 영주와 주민들은 산지를 개척하고 척박했던 땅을 깍아 도로를 건설했고, 결국은 북방의 비프로스트나 커티스와의 교역의 중심지로 자리 잡게 되었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/017"
msgid "이 땅은 우리들의 피와 땀이 일구어낸 결실인 것입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/018"
msgid "그런데.... 일년 전이었을 겁니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/019"
msgid "커티스로 통하기 위한 이 마을의 동쪽 길./n바로 그 도로의 북쪽에 있는 고원 지대가 새로운 영지로 분리되어 마을이 들어서게 된거예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/020"
msgid "설마 영지가 분리된게 곤란하다는 말씀인가요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/021"
msgid "그런 건 신경쓰지 않아요. 문제는, 그 작은 마을이 우리 리브레빌의 생명이나 다름 없는 이 도로를 버젓이 자기들의 소유인냥 차지하고는 통행세를 받기 시작한 거죠. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/022"
msgid "정말 염치도 없는 녀석들이로군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/023"
msgid "하지만 제국령내에서 그 정도 영토 분쟁은 여기저기서 셀 수도 없이 많이 벌어지고 있어요. 설마 이 정도일로 우리에게 도움을 청하려는 건 아니겠죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/024"
msgid "아직 말씀이 끝나지 않은 것 같은데 조금만 더 이야기를 들어보지요, 이자벨 님."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/025"
msgid "예, 사실 단지 통행세 정도의 문제 였으면 우리 영주들 선에서 해결을 보려고 했는데, 그 곳의 영주는 외부에 얼굴을 내비치지도 않을 뿐더러 우리쪽에서 서한을 보내도 소식이 없는 거예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/026"
msgid "게다가..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/027"
msgid "게다가...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/028"
msgid "그 도로를 통해 일을 하던 사람들이 언제부터인가 하나둘씩 리브레빌로 돌아오지 않는 거예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/029"
msgid "예?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/030"
msgid "실종?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/031"
msgid "납치라고 말씀하고 싶으신 겁니까."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/032"
msgid "저도 그렇게 까지는 생각하고 싶지 않았어요, 하지만 아무래도 우리 마을 사람들의 실종을 두손 놓고 보고만 있을 수는 없었어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/033"
msgid "하지만 어째서 직접 그들과 싸우지 않는 거죠? 리브레빌이 사람도 더 많고 더 발전된 마을이잖아요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/034"
msgid "그건... 우리들에게 힘이 없는 것도 이유중 하나지만 그들의 마을은 비 정상적이거든요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/035"
msgid "화력입니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/036"
msgid "아.../30d 예... 화력뿐 아니라.. 그들은 몬스터를 이용하고 있어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/037"
msgid "몬스터를... 확실히 뭔가가 있군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/038"
msgid "얼굴을 드러내지 않고 몬스터를 부려 사람들을 납치하는 영주라.../40d 소설을 무척 좋아하는 영주인가 보군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/039"
msgid "우리가 어떻게 해주길 바라는 거죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/040"
msgid "당연히 이 창으로 그 녀석을 절단내길 바라는 말씀이겠지!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/041"
msgid "무고한 사람을 괴롭히는 녀석을 우리 제피르 팰컨이 가만 둘 수 없지. 영주님의 청이 아니었다고 할지라도 이런 사실을 진작에 알았더라면 우리가 가만 있지 않았을 거요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/042"
msgid "그럼 제 청을 들어주시려나요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/043"
msgid "잠깐, 설마 아무런 대가도 없이 우리 힘을 빌리려는 생각은 아니겠죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/044"
msgid "물론 빈손으로 도움을 청한건 아니니까 안심하세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/045"
msgid "무슨 말씀을 하시는 겁니까, 영주님께 부담은..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/046"
msgid "옛말에 호의는 거절하는게 아니라고 했습니다. 무엇을 준비하셨는지 알고 싶습니다만, 에스테도데 님."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/047"
msgid "그리 대단한 것은 아니지만 제 정성을 선물 드리고 싶습니다. 세부적으로 말씀 드리자면"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/048"
msgid "연간 지원금 100만 엘드, 제 저택의 자유로운 사용과 제피르 팰컨 간부들의 신분 보장을 약속 하겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/049"
msgid "100만을 매년...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/050"
msgid "과연, 최고 영주님 다운 배포이십니다./n감사히 받겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/051"
msgid "이번 일 뿐만이 아니라 저는 평소부터 제피르 팰컨이 행하는 정의를 항상 동경해오고 있었답니다. 어떻게든 도움이 될 수 있다면 정성을 다 해 돕겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/052"
msgid "그리고 지금 당장 착수금으로 50만을 드리도록 할테니 유용하게 써주세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/053"
msgid "정말 고맙습니다, 에스테도데 영주님."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/054"
msgid "앞으로는 에스테라고 불러주세요, 메디치 님."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/055"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/056"
msgid "그리 대단한 것은 아니지만 제 정성이라고 생각하고 받아 주세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/057"
msgid "/2c리브레빌. 에스테도데의 살롱."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/058"
msgid "조금전에 프레데릭의 전령이 도착했습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/059"
msgid "내용이 흥미롭더군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/060"
msgid "프레데릭의 전령이 왜 제피르팰컨에게..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/061"
msgid "비프로스트군의 제국침공이 시작된 모양입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/062"
msgid "!!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/063"
msgid "설마..중립국인 비프로스트가.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/064"
msgid "어느정도 예견된 일 아니었나? /n비프로스트가 군비를 늘리기 시작한 것은 하루이틀의 일이 아니니."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/065"
msgid "물론입니다. /n하지만 지금은 상황이 좀 애매하다고 할 수 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/066"
msgid "아마도 밀사로 파견된 마키아벨리의 영향이 큰 것 같습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/067"
msgid "그때 그 녀석을 없애 버렸으면 이런일이 없었을 것을/10d...이게 모두 당신 책임이오. 시라노!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/068"
msgid "그 것과 프레데릭의 전령과는 무슨 연관이 있지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/069"
msgid "프레데릭은 비프로스트와 싸울 생각입니다. /n그래서 제피르팰컨의 협조를 요청하는군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/070"
msgid "과연 대단한 사람이군. /n적에게 함께 싸우자는 요청을 하다니.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/071"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/072"
msgid "그래서.. 클라우제비츠는 어떻게 생각하고 있지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/073"
msgid "외세를 끌어들일 수는 없는 일이지요. /n제국 입장에서 보면 이것은 명백한 침략 행위입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/074"
msgid "여러분들의 의견은 어떠신지요. /n다른 생각을 하시는 분은 안계십니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/075"
msgid "난 찬성"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/076"
msgid "비프로스트 녀석들에게 제국을 빼앗길 수는 없지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s03
msgctxt "field|ko|art_ko_fl13_s03|@kfl13_s03/077"
msgid "그렇다면, 다른분들은..?"
msgstr ""

