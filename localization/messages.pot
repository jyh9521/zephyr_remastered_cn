msgctxt "field|re|art_fl05_s04|@kfl05_s04/006"
msgid "앞으로는 너희들 마음대로 해도 좋아./50d/n지금처럼 해적질을 하든,/30d 그동안 번 밑천으로 장사를 하든,/40d 시골로 가서 농사를 짓든…/40d/n좋을 대로 해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl05_s04
msgctxt "field|re|art_fl05_s04|@kfl05_s04/007"
