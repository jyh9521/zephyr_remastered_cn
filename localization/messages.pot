msgid "<< 프리토리아 마을 >>"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmpx13
msgctxt "field|re|art_flmpx13|@kflmpx13/000"
msgid "북 - 산정상으로/n남 - 프리토리아 마을/n동 - 카라카스,게이시르 방면"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmpx13
msgctxt "field|re|art_flmpx13|@kflmpx13/000_3"
msgid "북 - 산정상으로/n남 - 프리토리아 시티"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmpx14
msgctxt "field|re|art_flmpx14|@kflmpx14/000"
msgid ""
"인간이 다른 존재보다 우월해질수 있는/n가장 큰 이유는 타인을 위해 희생할수 있다는 점이다./n오늘의 선택으로 모든 것을 잃는다 해도 슬퍼하거나 후회하지 말라./n인간이란 서로를 위해 희생하며 살아가는 법./n오늘 내가 사라져 가도 또다른 인생이 있지 않은가?/n아버지의 의지는 아들을 "
"통해 이어지고 어머니의 사랑은 결코 변치 않으니/n희생과 사랑으로 인간이란 영원해질수 있으리라..."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmpx18
msgctxt "field|re|art_flmpx18|@kflmpx18/000"
msgid "이 근방에는 반란군의 출몰이 잦으니 일반인의 통행을 금함/n/n프리토리아 영주 백"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmpx18
msgctxt "field|re|art_flmpx18|@kflmpx18/001"
msgid "동남 - 프리토리아 마을"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmpx19
msgctxt "field|re|art_flmpx19|@kflmpx19/000"
msgid "서둘러 프리토리아 마을로 가야 해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmpx19
msgctxt "field|re|art_flmpx19|@kflmpx19/000_3"
msgid "빨리 프리토리아쪽으로 가지 않으면 안된다./n"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmpx19
msgctxt "field|re|art_flmpx19|@kflmpx19/001"
msgid "이번 작전의 목표는/35d 프리토리아,/15d 멤피스,/25d 보르도 영주의 저택에 억류된/20d 포로 구출이다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmpx20
msgctxt "field|re|art_flmpx20|@kflmpx20/000"
msgid "북 - 피닉스의 동굴/n남 - 프리토리아 지방"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmpx23
msgctxt "field|re|art_flmpx23|@kflmpx23/000"
msgid "이쪽은 프리토리아 방향이 아니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmpx23
msgctxt "field|re|art_flmpx23|@kflmpx23/001"
msgid "<< 피닉스의 동굴 >>/n1000년에 한번,/n불새는 자신의 몸을 태워/n새로운 생명을 잉태한다./n/n무릇, 가장 소중한 것을 얻기 위해서는/n자신의 가장 귀한 것을 희생해야 하나니.../n/n모험가 라르고"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmro01
msgctxt "field|re|art_flmro01|@kflmro01/000"
msgid "동 - 게이시르 시티/n서 - 로우엔 시티"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmro01
msgctxt "field|re|art_flmro01|@kflmro01/001"
msgid "로우엔 지방"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmro01
msgctxt "field|re|art_flmro01|@kflmro01/002"
msgid "보르도로 가려면/25d 여기서 서쪽에 있는 로우엔 시티를 통과해서/30d 북쪽으로 가야 한다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmro08
msgctxt "field|re|art_flmro08|@kflmro08/000"
msgid "로웬숲이다!!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmro08
msgctxt "field|re|art_flmro08|@kflmro08/001"
msgid "서 - 로우엔 숲"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmro08
msgctxt "field|re|art_flmro08|@kflmro08/002"
msgid "[지리학회회원]/n우리는 지금 로우엔근처의 숲과 산들을 다시 측량하고 있는 중이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmro08
msgctxt "field|re|art_flmro08|@kflmro08/003"
msgid "[지리학회회원]/n로우엔으로 가고 싶나? 로우엔으로 가기 위해서는 이곳에서 서쪽으로 간 다음 남쪽으로 내려가서 계속 서쪽 방향으로 나아가면 갈 수 있다네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmro08
msgctxt "field|re|art_flmro08|@kflmro08/004"
msgid "[지리학회회원]/n로우엔과 게이시르는 상당히 떨어져 있어서, 게이시르에서 로우엔으로 가기 위해서는 게이시를 숲을 통해 이 로우엔산을 지나 다시 로우엔 숲을 거쳐야 하지. 이곳은 게이시르와 로우엔 사이 삼분의 이 지점쯤 되지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmro08
msgctxt "field|re|art_flmro08|@kflmro08/005"
msgid "[지리학회회원]/n이곳에서 게이시르로 가기 위해서는 남쪽으로 내려간 다음 계속해서 동쪽으로 숲이 나올때 까지 가서,숲에서는 동쪽으로 가다가 길이 막히면 북쪽으로 계속 올라가면 되지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmro08
msgctxt "field|re|art_flmro08|@kflmro08/006"
msgid "[지리학회회원]/n이곳에서 계속해서 올라가면 로우엔던젼으로 들어갈 수 있지요. 그곳은 예전부터 다이아몬드 원석의 광산으로 유명한 곳입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmro08
msgctxt "field|re|art_flmro08|@kflmro08/007"
msgid "[지리학회회원]/n멤피스 마을을 가기 위해서는 게이시르로 가다가 숲속 두번째 갈림길에서 북쪽으로 간 다음 첫번째 갈림길에서 남쪽으로 쭉 내려가면 되지요. 니코시아는 멤피스로 가는 갈림길에서 북쪽으로 간 다음 갈림길에서 동쪽으로 가면 되고요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmro10
msgctxt "field|re|art_flmro10|@kflmro10/000"
msgid "<< 경고문 >>/n이 던젼은 매우 위험하므로 일반인의 출입을 금함/n        - 로우엔 영주"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmro12
msgctxt "field|re|art_flmro12|@kflmro12/000"
msgid "어려서 검을 잡은지 12년,/n무도의 길은 험난하고 길기만 하네./n하지만,모든 길은 항상 마음속에 있는 법/n번뇌를 일검에 가르니 모든 것이 분명하다./n/n칼 스타이너,이곳에서 검의 도를 얻다. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmro15
msgctxt "field|re|art_flmro15|@kflmro15/000"
msgid "로웬숲이네"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmsd01
msgctxt "field|re|art_flmsd01|@kflmsd01/000"
msgid "   << 인페르노 공략작전 >>/n/n비프로스트군에 점령된 인페르노를 탈환하라!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmsd01
msgctxt "field|re|art_flmsd01|@kflmsd01/001"
msgid "인페르노라…/45d 3년만인가./40d/n여기에서는 북쪽에 있겠지."
msgstr ""

