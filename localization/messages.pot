#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/018"
msgid "게이시르, 프레데릭 저택"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/019"
msgid "프레데릭…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/020"
msgid "아마 우리 프레레릭 가문을 빛낼 사람은,/45d/n이 알프레드 프레데릭이 아니라/30d 크리스티나 프레데릭이 될 거요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/021"
msgid "크리스티나의 소식은/20d 아직도 없나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/022"
msgid "으음,/35d 아직은…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/023"
msgid "딸이 집을 나간지 3달이나 지났는데도…/45d/n당신은/20d 정말 태평하군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/024"
msgid "하하,/50d 나도 그 나이에는/20d/n세상을 돌아다니며 견문을 넓혔지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/025"
msgid "크리스티나, 그 녀석에게도/30d 이번 여행은/n좋은 경험이 될 테니,/35d 너무 걱정하진 마시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/026"
msgid "그걸 지금 말씀이라고 하세요?/35d/n그 애는 이제 겨우 15살이에요!/35d 더구나 여자아이라고요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/027"
msgid "하지만/30d 녀석의 심정도 이해는 되오./45d/n아직 15살인데/30d 생판 모르는 남자에게 시집을 가라고 했으니…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/028"
msgid "그렇다고 집을 나가버리다니…/45d 당신 탓이에요!/30d/n어릴 때부터/20d 남자아이 키우듯이 무술 같은 걸 가르치니까 그렇죠!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/029"
msgid "하하!/50d 걱정마시오./40d/n내 자식이라고는 하나,/30d 정말 비범한 재능을 타고 난 녀석이니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/030"
msgid "그 아이에게/50d 무슨 일이라도 생긴다면/15d 저는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/031"
msgid "…/70d당신이 그렇게까지 걱정을 하고 있었다니./60d/n알았소./40d 이번 기회에 찾아보리다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/032"
msgid "실은/40d 얼마전 장인어른께서/35d 니코시아 지방에/n설립하신 교회가/35d 제피르 팰컨에게 파괴당했다더군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/033"
msgid "이번 기회라니요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/034"
msgid "여보…/40d 그 분은/25d 저를 길러주신 분이세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/035"
msgid "또 반란이라니…/55d/n장인어른이 평민들을 너무 억압하는 게 아닌가 걱정이군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/036"
msgid "아무리 할아버지의 말씀이라고는 해도/55d/n받아들이기 어렵겠지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/037"
msgid "…/50d미안하오./75d/n당신을 길러주신 것 만으로도/35d 장인어른은 내겐 정말 고마우신 분이시지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/038"
msgid "어찌되었든,/40d 최근 제피르 팰컨 녀석들이/30d 무서운 줄 모르고 날뛰고 있으니/45d/n한번쯤 쓴 맛을 보여주는 것도 좋겠지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/039"
msgid "그럼,/15d 원정을 떠날 계획인가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s01
msgctxt "field|re|art_fl11_s01|@kfl11_s01/040"
msgid "일단/30d 제피르 팰컨을 상대하면서/35d/n크리스티나의 소식을 알아보겠소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/000"
msgid "제피르 팰컨, 작전회의실"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/001"
msgid "다들 모이신 것 같으니,/25d 작전 회의를 시작하겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/002"
msgid "이번 작전의 목표는,/35d/n프레데릭군의 힘을 빌린/15d 지방 영주들이 억류하고 있는/35d 아군 포로 구출입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/003"
msgid "프리토리아,/15d 멤피스,/15d 보르도./30d/n이 세 곳에 억류되어 있는/15d 아군 포로를 구출해 주십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/004"
msgid "프리토리아는/35d 아시다시피 제피르 팰컨 세력 아래에 있던 도시였지만,/50d/n프레데릭의 지휘로/30d 얼마 전 새로운 영주가 들어섰다고 합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/005"
msgid "멤피스는/30d 대륙 최남단에 있는 마을로,/30d 게이시르 숲을 통과해야 합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/006"
msgid "그리고 보르도는/30d 로우엔 시티 북쪽에 위치해 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/007"
msgid "로우엔 시티는/25d 검문이 삼엄해서/30d 얼마전까지는 잠입이 불가능 했었습니다만,/50d/n최근들어/30d 외부인의 출입이 비교적 수월해졌다고 합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/008"
msgid "자,/35d 그럼 준비를 마치는 대로 출발하시죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/009"
msgid "가까운 프리토리아 마을까지 같이 갈까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/010"
msgid "카나의 4부대와 함께 프리토리아까지 이동하겠습니까?/n(함께 행동하면 프리토리아 마을로 자동으로 이동합니다.)"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/011"
msgid "카나와 함께 프리토리아로 간다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/012"
msgid "주변을 조사할 겸 따로 움직인다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/013"
msgid "좋아요!/15d 그럼 출발해요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/014"
msgid "뭐…/25d 그럼 할 수 없죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/015"
msgid "[메디치]/n프레데릭 장군이라…/45d/n좋은 승부가 되겠는걸!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/016"
msgid "[클라우제비츠]/n작전 종료 후에/25d 모두 합류하도록 하겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/017"
msgid "[리델]/n훗,/20d 로우엔군 쯤이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/018"
msgid "[이자벨]/n요즘 대원들 사이에 소문난 이야기를 들었나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/019"
msgid "[에스메랄다]/n프리토리아라면…/30d 제 병원에도 들러볼 수 있겠네요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/020"
msgid "[실버]/n시라노,/15d 잘 기억해주세요./30d/n육지의 지리에는 쉽게 익숙해지지는 않는군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/021"
msgid "[카나]/n나는 다른 임무가 있어서 같이 가지는 못하겠어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/022"
msgid "좋아,/30d 카나와 함께 프리토리아로 가도록 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/023"
msgid "우리는/15d 이 근처를 좀 더 돌아보고 따로 움직이겠어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/024"
msgid "[이자벨]/n이 기지 지하에/30d 이상한 던전이 있다고 하는군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/025"
msgid "지난 임무였던/20d 실종된 리브레빌 마을 사람들의 구출은,/40d/n다행히 아무런 피해 없이 구출을 완수해 내/35d/n작전을 성공적으로 마쳤습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/026"
msgid "덕분에/30d 우리 제피르 팰컨에게/20d 큰 후원자가 생겼습니다만,/40d/n그 사이에/20d 프레데릭의 로우엔군이 움직인 모양입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/027"
msgid "[실버]/n프리토리아,/15d 멤피스,/25d 보르도…/45d/n한 번에 세 곳이라니!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/028"
msgid "[이자벨]/n혹시 좋은 창이라도 있다면,/50d 찾으러 가보는 것도 좋겠네요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/029"
msgid "[카나]/n목표를 잊으면 안돼요!/30d 프리토리아,/10d 멤피스,/15d 보르도…/25d/n기억하고 있죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/030"
msgid "[에스메랄다]/n출발 준비는 되었답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/031"
msgid "[실버]/n준비는 되셨나요?/35d/n저는 언제든지 출발할 수 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/032"
msgid "[크리스]/n저도 이제/20d 어엿한 제피르 팰컨 대원이죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/033"
msgid "[크리스]/n준비되셨으면 출발하시죠!/45d/n바로 따라 나가겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/034"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/035"
msgid "[카나]/n길을 잃지 않도록 조심해야 해요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/036"
msgid "[메디치]/n그나저나,/20d/n군사는 가끔씩 말없이 사라질 때가 있단 말이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/037"
msgid "[클라우제비츠]/n아마도/25d 긴 여정이 될 겁니다./35d/n길을 잃지 않도록 주의하세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/038"
msgid "[에스메랄다]/n프리토리아 사람들이 고통받는 일이 생기지 않기를…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/039"
msgid "요즘은/15d 계속 따로 다니게 되네요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/040"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/041"
msgid "[리델]/n내 창 앞에서는 별 거 아니지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/042"
msgid "[메디치]/n남몰래/25d 데이트라도 하고 있는 걸지도 모르겠군./30d/n하하하!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/043"
msgid "[클라우제비츠]/n지금까지/35d 프레데릭과 부딪힐 일은 피해왔지만,/40d/n이제는/25d 피할 수는 없겠군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/044"
msgid "[리델]/n당신도 힘에 부칠때는/30d 나한테 맡겨보라고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s02
msgctxt "field|re|art_fl11_s02|@kfl11_s02/045"
msgid "[크리스]/n…/45d로우엔군이라…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s04
msgctxt "field|re|art_fl11_s04|@kfl11_s04/000"
msgid "이상하군…/40d/n이곳이 합류 장소일 텐데."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s04
msgctxt "field|re|art_fl11_s04|@kfl11_s04/001"
msgid "진짜 이상하네?/35d/n메디치 오빠라면 몰라도,/25d 군사는 시간에 철저한 분인데."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s04
msgctxt "field|re|art_fl11_s04|@kfl11_s04/002"
msgid "엇?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s04
msgctxt "field|re|art_fl11_s04|@kfl11_s04/003"
msgid "저기/10d 누가 오고 있어요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s04
msgctxt "field|re|art_fl11_s04|@kfl11_s04/004"
msgid "[보르스]/n시라노 님!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s04
msgctxt "field|re|art_fl11_s04|@kfl11_s04/005"
msgid "[보르스]/n늦으셨군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s04
msgctxt "field|re|art_fl11_s04|@kfl11_s04/006"
msgid "다른 사람들은?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s04
msgctxt "field|re|art_fl11_s04|@kfl11_s04/007"
msgid "[보르스]/n클라우제비츠 님의 요청으로/30d/n모두 로우엔산 정상으로 향했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s04
msgctxt "field|re|art_fl11_s04|@kfl11_s04/008"
msgid "무슨 일이라도 있었나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s04
msgctxt "field|re|art_fl11_s04|@kfl11_s04/009"
msgid "[보르스]/n저도 자세히는 모르지만,/30d 프레데릭 장군이/15d/n로우엔산 근처에 있다고 하니/25d 관련이 있는 게 아닐까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s04
msgctxt "field|re|art_fl11_s04|@kfl11_s04/010"
msgid "프레데릭이라…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s04
msgctxt "field|re|art_fl11_s04|@kfl11_s04/011"
msgid "알겠네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s04
msgctxt "field|re|art_fl11_s04|@kfl11_s04/012"
msgid "흐음…/55d/n그럼/25d 우리도 로우엔산으로 가야겠군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s04
msgctxt "field|re|art_fl11_s04|@kfl11_s04/013"
msgid "그럼,/25d 출발하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s04
msgctxt "field|re|art_fl11_s04|@kfl11_s04/014"
msgid "음…/30d 다들 먼저 가세요./30d/n전 잠시 들를 곳이 있어서."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s04
msgctxt "field|re|art_fl11_s04|@kfl11_s04/015"
msgid "이따가 만나요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s07
msgctxt "field|re|art_fl11_s07|@kfl11_s07/000"
msgid "클라우제비츠,/40d 왜 여기서 모이자고 했소?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s07
msgctxt "field|re|art_fl11_s07|@kfl11_s07/001"
msgid "무슨 말씀입니까?/40d/n시라노 님께서/20d 이곳에서 합류하자고 말씀하신 게 아니었습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s07
msgctxt "field|re|art_fl11_s07|@kfl11_s07/002"
msgid "합류 장소를 바꾼게/50d 당신이 아니라고…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s07
msgctxt "field|re|art_fl11_s07|@kfl11_s07/003"
msgid "아…/55d 어째 예감이 안좋더라니…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s07
msgctxt "field|re|art_fl11_s07|@kfl11_s07/004"
msgid "이건 함정이다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s07
msgctxt "field|re|art_fl11_s07|@kfl11_s07/005"
msgid "이런 유치한 수작에 걸리다니…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s07
msgctxt "field|re|art_fl11_s07|@kfl11_s07/006"
msgid "뭐가 날아오고 있어요!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s07
msgctxt "field|re|art_fl11_s07|@kfl11_s07/007"
msgid "모두 엎드려!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s07
msgctxt "field|re|art_fl11_s07|@kfl11_s07/008"
msgid "프레데릭의 대포 부대입니다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s07
msgctxt "field|re|art_fl11_s07|@kfl11_s07/009"
msgid "!!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s07
msgctxt "field|re|art_fl11_s07|@kfl11_s07/010"
msgid "여기서는/20d 표적이 되기 십상입니다!/30d/n빨리 몸을 피하시지요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s07
msgctxt "field|re|art_fl11_s07|@kfl11_s07/011"
msgid "기지에서 합류하겠습니다! "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s08
msgctxt "field|re|art_fl11_s08|@kfl11_s08/000"
msgid "후후후,/75d 겁도 없이 덤벼들더니만/30d 이 정도의 함정에 걸리다니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s08
msgctxt "field|re|art_fl11_s08|@kfl11_s08/001"
msgid "제피르 팰컨 놈들,/45d 꽁지가 빠지게 도망가는군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s08
msgctxt "field|re|art_fl11_s08|@kfl11_s08/002"
msgid "장군님,/20d 어떻게 하시겠습니까?/25d/n추격대를 파견할까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s08
msgctxt "field|re|art_fl11_s08|@kfl11_s08/003"
msgid "그럴 필요는 없다./45d/n이 정도면 당분간 날뛰지 못할테지./50d 그냥 놔둬라."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s08
msgctxt "field|re|art_fl11_s08|@kfl11_s08/004"
msgid "장군님!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s08
msgctxt "field|re|art_fl11_s08|@kfl11_s08/005"
msgid "무슨 일인가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s08
msgctxt "field|re|art_fl11_s08|@kfl11_s08/006"
msgid "도주하는 제피르 팰컨 중에/35d 크리스티나 님으로 보이는/n사람이 있었다는 보고가 들어왔습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s08
msgctxt "field|re|art_fl11_s08|@kfl11_s08/007"
msgid "크리스티나가/30d 제피르 팰컨에?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s08
msgctxt "field|re|art_fl11_s08|@kfl11_s08/008"
msgid "하하하!/70d 정말 녀석답군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s08
msgctxt "field|re|art_fl11_s08|@kfl11_s08/009"
msgid "좋아!/30d 목적은 달성했다./35d/n전원 귀환 준비에 착수한다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s08
msgctxt "field|re|art_fl11_s08|@kfl11_s08/010"
msgid "예!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl11_s08
msgctxt "field|re|art_fl11_s08|@kfl11_s08/011"
msgid "예!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/000"
msgid "그래,/25d 프레데릭이 그냥 철수했다는 말이지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/001"
msgid "그렇습니다./40d/n제피르 팰컨 놈들을 쓸어버릴 수 있는 상황에서/55d/n군을 돌리더군요. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/002"
msgid "역시,/15d 프레데릭 공은…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/003"
msgid "쯧,/40d 일개 용병대장에 불과한 녀석을/30d/n이렇게까지 키워줬더니…/40d 은덕도 모르고…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/004"
msgid "이렇게 된 이상/20d 놈도 믿을 수 없겠군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/005"
msgid "크리스티나 아가씨를/25d 비프로스트에 시집보내는 일도/40d/n크게 반대하셨다고 들었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/006"
msgid "멍청한 놈이야./45d/n평생 딸과 함께 살 수 있으리라 생각하나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/007"
msgid "딸이란/30d 어차피 정략 수단의 하나일 뿐이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/008"
msgid "역시 비프로스트를 이용할 생각이시군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/009"
msgid "조세핀으로부터 연락은 있었나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/010"
msgid "모젤 2세는/30d 이미 조세핀에게 푹 빠진 모양입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/011"
msgid "방해 세력도/40d 각하께서 암흑살수를 파견하신 덕분에/50d/n대부분 제거되었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/012"
msgid "그럼, 이제는 자네가 좀 수고해 줘야겠군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/013"
msgid "비프로스트 군을 데려오라는 말씀이시군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/014"
msgid "하지만/30d 조금 위험하지 않겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/015"
msgid "괜찮아,/35d 모젤은 다루기 쉬운 인물이니./35d/n이 기회를 잘 이용하면/30d 비프로스트까지 손에 넣을 수 있다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/016"
msgid "프레데릭 공의 반발이/35d 만만치 않을 텐데요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/017"
msgid "걱정할 거 없어./35d/n그에 대해서는 이미 대책을 세워두었지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/018"
msgid "추기경 각하께서/30d 제국령을 통일하는 그날이,/50d/n한시라도 빨리 찾아오길 기원하겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/019"
msgid "우리의 대업을 이룰 날도/25d 이제 멀지 않았어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/020"
msgid "어리석은 인간들은/35d 우리의 위업을 이해하지 못하겠지만,/45d/n역사는 우리의 업적을 제대로 평가해 줄 걸세."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/021"
msgid "게이시르 대성당, 추기경 집무실"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/022"
msgid "그럼,/30d 저는 이만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/023"
msgid "이제…/30d 조금만 있으면/15d 나의 야망이 이루어진다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/024"
msgid "제피르 팰컨이나/15d 프레데릭 따위,/25d 비프로스트를 이용해 처리하면 그만이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/025"
msgid "제국의 세력을 하나로 합치기만 하면…/75d/n제국은/30d 안타리아 최고의 세력이 된다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/026"
msgid "하하하하…/80d 으하하하하…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/027"
msgid "그 패를 이용할 줄도 모르다니,/45d/n제국의 패자라는 이름이 아깝군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/028"
msgid "역시/20d 그러셨습니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/029"
msgid "제 12 장"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s01
msgctxt "field|re|art_fl12_s01|@kfl12_s01/030"
msgid "사상과 철학"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/000"
msgid "[카나]/n나도/15d 시라노와 같이 가고 싶은데…/50d/n정말 나 없이도 괜찮겠어요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/001"
msgid "[메디치]/n오랜만에/15d 팀의 리더로 활약할 수 있겠군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/002"
msgid "[클라우제비츠]/n마키아벨리는/20d 뛰어난 학자입니다./35d 하지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/003"
msgid "[보르스]/n…/15d부대원들 사이에서도/35d 에스메랄다 님을/n응원하는 사람들이 많던데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/004"
msgid "[루이]/n꼭/15d 임무를 성공시켜 주십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/005"
msgid "[리델]/n쳇…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/006"
msgid "[리델]/n너와 함께 출동하게 되다니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/007"
msgid "[카나]/n그래도/15d 보물 찾기라니,/25d 조금 설레네!/15d 헤헷."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/008"
msgid "[클라우제비츠]/n비프로스트 접경의/20d 망티고아 산에는/35d/n유니콘의 정령이 봉인된 동굴이 있다고 합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/009"
msgid "[이자벨]/n이번 일은 잘 부탁하지요./35d/n꼭 성공해 주시길 바랍니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
msgctxt "field|re|art_fl12_s02|@kfl12_s02/010"
msgid "[이자벨]/n당신의 실력을 무시할 정도로/15d/n삐뚤어진 사람은 아니예요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
