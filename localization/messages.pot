msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/001"
msgid "실례합니다./40d/n이 배가 다카마행 배 맞습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/002"
msgid "[선장]/n다카마행 배는 맞지만,/35d 출항은 연기되었소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/003"
msgid "연기라니요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/004"
msgid "[선장]/n하,/15d 말도 마시오./40d/n나도 분통이 터지지만,/40d 요새 해적이 너무 많이 출몰해서/45d/n당분간 다카마 항으로는 출항 금지요. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/005"
msgid "[선장]/n그깟 해적 놈들 때문에/25d 항로를 봉쇄하는 게 말이나 되나!/50d/n이게 다 시장 그놈이/25d 날 싫어하기 때문이라고!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/005_2"
msgid "[ 선장 ]/n그까짓 해적놈들 때문에/n이 항로로 출항 할 수 없다니 말이나 되나! "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/005_3"
msgid "[ 선장 ]/n그까짓 해적놈들 때문에 이 항로로 출항 할 수 없다니 말이나 되나! "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/006"
msgid "그럼/25d 언제쯤이면 출항할 수 있겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/007"
msgid "[선장]/n나도 모르지./35d/n그 시장 놈의 집을 다 때려 부수고/25d/n새로 시장을 선출하면 모를까!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/007_2"
msgid "[ 선장 ]/n그건 나도 모르오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/007_3"
msgid "[ 선장 ]/n그건 나도 모르오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/008"
msgid "항해의 허가를 내리는 것은 사이럽스 시장의 고유권한이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/009"
