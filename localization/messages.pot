#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/000"
msgid "/2c비프로스트 궁. 죠세핀의 방."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/001"
msgid "오랜만이군, 죠세핀."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/002"
msgid "호호, 당신도 여전하군요. /15d학자나리!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/003"
msgid "정말로 체사레 각하의 안목은 대단해./15d /n한낱 시골농부의 딸에 불과했던 당신을 이렇게 변신시켜 놓다니."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/004"
msgid "흥, 우린 서로 거래를 할 뿐이예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/005"
msgid "당신들은 당신들이 원하는 것을 얻고, 나는 내가 원하는 것을 얻을 뿐이죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/006"
msgid "그건 그렇고, 일은 잘 되어가고 있나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/007"
msgid "걱정 말아요. 공왕은 이미 뜻을 굳혔어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/008"
msgid "오오, 그럼 제국으로 병력을 파견하겠다는 뜻인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/009"
msgid "사실, 공왕은 어려서 제국에 수모를 당했던 장본인이죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/010"
msgid "원로원 늙은이들의 보수주의에 가로막혀 그동안 참고 있었지만, 당신들이 보낸 살수가 고위 원로들을 제거한 지금 /15d장애물은 아무것도 없는 셈이지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/011"
msgid "좋아. /10d그럼 내일 회담은 어렵지 않겠군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/012"
msgid "그런데, 지난번에 발굴한다던..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/013"
msgid "아스카론 말씀이시군요. /15d /n그건 아직 멀었어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/014"
msgid "위치는 대충 찾은것 같은데 발굴에 엄청난 시간과 인원이 투입되어야 한다나요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/015"
msgid "뭐, 비프로스트의 대군이라면 궂이 마장기까지도 필요 없겠지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/016"
msgid "발키리들이 동원된다면 제피르팰컨이나 프레데릭의 대포부대정도는 간단히 처리할거예요"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/017"
msgid "오히려, 그들에게 제국을 모두 빼앗기지나 않도록 노력해야 할걸요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/018"
msgid "후후, 그 점에 대해서는 추기경 각하께서도 이미 복안을 준비해두셨지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/019"
msgid "그럼 나는 이만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/020"
msgid "..../10d당신 말대로군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/021"
msgid "호호호, /15d비프로스트의 파병이 곧 제국의 멸망으로 이어질 것을 모르는/30d 녀석들이 불쌍하군요"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/022"
msgid "후후, 이번 파병은 제국 추기경의 요청으로 이루어 지는 것이니 팬드래건에서도 어쩔수 없을껄."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/023"
msgid "중립국을 표방한 우리로서는 더없이 좋은 기회지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/024"
msgid "하지만, 체사레 추기경은 만만하게 볼수만은 없는 인물이예요. /15d /n공왕폐하도 조심해야 할걸요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/025"
msgid "하하, 내가 그렇게 우습게 보이나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/026"
msgid "어디,/10d 내가 그렇게 우스운 인물인지 보여줄까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s07
msgctxt "field|ko|art_ko_fl12_s07|@kfl12_s07/027"
msgid "호호호..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/000"
msgid "/2c비프로스트 궁. 객실."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/001"
msgid "음..?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/002"
msgid "마키아벨리!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/003"
msgid "마키아벨리!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/004"
msgid "뭐하는 놈들이냐! "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/005"
msgid "우리는 제피르팰컨이다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/006"
msgid "이 곳까지 찾아올 줄이야.../n정말 대단한 놈들이군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/007"
msgid "이렇게까지 된 이상 별 도리가 없지. /n나는 학자에 불과해./30d 저항할 수 없으니 마음대로 해라."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/008"
msgid "흥, 그렇게 나오면 목숨을 부지할 수 있을줄 알았나? /n고통없이 저 세상으로 보내주지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/009"
msgid "잠깐!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/010"
msgid "왜 그래?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/011"
msgid "마키아벨리, 나를 알아보겠는가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/012"
msgid "내가 반란군 나부랑이를 알아볼리가 있으리라고 생각하나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/013"
msgid "하긴, 벌써 15년이 지났으니..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/014"
msgid "나는 한때 시라노 번스타인이라 불리우던 사람일세."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/015"
msgid "시라노라고! /n설마... 자네가 아직 살아있다니..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/016"
msgid "후후, 악운이 강한 모양이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/017"
msgid "그러나 절친한 친구였던 자네가 체사레의 수족이 되어 움직이는걸 보면 별로 유쾌하지는 않군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/018"
msgid "나는 학자일세. 우정이나 친분보다는 자신의 사상에 따르는것이 중요하지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/019"
msgid "나는 나의 철학에 따라 체사레 각하를 따르고 있네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/020"
msgid "체사레의 철학이라고? 음모를 꾀해 자기 친구의 아들에게 누명을 씌우는것?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/021"
msgid "자신의 딸을 권력을 잡기위한 도구로 이용하는것?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/022"
msgid "아니면, 이렇게 조국에 외세를 끌어들이는 것을 말하는것인가? 마키아벨리!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/023"
msgid "제국은 지금 황제가 없네. /n그렇기 때문에 더욱 각하같은 분이 필요한 것이네. /n모든 사적인 감정을 죽이고 잔혹할 정도의 수단을 강구해서라도 제국을 통일하고 평화를 되찾을 군주가 필요하단 말이네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/024"
msgid "지금으로서는 제국을 통일할 수 있는 인물은 체사레 각하밖에 없다는걸 자네도 잘 알텐데."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/025"
msgid "역사는 어느 개인의 손에 좌우되는 것은 아니야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/026"
msgid "어째서, 제국이 그를 위해 통일되어야 하지? 어째서 수많은 사람들이 그를 위해서 피를 흘려야 하냔 말이다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/027"
msgid "역사는 스스로 흘러가는 법이 아닌가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/028"
msgid "물론 시간이 흐르고, 수십년, 수백년이 흐르면 지금과 같은 제국의 혼란은 진정되겠지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/029"
msgid "하지만, 그 사이에 얼마나 많은 사람들이 희생되어야 하나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/030"
msgid "또, 얼마나 많은 전쟁이 벌어져야 하지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/031"
msgid "현세의 사람들은 체사레 각하를 비난할지도 모르지만, 후대의 역사가는 체사레 각하 덕분에 수많은 사람들의 고통이 짧아졌음을 감사할 것일세."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/032"
msgid "빨리 서둘러야 해요. 발키리들이 포위망을 완성하면 빠져나갈 수 없다구요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/033"
msgid "저런 녀석은 빨리 처치하고 도망갑시다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/034"
msgid "나는 학자로서의 신념에 충실했을 뿐. /n오늘 명이 다해 죽어간다 해도 나에게 여한은 없다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/035"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/036"
msgid "좋아, 마키아벨리. /n오늘만은 너를 용서해 주겠다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/037"
msgid "대신 체사레에게 전해라."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/038"
msgid "이 시라노가 그 썩은 목을 받으러 갈것이라고."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/039"
msgid "이 녀석을 살려둘 생각이오?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/040"
msgid "부탁하네. /n이 자는 죽이기에 너무 아까운 사람이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s08
msgctxt "field|ko|art_ko_fl12_s08|@kfl12_s08/041"
msgid "자, 어쨌든 빨리 이곳을 빠져나가자구요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s01
msgctxt "field|ko|art_ko_fl13_s01|@kfl13_s01/000"
msgid "/2c로우엔. 프레데릭의 집무실."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s01
msgctxt "field|ko|art_ko_fl13_s01|@kfl13_s01/001"
msgid "장군님!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s01
msgctxt "field|ko|art_ko_fl13_s01|@kfl13_s01/002"
msgid "무슨일인가."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s01
msgctxt "field|ko|art_ko_fl13_s01|@kfl13_s01/003"
msgid "비프로스트가..대군을 이끌고 제국령을 넘어왔다고 합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl13_s01
