msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/140"
msgid "마지막장 : 필살기"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/141"
msgid "[이올린]/n안타리아를 대표하는 검술에는 크게 두 가지/n줄기가 있다네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/142"
msgid "[이올린]/n팬드래건 왕국을 중심으로 한 검법과 게이시르 제국을/n중심으로 한 검법. 왕국 검법과 제국 검법이라고 하는데,/n왕국 검법은 속도를, 제국 검법은 힘을 중요시한다네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/143"
msgid "[이올린]/n제국 검법의 필살기는 적의 가드를 힘으로 뚫고/n일격 필살을 노린다면, 왕국 검법의 필살기는 적의/n의표를 찌르는 빠른 연속 공격으로 적을 제압하는 것이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/144"
msgid "[이올린]/n학자였던 자네가 사용하기에는 힘보다 기술을 중요시하는 왕국 검법이 유리할걸세."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/145"
msgid "[이올린]/n일단 왕국 검법의 기본 필살기라 할 수 있는 진공수라인을 예로 들어 보겠네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/146"
msgid "[이올린]/n진공수라인을 비롯한 각종 필살기를 사용하려면,/n그에 상응하는 기력(XP)이 필요하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/147"
msgid "[이올린]/n기력은 마법을 사용하는데 필요한 마력과도 비슷하지만, 적을 쓰러트릴 때마다 조금씩 상승하고 공격력과 방어력도 그에 비례해 상승한다네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/148"
msgid "[이올린]/n기력은 필살기를 사용한다고 줄어드는 것은 아니지만,/n기력이 충만해진 상태에서는 몸이 오래 버티기 힘들기/n때문에 일정 시간이 지나면 자연히 기력은 소멸될걸세."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/149"
msgid "[이올린]/n필살기의 수준에 따라 필요한 기력에 차이가 있으니,/n다른 필살기는 실전을 겪으며 익혀보게나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/150"
msgid "[이올린]/n그리고… 이건 내가 옛날에 쓰던 검이야./n언젠가 자네에게 도움이 될 걸세."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/151"
msgid "이올린에게 <color=#6EFDFF>낡은 엑스칼리버</color>를 받았습니다."
msgstr ""

