msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/050_3"
msgid "그런 그녀가 또한 마을 여자 전체의 선망의 대상이었던 휴 하고 결혼한다고 발표를 했을 때 얼마나 많은 말이 있었는지..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
