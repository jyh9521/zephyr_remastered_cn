msgctxt "field|ko|art_ko_fltzy03|@kfltzy03/008"
msgid "난 단지 내 개인적인 복수를 위해서 이 집단에 몸을 담고 있을 뿐이야. 제국의 국민을 위해? 흐흐흐..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltzy03
