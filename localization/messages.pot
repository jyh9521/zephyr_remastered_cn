msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/042"
msgid "그런데도 강물은 계속 흘러요. 이상하죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/043"
msgid "우리 부모님은 또 싸웠어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/044"
msgid "항상 싸운 다음에는 저보러 누가 옳으냐고 물어보는 것 있죠. 정말이지 괴로워요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/045"
msgid "손님, 그리로 들어오시면 안됩니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/046"
msgid "[샤론]/n이쪽, 저쪽을 둘러봐도 사람들이 보는것은 가수로서의 샤론이지 나 자신은 아니죠... 싸인도 마찬가지에요. 사람들은 오로지 무대에서 노래부르고 춤추는 샤론을 원할 뿐이라고요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/047"
msgid "... 그렇죠. 사람들은 바로 그런것을 원하고 있죠. /30d하지만 /20d 하지만, 당신은 사람들이 당신에게서 원하는 것이 있다는 것이 얼마나 큰 행운인지 모르겠단 말입니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/048"
msgid "당신은 어떤 곳에서라도 당신을 필요로 하는 사람을 볼 수 있으며, 당신을 소중히 여겨주는 사람을 만날 수 있다는 말입니다. 누군가가 당신에게 뭔가를 원하고, 특히 당신으로부터 기쁨을 얻는 다는 것은 당신에게 신이 내린 축복이 아닐까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/049"
msgid "[샤론]/n....나를 필요로 하는 사람들... 그래. 그런 사람들이 있지..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/050"
msgid "[샤론]/n그래요. 나는 샤룐, 샤론 인데리카지요. 사람들의 우상. 무대위의 요정. 그것이 난 거에요, 다른 어떤 것도 아닌. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/051"
msgid "[샤론]/n당신... 싸인을 받고 싶다고 했었나요? 싸인을 해 드릴께요, 이리 싸인북을..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/052"
msgid "샤론의 싸인을 얻었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/053"
msgid "이거, 정말 감사합니다. 이 싸인을 부탁한 꼬마아가씨가 정말 좋아하겠군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/054"
msgid "[샤론]/n그래요... 나도 팬이 필요하고, 팬도 내가 필요한 것이지요... 저야말로 고마와요. 그럼, 안녕히."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/055"
msgid "[샤론]/n그래요... 나는 샤론, 나의 노래를 사랑하는 사람들이 불러주는 \"샤론\"이죠. 좀 더 용기를 내서 해 볼꺼에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/000"
msgid "어서오세요./10d 우리 주점의 술맛은 세계 제일입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/000_3"
msgid "어서오세요. 우리 주점의 술맛은 세계 제일입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/001"
msgid "우리마을에는 유명한 여의사 에스메랄다 님이 살고 계신답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/001_3"
msgid "우리마을에는 유명한 여의사 에스메랄다님이 사십니답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/002"
msgid "우리 주점은 산골짜기에서 나는 광천수로 술을 만들기 때문에 그 어느 곳에서도..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/003"
msgid "남탱이바부"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/004"
msgid "프리토리아 마을"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/005"
msgid "[ 조지 ] /n어서오십시오. 무엇을 도와드릴까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/006"
msgid "무기점 '갈색의 폭풍'"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/006_3"
msgid "무기점 갈색의 폭풍"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/007"
msgid "저희 가게를 이용해 주셔서 감사합니다. 다음에 또 오세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/008"
msgid "[ 미스 바튼 ]/n 어서오세요, 저희는 반지 전문 입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/008_3"
msgid "[ 미스 바튼 ]/n 어서오세요, 유명한 에스메랄다 님이 계신 마을에 잘 오셨습니다. 무엇을 도와드릴까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/009"
msgid "약국 '성녀의 지팡이'"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/010"
msgid "안녕히 가세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/010_3"
msgid "안녕히 가세요. 저희 가게에 들러 주셔서 감사합니다. 에스메랄다 님의 축복이 있기를."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/011"
msgid "[ 헤이든 양 ]/n어서오세요. 저희 여관에 오신것을 환영합니다. 저희 여관의 가격은 95ELD입니다. 묵으시겠습니까? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/011_3"
msgid "[ 헤이든 양 ]/n어서오세요. 저희 여관에 오신것을 환영합니다. 묵으시겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/012"
msgid "감사합니다. 편안한 밤 되세요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/013"
msgid "그럼, 다음에 들려주세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/013_3"
msgid "그럼, 다음 기회에..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/014"
msgid "저희 여관을 이용해 주셔서 감사합니다. 다음에 또 이용해 주세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/014_3"
msgid "저희 여관을 이용해 주셔서 감사합니다. 그럼 이만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/015"
msgid "사실, 이곳에 이 물과 에스메랄다 님이 아니면 이 마을에 사는 보람이 없지..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/016"
msgid "전에 우리 마을에 사는 일가족이 마을 밖으로 도망 갔어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/017"
msgid "마녀 재판의 위기였기 때문이었기도 하지만, 그 집의 부인이 라몬 자작의 눈에 뜨인것이 가장 큰 원인이었죠..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/017_3"
msgid "마녀 재판의 위기였기 때문이었기도 하지만, 그 집의 부인이 라몬 자작의 눈에 뜨인것이 가장큰 원인이었죠..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/018"
msgid "난, 결코, 절대로, 이따위 세상을 그냥 놔두지 않겠어! "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/018_3"
msgid "난, 결코, 절대로, 이따위 세상을 그냥 놔두지를 않겠어! "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/019"
msgid "우리 친척 일가가, 라몬 자작의 손에서 도망가기 위해 이 고장을 버렸다... 지금은 생사도 몰라. 왜, 왜 힘이 없는 사람은 당해야 하지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/020"
msgid "난... 난 정말로 힘 있는 놈들이 싫어!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/021"
msgid "당신은... 누구? 나는... 누구? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/022"
msgid "아아.... 머리가. 머리가 아파."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/023"
msgid "라몬자작의 여성편력은 유명하지요. 도대체 이 마을에 에스메랄다님이 안계시다면 어떤 마을이 될지...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/023_3"
msgid "라몬자작의 여성편력은 유명하지요. 도데체 이 마을에서 에스메랄다님이 안계시다면 어떤 마을이 될지...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/024"
msgid "얼마 전에도 일가족이 라몬 자작을 피해 도망쳤답니다. 라몬 자작은 군대로 그 일가의 뒤를 쫓았죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/024_3"
msgid "얼마 전에도 일가족이 라몬 자작을 피해 도망쳤답니다. 라몬 자작은 그 일가를 군대로 뒤를 쫓았죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/025"
msgid "이 길로 가끔 고급 귀족의 마차가 지나곤 합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/025_3"
msgid "이 길로 가끔가다 고급 귀족의 마차가 지나가곤 합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/026"
msgid "우리 마을은 예로부터 경관이 수려하기 때문에 많은 귀족들이 서로 영주가 되려 하는 고장이죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/026_3"
msgid "우리 마을은 예로부터 경관이 수려하기 때문에 많은 귀족들이 서로 영주가 되려고 하는 고장이죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/027"
msgid "이곳이 이번 작전의 목표중 하나인 프리토리아이다./n어서 저택을 공격하도록 하자."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/028"
msgid "블랙, 블랙, 블랙"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/029"
msgid "레드, 레드, 레드"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/030"
msgid "하하하!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/031"
msgid "후후후... 나도 과거에는 칼 좀 썼었지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/031_3"
msgid "후후후... 나도 과거에는 칼 좀 썼었지. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/032"
msgid "칼을 다룰때 중요한 것은, 무기에 집착하면 안된다는 것일세. 무기는 어디까지나 검술을 위한 도구일뿐 그 목적이 아니야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/032_3"
msgid "칼을 다룰때 중요한 것은, 무기에 집착하면 안된다는 것일쎄. 무기는 어디까지나 검술을 위한 도구일뿐 그 목적이 아니야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/033"
msgid "궁극적으로 칼이 없어도 검술을 펼칠 수 있는 것이 경지 아니겠나! 무기에 연연하지 말게나!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/034"
msgid "외국어를 할 때는 그 나라 사람처럼 생각하고 말해야 해요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/034_3"
msgid "외국어를 할 때는 그사람 처럼 생각하고 말해야 해요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/035"
msgid "요사이 점점 투르족의 말을 배우는 사람이 늘어나고 있어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/036"
msgid "그 쪽과도 언젠가는 전쟁이 끝날 테고, 그렇게 되면 투르족의 말이 필요하게 될 테지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/036_3"
msgid "그쪽과도 언젠가는 전쟁이 끝날 거고, 그렇게 되면 투르족의 말이 필요하게 될 것 같군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/037"
msgid "도망치지 말아요. 도망치는 것은 문제를 해결 할 수 없어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/038"
msgid "우리 마을의 영주님은 상당히 이상한 분이시라.... 이 곳에서는 살기 어렵다는 것이 진실이죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/038_3"
msgid "우리 마을의 영주님은 상당히 이상한 분이시라.... 이곳에서 살기는 정말 어렵다는 것이 진실이지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/039"
msgid "고무줄을 너무 오래 당기고 있었더니 끊어져 버렸어요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/040"
msgid "그 고무줄이 제 다리를 쳤는데, 눈물이 쏙 빠질 정도로 따끔했어요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/041"
msgid "이문은 안에서 잠겨있는 것 같다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/041_3"
msgid "이 집은 아무도 없는 것 갈다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/042"
msgid "[ 실리아 ]/n어서오세요. 우리 상점에서 찾으시는 물건이 있나요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/043"
msgid "저희 마을에 오신것은 행운입니다. 안녕히 가세요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/044"
msgid "라몬자작은 자신의 저택 2층에 막대한 재보를 모아 놓았다고 하던데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/045"
msgid "혹자는 그 특성에 따라 세검과 중검으로도 구분하는 모양입니다만.... 어찌되었든 살아남기 위해서라면 세검보다 중검이 좋지요. 세검을 사용하면, 이쪽이 때리는 것 만큼이나 공격당할 위험이 높으니까, 여간한 레벨이 아니고는 전투에서 살아남기가 힘들지요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/046"
msgid "Chry. 기리엄이나 바스타드 소드 같은 중검류의 무기를 사용하는 것이 당신의 목숨부지에 도움을 줄 것입니다. 특히나 강한 적과 맞붙게 된다면 말이죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/047"
msgid "검은 크게 방어형,공격형으로 나뉩니다.방어형은 칼의 내구성은 뛰어나지만, 공격력이 약하고,반대로 공격형은 쉽게 망가지는 반면, 공격력이 상당히 세지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/048"
msgid "대표적인 방어형 검은 Chry.기리엄과 바스타드 소드입니다. 그리고 대표적인 공격형 검은 카산드라와 그람입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/049"
msgid "바스타드 소드는 상당히 튼튼하기 때문에 유지비가 적게드는 것이 장점이지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/050"
msgid "그람은 공격력은 강력하지만 내구성이 약해서 상당한 유지비를 감수해야 합니다. 게다가 전투중 아군의 체력소모도 심하게 되서 회복약도 상당히 필요하지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/051"
msgid "저, 이런 이야기 아세요? 얼마전에도 뛰어난 검사가 용의 굴을 탐험하러 들어갔었는데, 도중에 무기가 망가져서 결국...살아서 돌아오지 못했데요. 역시 무기는 튼튼한게 가장 좋은걸까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/052"
msgid "그람은 쓰는이에 따라 최강의 검으로 바뀔 수 있습니다. 비록 세검이라 방어는 힘들고, 날이 쉽게 빠지지만 위력은 유명한 명검들 못지 않거든요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/053"
msgid "우리 학술원 산하 검 연구회 사람들은 점점 잊혀져가는 무기인 검의 매력을 사람들에게 알리고 그것을 연구하는데 모든 정열을 바치고 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/054"
msgid "- 학술원 산하 무기연구회 공식 집회장소 -"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/055"
msgid "전투에서 중요한 것은 적을 죽이는 것이 목적이 아니라, 내가 살아남는 것이지요. 갑옷류가 유명무실해진 지금에 와서 몸을 지키는 것은 검에 달려있답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/056"
msgid "세검류는 통쾌한 공격력을 자랑하긴 하지만, 자신의 HP에 상당한 부담을 안고 싸우게 됩니다. 목숨을 걸고 싸우는 것이라 할까요...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/057"
msgid "게다가 세검은 내구도가 약해서, 치열한 전투가 연속적으로 발생하게 되면 다 부숴져 적과 맨손으로 싸워야 하는 경우가 생길지도 몰라요. 그런 경우는 자살행위와 같지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/058"
msgid "게이시르 학술원산하 제국지리학회 지부가 이 마을 서쪽에 있음"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/059"
msgid ""
"프리토리아: 중급의 마을. 비교적 싼 물가. 유명한 여의사 에스메랄다의 고장. 이 근처의 산은 지형이 복잡하고 넓은 것으로 유명하다. 또한 유명한 피닉스의 동굴이 근처에 있으나 위험한 장소이기 때문에 정확한 위치는 밝혀두지 않는다. 단, 피닉스의 동굴 내부에서는 화염계열 최강마법을 구할"
" 수도 있다고 한다./n- 게이시르 학술원 산하 제국지리학회 -"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/060"
msgid "서부에 있는 지리학회 사람들을 본 적이 있어요? 허구한날 지도만 보고 다니는 이상한 사람들이랍니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/061"
msgid "세상에, 그렇게 할일이 없는 사람들도 밥을 먹고 살고 있다니... 우리는 뼈빠지게 일해야 근근히 먹고살 수 있는데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/062"
msgid "이게 다 흑태자님이 돌아가신 이후에 이 제국이 살만하지 못한 곳이 되었다는 증거에요. 우리도 강력한 지도자가 이곳을 다시 통일하길 원해요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr01
msgctxt "field|ko|art_ko_fltpr01|@kfltpr01/063"
msgid "-프리토리아 마을 안내-/n주점:서북쪽/n아이템상점:서쪽/n여관:동북쪽/n무기상점:동쪽/n에스메랄다님의 병원: 마을 서부/n제국지리학회: 마을 서부"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/000"
msgid "우리마을에는 에스메랄다 양의 진료소가 있지요. 그 유명한... 왜 아시죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/001"
msgid "옛날부터 많은 사람들의 그녀의 아름다움을  혹은 진정한 봉사정신을 보기 위해서 오곤 했답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/002"
msgid "그녀는 정말로 '성녀' 그 자체지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/003"
msgid "훗, 아무리 생각해봐도 이 고장은 멋진 고장이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/004"
msgid "경치좋고, 여인들 아름답고... "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/005"
msgid "아예 이 곳에서 눌러살까 ?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/006"
msgid "큰일이에요, 요새는 정말 물가가 많이 올라가고 있어요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/007"
msgid "가뜩이나 먹고 살기 힘든데... 이 단벌옷이라도 팔아야 할 것 같아요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/008"
msgid "아이... 우리 오빠는 굉장히 아가씨들 한테 인기가 많아요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/009"
msgid "오빠는 에스메랄다님의 집에서 의사수업을 받고 있었답니다. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/010"
msgid "에스메랄다 님은 정말 천사같으세요! 목소리도 그렇고, 모습도 그렇고, 더군다나 아픈사람들을 고쳐주시잖아요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/011"
msgid "나도 이담에 커서 에스메랄다 님과 같은 의사가 되고 싶어요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/012"
msgid "에스메랄다님, 오랜만에 오시는 군요. 병원은 별일 없습니다. 더이상 진료를 하지 않으니까, 별로 관리할 일은 없네요...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/012_3"
msgid "이곳은 에스메랄다 님의 병원입니다. 무슨 용건이십니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/013"
msgid "우리 어머니 아버지는 얼마전에 같이 하늘나라로 떠나셨데요. 삼촌이 그러셨어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/014"
msgid "내가 삼촌한테 나도 어머니 아버지가 있는 곳으로 가고 싶다고 했더니 막 혼났어요. 삼촌 미워요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/015"
msgid "어른들은 이상해요. 왜 꼭 우리들이 하려고 하는 일을 못하게 막는 것이지요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/016"
msgid "저애 부모들은 라몬자작 손에 의해서 죽었다고 해도 과언이 아니죠. 불쌍하게도..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/017"
msgid "하지만, 난 결혼도 하기 전인데 애를 떠맡게 되었으니.... 정말 빌어먹을 세상이에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/018"
msgid "왜 저런 아이를 놔두고 부모가 세상을 떠야 하는 것일까요? 과연 있는 자들은 없는 자들을 마음껏 괴롭히고 심지어 죽여도 된다는 것인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/019"
msgid "에스메랄다 님은 정말 신의 현신이라는 말이 옳은 것 같아요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/020"
msgid "그 인물에, 마음씨도 고우시고 게다가 돈이 없는 사람은 무료로도 치료해 주시지 않아요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/020_3"
msgid "그 인물에, 마음씨도 고우시고 게다가 돈이 없는 사람은 무료료도 치료해 주시지 않아요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/021"
msgid "우리마을에 지도를 대단히 좋아하는 사람들이 있어요. 저도 지도를 굉장히 좋아하는데...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/021_3"
msgid "우리 아버지는 저 아랫마을에 가셨어요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/022"
msgid "전설적인 지리학자 라르고 씨에 대해서 들어본 적이 있나요? 그는 실버애로우 사람이면서도 후생을 구 제국령에서 보내면서 제국령 지도제작에 몸을 바친사람이랍니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/022_3"
msgid "나쁜 사람이 들어오지 못하게 문을 닫아 놓으시라고 하셨는데... 왜 닫아 놓지 않았을까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/023"
msgid "사실상 제국에 알려진 지도의 초안은 그사람이 잡았다고 해도 과언이 아니죠. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/023_3"
msgid "설마 늑대는 아니시겠죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/024"
msgid "에스메랄다님의 제자분들은 지금 전원 고향에 내려가서 선생님의 뜻을 실현라고 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/024_3"
msgid "에스메랄다님의 부재로 이곳은 더이상 진료를 하지 않습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/025"
msgid "단지, 선생님의 제자분들이 전국에 흩어져서 봉사활동을 펼치고 있으니 가장 가까운 곳을 가시면 되요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/026"
msgid "지금은 비록 안계시지만... 그 자비의 정신은 아직도 계속되고 있답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/027"
msgid "이게 다 게이시르 전역이 불안해 져서 그래요. 제피르팰컨은 왜 전국을 불안하게 하고 있는 것이죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/027_3"
msgid "이게 다 게이시르 전역이 불안해 져서 그래요. 제피르 팰컨은 왜 전국을 불안하게 하고 있는 것이죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/028"
msgid "지금은 더이상 이곳에 없어요. 선진의술을 배우기 위해서 팬드래건으로 유학갔답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/029"
msgid "어제 우리 학교에서 아이들이 단체로 수업을 빠졌지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/030"
msgid "학생회장의 지도하에 전체가 다 궐기했답니다. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/031"
msgid "그렇지만 오늘 가서는 상당히 크게 혼났지요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/032"
msgid "에스메랄다 선생님, 몸은 건강하십니까? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/032_3"
msgid "저는 에스메랄다님의 병원의 간호사입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/033"
msgid "다른 친구들은 전부 지방으로 돌아갔습니다. 모두 잘 도착해서 잘 지내고 있다는 연락이 왔습니다. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/033_3"
msgid "다른 친구들은 전부 지방으로 돌아갔지요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/034"
msgid "저는.... 저는.... 선생님이 이 마을로 돌아오실 때 까지 이곳에서 기다리고 있겠습니다. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/034_3"
msgid "저는, 언젠가 그분이 다시 이곳을 열 때 까지 여기에 있을 생각입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/035"
msgid "어서오세요, 에스메랄다님. 함께계신 분들에게는 특별히 싼 값에 물건을 드릴께요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/035_3"
msgid "이전에 에스메랄다님이 사용하시던 약을 처분한답니다. 하나 골라보시겠어요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/036"
msgid "병원자매 약국"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/036_3"
msgid "에스메랄다 병원"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/037"
msgid "안녕히 가세요, 에스메랄다님. 몸조리 잘 하시고요.... 언젠가 돌아오실날을 기다리고 있겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/037_3"
msgid "안녕히 가세요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/038"
msgid "돈 벌기는 정말로 쉽지는 않지..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/039"
msgid "진정으로 생활력이 강한 사람들은 일을 가리지 않고 하지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/040"
msgid "이 근처에는 제피르팰컨 기지가 있소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/040_3"
msgid "이 근처에는 제피르 팰컨 기지가 있소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/041"
msgid "제피르 팰컨 기지 아래쪽에 있는 숲은 옛날부터 이상한 일이 많이 있기로 유명했지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/042"
msgid "이 근처에는 옛날부터 상당히 많은 동굴들이 있지요. 동굴마다 많은 전설이 내려오는데, 그 전설이 하나같이 보물에 관련된 것이랍니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/043"
msgid "손님, 그리로 들어오시면 안됩니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/044"
msgid "에스메랄다님의 제자분들은 지금 전원 고향에 내려가서 선생님의 뜻을 실현하고 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/045"
msgid "에스메랄다님의 제자분들은 지금 전원 고향에 내려가서 선생님의 뜻을 실현하고 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/046"
msgid "돈을 벌기 위해서는 어떤 일이라도 하겠다는 듯이 덤벼들어... 정말이지 이 동네는 너무 가난해."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/047"
msgid "제국지리학회 프리토리아 지부/n지리에 어두운 모든 사람을 도와드립니다. 저희는 공공기금으로 운영되는 \"제국학술원\"재단산하 소속입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/048"
msgid "구제국령을 길을 잃지않고 다니기 위해서는 역시 숲의 길을 파악하는 것이 중요하지. 숲의 길만 파악하면 제국의 지리를 반을 알았다해도 과언이 아니야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/049"
msgid "단적으로, 로우엔과 보르도 사이의 숲은 남북으로는 도시와 연결되어 있지만, 오른쪽으로 빠지게 되면 마검숲이란 미로숲으로 빠지게된단 말이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/050"
msgid "게이시르와 로우엔 사이는 상당히 복잡한 숲이 놓여져 있다네. 게이시르 숲은 표지판도 적은 편이고, 더군다나 동쪽으로는 니코시아 남으로는 멤피스랑 연결이 되고, 서쪽으로 가면 로우엔 방향이기는 하지만, 중간에 다시 산을 건너야 하지. 상당히 어려운 길이야..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/051"
msgid "카라카스 근처의 숲의 특징은 상당히 많은 지방과 연결이 된다는 점에 있습니다. 북쪽으로는 리브레빌, 남으로는 게이시르 시티, 동으로는 파로마을과 트리시스 사막이 있고 서쪽으로는 이곳, 프리토리아와 통하지요. 한마디로 게이시르시티 북부의 교통의 요지라고 생각하시면 될 거에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/052"
msgid "따라서 카라카스 근처의 숲에서는 갈림길에서 갈려 나가는 모든 길이 각각 다른 지방으로 통하는 길이라고 생각하셔도 무방합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/053"
msgid "카라카스에서 나와 계속 남쪽으로만 가면 파로가 나오고, 남쪽으로 가다가 서쪽으로 꺾은다음 다시 남쪽으로 가면 게이시르 시티가, 남쪽으로 가다가 서쪽으로, 그리고 다시 북쪽으로 가서 동북쪽으로 가면 리브레빌 지방으로 가게 되죠. 물론, 카라카스와 이곳 프리토리아 사이 길은 아시겠지요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/054"
msgid "우리 마을에서 나가셔서 계속 북쪽으로 가시면 피닉스 동굴을 발견할 수 있을 것입니다. 그 유명한..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/055"
msgid "마을에서 나가 서쪽으로 가다가 남서쪽으로 꺾어지면 드래건 브레스 산맥 남단으로 접어들지요. 그곳은 예로부터 많은 저항세력들이 있던 곳입니다. 또한 드레건 브레스 산맥 남단에서는 한 이름없는 동굴로 이어지는데, 동굴안에는 값나가는 보물이 많다고 합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/056"
msgid "그 동굴은 드래건 브레스 산맥 남단의 서쪽 끝에 있다고 알려져 있지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/057"
msgid "게이시르시티 남쪽의 게이시르 숲은, 현재는 게이시르시의 관리소홀로 표지판이 부족하지만, 상당히 넓고 이곳저곳 통한 곳이 많은, 남부의 교통의 요지라고 할 수 있지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/058"
msgid "게이시르 시티에서 나와서 계속 남쪽으로 가면 멤피스 마을, 남쪽으로 가다가 동북쪽으로 꺾어 올라가면 니코시아 교회요새로, 남쪽으로 가다가 서북쪽으로 꺾으면 로우엔으로 가는 길이지. 하긴, 로우엔으로 가는 길과 화룡굴로 가는 길이 헷갈릴 수도 있겠군..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/059"
msgid "게이시르에서 로우엔을 가기는 쉽지않지. 게이시르 시티에서 내려와 두번째 갈림길에서 서북쪽으로 간 뒤에 계속 서쪽으로 방향을 잡고 전진해야 하네. 그 숲들은 상당히 복잡하지..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/060"
msgid "전 지리학회 소속이에요. \"비프로스트 접경지대의 지리와 사람들의 삶의 변화형태의 미분적고찰\"이란 논문으로 박사학위를 받았지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/061"
msgid "리브레빌은 게이시르 시티에서 계속 북쪽으로 가다가 동쪽의 다리를 건너서 다시 북쪽으로 가면 나오지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/062"
msgid "리브레빌에서 동북쪽으로 올라가면 안타나나리보 지방인데, 상당한 시골 산골 마을이에요. 리브레빌에서 가기 위해서는 리브레빌 근처의 숲에서 북쪽으로 올라가서 산악지대 첫번째 갈림길에서 서쪽으로 간 뒤 막바로 북쪽으로 꺾어서 쭉 올라가야 하지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/063"
msgid "아, 에스메랄다님. 아직도 사람들이 에스메랄다님을 찾아서 이곳으로 오곤 한답니다. 가까운 선생님의 제자가 운영하는 자선병원으로 가라고 해도 막무가내인 사람이 많아요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/064"
msgid "아직은 돌아오시지 않을 생각이십니까? ... 저도 에스메랄다님이 좀 자신을 위해서 살아보기를 바라고 있었습니다만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/065"
msgid "언제나 자신의 감정에 따라서, 후회없는 선택을 하시기 바랍니다. 저는 계속 이곳을 지키고 있겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/066"
msgid "앗! 에스메랄다 선생님! 저도 선생님의 뜻에 따라서 고향에 내려가 자선 병원을 세웠습니다. 하지만 역시 제 능력이 부족한지 사람들이 오지 않더군요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/067"
msgid "무엇보다도 자선병원을 운영할 기금이 너무나도 부족했기 때문에, 지금은 문을 닫은 상태입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr02
msgctxt "field|ko|art_ko_fltpr02|@kfltpr02/068"
msgid "지금 생각하면 정말로 선생님이 존경스럽습니다. 선생님의 봉사정신과 사업수완 모두가요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltpr03
msgctxt "field|ko|art_ko_fltpr03|@kfltpr03/000"
msgid "이곳에는 지금 볼일이 없다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/000"
msgid "우리 에스테도데님은 사람들을 매혹시키는 미모를 가지신 분입니다. 리브레빌 시에 사는 사람으로서 자랑이 아닐 수 없지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/001"
msgid "이곳은 북쪽 치고는 상당히 따뜻한 기후지요. 우리 시민들은 그것을 '에스테도데의 바람' 때문이라고 말한답니다. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/002"
msgid "게이시르에 있는 대성당은 10여년전에 세워졌다고 하더군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/003"
msgid "에스테도데 영주님의 가문은 상당히 유서 깊은 가문이라고 하더군요. 그렇지 않고서야 어떻게 그런 품위가 나올 수 있겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/004"
msgid "어서오세용"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/005"
msgid "원래는 두 나라 사이의 무역량이 그다지 많은 편이 아니었지만, 요새 들어서 상당히 많은 양의 물자들이 이동하고 있어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/006"
msgid "빠이"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/007"
msgid "최근에 사막에서는 도적 떼들이 설치고 있다네. 덕택에 나도 이번에 죽을 위기를 많이 넘겼다고."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/008"
msgid "상당히 더운 곳에서 사는 사람들은 대체로 성격이 느긋해 지지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/009"
msgid "우리집은 여관을 하고 있어서 여러 사람들을 많이 보게 되요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/009_3"
msgid "내 친구 한명이 카라카스로 이사간다고 해요. 그런 시골마을로 가서 무엇하려고... "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/010"
msgid "요새 북쪽에서 사람들이 많이 왔다갔다 한데요. 우리집은 여관을 하는데 비프로스트에서 내리오는 손님이 상당히 많이 늘었다고 한답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/011"
msgid "당신들 칼스님이 남기셨다는 검에 대해 알고 있소?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/012"
msgid "비프로스트 공왕의 애첩인 죠세핀에 대해서 들어본 적이 있소? 그녀에 대해서는 여러가지 말이 많지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/012_3"
msgid "샤른호스트가 이근방에도 나타났다는 소문이..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/013"
msgid "이곳 출신의 평민의 자손이라는 말 부터, 게이시르의 거리의 여자 출신이라는 둥... 하여튼 높은 신분의 여자가 아닌 것은 확실해."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/013_3"
msgid "에스테 로데님은 비프로스트의 죠세핀님과 함께 북방의 두미인으로 꼽히고 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/014"
msgid "누가 듣지는 않았겠지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/015"
msgid "제국황실은 흑태자님이후 맥이 끊겼다고 할수 있지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/016"
msgid "투르족은 자신들의 뛰어난 기술로 전쟁의 승부를 걸어왔고, 팬드래건은 자신의 영토에서 싸웠기 때문에 풍부한 자원을 이용한 물량작전과 장기전 전략으로 나왔지요. 지금은 두 세력이 싸움의 끝을 보지 못 하고 전쟁이 소강상태에 빠져 있다고 하더군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/016_3"
msgid "투르족의 기술력은 정말 대단하다고 하던데요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/017"
msgid "사이럽스의 니카차라면 나도 알고 있어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/018"
msgid "내 나이정도 되면 여태까지 살아온 나날을 되돌이키게되지. 여태까지 나는 무엇을 하며 살았었나, 나는 무엇을 하는 사람인가 하는..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/019"
msgid "곰곰히 생각해 보니... 최근에 투기장 지하에서 이상한 소리가 나는 것을 들은 것 같아. 내가 많이 늙었는지..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/020"
msgid "이 마을 사람들은 육체 단련과는 거리가 좀 멀지. 가장 우려되는 일이야... 무슨 일이 생길 경우 가장 필요한 것이 무력과 금력 아닌가. 우리 도시 사람들의 무력은 너무 약해."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/020_3"
msgid "자네 카오스큐브라고 알고있는가? 정말이지 대단한 아이템이라고 하더군. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/021"
msgid "이곳은 리브레빌시 입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/022"
msgid "이곳은 리브레빌 시티입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/023"
msgid "음악가 니카차씨를 아시나요? 사이럽스의 인기인 이랍니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/024"
msgid "이곳의 영주님은 정말 아름다우시답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/025"
msgid "리브레빌시"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/026"
msgid "듣기로는 팬드래건과 투르족의 싸움이 최고조는 지난 상태라고 하던데요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/027"
msgid "우리 리브레빌은 주로 비프로스트와 구 제국령 사이의 무역이 주된 수입원 이지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/028"
msgid "일반 남성들이 우리 에스테도데님을 한번 보면은 그 얼굴을 다시는 잊지 못한다고 하던데요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/029"
msgid "뭐, 나는 여자니까, 남자들의 기분 따위는 알 수 없지만... 우리 영주님이 미인은 미인이세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/030"
msgid "어서오세요. 우리 투기장에서는 항상 싼 가격에 여러분들을 모시고 있답니다.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/031"
msgid "역대 국왕 중에서 전설을 가장 많이 갖고 있는 사람은 역시 모험왕이라 불린 유그드페인이 아닐까? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/031_3"
msgid "최근의 비프로스트쪽 움직임은 상당히 수상하지. 무엇보다도 군비 증강이 문제야... "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/032"
msgid "우리 흑태자님이 기사수업의 여행에서 남긴 전설도 대단하지만, 유그드페인은 왕위에 있으면서도 상당히 많은 이야기거리를 남긴 모양이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/032_3"
msgid "비프로스트의 움직임이 수상한 것은 무엇보다도 그들의 확장정책이 점점 가시화 되고 있다는 뜻이 아닐까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/033"
msgid "훗... 그까짓 촌 구석동네인 비프로스트가 무엇이 무섭다는 것일까. 과거 우리 제국이 제대로 된 시절에는 저녁 찬거리도 안되던 놈들이..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/034"
msgid "게다가 그 긴 역사동안 그들은 방어뿐이 모르는 민족이 아니었었나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/035"
msgid "어머... 가장 강한 것은 가장 쉽게 부러진다는 말을 모르세요? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/036"
msgid "너무 강한 것이 좋은 것은 절대로 아니랍니다. 유는 강을 제압한다는 말도 있잖아요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/037"
msgid "[ 에머리 씨 ]/n 어서오세요, 우리 상점에 오신것을 환영합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/038"
msgid "무기상점 '드래건 버스터'"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/039"
msgid "우리상점의 무기를 구입해 주셔서 감사합니다. 다음에 또 오세요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/040"
msgid "[ 헤럴드 씨 ]/n 어서오시오. 무엇 특별히 찾는 것이라도 있습니까? 찾아드리겠습니다. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/040_3"
msgid "[ 헤럴드 씨 ]/n 어서오시오. 무엇 특별히 찾는 것이라도 있소?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/041"
msgid "악세사리 상점 '바람의 불꽃'"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/042"
msgid "리브레빌 제일인 저희 상점의 물건을 사 주셔서 감사합니다. 언제든지 이용해 주시기 바랍니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/042_3"
msgid "리브레빌 제일인 저희 상점의 물건을 사 주셔서 감사합니다. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/043"
msgid "투기장 근처에서 이상한 소리가 난다는 것을 알고 있어? 그런데, 요새 투기장을 운영하기는 하나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/044"
msgid "[해리슨 씨]/n 어서오세요. 우리 리브레빌 여관은 게이시르 북부에서 가장 깨끗한 방을 제공해 드립니다. 가격은 150Eld! 주무시겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/044_3"
msgid "[ 해리슨 씨]/n 어서오세요. 우리 리브레빌 여관은 게이시르 북부에서 가장 깨끗한 방을 제공해 드립니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/045"
msgid "감사합니다. 편안한 밤 되세요. 저희 리브레빌 여관은 언제나 최상의 서비스를 제공합니다. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/045_3"
msgid "감사합니다. 편안한 밤 되세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/046"
msgid "다음에 리브레빌을 들리실 일이 있으면 언제라도 우리를 찾아주세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/047"
msgid "우리 여관을 이용해 주셔서 감사합니다. 리브레빌에 들리실 일이 있으면 언제라도 들려주세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/048"
msgid "에스테도데님의 저택에는 이상한 동굴로 통하는 길이 있었다고 합니다. 지금은 다 막은 상태이지만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/049"
msgid "이전에 투기장 부근에서 밤중에 이상한 소리가 나는 것을 들은 적이 있어요. 이제 더이상 그 투기장에는 아무도 가지 않지만, 무엇인지 대단히 불안해요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/050"
msgid "이 집의 문은 잠겨 있는 것 같다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/051"
msgid "이곳은 여관입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/052"
msgid "유그드페인, 그는 왕의 몸으로 세상의 오지를 탐험하던 그는 마검의 탑에서 실종되었다고 하더군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/053"
msgid "제가 일하는 곳에있는 사원 하나가 저를 좋아한다고... "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/054"
msgid "그런데, 문제는 그가 저보다 나이가 어리가든요? 5살이나..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/055"
msgid "요새 그 일 때문에 고민이에요. 저한테는 그는 연인이라기 보다는 동생같은데... 어떻게 연애가 되겠어요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/056"
msgid "이 투기장의 문은 이상한 자물쇠로 잠겨있군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/057"
msgid "아름다운 리브레빌의 평화를 위하여 건배!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/058"
msgid "아름다룬 우리 리브레빌의 에스테도데 영주님을 위하여 건배!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/059"
msgid "그리고 아름다운 당신을 위해서도 건배!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/060"
msgid "[ 구스타프 ]/n우리 도시에 있는 투기장 말인가? 예전에는 나도 그 투기장을 꽤나 다녔었지만, 이 도시의 사람들은 도통 육체단련과는 관계 없어서, 얼마전에 문을 닫았지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/061"
msgid "[ 구스타프 ]/n뭐.... 그곳에서 이상한 소리를 들었다는 사람도 있지만, 난 별로 믿지는 않아. 정 궁금하다면 그곳 주인을 만나 보는 것이 어때? 무기상점 주인과 친해서, 주로 그곳에 많이 있던데."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/062"
msgid "[ 에머리 씨 ]/n투기장 주인 말인가? 늘 우리집에 왔었는데, 오늘은 없군. 몸이 좋지 않다나? 그사람 요새 들어서 이상한 소리를 많이 해서... 아마도 자기 가게를 문이 닫은 것에 많이 상심했었던 것 같아."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/063"
msgid "그사람 집의 위치는 어디죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/064"
msgid "[ 에머리 씨 ]/n북쪽 블럭의 내려가는 계단 건너편에 있는 집이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/065"
msgid "아까 책상위에 놓인 열쇠를 사용 해 볼까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/066"
msgid "투기장의 열쇠가 사용되었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/067"
msgid "카오스 큐브에 얽힌 신비한 이야기를 알고 계신가요? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/068"
msgid "먼 옛날에 카오스 큐브는 하늘의 별이었답니다. 그 당시도 지금같이 전쟁이 많은 시기였지요. 어느날 자신의 애인이 전장에 출전하게 된 한 처녀가 호숫가에서 그 별을 보면서 소원을 빌었다나봐요. \"저의 애인을 전장에서 부디 보호해 주세요\" 하고."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/069"
msgid "별은 그 처녀의 마음이 너무 깨끗한데에 감동되서 대답했답니다. \"당신의 부탁은 들어줄 수 있지만, "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/070"
msgid "카오스 큐브에 얽힌 이야기를 아세요? 옛날에 이 땅에 전쟁이 끊이지 않던시절, 한 연인이 있었습니다. 여자의 이름은 아웬, 남자의 이름은 엘 이었지요. 둘은 결혼을 약속한 사이었지만, 엘이 전쟁에 나가게 되었어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/071"
msgid "아웬은  엘의 무사를 하늘에 별에 대고 빌고 빌고 또 빌었답니다. 하늘의 별이 그 정성에 감동되어서, 하루는 그 아웬에게 말을 걸었답니다. \"그대는 진정으로 그를 구할 용기가 있는가? 그렇다면 마을 뒤편의 호수 안으로 들어가 보라.\""
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/072"
msgid "그 다음은 다른 사람이 이야기 해 줄 거에요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/073"
msgid "존스씨 부탁인데, 술을 좀 주시겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/074"
msgid "[ 술집주인 ]/N존스라고...? 관 두슈. 누구 장사 망하는 꼴 보고 싶은거유? 그분 술 먹는게 들키는 날에는 그 집 부인이 이곳에 와서 얼마나 행패를 부리는 줄 아슈?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/075"
msgid "그렇지만, 존스 씨는 이런 것을 주시던데요? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/076"
msgid "나는 브레스젬을 카운터 위에 놓았다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/077"
msgid "어.. 이건 브레스젬? 허, 허허허! 뭐 알고보면 그사람도 불쌍한 사람이지요. 지독한 부인을 만나서, 원. 그사람에게 술먹는 것을 빼앗아 가면 사는 재미가 뭐 남겠소? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/078"
msgid "술을 얻었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/079"
msgid "그럼 잘 전해주라고!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/080"
msgid "카오스 큐브에는 아름다운 전설이 얽혀 있답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/081"
msgid "상당히 아름답고도 슬픈...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/082"
msgid "하지만, 난 비프로스트 사람들이 싫어요. 너무 무섭게 노려보는 그 눈들이..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/083"
msgid "그렇지만, 그 미모와 매력은 대단한 모양이라, 우리 에스테도데님과 함께 북방의 두 미인이라 불리는 모양이야. 절대로 우리 에스테도데님의 품위에는 미치치 못하겠지만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/084"
msgid "뭐, 이곳 리브레빌에서야 별로 상관없는 일이기는 하죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/085"
msgid "항간에 퍼지고 있는 비프로스트 침공설이 진짜일까요? 정말 전쟁은 싫은데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/086"
msgid "호호호. 역시 아름다운 여자한테 강한 남자는 없는 법인가요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/087"
msgid "그까짓 비프로스트의 공세 쯤이야 우리 리브레빌 만으로도 막을 수 있는 것이 아닌가, 하하하!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/088"
msgid "비프로스트에서 우리 리브레빌을 쳐들어올 모양이라면서요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/089"
msgid "저는 정말 전쟁이 두렵답니다. 저쪽에 계신 신사분은 비프로스트의 군사력은 우습다고 하지만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/090"
msgid "제가 정말 무서운 것은 저분같이 쓸데없이 배짱만 많은 분이에요. 말만 많아서는 하는 일은 하나도 없는 그런 사람들 말이에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/091"
msgid "무기도 그래요, 꼭 비싸고 단단하다고 좋은것은 아니지요. 하지만 비싼 무기는 오랫동안 사용할 수 있다는 장점이 있어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/092"
msgid "투기장에서 이상한 소리가 처음 들여오기 시작한 것은 투기장이 문을 닫은 직후였어. 저녁 늦게 사람들이 자신의 집에 있을 때 즈음부터 말이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/093"
msgid "마치 이세상의 소리가 아닌듯한 소리가, 어떻게 들으면 바람 소리 같기도 하고, 신음 소리 같기도 한 소리가 불길하게 울려퍼졌지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/094"
msgid "혹시 우리 리브레빌시 밑에는 다른 세계 같은 것이 있는 것 아닐까요? 정말로 두렵답니다. 어느날 갑자기 그 세계로부터 무엇인가가 튀어나오면 어떻게 해요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/095"
msgid "안타나나리보에 가본 적 있어요. 상당히 작으면서도 사람들이 굉장히 거친 마을이었어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/096"
msgid "아마도 끊임없이 전쟁에 시달리던 피가 있어서 그런 것 아닐까요? 하지만 그곳도 우리 제국이 붕괴된 이후에는 한동안 조용했었지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/097"
msgid "비프로스트로 공격해 들어가는 적이 없었기 때문에 그곳도 상당히 조용했었는데... 이즈음은 비프로스트 쪽에서 내려온다는 소문 때문에 불안해요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri01
msgctxt "field|ko|art_ko_fltri01|@kfltri01/098"
msgid "죄송합니다 손님. 그리로 들어오시면 안됩니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/000"
msgid "하지만 요 몇년 사이는 비프로스트로 가는 별다른 세력이 없어서 조용한 나날을 지낼 수 있었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/001"
msgid "안타나나리보는 역사상 비프로스트의 국경 부근에 있어서 한시도 조용할 날이 없었지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/002"
msgid "게이시르에 있는 대성당은 10여년전에 세워졌다고 하더군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/003"
msgid "단지... 이제는 비프로스트 자체에서 밖으로 진출하려고 하는 것 같군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/004"
msgid "어서오세용"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/005"
msgid "항간에는 일부 종교인들의 문제를 전체 종교인의 문제인양 확대해석하는 집단이 있다던데...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/006"
msgid "빠이"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/007"
msgid "최근에 사막에서는 도적 떼들이 설치고 있다네. 덕택에 나도 이번에 죽을 위기를 많이 넘겼다고."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/008"
msgid "상당히 더운 곳에서 사는 사람들은 대체로 성격이 느긋해 지지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/009"
msgid "이곳은, 리브레빌이지요. 가장 강력한 군사영주가 프레데릭이라고 하자면 가장 살기 좋은 곳은 이곳, 리브레빌입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/010"
msgid "그렇지만 어디든지 이 혼란의 시대를 정상적으로 헤쳐나갈 수 있는 곳은 없는 것 같군요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/011"
msgid "당신들 칼스님이 남기셨다는 검에 대해 알고 있소?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/012"
msgid "샤른호스트가 이근방에도 나타났다는 소문이... 도데체 그 괴도는 정체가 무엇일까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/013"
msgid "샤른 호스트 역시 제피르 팰컨과 같은 단순한 도둑에 불과한 것 아닐까요? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/014"
msgid "누가 듣지는 않았겠지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/015"
msgid "그런 그들이 좋은 무기를 갖고 있는 것은 어쩌면 당연한 것이 아닐까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/016"
msgid "난 이전에 투르족의 포로로 있으면서 그들의 생활을 본 적이 있는데, 발달된 문명을 기반으로 해서 이것저것 여러 편리한 기계들을 많이 만들어서 쓰고 있었어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/017"
msgid "저는 독실한 주신교 신자에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/018"
msgid "훗, 나는 중년의 낭만을 즐기는 한가로운 귀족이라네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/019"
msgid "체사레는 제국 통일이라는 해법을 위해서 너무 자신만의 방법을 추구하는 경향이 있는 것 같아."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/020"
msgid "그런 식으로는 너무나 많은 희생이 필요하게 되지... "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/021"
msgid "우리 엄마가 친 엄마가 아니라면... 나의 친 동생은 다른 곳에서 나를 모른 채 살아가고 있지 않을까요? 아... 얼마나 낭만적이에요...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/022"
msgid "이곳은 리브레빌 시티입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/023"
msgid "돈을 받고 파는 것이 아니라 그 거울이 선택한 사람한테 판다고 하더군요. 이상한 할아버지 였어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/024"
msgid "이곳의 영주님은 정말 아름다우시답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/025"
msgid "대부분의 수도승들은 항간에 알려진 것 처럼 타락하지 않았답니다. 단지, 일부의 종교인들이 문제인 것이지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/026"
msgid "가장 강한것은 가장 잘 부러지기 마련이라네. 문제에 대한 해법은 하나만 있는 것이 아니야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/027"
msgid "전에 어떤 할아버지가 재미있는 거울을 파는 것을 본 적이 있는데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/028"
msgid "자신이 평소에 간절히 원하는 것을 비추어 주는 거울이었는데...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/029"
msgid "난 울 엄마가 정말 싫어요! 정말이지 나를 야단치기만 해요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/030"
msgid "우리 엄마는 나의 친 엄마가 아닌것이 분명해요. 나의 친 엄마는 어디에 계실까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/031"
msgid "남장을 한 아웬은 그 보석의 도움으로-보석은 신비한 힘이 있어서 그녀를 보호했지요-전장을 뚫고 다니면서 엘을 찾았답니다. 그러는 과정에서 아웬이 \"케인\"이란 이름으로 수도없이 겪은 모험은 그녀를 유명인사로 만들었지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/031_3"
msgid "제 친구 하나가 파로에 사는데 요즘에 그 마을에 이상한 일이 일어났다고 하던데요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/032"
msgid "그러는동안 아웬은 전장에서 엘이 있다는 전장의 위치를 알아냈답니다. 그녀는 하늘의 바람과도 같이 그곳으로 달려갔지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/032_3"
msgid "교회측의 반대에도 불구하고 이교도와 결혼하려던 세도가의 아드님이 갑자기 파혼을 선언했다면서...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/033"
msgid "다음 이야기는 로우엔에서 들을 수 있답니다. 지금, 주점에서 1편, 꼬마한테 2편, 저한테 3편을 들으신 거에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/033_3"
msgid "원 세상에, 교회가 반대하면 결혼도 할 수 없는 것인가요? 그쪽 시골 사람들은 그런 취급을 어떻게 견디어 내고 있는 것이죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/034"
msgid "비프로스트는 정말 별 볼일 없는 국가에요. 이전에 한번 가 본 적이 있는데, 어찌 그리 촌스럽던지! 정말 시골이라니까요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/035"
msgid "게다가 사람들은 왜 그리도 앞뒤가 꽉 막혀 있는지, 정말 알다가도 모르겠다니까..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/036"
msgid "카오스 큐브라는 것은 굉장히 소중한 것이라고 어머니께 들은 적이 있어요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/037"
msgid "카오스 큐브의 효능은 신이내리신 선물이라고 부른다고 하던데요, 어머니께서는요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/038"
msgid "저희 집에는 가보로 내려오는 카오스 큐브가 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/039"
msgid "우리 집안이 요새 같은 때에도 이정도로 살아갈 수 있는 것은 다 카오스 큐브 덕택이 아니겠어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/040"
msgid "전 제국에서 가장 살기 좋은 곳은 역시 이곳 리브레빌이 아닐까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/041"
msgid "로우엔의 프레데릭 공 역시 상당히 뛰어난 자질을 갖고 있다고 듣기는 했었지만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/042"
msgid "그곳이 군사력이라면 이곳은 생활을 영위하는 데 더 좋은 것이지요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/043"
msgid "제 모습이 파 앤 어웨이의 니콜 키드만을 닮았다고요? 어머... 고맙군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/044"
msgid "하지만 당신은 탐 크루즈 같지는 않은데요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/045"
msgid "우리 집안은 과거에 프리토리아에서 살고 있었답니다. 그런데 그곳의 영주 때문에 이리로 도망왔지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/046"
msgid "지금은 어느정도 안정된 삶을 살고 있지만, 정말 악몽같은 기억이었어요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/047"
msgid "얼마전에 저와같은 사정의 아이들을 보게되서 제가 맡아서 데리고 있답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/048"
msgid "호수 안으로 들어간 아웬은 호수 밑바닥에서 이상하게 빛나는 보석을 하나 발견하고 주워왔답니다. 그 때 다시 별의 목소리가 말했지요. \"그 보석을 갖고 있으면 그는 무사할 것이다.\""
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/048_3"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/049"
msgid "지난번에는 정말로 고마웠습니다. 저희의 목숨을 살려준 것.... 그리고 복수까지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/050"
msgid "제 동생은 그때의 충격 이후로 말을 잃어 버리고 말았습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/051"
msgid "하지만 난, 절대로, 절대로 영주들을 용서할 수 없어요. 진실로."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/052"
msgid "이이는 허구한날 술이야, 술, 술, 술! 도데체 내가 언제까지 참고 살아야 하는 것인지 모르겠다니까! "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/053"
msgid "그렇게 해서 언제 성공하려고 그러는 건지 정말 모르겠어! 왜, 왜, 왜 그러는 것인데 도데체!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/054"
msgid "이럴 줄 알았으면 결혼하지 않는 건데 그랬다니까!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/055"
msgid "[ 존스 씨 ]/n아아... 술이야 말로 인생에 기쁨, 즐거움."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/055_3"
msgid "아아... 술이야 말로 인생에 기쁨, 즐거움 이라고 할 수 있지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/056"
msgid "[ 존스 씨 ]/n도데체... 술이 없다면 내가 이세상을 사는 이유가 없다니까.... 아무리 부인이 무엇이라 그래도 어쩔 수 없다고."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/056_3"
msgid "도데체... 술이 없다면 내가 이세상을 사는 이유가 없다니까.... 아무리 부인이 무엇이라 그래도 어쩔 수 없다고."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/057"
msgid "[ 존스 씨 ]/n그리고 나는 그다지 많이 마시는 편도 아닌데 말이야... 왜 내가 술 먹는것을 그렇게 싫어하는지 알 수 없어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/057_3"
msgid "그리고 나는 그다지 많이 마시는 편도 아닌데 말이야... 왜 내가 술 먹는것을 그렇게 싫어하는지 알 수 없어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/058"
msgid "이곳은 잠겨있는 것 같군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/059"
msgid "이 편지를 볼 누군가에게. 나는 나의 가게 지하에서 가게를 정리하던 도중, 이상한 동굴로 가는 길을 찾아내었다. 굉장히 복잡한 동굴로, 이번에는 본격적으로 준비를 갖추어서 들어가 볼 생각이다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/060"
msgid "책상위에 편지와 열쇠가 놓여져 있다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/061"
msgid "이 집에는 아무도 없는 것 같군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/062"
msgid "이 집이 무기점 주인이 말하던 투기장 주인 집인가? 이상하군. 문이 열려 있는 것 같은데."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/063"
msgid "[ 존스 씨 ]/n자네... 저 아래 술집알지? 죽는사람 살려주는 셈 치고 술좀 사다주게나. 도데체 저 마누라 때문에 술집에 갈 수가 있어야 말이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/064"
msgid "저런... 꼭 그렇게 까지 하셔서 술을 드셔야 겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/065"
msgid "[ 존스 씨 ]/n자자... 그러지 말고, 내 사례는 따로 함쎄. 그럼, 이 브레스젬을 주점 주인장 갖다주고 술을 좀 얻어오게나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/066"
msgid "브레스 젬을 받았다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/067"
msgid "[ 존스 씨 ]/n자... 그럼 꼭 부탁하네 그려."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/068"
msgid "[ 존스씨 부인 ] 여봇! 설마 또 술 심부름 부탁하는 것은 어니겠지요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/069"
msgid "[ 존스 씨 ]/n아니야! 아니라고!/n(속삭이듯이)빨리 갖다오게, 빨리!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/070"
msgid "[ 존스 씨 ]/n이 도둑놈! 내 브레스 젬을 어떻게 한 거지! 이 도둑놈!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/071"
msgid "[ 존스 씨 ]/n이거 정말 고맙구만... 약소하지만, 사례하겠네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/072"
msgid "바바리안을 얻었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/073"
msgid "에게게? 겨우 회복약이야?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/074"
msgid "이 열쇠, 투기장의 문에 맞을 것 같군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/075"
msgid "그렇지만 이미 엘은 전장으로 떠난 뒤였지요. 아웬은 그 보석을 지니고, 한자루 칼에 의지해서 엘이 싸우고 있는 전장으로 내달았답니다. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/076"
msgid "이건 두번째 이야기에요. 다음 이야기는 다른 사람이 해 줄 거에요. 첫번째 이야기는 주점의 누나가 해 주었죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/077"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/078"
msgid "당신... 카오스 큐브에 얽힌 모든 전설을 다 알아내셨군요. 그렇다면 카오스 큐브를 받을 자격이 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/079"
msgid "카오스 큐브를 손에 넣었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/080"
msgid "부디 올바르게 이용 해 주세요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/081"
msgid "카오스 큐브에는 아주 아름다운 전설이 있어서...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/082"
msgid "저는 그 전설을 굉장히 좋아해요. 그렇지만 중간 서 부터만 안답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/083"
msgid "이전 것을 들었으면 이야기 해 드릴 수도 있는데...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/084"
msgid "그렇다고는 해도, 이곳은 정말로 살만한 곳이랍니다! 우리 도시는 물이 정말 좋거든요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/085"
msgid "뭐, 어떤 편이든 나같이 없이사는 사람이야 문제 되겠나 싶기는 하군. 있는 놈 돈이야 좀 없어지면 어떻겠어?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/086"
msgid "우리도 그런 무기가 있어야 우리 자신을 지킬텐데... 아, 우리 마을 무기상의 무기는 상당히 좋은 편이지. 한번 가 봐서 손해 볼 것은 없겠지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/087"
msgid "더욱 충격적인 것은 그곳 사람들은 \"초컬릿\"도 모르더라니까요, \"초컬릿\"도! 아무리 투르족이 전래한 새로운 식품이라도 말이에요. 내 참 기가차서..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/088"
msgid "어머니는 저도 한번 보여준 적이 없답니다. 성인이 되기 전에는 볼 자격이 없다나요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/089"
msgid "저희 가문에 내려오는 말 중에, 카오스 큐브의 전설을 모두 아는 사람에게 그 보석을 전해주라고 되어있답니다. 그 전설을 모두 들으셨나요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/090"
msgid "호호호! 하지만 부르스 윌리스를 닮은 것 같기는 하군요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/091"
msgid "...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/092"
msgid "우리 도시로 오는 도중에 큰 다리를 보셨나요? 그 다리는 구제국령 다리중 가장 아름다운 다리라는 \"리브레빌 다리\"죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/093"
msgid "그 다리 공사에는 전설이 하나 있어요. 그 공사를 시작하려고 하자 자꾸 비가 쏟아지고 홍수가 나서 작업을 진척시킬 수 없었답니다. 무녀가 말하기를 \"이 강의 수호령이 이 다리 공사를 허락하지 않는다.\"고 말했지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/094"
msgid "사람들은 강의 수호령을 달래기 위해서 갖은 방법을 다 썼었지만, 전혀 소용이 없었어요. 마지막으로 사람들은 인신공양이라는 방법을 찾았지요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/095"
msgid "다리에 얽힌 다음 전설을 들으시게요? 그래서 사람들은 다리 공사를 위해 희생할 처녀를 찾았지만, 그런 처녀가 있을 리 없었지요. 그래서 공사가 계속 지연되던 어느날, 한 소녀가 공사장에 찾아왔답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/096"
msgid "그 소녀는 말했지요. \"제가 이 공사를 진행되게 해 드리겠어요. 대신, 저에게 이 다리를 주세요.\" 사람들은 의아했답니다. 소녀가 자신을 강의 신에게 바치겠다는 것인줄 알았는데 어떻게 다리를 가질 수 있는지 궁금했지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/097"
msgid "의논한 끝에, 사람들은 그 소녀에게 다리의 소유권을 주기로 했답니다. 그러자 소녀는 높은 목소리로 웃은 다음에 강물로 뛰어들었답니다! 다음 이야기는 다른 사람한테 들으세요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/098"
msgid "저는 전설을 대단히 좋아해요. 옛날 이야기 아는 것 있으면 좀 들려주시겠어요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/099"
msgid "저런... 다리 다음 이야기를 들으시고 싶으신가 봐요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/100"
msgid "그 다음은 이렇지요, 그 강물로 뛰어들어간 소녀는 용으로 화해서 강의 신과 싸움을 벌였답니다. 당연히 제물이 된다는 뜻으로 받아들였던 사람들은 겁에 질려서 그 싸움을 지켜보았답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/101"
msgid "싸움은 3일 낮 3일 밤 동안 계속되었지요. 그동안 땅도, 하늘도 어두워져서 사람들은 빛을 볼 수 없었지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/102"
msgid "이윽고 날이 밝자, 사람들은 강가에 소녀가 서 있는 것을 보았습니다. 사람들이 다가가자 소녀가 말했지요. \"이 강의 소유권은 지금부터 나에게 있다. 이 강에 다리를 놓는것은 이전 신의 주술을 깨는 것이었고, 나는 너희를 도와 이 강에 다리를 놓을 수 있도록 신을 쫓아냈다.\""
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/103"
msgid "\"단, 너희들은 이 강의 다리를 세계 최고로 튼튼하고 아름답게 만들어야 한다. 이제 이 다리는 이강에 대한 나의 소유권을 나타내는 것이자, 나의 주술이므로. 따라서 이 강의 다리가 끊어지면 나와, 이다리를 만든 너희, 혹은 너희의 자손들이 죽을 것이다.\""
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/104"
msgid "그리고 그 소녀는 거짓말 같이 사라졌답니다. 사람들은 그야말로 미친듯이 다리를 만들었고, 그 결과가 보신 그 다리죠. 어때요, 재미있었나요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/105"
msgid "이 지역은 다른 지역에 비해 지대가 낮으므로 침수 위험이 있음./n게이시르 지리학회"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/106"
msgid "제프리 바지를 얻었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri02
msgctxt "field|ko|art_ko_fltri02|@kfltri02/107"
msgid "당신도 이야기 듣는 것 좋아하는 군요? 제가 이거 드릴께요. 얼마전에 주운건데, 저한테는 맞지 않아서."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri03
msgctxt "field|ko|art_ko_fltri03|@kfltri03/000"
msgid "영주님과의 약속이 없다면 만나실수 없습니다"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltri03
msgctxt "field|ko|art_ko_fltri03|@kfltri03/001"
msgid "이곳이 영주 에스테 도데의 저택이군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro00
msgctxt "field|ko|art_ko_fltro00|@kfltro00/000"
msgid "동 - 로우엔 숲/n북서 - 로우엔 시티/n북 - 마검의 숲"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/000"
msgid "로우엔의 자랑은 뭐니뭐니해도 역시 프레데릭 경이계신 군대라고 할 수 있지요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/001"
msgid "이 로우엔이야 말로 구 제국령 최고의 도시라고 할 수 있죠. 강력한 군사력과 탄탄한 경제! 우리야 말로 미래 제국의 핵심입니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/002"
msgid "게이시르에 있는 대성당은 10여년전에 세워졌다고 하더군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/003"
msgid "남자들이란, 다 큰 아이랍니다. 계속해서 보채고 떼를 쓰지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/004"
msgid "어서오세용"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/005"
msgid "남편이라고 하나 있는 것은 날마다 노름질만 해대고, 가게는 돌볼 생각조차 안해요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/006"
msgid "빠이"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/007"
msgid "최근에 사막에서는 도적 떼들이 설치고 있다네. 덕택에 나도 이번에 죽을 위기를 많이 넘겼다고."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/008"
msgid "상당히 더운 곳에서 사는 사람들은 대체로 성격이 느긋해 지지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/009"
msgid "전에 한번, 딱 한번 프레데릭님 께서 광검을 뽑으신 것을 본 적이 있어요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/010"
msgid "그날 저녁에 저는 잠을 잘 수가 없었어요! 너무 멋있어~~!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/011"
msgid "당신들 칼스님이 남기셨다는 검에 대해 알고 있소?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/012"
msgid "샤른 호스트 라는 도적의 정체는 정말로 무엇일까요? 최근에는 이 근방에도 나타났었다는 이야기를 들은적이 있는데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/013"
msgid "이곳과 리브레빌 정도가 살기 좋은 곳일 뿐, 현제 제국령의 전체적인 상황은 엉망이에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/014"
msgid "누가 듣지는 않았겠지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/015"
msgid "그런데 내 부인은 언제나 나를 잡아먹지 못해서 안달이니, 어떻게 제가 살 수가 있겠어요 도데체!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/016"
msgid "아, 그렇지 않습니까? 저 정도면 어디 내 놓아도 손색이 없는 남편이라고요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/017"
msgid "붙잡히기만 해 봐라 이번에는 그 버릇을 단단히 고쳐놓겠어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/018"
msgid "허허허... 부부싸움은 칼로 물베기라고 하지 않는가. 어쩔 수 없는 일이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/019"
msgid "저렇게 싸우는 커플들을 보면 나는 언제나 나의 젊은 시절이 생각난다네..... 내 마누라도 그때는 좋았었는데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/020"
msgid "훗. 사실 이 마을은 군사도시긴 해도 이상하게 여자들의 기가 드세서 말이야. 대부분의 남자들이 꼼짝못한다니까."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/021"
msgid "이곳은 리브레빌시 입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/022"
msgid "이곳은 리브레빌 시티입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/023"
msgid "호호... 그래도 가끔은 귀여운 면이 있으니까, 같이 사는 것 아니겠어요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/024"
msgid "이곳의 영주님은 정말 아름다우시답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/025"
msgid "로우엔 시티"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/026"
msgid "이곳은 프레데릭의 저택이 있는 곳이다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/027"
msgid "으윽.. 화가난다니까! 자기가 잘났으면 얼마나 잘났다고 난리야, 도데체!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/028"
msgid "또 어디로 간 거지? 아아악~~ 도데체 내가 결혼을 왜 한건지 모르겠다니까요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/029"
msgid "자꾸 달래주지 않으면 삐져버려요. 아주 골치아픈 족속들이죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/030"
msgid "[ 헤럴드 씨 ]/n어서오십시요! 이곳은 전국 최고의 총기류를 비치해 놓고 있습니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/031"
msgid "무기상점 '파에톤'"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/032"
msgid "총의 명가, 저희 파에톤을 이용해 주셔서 대단히 감사합니다. 다음에 또 오세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/033"
msgid "[ 헤럴드 부인 ]/n어서오세요, 저희 상점은 총 뿐만 아니라 도검류도 고급을 판매합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/034"
msgid "무기상점 '파에톤'"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/035"
msgid "로우엔의 자랑, 저희 파에톤을 이용해 주셔서 감사합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/036"
msgid "저희 집은 심지어 프레데릭 경께서도 가끔 들리실 정도로 좋은 총이 많다고요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/037"
msgid "아버지는 자신이 총 수집가 이시기도 해서, 일반적으로는 팔지 않는 좋은 총을 따로 보관해 두시고는 하죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/037_3"
msgid "아버지는 자신이 총수집가 이시기도 해서, 일반적으로는 팔지 않는 좋은 총을 따로 보관해 두시고는 하죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/038"
msgid "[ 엘렌 양 ]/n어서오세요. 무엇을 도와드릴까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/039"
msgid "악세사리상점 '오거스트'"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/040"
msgid "저희 오거스트를 이용해 주셔서 감사합니다. 또 오세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/041"
msgid "우리 아버지는 이상하게도 얼마전에 숲속으로 들어간 다음에는 나타나지 않으시고 계세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/042"
msgid "어머니는 언제나 아버지를 수소문 해 보지만 돌아오지 않아요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/043"
msgid "로우엔의 명물, '폭열주점'에 오신것을 진심으로 환영합니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/044"
msgid "우리 주점의 자랑은 무엇보다도 전 안타리아를 통털어 가장 독한 술 '루드'입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/045"
msgid "이곳은 술 '루드'는 정말로 센 술이지. 한번 마셔 보겠나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/046"
msgid "로우엔의 남자들은 모두 프레데릭 군 소속의 병사들이지. 우리 모두는 일당 백의 능력을 지닌 우수한 병사들이다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/047"
msgid "세계에서 가장 살기좋은 곳은 리브레빌이 아니라 우리 로우엔이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/048"
msgid "이곳 투기장에 들어가 보신 적 있으세요? 우리는 흔히 투기장에서 얼마만큼이나 더 버티는가로 용기의 정도를 시험하곤 해요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/049"
msgid "겁장이들은 로우엔의 수치에요. 우리들은 모두 전장에서 목숨을 잃을 준비가 되어있는 병사라고요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/050"
msgid "[재프 씨]/n어서오세요. 자랑스러운 로우엔에 오신 것을 환영합니다. 저희 여관에서 묵으시려면 110 Eld가 필요합니다. 묵으시겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/050_3"
msgid "[ 재프 씨 ]/n어서오세요. 자랑스러운 로우엔에 오신 것을 환영합니다. 저희 여관에서 묵으시려면 110 Gold가 필요합니다. 묵으시겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/051"
msgid "감사합니다. 평안한 밤 되십시오. 신의 가호가 당신의 밤과 함께 하기를!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/051_3"
msgid "감사합니다. 평안한 밤 되십시오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/052"
msgid "다음 기회에 다시 들려 주시기 바랍니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/053"
msgid "이용해 주셔서 감사합니다. 다음에 또 오세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/053_3"
msgid "이용해 주셔서 감사합니다. 다음에 또 이용해 주십시오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/054"
msgid "나는 용병이오. 하지만 떠돌이 생활도 이제 진력이 나서 이곳에 정착하기 위해 왔지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/055"
msgid "로우엔의 강력한 군대라면 내가 여태까지 익힌 용병으로의 능력을 십분 발휘할 수 있을 것이라 생각했소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/056"
msgid "가장 살 만한 고장은 리브레빌과 로우엔 이 두곳이 아니겠소. 나도 이곳에 정착하기 위해 왔지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/057"
msgid "게이시르 시티? 그곳은 알게 모르게 위험한 곳이라고. 오히려 다른 마을보다 더 위험하지. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/058"
msgid "저희 투기장에는 강인한 체력을 가진 강한 교관들로 가득 차 있습니다. 일단 들어 가 보십시오!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/058_3"
msgid "저희 투기장에는 신선한 몬스터들로 가득 차 있습죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/059"
msgid "남자들이라면 우리 투기장에서 힘을 기르는 것이 실전에는 가장 도움이 된답니다. 그럼요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/060"
msgid "[ 위니 ]/n어서오세요. 우리 부모님들은 또 싸우고 나가셨는데, 곧 돌아오실 거에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/061"
msgid "약국, '목련'"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/062"
msgid "우리 부모님께서 안계셔서 가격을 잘 몰라요. 죄송해요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/062_3"
msgid "우리 부모님께서 안계셔서 가격을 잘 몰랐어요. 죄송해요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/063"
msgid "자네도 하나의 시민으로서의 역할을 다 하려면 실전훈련을 쌓게!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/064"
msgid "죄송합니다, 손님. 그리로 들어오시면 안 됩니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/065"
msgid "죄송합니다, 손님. 그리로는 들어오실 수 없습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/066"
msgid "손님, 그곳으로는 들어오시면 안 됩니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/067"
msgid "죄송합니다, 손님. 그리로 들어오시면 안되요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/068"
msgid "어이, 날 한번 잡아봐! 날 잡으면 좋은 것 주지!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/069"
msgid "흥! 내가 그정도로 잡힐 것 같아?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/070"
msgid "투기장 \"실전특공무술수련관\""
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/071"
msgid "표를 내고 가슈!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/072"
msgid "회원권을 갖고 있군요. 들어가시오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/073"
msgid "엘이 있는 전장은 모든 격전지 중에서도 가장 격렬한 전투가 벌어졌던 곳이었답니다. 아웬은 불길한 예감에 사로잡혔지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/074"
msgid "아웬이 엘이 있다는 부대에 도착했을 때, 그녀를 따뜻히 맞이해주는 사람들중에는 엘이 없었지요. 아웬을 물었답니다. \"엘은?\" 그러자 그의 전우중 한명이 대답했어요. \"그는 지난 전투에서 포로로 잡혀갔습니다.\""
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/075"
msgid "그 이후로 그 호수에서는 가끔, 이전에는 볼 수 없었던 보석을 구하게 되었답니다. 그게 카오스큐브인 것이지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/076"
msgid "엘이 잔혹한 적의 손에 포로로 잡혔다는 것을 들은 아웬은 한시라도 지체할 수 없었어요. 그녀는 적국의 성에 몰래 잠입해서 엘의 행방을 찾기 시작했죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/077"
msgid "아웬은 잡혀온 포로들이 크레앙 산의 절벽에 죽을때 까지 매달리는 형벌을 받았다는 것을 알아냈답니다. 그녀는 절벽아래까지 한달음에 달려가서 경비병들을 해치웠지만, 경비병들은 절벽위로 올라가는 사다리를 부숴버렸습니다. 곧 추가병력이 절벽쪽으로 몰려오기 시작했고, 아웬이 절벽으로 올라갈 방법은 없었어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/078"
msgid "이제 이야기도 거의 끝나가지요... 다음편은 서부에 사는 사람이 이야기해 줄 꺼에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/079"
msgid "우리 할아버지는 실버애로우와의 전쟁당시 돌아가셨어요. 흑태자님 직속휘하에 있는 사병이었다고 해요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/080"
msgid "저도 어른이 되면 용감한 군인이되서, 우리 제국을 얕보는 놈들을 혼내줄 거에요. 두고봐요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/081"
msgid "제국은 하나로 뭉쳐야 합니다. 실버애로우 세력이 투르제국과의 전쟁으로 현격하게 약화된 지금이야 말로 과거 제국의 영화를 부활시키기에 더없이 좋은 시점입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/082"
msgid "더군다나 우리가 뭉치지 않으면 만약 실버애로우가 투르제국에 의해 멸망당하게 될 경우에 이번에는 우리 영토가 유린당하게 됩니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/083"
msgid "그리고, 그 결합의 중축은 우리 로우엔이 담당해야하는 것은 물론이지요. 우리야 말로 제국의 진정한 강자아닙니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/084"
msgid "어서오게. 자네는 우리 술집에는 처음인 것 같은데.... 우리 술집에는 뭐니뭐니해도 제국령 최고로 독한 술인 \"루드\"가 있지. 한번 마셔 보겠나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/085"
msgid "어떻게 할까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/086"
msgid "루드를 마신다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/087"
msgid "루드를 마시지 않는다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/088"
msgid "좋아요 마시겠소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/089"
msgid "윽... 이거 상당히 독한데.../20d 머리가..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/090"
msgid "여... 여기는...? 아, 그 술을 마시고 정신을 잃은 것인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/091"
msgid "당신, 쉬고 싶지 않아?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/092"
msgid "누구야!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/093"
msgid "... 싫소. 마시지 않겠소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/094"
msgid "[주점주인]/n흥... 겁쟁이군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/095"
msgid "나는 너야. 너의 마음속에 있는 또 다른 너. 그런데... 너 요새 너무하지 않니?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/096"
msgid "뭐가? 뭐가 너무하다는 거지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/097"
msgid "무엇을 위해서 그렇게 미친듯이 다니고 있는 것이지? 도데체 나보다 더 중요한 것이 무엇이길래? 이제 좀 쉬면 안돼?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/098"
msgid "세상은 세상대로 흘러가라고 하고, 우리는 쉬자. 응? 꿈결같이 따뜻한 곳에서, 어머니의 품같이 편안한 곳에서, 마치 죽은듯이, 영원한 평화를..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/099"
msgid "어떻게 하지? 나 자신의 목소리가 아닌가..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/100"
msgid "목소리의 조언에 따라 쉰다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/101"
msgid "아니야! 나는 아직 할 일이 많이 남아 있어!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/102"
msgid "남자라면, 첫째도, 둘재도 체력단련이지! 체력단련을 게을리 하지 말게나! 게이시르시티에서 군인으로 근무하는 우리 친척은 달리기 전문이지!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/103"
msgid ""
"로우엔시티. 물가는 약간 비싼 편. 유명한 군사군주 프레데릭 경 치하에 있는 안정된 도시. 좌우대칭형의 도시설계가 군사도시의 잘 짜여진 면을 보여주고 있으며, 다리와 해자로 이루어진 방벽은 제국령 최고의 방어능력을 자랑한다. 또한 이곳의 병사들은 제국령 최고의 정예부대라고 알려져 있다."
" 고급의 총기를 구할 수 있으며, 북쪽의 출구는 보르도 쪽으로 통해있다. 보르도 가는 길에는 마검이 숨겨져있다는 마검숲을 통과하게 된다. 이 근처 로우엔산 속에는 역시 전설의 검이 있다는 동굴이 있다./n- 게이시르 학술원 산하 제국지리학회 -"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/104"
msgid "전투에서 살아남기 위해서는 고급의 무기와 장비를 최대한 많이 갖추어야 한다. 비싼것은 비싼값을 한다는 것은 동서고금을 불문하고 진리인 것이다. 최고의 장비에 최고의 투사가 되는 것많이 혼란한 세상을 살아가는 지름길인 것이다./n- 게이시르 학술원 산하 전술연구회 -"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/105"
msgid "이제, 당신은 전란의 시기로 들어설 것입니다. 정신없이 몰아치는 당신의 운명은 앞으로 당신이 자신을 돌아 볼 여유를 주지 않을 것입니다. 당신은 지금, 준비할 수 있는 기회인 지금, 모든것을 든든히 준비해서 후일에 대비해야 합니다. /n-로우엔의 고 예언가 할머니께서 누군가에게 남긴 유언-"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/106"
msgid "[지리학회 회원]/n던젼은 너무나도 위험해서, 우리 지리학회의 발걸음이 전혀 미치지 않은 미지의 지역이지. 그곳에서 살아남기 위해서는 지도를 제작하면서 다녀야 해."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/107"
msgid "[지리학회 회원]/n가장자리로 다니면 적을 적게 만난다는 만고불변의 진리를 모르고 있는 것은 아니겠지? 혹시 던젼에 들어가서 지도를 만들게 되면 후손을 위해서 우리들에게 전해주게나. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/108"
msgid "[지리학회회원]/n자네 손에 게이시르 전역의 여행자들의 안전이 달려 있다는 것을 잊지말게! 주소는 \"게이시르령 게이시르시티 스타이너가 23번지 게이시르 제국 학술원산하 지리연구학회 지도제작국장앞\" 라고 쓰면 된다네!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/109"
msgid "[지리학회 회원]/n아니, 당신은...! 리브레빌의 썬더메어 동굴에 갔다 왔군요! 오오... 그곳은 수많은 우리 지리학회 회원들의 목숨을 앗아간 위험한 동굴! 그곳의 지도는 그리셨겠죠? 제발, 제발 저에게 그곳의 지리를 알려주십시오!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/110"
msgid "동굴의 지리...? 그곳을 갖다 온지 오래되서 기억이 에매모호 한데...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/111"
msgid "[지리학회 회원]/n대충이라도 좋습니다. 제발 제발 알려주세요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/112"
msgid "이거 어떻게 한다? 도와줄까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/113"
msgid "시간을 내어 지도제작을 도와준다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/114"
msgid "귀찮다. 무시한다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/115"
msgid "좋아요. 제가 갖고 있는 기억으로 지도 제작을 도와주겠어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/116"
msgid "[지리학회 회원]/n감사합니다.정말 감사합니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/117"
msgid "[지리학회 회원]/n정말로 감사합니다. 이 은혜는 전 지리학회 회원들이 잊지 못할 것입니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/118"
msgid "[지리학회 회원]/n제발... 제발 저에게 동굴의 지도를 알려주십시오. 사례는 충분히 하겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/119"
msgid "실버젬을 얻었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/120"
msgid "어떡하지? 실버젬 까지 받았는데, 그냥 알려줄까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro01
msgctxt "field|ko|art_ko_fltro01|@kfltro01/121"
