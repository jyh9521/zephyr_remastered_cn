#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/012"
msgid "…하여튼 대장의 고집은…/70d/n알겠습니다./35d 저희는 먼저 가서 기다리겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/013"
msgid "곧 구해줄 테니,/10d 조금만 기다리시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/014"
msgid "이런…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/015"
msgid "…/45d괜한 짓이야./40d/n이 문은 화약으로도 부술 수 없어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/016"
msgid "훗,/40d 화약으로는 안될 지 몰라도,/30d/n이 검이라면 통할걸!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/017"
msgid "대단하군…/50d 멋진 솜씨야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/018"
msgid "훗,/30d 감탄은 나중에 해도 늦지 않지./45d/n걸을 수는 있겠소?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/019"
msgid "좋아,/10d 열렸군!/25d 빨리 탈출하지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/020"
msgid "[카인]/n구해주러 오셨군요,/20d 메디치 대장님!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/021"
msgid "밀레,/10d 구해주러 왔다./25d 어서 탈출해라!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/022"
msgid "[밀레]/n메디치 대장,/10d 감사합니다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/023"
msgid "감옥에 폭약을 설치하고 있다./30d 빨리 탈출하자!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/024"
msgid "[어윈]/n오,/25d 메디치 대장."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/025"
msgid "[카인]/n먼저 가십시오./25d 저도 곧 탈출하겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/026"
msgid "[밀레]/n옆 방에는/15d 카인과 어윈도 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/027"
msgid "[어윈]/n바로 옆 서쪽 방에 있는/15d 백발 죄수도 같이 구해주십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/028"
msgid "녀석들,/20d 엄청나게 몰려드는군./30d/n아무래도 이쪽은 안되겠는걸!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/029"
msgid "안 돼,/15d 이쪽 길로는 곤란하다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/030"
msgid "별 수 없지./25d 뛰어내린다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/031"
msgid "잠깐,/20d 그 쪽은…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/032"
msgid "탈주자를 잡아라!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/033"
msgid "서라!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/034"
msgid "이런,/35d 성미도 급하긴…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/035"
msgid "경비병이…!/30d 할 수 없군!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/036"
msgid "자, 어서/15d 동료들을 구하자!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/037"
msgid "인페르노 지하 감옥"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/043"
msgid "……!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/044"
msgid "아,/40d 물론이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/045"
msgid "13년 동안 유황에 시달려와서/45d 노인으로나 보이겠지만…/45d/n그 정도 나이는 아니야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/047"
msgid "폭파 예정 시간이 다가오고 있으니/20d/n안타깝지만/15d 이 방의 죄수는 포기해야 할 것 같습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/048"
msgid "…/40d나를…/35d 구해준다고?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/052"
msgid "이 문은 쉽지 않군 그래."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s04
msgctxt "field|re|art_fl00_s04|@kfl00_s04/054"
msgid "주신교도 어지간히 하는군…/60d/n그럼 빨리 가지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/000"
msgid "인페르노 외곽"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/001"
msgid "대장!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/002"
msgid "그보다,/25d 모두 무사한가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/003"
msgid "예./30d 다행히 피해는 없습니다./30d/n대부분 가벼운 경상에 불과합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/004"
msgid "하하,/45d 작전은 성공이군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/005"
msgid "그럼 예정대로/15d 여기서 산개,/30d/n제2집결지로 이동한다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/006"
msgid "제1부대/15d 해산!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/007"
msgid "예!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/008"
msgid "예!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/009"
msgid "늦어서 걱정했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/010"
msgid "후후,/40d 언제나 있는 일 아닌가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/011"
msgid "당신은 이제/15d 어떻게 할 생각이지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/012"
msgid "특별한 일이 없다면/30d/n우리 제피르 팰컨에 동참하지 않겠나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/013"
msgid "미안하군./40d 나는 지금부터 해야만 하는 일이 있어./40d/n아주 중요한…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/014"
msgid "그런가,/30d 그럼 어쩔 수 없지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/015"
msgid "이제 헤어져야겠군./40d/n그럼, 이만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/016"
msgid "메디치 대장…/15d 이라고 했던가."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/017"
msgid "음…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/018"
msgid "이 은혜는/35d 평생 잊지 않겠다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/019"
msgid "하하!/45d 그건 고맙지만,/25d/n제피르 팰컨으로서 당연히 해야할 일을 했을 뿐이다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/020"
msgid "하지만 모처럼이니/30d 통성명이라도 해 둘까./50d/n나는 제피르 팰컨 제1부대장/40d 로베르토 데 메디치!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/021"
msgid "그렇군./30d/n시라노,/25d 당신의 행운을 빌어주지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/022"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s08
msgctxt "field|re|art_fl00_s08|@kfl00_s08/023"
msgid "13년만의 하늘인가."
