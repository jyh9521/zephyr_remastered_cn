#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/008"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/009"
msgid "세상에…/35d 클라우제비츠가/15d 괴도 샤른호스트였다니!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/010"
msgid "…/45d사정이 있어서/35d 정체를 숨긴 채 활동하고 있었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/011"
msgid "당신이 저를/20d 수중도시에서 구해주신 건가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/012"
msgid "어디까지 기억나십니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/013"
msgid "파괴신에 흡수되고 나서…/50d/n시라노 씨를 공격했던 것 까지는 기억나지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/014"
msgid "당신은/40d 에스메랄다 님의 희생으로/30d 파괴신으로부터 분리된 후,/45d/n시라노 님의 희생으로 살아난 것입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/015"
msgid "나를 위해…/35d 에스메랄다 씨와 시라노 씨가…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/016"
msgid "하지만…/40d 대체 왜…/35d/n왜 시라노 씨는/10d 자신을 죽이려고 한 저를 구해준 거죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/017"
msgid "그 이유는/25d 저도 모르겠습니다./45d/n하지만/30d 한가지 확실한 것이 있습니다./55d/n시라노 님은/20d 프레데릭 경도,/20d 프레데릭 부인도/20d 해치지는 않았다는 것입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/018"
msgid "프레데릭 경의 시신을 자세히 조사한 결과,/55d/n체사레 추기경의 수하인/30d 암흑살수의/n공격 흔적이 발견되었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/019"
msgid "뭐라고요?/65d 그럼/35d 할아버지가/40d 아버지를…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/020"
msgid "그뿐 아니라,/30d 프레데릭 부인도/20d 독극물에 의해/15d/n사망했다는 정보도 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/021"
msgid "만약 복수를 위해 갔다고 하더라도…/50d/n시라노 님 정도의 사람이/25d 독을 사용했을 것이라고는/15d/n생각하기 어렵습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/022"
msgid "설마…/50d 어머니도?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/023"
msgid "시라노 님이 돌아가신 이상/30d 진상을 알 수는 없습니다만…/40d/n분명한 것은/35d 이 일에/25d 체사레 추기경이 개입되어 있다는 사실입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/024"
msgid "…어머니도…/40d 시라노 씨를 잘 알고 있는 것 같았어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/025"
msgid "어머니가 그 곡을 가르쳐 주실 때,/60d 이 곡을 아는 사람은/40d/n이제 어머니와 저 밖에 없다고 하셨거든요./70d/n뭔가/40d 그리워 하는 표정을 지으면서…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/026"
msgid "저도/30d 시라노 님을 초대한 부인의 행동도,/45d/n또 초대를 받고 단신으로 사지를 찾아간/30d/n시라노 님의 행동도/20d 이해할 수 없었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/027"
msgid "짐작컨데,/50d 두 분은 과거에 어떤…/50d/n인연을 가지고 계셨던 것 같습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/028"
msgid "아무리 그렇다고 해도…/45d/n자신의 생명을 버리면서까지/15d 저를…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/029"
msgid "아무래도 시라노 님에게/35d 크리스티나 님은/35d/n소중한 분이셨던 것 같습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/030"
msgid "제게/30d 크리스티나 님의 뒤를 부탁한다는 말씀까지/30d 남기신 걸 보면…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/031"
msgid "…할아버지는/40d 모든 일의 내막을 알고 계실거예요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/032"
msgid "그리고 저는/15d 아버지와 어머니,/30d/n그리고 시라노 씨를 대신해서/30d/n할아버지의 야망을 저지할 책임이 있어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/033"
msgid "체사레 추기경은/40d 아마도/25d 비프로스트의 원군을/n다시 요청하기 위해/35d 직접 나섰을 겁니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/034"
msgid "비프로스트의 재침공으로부터/45d 이 땅을 지켜내기 위해서는,/40d/n프레데릭 가문의 정통 후계자인/10d 크리스…/40d/n아니,/30d 크리스티나/30d 당신이 일어서야 합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/035"
msgid "알겠어요,/15d 클라우제비츠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/036"
msgid "그럼,/40d 분열된 제피르 팰컨을/20d 다시 집결시키기 위해/35d/n우선/15d 메디치 님부터 찾아야겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/037"
msgid "메디치 씨는 어디에 계실까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/038"
msgid "평소 성격으로 봐서는,/50d/n여기저기/25d 술집을 전전하고 있을지도 모르겠군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/039"
msgid "게다가 본인도 상당한 독을 마신 상태였기도 했지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/040"
msgid "그럴 리가 없어요!/40d/n어머니는 할아버지의 하나뿐인 딸이란 말이에요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/041"
msgid "하지만/40d 시라노 씨도 그 곡을 알고 있었어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/047"
msgid "지난 번 피아노 곡의 일도 그렇고…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/052"
msgid "알프레드 프레데릭 경의 유지를 이어받아,/50d 우리 제피르 팰컨과/30d 힘을 합쳐야 합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl18_s05
msgctxt "field|re|art_fl18_s05|@kfl18_s05/058"
msgid "그리고 샤른호스트… 당신이 왜?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/000"
msgid "…/55d다 꺼져버려!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/001"
msgid "응? 무슨 일이지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/002"
msgid "이거 원,/30d 불안해서 술을 마실 수나 있겠어?/40d/n여기도 이제 올 곳이 못되는구만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/003"
msgid "결국/10d 로우엔으로 다시 돌아와 버렸군요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/004"
msgid "메디치 님이/35d 제국령을 떠나진 않으셨을 텐데…/55d 대체 어디에…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/005"
msgid "??"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/006"
msgid "에잇,/15d 재수가 없으려니까 별…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/007"
msgid "클라우제비츠,/35d 혹시…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/008"
msgid "그러고 보니,/30d 로우엔의 술집은/25d 아직 들러보지 않았군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/009"
msgid "이봐, 주인장!/45d 내가 누군지 아나?/15d 응?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/010"
msgid "어서 들어가 보죠!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/011"
msgid "[주점 주인]/n…/45d손님이 누구신지/15d 제가 어떻게 알겠습니까./35d/n돈은 받지 않을테니,/20d 진정하시고/25d 그만 돌아가 주세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/012"
msgid "뭐야?/55d/n이 메디치가/30d 돈이나 떼어 먹을 인간으로 밖에 안보이나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/013"
msgid "메디치 씨!/30d 여기 있었군요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/014"
msgid "뭐야,/10d 너희들은."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/015"
msgid "클라우제비츠 군사!/50d 크리스티나…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/016"
msgid "이자벨 님,/35d 메디치 님은/15d 어떻습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/017"
msgid "보시다시피…/45d 그리 좋다고 할 수는 없네요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/018"
msgid "메디치 씨,/30d 정말 한심하군요./40d/n로베르토 데 메디치의 이름이 부끄럽지 않나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/019"
msgid "로베르토 데 메디치의…/55d 이름이라고…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/020"
msgid "젠장…/60d 이제와서 나한테/25d 뭘 바라는거야…/50d/n이 무능한 내가…/45d 대체 뭘 할 수 있다고…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/021"
msgid "시라노…/50d 그의 죽음도/30d 내 책임이야…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/022"
msgid "메디치 씨,/45d 당신의 잘못이 아니에요./40d/n시라노 씨의 죽음은/15d 제 책임입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/023"
msgid "복수심에 사로잡힌 저는/45d 파괴신 부활에 몸을 던졌어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/024"
msgid "시라노 씨의 생명을 대가로 살아난 저는,/50d/n그의 희생이 헛되이 하지 않기 위해/20d 최선을 다해 살아갈 거예요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/025"
msgid "메디치 씨,/45d 아직 늦지 않았어요./40d/n우리 손으로,/25d 함께 제피르 팰컨을 다시 일으키는 거예요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/026"
msgid "내가…/45d 해낼 수 있을까…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/027"
msgid "당신은/30d 제피르 팰컨의 실질적 리더,/45d 로베르토 데 메디치예요./40d/n당신 밖에는 할 수 없어요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/028"
msgid "…/50d그래,/15d 해 보겠어./45d 그의 죽음을/15d 헛되게 할 수는 없지…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/029"
msgid "그런 저를 살리기 위해…/45d 시라노 씨가 희생한 거예요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/030"
msgid "크리스티나…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/031"
msgid "제 19 장"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s01
msgctxt "field|re|art_fl19_s01|@kfl19_s01/032"
msgid "최후의 작전"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/000"
msgid "비프로스트, 어전"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/001"
msgid "흥미로운 제안이군요./30d 체사레 추기경."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/002"
msgid "지난번 출병 때의 치욕을/50d/n그대로 마음속에 담아둘 생각은 아니시겠지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/003"
msgid "이번에야말로/25d 반란군들과/10d 그에 동조하는 영주들을 일소할/30d/n좋은 기회입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/004"
msgid "흐음…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/005"
msgid "게다가/25d 발굴에 성공한/25d 마장기 아스카론의 성능도/50d/n시험해 보아야 하지 않겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/006"
msgid "허허,/25d 대단하시군요./35d/n그 일은/20d 1급 기밀사항으로 되어 있을 텐데요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/007"
msgid "무엇을 망설이십니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/008"
msgid "저의 제국 통일에/15d 힘을 보태주신다면/50d/n통일 제국 영토의/25d 절반을 공여하겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/009"
msgid "오호라?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/010"
msgid "추기경 각하!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/011"
msgid "여기까지 온 이상 어쩔 수 없네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/012"
msgid "역시,/30d 체사레 추기경은/20d 요점을 정확히 짚으시는군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/013"
msgid "좋습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/014"
msgid "다시 한번/15d 우리 비프로스트군과/30d/n아스카론을 움직이도록 하지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/015"
msgid "저는/25d 팬드래건에 사절을 보내,/25d/n제국이 반란군에 의해/35d 통제불능 상태에 빠져있어/35d/n귀국에 도움을 요청했다는 서한을 전하도록 하겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/016"
msgid "아무리 팬드래건이라 해도,/40d/n내정 문제인 이상/25d 쉽사리 개입할 수는 없을 것입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl19_s02
msgctxt "field|re|art_fl19_s02|@kfl19_s02/017"
msgid "안 그래도 팬드래건은/45d 투르족과의 전쟁으로/20d/n정신없는 모양이니,/40d 그들도 별 수 없을 겁니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/000"
msgid "제피르 팰컨, 작전회의실"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/001"
msgid "급보입니다./30d/n체사레 추기경이/30d 또다시/15d 비프로스트군을 일으켰습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/002"
msgid "그놈들,/25d 아직도 혼이 덜 났군./40d 이번 기회에 아주 박살을…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/003"
msgid "이번 침공은/15d 그리 만만하지 않습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/004"
msgid "얼마 전/10d 발굴에 성공한/25d 1급 마장기,/20d 아스카론이 투입된다고 합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/005"
msgid "설마,/30d 아스카론이…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/006"
msgid "1급 마장기는/35d 부대의 사기와 전력에/25d/n절대적인 영향을 줍니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/007"
msgid "정상적인 전법으로는/30d 통용되지 않는 상대지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/008"
msgid "그래서,/20d 작전은?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/009"
msgid "적의 본진이 주둔하고 있는/35d 망티고아봉으로 출병할 것을 제안합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/010"
msgid "적의 본진을…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/011"
msgid "소수 정예부대를 조직하여/35d 적의 사령부를 일거 제압한다면,/30d/n충분히 승산이 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/012"
msgid "그렇다고 해도…/35d 아스카론은 누가 상대하지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/013"
msgid "그 점은/25d 걱정하지 않으셔도 됩니다./45d/n이미 몇 가지 대안을 강구해 놓았습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/014"
msgid "그리고 이번 작전이,/45d 제피르 팰컨/20d 최후의 작전이 될 것입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/015"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/016"
msgid "마지막까지…/40d 힘을 내어 싸워주시기 바랍니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/017"
msgid "여러분,/35d 우리는 지난 전투에서/50d 너무나도 많은 동료들을 잃었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/018"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/019"
msgid "아,/35d 그리고 메디치 님에게/30d 칼을 한 자루 드리겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/020"
msgid "음…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/021"
msgid "코드 네임/20d PSX-9,/35d '아르마다' 입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/022"
msgid "'아르마다'라면,/25d 팬드래건에서 비밀리에 테스트하고 있다는/30d 차세대 제식검이 아닌가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s01
msgctxt "field|re|art_fl20_s01|@kfl20_s01/023"
msgid "그렇습니다./35d 전에 드린 '블릿츠'의 후계모델로 경합중인/35d/n크리사오르의 신형검입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/000"
msgid "오랜만이군요,/35d 프레데릭 각하."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/001"
msgid "라시드 왕자…/45d 3년 만이던가요./45d/n시간이 참 빠르군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/002"
msgid "제국을 훌륭히 이끌고 계신 것 같더군요./60d/n정말 감탄했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/003"
msgid "메디치 경의 도움이 없었다면/25d 힘들었을 거예요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/004"
msgid "아,/30d 메디치 경…/60d 그도/25d 열심히 해 주고 계시는 것 같군요./50d/n메디치 부인도/35d 안녕하시겠지요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/005"
msgid "이자벨도 잘 지내고 있어요./40d/n그녀도/30d 큰 버팀목이 되어주고 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/006"
msgid "프레데릭 가문과/30d 메디치 가문…/55d/n이제는/30d 제국령이 안정세에 들어간 것 같아/40d/n마음이 놓입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/007"
msgid "이 평화의 초석도/40d 라시드 왕자가 놓아준 것이잖아요./40d/n진심으로/15d 감사하고 있어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/008"
msgid "그렇게 말씀해주시니 기쁘지만,/55d/n저는/30d 약간의 힘을 보탰을 뿐입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/009"
msgid "우리가 진정/20d 잊지 않고/35d 감사를 드려야 할 사람은…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/010"
msgid "시라노…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/011"
msgid "네,/35d 시라노 번스타인./70d/n그 분이야말로/30d 지금의 제국을 있게 해준 은인이자,/55d/n우리에게/25d 깨우침을 준 사람…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/012"
msgid "맞아요./45d 그 분의 희생이 아니었다면…/60d/n결코 잊을 수 없겠죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/013"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/014"
msgid "팬드래건으로는/30d 언제 돌아가시죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/015"
msgid "한동안은/20d 계획이 없습니다./55d 전쟁의 불길이/25d/n다시 타오르기 전에/30d 고향에 다녀올 생각입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/016"
msgid "아버님의 묘소에도 들를 겸…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/017"
msgid "동방 대륙 말씀이신가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/018"
msgid "네./45d 못 가본 지/20d 15년 정도 된 데다,/40d/n제가 그곳을 떠날 때에도/30d 계속 전쟁 중이었으니…/45d/n지금쯤/40d 많이 변했을 겁니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/019"
msgid "그럼/35d 다음에 뵐 수 있는 것도/30d 몇 년 후의 일이겠군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/020"
msgid "몇 년이나 걸릴지/35d 기약할 수는 없지만…/55d/n원래 제국의 것이었던/15d 마검 아수라를/30d/n제가 맡아두고 있으니,/35d 언젠가는/30d 꼭 다시 만날 겁니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/021"
msgid "그동안,/40d 저는/5d 더욱 강하고/40d 풍요로운 제국을 만들기 위해/15d/n노력하고 있겠습니다./70d 기대하세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/022"
msgid "크리스티나 프레데릭이라면,/45d/n분명 제 기대에/25d 어긋나지 않겠지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/023"
msgid "네,/35d 반드시…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/024"
msgid "뜻하는 바를/35d 이루시길 빌겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/025"
msgid "4년 후, 수중도시 입구"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/034"
msgid "당신을 부탁한다는/30d 약속도 있으니까요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/035"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/036"
msgid "에필로그"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl20_s02
msgctxt "field|re|art_fl20_s02|@kfl20_s02/037"
msgid "그가 남기고 간 것"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/000"
msgid "제피르 팰컨, 작전회의실"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/001"
msgid "크리스…/25d 아니,/25d 크리스티나 프레데릭이/30d 프레데릭 장군의 뒤를 이어/n최고 지휘관이 되었다고 합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/002"
msgid "크리스가?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/003"
msgid "그리고 조금 전,/40d/n우리 제피르 팰컨에게 선전포고를 해 왔습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/004"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/005"
msgid "설마…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/006"
msgid "아시다시피,/25d 프레데릭군은 제국 최강의 정예 부대입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/007"
msgid "게다가,/30d 크리스티나 만큼/30d 우리 내부 사정에 대해 잘 아는 사람도 없겠지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/008"
msgid "크리스가 마음만 먹으면,/15d 제피르 팰컨 따위는 손쉽게 무너트릴 수 있다는 건가."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/009"
msgid "그래서,/35d 이번에는/15d 크리스티나의 배후 세력인 주신교의 본거지,/45d/n게이시르 시티의 대성당을 습격할 생각입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/010"
msgid "대성당을 직접…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/011"
msgid "본거지인 제국 학술원과/15d 대성당을 제압한다면,/60d 주신교는 물론 크리스티나 측에도 큰 타격을 주게 될 것입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/012"
msgid "방어보다는/30d 선공하는 작전이라는 거군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/013"
msgid "그렇습니다./35d 기회는 지금밖에 없으니,/30d 다들 힘을 내 주십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/014"
msgid "회의는 이상입니다./35d 게이시르 시티로 이동하겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/015"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/016"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/017"
msgid "프레데릭 장군의 사망으로,/35d 전황이 급격히 바뀌었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/018"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/019"
msgid "내용은 간단합니다./45d/n'전멸당하고 싶지 않으면 무조건 항복하라.'"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/020"
msgid "상당히 과격한걸."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/021"
msgid "오늘은 보르스가 없군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/022"
msgid "서랍 안에 뭐가 들어있길래…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/023"
msgid "서랍을 열어보겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/024"
msgid "미안하지만 살짝 열어보자."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
