#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmpx23
msgctxt "field|ko|art_ko_flmpx23|@kflmpx23/001"
msgid "<< 피닉스의 동굴 >>/n1000년에 한번,/n불새는 자신의 몸을 태워/n새로운 생명을 잉태한다./n/n무릇, 가장 소중한 것을 얻기 위해서는/n자신의 가장 귀한 것을 희생해야 하나니.../n/n모험가 라르고"
msgstr ""

