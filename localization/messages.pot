#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/004"
msgid "어서오세용"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/005"
msgid "미르..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/006"
msgid "빠이"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/007"
msgid "최근에 사막에서는 도적 떼들이 설치고 있다네. 덕택에 나도 이번에 죽을 위기를 많이 넘겼다고."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/008"
msgid "상당히 더운 곳에서 사는 사람들은 대체로 성격이 느긋해 지지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/009"
msgid "이루스님이 칼을 쓰는 것을 보신적이 있나요? 얼마나 박력있다고요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/010"
msgid "어? 당신들은 처음 보는 사람들인데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/011"
msgid "당신들 칼스님이 남기셨다는 검에 대해 알고 있소?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/012"
msgid "샤른호스트가 이근방에도 나타났다는 소문이..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/013"
msgid "에스테 로데님은 비프로스트의 죠세핀님과 함께 북방의 두미인으로 꼽히고 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/014"
msgid "누가 듣지는 않았겠지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/015"
msgid "제국황실은 흑태자님이후 맥이 끊겼다고 할수 있지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/016"
msgid "투르족의 과학기술은 상상이상이라 하더군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/017"
msgid "사이럽스의 니카차라면 나도 알고 있어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/018"
msgid "훗, 나는 중년의 낭만을 즐기는 한가로운 귀족이라네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/019"
msgid "풍류와 낭만이야 말로 이곳 안타리아에서 살아가는 진정한 낙이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/020"
msgid "나는 루벤녀석같이 비밀통로나 이곳저곳에 만드는 취미는 없어. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/021"
msgid "이곳은 리브레빌시 입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/022"
msgid "이곳은 리브레빌 시티입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/023"
msgid "음악가 니카차씨를 아시나요? 사이럽스의 인기인 이랍니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/024"
msgid "이곳의 영주님은 정말 아름다우시답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/025"
msgid "로우엔시티 서부"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/026"
msgid "이곳은 리브레빌시 입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/027"
msgid "마검의 숲에는 칼스님의 검이 숨겨져 있다는데...위험해서..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/028"
msgid "우리 로우엔의 북쪽에는 보르도라는 마을이 있어요. 경치가 아름다운 곳이지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/029"
msgid "최근에 보르도 근처에 가는데 이상한 안경을 쓴 사람들이 지나다니는 것을 본 적이 있어요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/030"
msgid "보르도 쪽으로 가는 길에는 깊은 숲이 있는데, 그곳은 예로부터 이상한 전설이 내려오곤 했었지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/030_3"
msgid "보르도 쪽으로 가는 길에는 깊은 숲이 있지. 그곳은 예로부터 이상한 전설이 내려오곤 했었지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/031"
msgid "지금은 칼스님의 검이 숨겨저 있다는 말이 돌더군... 뭐, 처음에 들었을때는 \"또야?\"하는 생각이 들기도 했지만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/031_3"
msgid "지금은 칼스님의 검이 숨겨저 있다는 말이 돌더군..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/032"
msgid "요새 전국에 있는 제피르 팰컨 일당과 각지의 영주들 간의 싸움이 점점 심화 되가고 있다고 하더군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/032_3"
msgid "요새 전국에 있는 제피르 팰컨 일당을 우리 프레데릭 영주님께서 공격하셨다고 하시던데요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/033"
msgid "제피르 팰컨은 돈 많은 사람들만 노리는 도둑집단이라면서? 큰일이야... 그런 놈들이 활개를 치고 있다니. 이곳 로우엔은 프레데릭 영주님이 잘 지키고 계시니..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/033_3"
msgid "제피르 팰컨은 돈 많은 사람들만 노리는 도둑집단이라고 하던데요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/034"
msgid "우리 어머니는 요새 집을 잘 비우세요. 과거에는 맛있는 것도 많이 만들어 주고 잘 웃으시던 분이었는데... 더이상은 요리를 하지도, 웃지도 않으세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/034_3"
msgid "우리 어머니는 요새 집을 잘 비우세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/035"
msgid "이게 다 아버지가 팬드래건 국경수비대의 총에 맞아 돌아가신 뒤 부터에요. 아버지는 팬드래건 국경에서 장사를 하셨었지요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/035_3"
msgid "아버지는 3년전에 하늘나라도 돌아가셨다나 봐요. 어머니는 그 뒤로 전혀 웃지를 않아요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/036"
msgid "어머니의 웃음을 보고 싶어요. 아버지를 다시 보고 싶어요. 팬드래건이 미워요. 정말로 미워요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/036_3"
msgid "어머니의 웃음을 보고 싶어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/037"
msgid "이 근처의 숲은 위험한 편이거든요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/038"
msgid "처음보는 옷에, 처음보는 안경, 그리고 처음보는 머리스타일 이었지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/039"
msgid "상당히 많은 사람들이 그 검을 찾기위해 혈안이 된 것을 보면 그 칼이 실제로 그곳에 숨겨져 있는 모양이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/040"
msgid "우리 제국 재 통합에 방해만 되는 그런 놈들은 하나도 남김없이 잡아들여야 해!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/041"
msgid "흥... 이곳 사람들은 너무나 프레데릭 경을 믿는 경향이 있지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/042"
msgid "그도, 영주고 지주일 뿐이라는 사실을 왜 직시하지 않는 것일까, 사람들은?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/043"
msgid "이곳이 다른 지역보다 사정이 좋기는 해도, 역시 영주들이 지나치게 모든것을 갖고 있는 것은 변함없는 사실이다. 이것은 바뀌어야 해!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/044"
msgid "젊은이, 처음보는 얼굴인데.. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/045"
msgid "혹시, 칼스경 이라는 말을 들어본 적이 있는가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/046"
msgid "예, 들어본 적이 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/047"
msgid "아니오, 들어본 적이 없습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/048"
msgid "칼스님에 대해 들어봤다는 이야기지.... 정말 장한 젊은이군. 그런데 젊은이, 칼스님이 사용하시던 칼이 어떤 것인지 알고 있는가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/049"
msgid "아웬은 다시 하늘에 대고 기도를 했답니다. \"저에게 빛나는 보석을 주신 하늘이여, 제게 보석을 주신 뜻 정녕 그를 위한 저의 마음을 이해 하신 것이라면, 저를 도와주세요.\""
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/050"
msgid "그러자 그녀는 마음속에서 하늘의 대답을 들었답니다. \"너의 바람은 잘 알겠다. 하지만, 그를 구하기 위해서는 희생이 필요하다.\""
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/051"
msgid "그녀는 눈을 감고 대답했습니다. \"신이여, 제 목소리를 바치겠나이다. 그가 있는 곳 까지 올라가게 해 주세요.\" "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/052"
msgid "그녀가 눈을 뜨자, 그녀는 자신이 떠오르고 있는 것을 알았지요. 그녀는 자신들을 쫓아오던 적들이 놀라서 그자리에 서 있는 동안 엘 에게로 올라갔습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/053"
msgid "그녀가 엘 곁에 갔을 때, 엘이 말했답니다. \"오, 자비로우신 분이여. 아마도 내 조국에서 오신 분 같은데 저 하나를 구하기 위해서 이런 위험을 무릅쓸 필요가 없답니다. 저는 포기하시고 당신의 귀한 몸을 보존하세요.\""
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/054"
msgid "아웬은 대답을 해 주고 싶었지만, 목소리가 나오지 않았습니다. 그녀는 말 없이 그의 쇠사슬을 푸는데 열중했지요. 하지만, 엘을 묶은 쇠사슬은 너무나 단단해서 아웬으로서도 풀 방법이 없었답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/055"
msgid "아웬은 아래쪽에서 적군이 사다리를 놓고 올라오고 있는 것을 보았습니다. 그녀는 다급해졌습니다. 이윽고, 아웬은 엘의 팔에 칼을 갖다 대었어요. 그의 팔을 자르지 않고서는 묶은 쇠사슬을 풀 방법이 없었기 때문이지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/056"
msgid "엘은 고개를 끄떡였습니다. \"자르십시오. 그것 밖에는 방법이 없는 것 같군요.\" 아웬은 눈물을 머금고 엘의 팔을 잘랐답니다. 엘은 자신의 팔이 잘리자 그 충격으로 기절했지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/057"
msgid "아웬은 엘을 사슬에서 풀기는 했지만, 내려갈 곳이 없었지요. 더군다나 적들은 사다리를 놓고 절벽을 올라오고 있었어요. 아웬은 다시한번 하늘에 빌어야만 했지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/058"
msgid "'하늘이여, 나의 자비로운 하늘이여! 이 보석을 그에게 주겠습니다. 처음에 제 소원을 들어주셨던 대로 그를 지켜주십시오. 그리고 제 목숨을 드리겠습니다. 그러니 이번엔 그를 이곳에서 빠져 나갈 수 있게 해주세요.'"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/059"
msgid "그리고 그녀는 보석을 엘의 가슴에 놓고 절벽으로 달려가 뛰어내렸습니다! 그녀가 뛰어내리는 순간에 엘은 자신의 가슴에 놓인 차가운 보석의 감촉 때문에 눈을 떳지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/060"
msgid "그 순간 엘은 보았습니다, 아웬의 머리띠가 풀리면서 그녀의 찬란한 아침햇살같은 머리가, 하얀 아침안개 같은 피부를, 그가 꿈속에서도 그리워하던 아웬이 자신을 위해 목숨을 내놓으려는 장면을... 그는 소리쳤지요. \"아웬!\" 하지만 아웬은 대답없이 아래로, 아래로 떨어져갈 뿐이었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/061"
msgid "그때, 그곳에 있던 모든 사람들은 신의 말을 들었답니다. \"그대의 엘을 향한 마음은 잘 알겠다. 나는 그대의 목숨을 거두어 들이고, 새 생명으로 화할 것이니 그대는 엘을 구하도록 하라.\""
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/062"
msgid "엘은 자신의 가슴에 놓인 보석이 눈을 뜨지 못할 정도로 강렬히 빛나는 것을 보았습니다. 그리고 그가 다시 눈을 뜨자, 그의 앞에는 못보던 거대한 새 한마리가 있었죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/063"
msgid "엘은 그 새의 눈을 응시하면서 말했답니다. \"아웬, 아웬. 당신이요?\" 새는 대답이라도 하듯이 몸을 앞으로 내밀었습니다. 엘은 그 새의 등에 탔고, 새는 하늘을 날았습니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/064"
msgid "엘의 고향 사람들은 엘이 한 팔이 없는 채로 돌아온 것도 놀랐지만, 엘이 이상한 새 한마리와 같이 온 것이 더 놀라웠습니다. 엘은 돌아온 이후로 말이 없어지고, 외진곳에 오두막을 짓고 새와 같이 살면서 돌 세공하는데 열중했지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/065"
msgid "엘은 평생에 걸쳐서 그의 가슴속에 놓였던 보석을 재생하는데 힘을 쏟았고, 이윽고 전혀 새로운 보석을 개발해 내었지요. 그것이 카오스큐브 인 것이에요. 그리고 엘이 자신의 고향으로 돌아온 이후로, 엘을 구한 새와같은 용맹하고 거대한 새가 전국에서 보이게 되었지요. 사람들은 그 새를 매라고 부른답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/066"
msgid "어때요, 재미 있으셨나요? 이 긴 이야기를 듣느라 수고하셨으니 제가 상을 드릴께요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/067"
msgid "호크아이를 얻었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/068"
msgid "당신의 앞날에 아웬과 엘의 축복이 있기를..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/069"
msgid "- 게이시르 학술원 로우엔 지부 -/n우리는 여러분들이 궁금해 하는 점에 대한 답을 갖고 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/070"
msgid "[지리학회 회원]/n이곳 로우엔시는 물가는 비교적 높은 편이지만, 강한 군대와 잘 정비된 치안등으로 매우 안정적인 삶을 누릴 수 있는 곳이죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/071"
msgid "[지리학회 회원]/n로우엔의 북쪽은 마검숲이죠. 마검숲의 북쪽은 다시 보르도 마을이고요. 사실, 마검숲은 이름과는 달리 보르도로 갈 생각만 하고 북쪽으로 직진만 하면 전혀 어렵지 않답니다. 그렇지 않고 마검이 있는 동쪽으로 꺾어지게 되면 상당히 복잡한 구조의 숲으로 들어가게 되지만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/072"
msgid "[전술연구회 회원]/n이제 상황이 상당히 급박하게 돌아가고 있지. 급작스런 상황변화는 무기정비의 틈을 주지 않는 법이니까, 가능하다면 최대한 장비를 모아놓는 것이 좋지 않을까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/073"
msgid "[검 연구회]/n옛날, 우리 연구회에 파즈라는 사람이 있었지. 그사람은 그 자신이 상당히 뛰어난 검사이기도 해서 \"쾌속의 파즈\"라고 불릴정도였어..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/074"
msgid "[검 연구회]/n하지만 그보다도 그사람을 더 유명하게 한 것은 그가 검을 고치는데 달인이라는 점이지. 검을 손질하거나 수리하는데 있어서 그사람을 따라갈 사람은 아무도 없었으니까."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/075"
msgid "[검 연구회 회원]/n팬드래건의 제식검에 대해서 들어본 적이 있습니까? SP-7 '블릿츠'라는 검이 참 좋다고 하던데... 양산형 성검 수준의 칼이라고 하더군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/076"
msgid "[검 연구회 회원]/n팬드래건에는 두개의 검의 명가가 있지요. 하나는 유명한 크리사오르고, 또 하나는 제국에는 잘 알려져 있지는 않은 모글레이 입니다. 현재 모글레이에서는 크리사오르의 \"블릿츠\"에 대항할 만한 제식검을 극비리에 개발중이라는 군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/077"
msgid "[검 연구회 회원]/n\"블릿츠\"와 모글레이의 경쟁검. 과연 어떤 것이 더 우수할까요? 단지 팬드래건왕가의 명으로 제식검들은 상당히 구하기 힘든것이 아쉽죠. 철저히 보안에 붙여서 외부인이 가져나갈 수 없게 하거든요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02
msgctxt "field|ko|art_ko_fltro02|@kfltro02/078"
msgid "[검 연구회]/n단지... 그가 검 자체에 지나치게 욕심을 내는 경우가 많은 것이 그의 단점이었지. 마지막으로 안타나나리보 근방에서 본 이후에 소식이 끊겼다네. 지금은 뭘 하는지..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02b
msgctxt "field|ko|art_ko_fltro02b|@kfltro02b/000"
msgid "이제..어떻게 해야 할까요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02b
msgctxt "field|ko|art_ko_fltro02b|@kfltro02b/001"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltro02b
msgctxt "field|ko|art_ko_fltro02b|@kfltro02b/002"
msgid "카나.."
msgstr ""

