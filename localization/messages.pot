msgid "마검의 숲"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwsw02
msgctxt "field|re|art_flwsw02|@kflwsw02/000"
msgid "북 - 보르도 지방/n동쪽길은 위험하므로 서쪽으로 돌아가시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwsw06
msgctxt "field|re|art_flwsw06|@kflwsw06/000"
msgid "이제 이쪽에 볼일은 없겠지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwsw06
msgctxt "field|re|art_flwsw06|@kflwsw06/001"
msgid "마검의 숲 외곽"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwsw09
msgctxt "field|re|art_flwsw09|@kflwsw09/000"
msgid "허허...자네 라르고라는 사람 이야기를 들어 보았는가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwsw09
msgctxt "field|re|art_flwsw09|@kflwsw09/001"
msgid "나는 그 사람의 절친한 친구인 페넬로라고 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwsw09
msgctxt "field|re|art_flwsw09|@kflwsw09/002"
msgid "내 친구 라르고는 말년에 이 제국 근방에서 무언가를 찾으려 했었어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwsw16
msgctxt "field|re|art_flwsw16|@kflwsw16/000"
msgid "칼스의 마검 '멸살지옥검'을 발견하였습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwsw16
msgctxt "field|re|art_flwsw16|@kflwsw16/001"
msgid "이 검은…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwsw16
msgctxt "field|re|art_flwsw16|@kflwsw16/002"
msgid "잠깐!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwsw16
msgctxt "field|re|art_flwsw16|@kflwsw16/003"
msgid "[조직원] /n후후후, 미안하지만 그 검은 우리가 가져가야 겠다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwsw16
msgctxt "field|re|art_flwsw16|@kflwsw16/004"
msgid "[조직원] /n그 검은 전설적인 검사 칼스의 마검!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwsw16
msgctxt "field|re|art_flwsw16|@kflwsw16/005"
msgid "[조직원] /n'그분'께서 애타게 찾고 계시던 검이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwsw16
msgctxt "field|re|art_flwsw16|@kflwsw16/006"
msgid "[조직원] /n자,덤벼라!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/000"
msgid "기다리고 있었습니다,/15d 시라노./20d/n그리고/20d 제피르 팰컨 여러분."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/001"
msgid "당신이…/25d 어떻게 이곳에?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/002"
msgid "그보다,/20d 빨리 제단으로 내려가서/25d/n크리스티나의 마음을 돌려야 합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/003"
msgid "한시라도 빨리/25d 의식을 중단시켜야 합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/004"
msgid "샤른호스트?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/005"
msgid "그런 바보같은…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/006"
msgid "믿을 수가 없네요./35d 자신의 손녀마저 이용하다니…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/007"
msgid "그런 짓도 서슴지 않는 게 체사레다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/008"
msgid "이대로 파괴신이 부활해버리면,/40d/n체사레의 야욕을 막을 수 없을 겁니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/009"
msgid "샤른호스트,/35d 나 대신 시라노와 함께 싸워줘요./50d/n나보다는/10d 당신이 더 큰 힘이 되어줄 것 같네요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/010"
msgid "알겠습니다./40d 여러분과 함께/25d 체사레를 저지해 보겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/011"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/012"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/013"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/014"
msgid "[이자벨]/n내가 지켜줄테니, 잠시 체력을 비축하세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/015"
msgid "그럼, 걱정말고 푹 쉬세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/016"
msgid "서둘러 최하층으로 향하세요./n부디 파괴신 부활을 막아내 주시길."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/017"
msgid "나는 여기서 퇴로를 확보하고 있을게요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn31
msgctxt "field|re|art_flwtn31|@kflwtn31/018"
msgid "그녀는/30d 자신의 손으로 원수를 갚겠다는 생각으로/35d/n파괴신 부활의 제물 역할을 자처한 것 같습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn32
msgctxt "field|re|art_flwtn32|@kflwtn32/000"
msgid "이 스위치는 누른 다음 한번 밟아주어야 작동하는 것이군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn35
msgctxt "field|re|art_flwtn35|@kflwtn35/000"
msgid "그럼, 전 이만 떠나가야 할 것 같습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn35
msgctxt "field|re|art_flwtn35|@kflwtn35/001"
msgid "무슨 일이요? 갑자기…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn35
msgctxt "field|re|art_flwtn35|@kflwtn35/002"
msgid "[개구리 상인]/n이런 위험한 곳에 자꾸 인간들이 오는군?/n살고 싶다면 내 물건들을 사 두라고!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn35
msgctxt "field|re|art_flwtn35|@kflwtn35/003"
msgid "개구리 무기상 수중도시 지점"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn35
msgctxt "field|re|art_flwtn35|@kflwtn35/004"
msgid "[개구리 상인]/n그럼, 행운을 빈다구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn35
msgctxt "field|re|art_flwtn35|@kflwtn35/005"
msgid "[개구리 상인]/n위험한 곳에서는 최고의 약과/n최고의 장비를 갖추어야 살 수 있지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn35
msgctxt "field|re|art_flwtn35|@kflwtn35/006"
msgid "개구리 악세사리상 수중도시 지점"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn35
msgctxt "field|re|art_flwtn35|@kflwtn35/007"
msgid "[개구리 상인]/n그저 살아서 이곳을 나가기만 하라구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn35
msgctxt "field|re|art_flwtn35|@kflwtn35/008"
msgid "[개구리 여관 주인]/n어서와요. 이곳에서 자면,/n우리 동료들이 당신을 보호해 준답니다./n가격은 겨우 100 ELD! 주무시겠어요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn35
msgctxt "field|re|art_flwtn35|@kflwtn35/009"
msgid "[개구리 여관 주인]/n홍홍홍, 속았지!/n사실은 10,000 ELD를 갖고 가겠어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn35
msgctxt "field|re|art_flwtn35|@kflwtn35/010"
msgid "흥… 자지도 않고 가다니./n가다가 게임 오버나 되라."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flwtn35
msgctxt "field|re|art_flwtn35|@kflwtn35/011"
msgid "[개구리 여관 주인]/n다음에 또 볼 일은 없을 거예요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flxca01
msgctxt "field|re|art_flxca01|@kflxca01/000"
msgid "기술추가이벤트"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flxca06
msgctxt "field|re|art_flxca06|@kflxca06/000"
msgid "이곳이 교회의 비밀 통로로군./75d 체사레는 어디에 있지?"
msgstr ""

