msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/011"
msgid "시라노...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/012"
msgid "그를 내버려 둬, 그에게는 지금 하고자 하는 일이 있어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/013"
msgid "설마...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/014"
msgid "시라노, 오늘 정말 수고가 많으셨소이다./40d 이번 전투의 영웅을 위해 건배하고 싶습니다만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/015"
msgid "...그것도 나쁘지는 않겠지./20d 하지만 나는 당신과 건배 전에 하고 싶은 일이 있소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/016"
msgid "무슨...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/017"
msgid "알프레드 프레데릭 장군, 당신에게 결투를 신청하겠소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/018"
msgid "!!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/019"
msgid "!!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/020"
msgid "!!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/021"
msgid "갑자기 무슨 말이예요, 시라노!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/022"
msgid "하하하, 이러지 마십시요./30d /n내게 무슨 칼 솜씨가 있다고 현 제국령 최고의 검사와 대적을 하겠소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/023"
msgid "내 말을 잘 이해하지 못한 모양인데,/30d 내가 원하는 것은 당신과의 검술대련이 아니라 당신의 그 목숨이오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/024"
msgid "시라노...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/025"
msgid "...곤란하군./30d 당신이 내게 무슨 악 감정이 있는지는 모르겠지만, 지금은 우리 연합군의 승리를 축하하는 연회중이 아니겠소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/026"
msgid "설사 당신의 결투를 받아들이는 일이 있다고 할지라도 이 자리에서는 할 수 없소이다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/027"
msgid "내일 아침 동트기 직전, 장소는 바로 이 계곡의 뒷 봉우리에서, 물론 단신으로."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/028"
msgid "늦지 않길 바라겠소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/029"
msgid "정말로 무례한 사람이로군! 그런 일방적인 결투 신청은 받아들일 수 없소!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/030"
msgid "일방적인 결투 신청? 무고한 상대를 결투라는 이름으로 죽인자가 자신은 받아 들일 수 없다고?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/031"
msgid "무슨 소리를 하는 거냐!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/032"
msgid "우리 장군님은 그런 짓을 할 사람이 아니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/033"
msgid "이건 모독입니다, 장군님!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/034"
msgid "시라노, 제발 장군에게 사과하고 결투 신청을 거두어 주세요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/035"
msgid "시라노!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/036"
msgid "그렇게 까지 말하니 좋소, 결투 신청을 받아 들이도록 하지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/037"
msgid "하지만, 이 결투 신청을 받아 들이는 것은 결코 당신 말이 옳기 때문이 아니오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/038"
msgid "나는 지금까지의 내 행동에 한 점 부끄러움이 없음을 밝히기 위해 당신의 결투를 받아들이는 것 뿐이오!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/039"
msgid "두고보면 알게 될 일이겠지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/040"
msgid "시라노 님, 이게 무슨 짓입니까."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/041"
msgid "군사에게는 미안하게 됐군. 나 때문에 이 연합에 차질이 있을 테니."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/042"
msgid "아닙니다. 시라노 님의 이런 행동에는 이유가 있으리라 생각합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/043"
msgid "우리에게 말씀하지 못할 사정이 있으신 거겠지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/044"
msgid "우리는 그렇게 알고 있을테니, 기대에 어긋나는 행동은 않으시겠지요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/045"
msgid "예!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/046"
msgid "내일은 따라오지 말도록 해."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/047"
msgid "안됩니다, 저도 데려가 주세요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/048"
msgid "프레데릭은 분명히 단신으로 온다. 만에 하나 내가 그의 칼앞에 무릎꿇어 목숨을 위협받게 된다면 네가 손을 쓰지 않을 자신이 있나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/049"
msgid "그건...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/050"
msgid "나는 저자와의 대결에서 목숨을 잃어도 좋다. 다만, 반드시 밝히고 싶은 것이 있기 때문에 정당한 결투를 원해."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/051"
msgid "...알겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s01
msgctxt "field|ko|art_ko_fl15_s01|@kfl15_s01/052"
msgid "글쎄..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s02
msgctxt "field|ko|art_ko_fl15_s02|@kfl15_s02/000"
msgid "동틀 때 까지는 조금 시간이 남았나..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s02
msgctxt "field|ko|art_ko_fl15_s02|@kfl15_s02/001"
msgid "과연, 약속은 정확히 지키는군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s02
msgctxt "field|ko|art_ko_fl15_s02|@kfl15_s02/002"
msgid "물론이오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s02
msgctxt "field|ko|art_ko_fl15_s02|@kfl15_s02/003"
msgid "아, 그리고 한가지./30d 이제와서 결투 신청의 이유를 묻는다고 해도 답해줄리 없을테지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s02
msgctxt "field|ko|art_ko_fl15_s02|@kfl15_s02/004"
msgid "잘 알고 있군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s02
msgctxt "field|ko|art_ko_fl15_s02|@kfl15_s02/005"
msgid "그렇다면 긴말이 필요 없겠지!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s02
msgctxt "field|ko|art_ko_fl15_s02|@kfl15_s02/006"
msgid "과연... 명불허전이로군. 제국 최강의 검사..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s02
msgctxt "field|ko|art_ko_fl15_s02|@kfl15_s02/007"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s02
msgctxt "field|ko|art_ko_fl15_s02|@kfl15_s02/008"
msgid "자, 나의 목을 원하지 않았소? 어서 가져가시오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s02
msgctxt "field|ko|art_ko_fl15_s02|@kfl15_s02/009"
msgid "...한가지 묻고 싶은 것이 있소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s02
msgctxt "field|ko|art_ko_fl15_s02|@kfl15_s02/010"
msgid "15년전 당신과의 결투로 목숨을 잃은 루크 번스타인이라는 남자를 기억하고 있소?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s02
msgctxt "field|ko|art_ko_fl15_s02|@kfl15_s02/011"
msgid "루크 번스타인이라면..."
msgstr ""

