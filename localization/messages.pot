msgctxt "field|re|art_fl16_s02|@kfl16_s02/003"
msgid "헉…/45d 헉…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/004"
msgid "놈이 여기 있다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/005"
msgid "이제 포기해라,/30d 시라노 번스타인!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/006"
msgid "제길…/40d 하필 이럴 때…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/007"
msgid "체사레 님의 명령으로/30d 너의 목숨을 받으러 왔다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/008"
msgid "쿨럭…/50d 쿨럭…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/009"
msgid "음…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/010"
msgid "이런,/15d 싱겁게 벌써 쓰러지다니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/011"
msgid "후후후,/35d 조금만 더 참아라./35d/n곧 편하게 해줄테니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/012"
msgid "멈춰라!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/013"
msgid "그런데/15d 조금 이상해서,/40d 여기서는 제대로 치료하기 어렵겠어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/014"
msgid "아…!/20d 시라노가 쓰러져 있어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/015"
msgid "이런…/20d 한발 늦었나!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/016"
msgid "너희들은 뭐냐?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/017"
msgid "설명할 시간 따위 없어!/20d 빨리 덤벼라!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/018"
msgid "시라노는…/25d 어떻게 된거죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/019"
msgid "독을…/30d 마신 것 같아요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/020"
msgid "빨리 여기서 빠져나갑시다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s02
msgctxt "field|re|art_fl16_s02|@kfl16_s02/021"
msgid "시라노 님…!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s04
msgctxt "field|re|art_fl16_s04|@kfl16_s04/000"
msgid "에스메랄다 님…/30d/n시라노는…/20d 괜찮나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s04
msgctxt "field|re|art_fl16_s04|@kfl16_s04/001"
msgid "다행히 생명은 건졌지만…/45d/n너무 지독한 독이라/25d 완전히 해독했는데도…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s04
msgctxt "field|re|art_fl16_s04|@kfl16_s04/002"
msgid "아마…/35d 몸에 많이 무리가 갔을 거예요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s04
msgctxt "field|re|art_fl16_s04|@kfl16_s04/003"
msgid "아아…/40d 어째서 이렇게 된걸까…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s04
msgctxt "field|re|art_fl16_s04|@kfl16_s04/004"
msgid "추격자는/35d 모두 따돌린 것 같습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s04
msgctxt "field|re|art_fl16_s04|@kfl16_s04/005"
msgid "아까는…/30d 미안했어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s04
msgctxt "field|re|art_fl16_s04|@kfl16_s04/006"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s04
msgctxt "field|re|art_fl16_s04|@kfl16_s04/007"
msgid "그럼/30d 저는 이만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s04
msgctxt "field|re|art_fl16_s04|@kfl16_s04/008"
msgid "샤른호스트."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s04
msgctxt "field|re|art_fl16_s04|@kfl16_s04/009"
msgid "당신은…/35d 도대체 누구죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s04
msgctxt "field|re|art_fl16_s04|@kfl16_s04/010"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s04
msgctxt "field|re|art_fl16_s04|@kfl16_s04/011"
msgid "역시…/40d 대답해 주지 않는군요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s04
msgctxt "field|re|art_fl16_s04|@kfl16_s04/012"
msgid "잠깐."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl16_s04
msgctxt "field|re|art_fl16_s04|@kfl16_s04/013"
msgid "그때…/30d 어떻게든 말렸어야 했어…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/000"
msgid "도대체 언제까지/15d 참고만 있을 건가."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/001"
msgid "무슨 말씀이십니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/002"
msgid "저런 살인마를/10d 대체 언제까지/45d 우리 제피르 팰컨에 데리고 있을 거냐는 말이다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/003"
msgid "메디치 오빠,/25d 설마…/15d 시라노를 말하는 건 아니죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/004"
msgid "그 자 말고 살인마가 누가 또 있어./45d/n그 자식이 더 이상 멋대로 설치게 놔뒀다가는,/50d/n우리 제피르 팰컨의 이름이/25d 땅에 떨어지고 말 거야!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/005"
msgid "시민들로부터 사랑받는 영주 부부를/50d 시라노 님이 살해했다는 혐의는/35d/n확실히 우리에게 불리합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/006"
msgid "하지만/35d 뻔한 누명임을 알면서도/40d 그에게 책임을 묻겠다는 말씀이십니까,/25d 메디치 님."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/007"
msgid "누명인지 아닌지 알게 뭔가!/45d/n나는/25d 우리 제피르 팰컨의 명성에 금이 가는 것을/30d 두눈 뜨고 볼 수 없어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/008"
msgid "오빠…/30d 언제부터 그런 데 연연했었죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/009"
msgid "그리고 시라노는…/35d 실버마저 잃었단 말이에요./35d/n그런데…/30d 그런데도…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/010"
msgid "나 때문에 싸우는 건 그만 두시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/011"
msgid "시라노 님,/30d 괜찮으십니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/012"
msgid "시라노…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/013"
msgid "메디치의 생각,/35d 나는 충분히 이해할 수 있소./45d/n그리고 나는/35d 더 이상 제피르 팰컨에 몸담을 수 없소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/014"
msgid "이제 내게는…/40d 시간이 얼마 남지 않았소./45d/n주어진 시간의 끝에 다다르기 전에,/45d 그동안의 업을/25d 모두 청산하고 싶소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/015"
msgid "체사레와의 이 질긴 악연…/65d/n반드시/30d 내 손으로 매듭짓고 말겠소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/016"
msgid "저는/25d 시라노 님을 지원하기 위해/10d 병력을 이끌고/30d 게이시르 대성당으로 향할 생각입니다./45d/n메디치 님,/30d 당신은 어떻게 하시겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/017"
msgid "누가 뭐라고 해도,/25d 나는 시라노를 따를 거예요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/018"
msgid "…나는 여기 남겠어./50d/n저 자와 행동을 함께할 바에야,/30d 차라리 제피르 팰컨을 그만 두는게 낫다고!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/019"
msgid "메디치 님,/35d 당신에게서/25d 그런 말을 듣게 되다니…/40d 정말 유감입니다./55d/n그 선택에/20d 후회가 없기를 바랍니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/020"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/021"
msgid "실버 씨의 죽음도/35d 시라노,/15d 그가 자초한 일 아닌가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/022"
msgid "시라노는 우리 동료예요./35d/n오빠는 동료보다/20d 명예가 중요하다는 거예요?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/023"
msgid "에스테…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/024"
msgid "클라우제비츠 군사도 너무하네요./45d 시라노를 감싸고/n드는 건/30d 순전히 그의 힘이 필요하기 때문인 거죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/025"
msgid "어떻게 그렇게 계산적일 수가 있나요?/35d/n그런 당신들은/20d 메디치 님을 비난할 자격이 없어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/026"
msgid "……!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
msgctxt "field|re|art_fl17_s01|@kfl17_s01/027"
msgid "에스테…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl17_s01
