msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/045"
msgid "[보르스]/n다들 바쁘셔서 여기 집합할 일은/n그렇게 많지는 않습니다만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/046"
msgid "[보르스]/n회의를 놓치면 작전에 지장이 있으니/n되도록이면 참석해 주세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl09_s01
msgctxt "field|re|art_fl09_s01|@kfl09_s01/047"
