#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/008"
msgid "일단 시라노 님 앞으로 온 서신이니 알려 드리긴 했습니다만.../50d 그 내용에 크게 신경 쓰실 일은 아니리라 생각됩니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/009"
msgid "내용을... 읽어 보았나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/010"
msgid "그럴리 있겠습니까. 하지만 지금 상황에서 로우엔 측에서 오는 서한이야 뻔한 것 일테지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/011"
msgid "게다가, 프레데릭 장군의 미망인이 직접 쓴 서한이라면, 대단히 감정에 치우친 글이거나 아주 간략하고 냉정한 글. 둘중에 하나가 아니겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/012"
msgid "서한을 줘 보게나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/013"
msgid "여기 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/014"
msgid "/2c친애하는 시라노/n/n/n/n/n/n로우엔의 제 살롱에서 기다리고 있겠습니다./n/n/n/n/n/n메르세데스 프레데릭"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/015"
msgid "가야겠소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/016"
msgid "그녀가 초청을...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/017"
msgid "...시라노 님./30d 시라노 님과 프레데릭 부처가 과거에 어떤 은원이 있었는지 알 수는 없지만. 이 초청은 틀림 없는 함정입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/018"
msgid "그러나, 나는 갈 수 밖에 없소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/019"
msgid "시라노 님, 제발 냉정히 생각해 주십시요!/30d 그 곳에서 그녀가 기다린다는 보장도 없습니다! 틀림 없는 체사레의 수작입니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/020"
msgid "나는 지금 충분히 냉정하다네./n내가 지금까지 어떻게 살아왔는지를 안다면 클라우제비츠도 이해 할 수 있었을 것이오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/021"
msgid "내 모든 것을 잃는다 해도, 나는 그 곳에 갈 수 밖에 없어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/022"
msgid "미안하네, 클라우제비츠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/023"
msgid "시라노 님!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/024"
msgid "그러나, 나는 가야만하네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/025"
msgid "...생각할 시간을 주게나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/026"
msgid "어떻게 대답하겠습니까? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/027"
msgid "....../30d 알겠습니다. 시라노 님의 현명한 판단을 기다리겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/028"
msgid "메르세데스.../30d 하지만 나를 따르던 실버와 카나, 에스메랄다는..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/029"
msgid "누구를 가장 먼저 생각 할 것인가."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/030"
msgid "나에게는 메르세데스가 가장 중요하다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/031"
msgid "실버에게 작별인사도 않고 갈 수는 없다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/032"
msgid "카나..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/033"
msgid "에스메랄다가 보고 싶군..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/034"
msgid "다른 것을 생각할 필요는 없어. 지금은 메르세데스를 만나는 일이 가장 중요하다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/035"
msgid "이 것이 설사 체사레의 함정일 지라도... 그 보답이 나의 생명일 지라도 그녀를 만나고 말겠다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/036"
msgid "모두... 잘 있거라."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/037"
msgid "실버.../40d 그래, 지금까지 나를 따라준 실버에게 작별 인사조차 안하고 갈 수는 없어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/038"
msgid "그녀는 분명히 나를 붙잡을 것이다. 하지만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/039"
msgid "실버!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/040"
msgid "[실버]/n시라노!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/041"
msgid "실버...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/042"
msgid "그 곳에 혼자 가시게 할 수는 없어요, 시라노!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/043"
msgid "클라우제비츠에게 들었나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/044"
msgid "어째서... 저를 버려두고 가시려는 거죠? 그 곳에 가면 분명 무사히 돌아 올 수 없을 거예요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/045"
msgid "그 것을 알기 때문에 너와 함께 갈 수 없는 것이야, 실버."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/046"
msgid "지금까지... 정말 나를 잘 따라 주었구나. 여자의 몸으로... 힘든 일도 많았었는데."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/047"
msgid "지금 무슨... 무슨 말씀을 하시는 거예요. 정녕... 저를 두고 가시려는 겁니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/048"
msgid "분명... 내가 그 곳에 가서 무사히 돌아 올 가능성은 별로 없을 거야. 그리고, 돌아온다 하더라도 내게는 더 이상 너를 구속할 자격이 없어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/049"
msgid "안돼요... 그런 말씀..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/050"
msgid "마지막 명령이다, 실버./30d 나를 잡지마라."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/051"
msgid "그런 명령, 따를 수 없습니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/052"
msgid "그렇게도 그 여자를 만나셔야 겠다면.../40d 차라리 제 시체를 밟고 가세요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/053"
msgid "실버...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/054"
msgid "네가 나를 베더라도 나는 갈 것이다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/055"
msgid "알겠다, 실버. 가지 않겠다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/056"
msgid "네가 나를 벤다고 해도, 나는 지금까지 그녀를 만나기 위해 살아왔기 때문에 가야한다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/057"
msgid "미안하다, 실버."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/058"
msgid "시라노...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl15_s05
msgctxt "field|ko|art_ko_fl15_s05|@kfl15_s05/059"
msgid "......!"
msgstr ""

