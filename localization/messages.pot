msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltcy01
msgctxt "field|ko|art_ko_fltcy01|@kfltcy01/003"
msgid "연기라니요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltcy01
msgctxt "field|ko|art_ko_fltcy01|@kfltcy01/004"
msgid "[ 선장 ]/n나도 분통이 터지지만, 요새 해적이 너무 많이 출몰하기 때문에 당분간 다카마 항으로의 출항은 금지라는 말도 안되는 명령이오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltcy01
msgctxt "field|ko|art_ko_fltcy01|@kfltcy01/005"
msgid "[ 선장 ]/n그까짓 해적놈들 때문에 이 항로로 출항 할 수 없다니 말이나 되나! 이게 다 시장 그놈이 나를 싫어하기 때문이라는 것은 만 천하가 알고 있는걸!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltcy01
