msgctxt "field|re|art_fl25_s02|@kfl25_s02/026"
msgid "안돼!/20d 파괴신의 부활이 시작되고 있어요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl25_s02
msgctxt "field|re|art_fl25_s02|@kfl25_s02/027"
msgid "파괴신 따위가 뭐냐!/40d 상대가 무엇이든 상관없어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl25_s02
msgctxt "field|re|art_fl25_s02|@kfl25_s02/028"
msgid "시라노 님!/15d 저기에는 크리스티나가…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl25_s02
msgctxt "field|re|art_fl25_s02|@kfl25_s02/029"
msgid "어머,/45d 시라노님의 승리네요./40d/n역시/25d 당신이 최강의 검사시군요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl25_s02
msgctxt "field|re|art_fl25_s02|@kfl25_s02/030"
msgid "닥쳐라."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl25_s02
msgctxt "field|re|art_fl25_s02|@kfl25_s02/031"
msgid "네가 메디치를 사주하지 않았다면/55d 메르세데스의 죽음도 없었을거다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl25_s02
msgctxt "field|re|art_fl25_s02|@kfl25_s02/032"
msgid "안돼…/30d 제발 살려주세요,/10d 시라노 님!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl25_s02
msgctxt "field|re|art_fl25_s02|@kfl25_s02/033"
msgid "…/50d용서는 없다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl25_s02
msgctxt "field|re|art_fl25_s02|@kfl25_s02/034"
msgid "[에스테도데]/n아아악!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl25_s02
msgctxt "field|re|art_fl25_s02|@kfl25_s02/035"
msgid "……!!"
msgstr ""

