msgid "어서 마키아벨리를 추격해야 해!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma05a
msgctxt "field|re|art_flmma05a|@kflmma05a/000"
msgid "북 - 비프로스트방면"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/000"
msgid "…그런고로,/40d 이쪽은 부탁하겠네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/001"
msgid "[????]/n걱정 마시죠./40d/n공왕님께서 기다리고 계시니,/30d 길을 서두르십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/002"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/003"
msgid "마키아벨리는…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/004"
msgid "[????]/n한발 늦었군요./45d/n당신이/20d 시라노 번스타인?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/005"
msgid "…나를 알고 있군./30d 너는 누구지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/006"
msgid "내 이름은/25d 카타리나./45d/n비프로스트의 발키리 대장입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/007"
msgid "당신에게는/30d 이전부터 관심이 많았습니다./60d/n듣기로는/30d 제국 최강의 검사라지요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/008"
msgid "훗,/35d 하지만/15d 여기를 지나가려면/35d/n비프로스트 최강의 검사인/30d 저부터/35d 꺾으셔야 할 겁니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/009"
msgid "대단한 자신감이군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/010"
msgid "이쪽은 시간이 급하니,/35d 빨리 끝을 내 주지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/011"
msgid "이…/10d 이런…/30d 내가 지다니…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/012"
msgid "잘난척하더니 꼴좋군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/013"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/014"
msgid "드레이크!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/015"
msgid "으앗…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/016"
msgid "[카타리나]/n시라노 번스타인!/60d 오늘의 치욕은/40d 절대로 잊지 않겠다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/017"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/018"
msgid "이…/20d 이건…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/019"
msgid "생각보다 시간이 많이 걸렸군./45d/n서두르지 않으면/20d 마키아벨리를 따라잡을 수 없겠어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/020"
msgid "..."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/021"
msgid "이곳을 통과하면 다음 서브 퀘스트는 클리어 할 수 없게 됩니다./n계속 진행하시겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/022"
msgid "서브 퀘스트를 무시하고 진행한다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma13a
msgctxt "field|re|art_flmma13a|@kflmma13a/023"
msgid "계속 진행하지 않고 돌아간다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma14a
msgctxt "field|re|art_flmma14a|@kflmma14a/000"
msgid "망티고아산…/50d 이제 정상이 눈앞에 있습니다./50d/n어서 산 정상에 주둔하고 있는 적의 본영을 공격합시다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma14a
msgctxt "field|re|art_flmma14a|@kflmma14a/001"
msgid "체사레는 산 정상으로 도망가고 있다!/45d 빨리 쫓아야 해!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma14a
msgctxt "field|re|art_flmma14a|@kflmma14a/002"
msgid "개골. 어서와 개골."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma14a
msgctxt "field|re|art_flmma14a|@kflmma14a/003"
msgid "비밀의 개구리 상점"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma14a
msgctxt "field|re|art_flmma14a|@kflmma14a/004"
msgid "잘가라구, 개골"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma16a
msgctxt "field|re|art_flmma16a|@kflmma16a/000"
msgid "여기는 길이 없는 것 같아."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21a
msgctxt "field|re|art_flmma21a|@kflmma21a/000"
msgid "저 마장기는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21a
msgctxt "field|re|art_flmma21a|@kflmma21a/001"
msgid "역시,/40d 비프로스트의 1급 마장기/30d 아스카론이군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21a
msgctxt "field|re|art_flmma21a|@kflmma21a/002"
msgid "저게…/35d 그 전설의 마장기/35d 아스카론…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21a
msgctxt "field|re|art_flmma21a|@kflmma21a/003"
msgid "우리가 저 괴물과 싸워야 한단 말인가…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21a
msgctxt "field|re|art_flmma21a|@kflmma21a/004"
msgid "걱정 마십시오, 메디치 님./40d/n아무리 전설적인 힘을 지닌 마장기라도/45d 다루는 사람의 역량이 부족하면/30d/n그 위력을 제대로 발휘할 수 없습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21a
msgctxt "field|re|art_flmma21a|@kflmma21a/005"
msgid "저 마장기를 모는 사람은/25d 분명/25d 비프로스트 최강의 전사,/40d 발키리 대장 카타리나겠지요./45d/n하지만 그녀는/30d 마장기를 몰아본 적 없는 사람입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21a
msgctxt "field|re|art_flmma21a|@kflmma21a/006"
msgid "해볼만 한 상대죠./40d 게다가…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21a
msgctxt "field|re|art_flmma21a|@kflmma21a/007"
msgid "클라우제비츠,/25d 아스카론이 우리 쪽으로…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21b
msgctxt "field|re|art_flmma21b|@kflmma21b/000"
msgid "[카타리나]/n후후,/60d 지금껏 잘도/30d 내게 치욕을 맛보게 했겠다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21b
msgctxt "field|re|art_flmma21b|@kflmma21b/001"
msgid "[카타리나]/n하지만/30d 이번에는 어림없다./45d/n우리 비프로스트의 힘에/40d 무릎을 꿇어라!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21b
msgctxt "field|re|art_flmma21b|@kflmma21b/002"
msgid "아,/30d 이제 슬슬 올 때가 되었군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21b
msgctxt "field|re|art_flmma21b|@kflmma21b/003"
msgid "??"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21b
msgctxt "field|re|art_flmma21b|@kflmma21b/004"
msgid "부탁해 두었던 것이 도착할 시간이라,/40d/n잠시 실례하겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21b
msgctxt "field|re|art_flmma21b|@kflmma21b/005"
msgid "잠깐,/5d 클라우제비츠!/25d/n싸우는 와중에 갑자기 무슨 소린가!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21b
msgctxt "field|re|art_flmma21b|@kflmma21b/006"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21b
msgctxt "field|re|art_flmma21b|@kflmma21b/007"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21b
msgctxt "field|re|art_flmma21b|@kflmma21b/008"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21b
msgctxt "field|re|art_flmma21b|@kflmma21b/009"
msgid "크…/15d 클라우제비츠?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21b
msgctxt "field|re|art_flmma21b|@kflmma21b/010"
msgid "이게 저의 본 모습입니다./50d/n자초지종은/30d 아스카론을 쓰러트린 후에 말씀드릴 테니,/45d/n지금은/25d 해야 할 일에 집중합시다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21b
msgctxt "field|re|art_flmma21b|@kflmma21b/011"
msgid "[카타리나]/n이런 제길!/60d 왜 마장기가/20d 마음대로 움직이질 않는 거야!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21b
msgctxt "field|re|art_flmma21b|@kflmma21b/012"
msgid "…/45d역시 우리 힘 만으로/30d/n저 괴물을 쓰러트리는 건 무리인가…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21b
msgctxt "field|re|art_flmma21b|@kflmma21b/013"
msgid "[카타리나]/n…/25d아직이야…/35d 아직 안 끝났어!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21b
msgctxt "field|re|art_flmma21b|@kflmma21b/014"
msgid "??"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21b
msgctxt "field|re|art_flmma21b|@kflmma21b/015"
msgid "??"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/000"
msgid "아,/30d 아론다이트가 아닙니까…/45d 저 마장기는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/001"
msgid "팬드래건이 개입하다니…/55d/n투르족과의 전쟁은 어쩌고…/40d 이쪽으로/10d 아론다이트를 투입시켰냔 말이냐,/35d 라시드!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/002"
msgid "얼마 전부터 들리던 소문이/30d 사실이었나 봅니다…/35d/n투르 제국과 팬드래건이/30d 잠정적인 휴전에 들어갔다는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/003"
msgid "하필 이럴 때…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/004"
msgid "안돼…/35d 너무 일러!/35d/n우리 제국령은/15d 아직 통일되지 못했단 말이다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/005"
msgid "추기경 각하,/20d 이럴 때가 아닙니다./25d/n팬드래건이 개입한 이상/15d 각하의 계획은…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/006"
msgid "빨리 여기서 피해야 합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/007"
msgid "아니야,/35d 아직 방법은 있어…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/008"
msgid "내가 살아있는 한,/30d 제국은 반드시/20d 내 손으로 통일시키고 말 것이다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/009"
msgid "체사레 추기경!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/010"
msgid "헛된 꿈은 버리십시오./35d/n사람은/15d 포기할 때를 알아야 하는 법입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/011"
msgid "할아버지… "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/012"
msgid "그런 야망을 위해 무고한 사람들이 희생되는 것을…/45d/n더 이상은 용납할 수 없어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/013"
msgid "제발 부탁이에요./45d 항복해 주세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/014"
msgid "그렇게는 할 수 없어./30d 내가 포기할 줄 아느냐!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/015"
msgid "포기해,/10d 크리스티나!/25d/n저 자는 더 이상/10d 당신이 아는 할아버지가 아니야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/016"
msgid "야망에 홀린/10d 악마다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/017"
msgid "누가 감히/35d 나를 악마라 하는가!/40d 이 나를!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/018"
msgid "덤벼라!/10d 체사레!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/019"
msgid "…할아버지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/020"
msgid "울고 있나…/40d 크리스티나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/021"
msgid "네…/60d 하지만 슬프지는 않아요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/022"
msgid "할아버지께/55d 진정한 평화가 찾아와서 기쁩니다…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/023"
msgid "이제…/60d 아버지와 어머니도/55d/n편히 잠드실 수 있으시겠죠…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/024"
msgid "그리고…/65d 시라노 씨도…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/025"
msgid "다들…/40d 크리스티나,/30d 너의 강한 모습을 지켜보고/30d 기뻐하고 있을 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/026"
msgid "카나도,/25d 리델도,/10d 실버도,/25d 에스메랄다도…/40d 모두들…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/027"
msgid "그러고 보니,/35d 마키아벨리라는 놈은 어디 간 거지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/028"
msgid "그 자는/25d 내가 놓아줬습니다,/15d 메디치 님."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/029"
msgid "!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/030"
msgid "클라우제비츠!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/031"
msgid "그는 단지/35d 자신의 사상을 통해/35d 체사레와 우리에 대한 평가를/20d 후세에 남기는 것만이/25d/n목적일 뿐입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/032"
msgid "아니,/40d 그 자가 어떻게 되든 관심 없어./35d/n그보다…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/033"
msgid "자네 정체는 대체 뭔가?/55d/n클라우제비츠라는 이름도/35d 진짜 이름인가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/034"
msgid "안그래도 여러분들에게는/40d 드릴 말이 많습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21c
msgctxt "field|re|art_flmma21c|@kflmma21c/035"
msgid "하지만/40d 지금은/25d 저희 할아버지께서 기다리고 계시니,/40d/n일단 여러분도/30d 함께 가 주시지 않겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21d
msgctxt "field|re|art_flmma21d|@kflmma21d/000"
msgid "[체사레]/n파괴신의 힘을 얻은 나는/45d 더 이상 인간이 아닌,/45d 신이다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21d
msgctxt "field|re|art_flmma21d|@kflmma21d/001"
msgid "[체사레]/n내게 대항하는 자…/60d/n신성을 모독하는 자는/35d 죽음으로써 속죄할지어다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21d
msgctxt "field|re|art_flmma21d|@kflmma21d/002"
msgid "할아버지…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/000"
msgid "[클라우제비츠]/n폐하,/35d 그간 별고 없으셨습니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/001"
msgid "음,/35d 오랜만이로구나./35d/n그리고 메디치 자네도/25d 오랜만일세."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/002"
msgid "아니,/20d 총수 각하?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/003"
msgid "총수님?/45d 우리/10d 제피르 팰컨의?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/004"
msgid "총수님?/45d 폐하?/35d 대체 무슨 소리죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/005"
msgid "[클라우제비츠]/n이 분이 바로/25d 제 할아버님이시자,/35d 제피르 팰컨의 총수,/30d/n그리고/30d 팬드래건 국왕이시기도 한/35d 라시드 팬드래건/20d 1세이십니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/006"
msgid "뭐라고요…?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/007"
msgid "총수님이…/30d/n바로 그 전설의 성왕,/30d 라시드?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/008"
msgid "그리고,/35d 클라우제비츠/15d 당신의 할아버지라구요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/009"
msgid "그동안/30d 정체를 숨겨 죄송합니다./60d/n제 본명은/30d 라시드 클라우제비츠 팬드래건 3세,/55d 팬드래건/25d 제1왕자의 아들입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/010"
msgid "그렇다면/30d 당신은 팬드래건의…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/011"
msgid "클라우제비츠,/35d 샤른호스트에/15d 이제는 라시드 3세라니…/40d/n어떤게 진짜 당신인거죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/012"
msgid "하하,/45d 글쎄요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/013"
msgid "3세야,/40d 네가 일을 잘 이끌어 주었지만/30d 역시 무리수가/n많았다./70d 이번/15d 아론다이트 건도 그렇고,/40d 우리쪽 전쟁이/15d/n길어지기라도 했다면/30d 어떻게 감당할 수 있었겠느냐."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/014"
msgid "그리고,/35d 제피르 팰컨 여러분."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/015"
msgid "예,/10d 옛!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/016"
msgid "총수가/20d 다른 나라의 국왕이라는 것이/30d 기분 나쁠지도/n모르겠지만…/55d 고맙네./40d 제피르 팰컨을/20d 잘 이끌어 주었어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/017"
msgid "아아…/30d 예."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/018"
msgid "…그런데,/20d 실례되는 말씀이지만…/40d/n대륙 최고 강국의 국왕이/35d 왜 이런 비공식 단체를 조직해/25d/n다른 나라의 국정에 간섭하신 거죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/019"
msgid "허허,/55d 역시 들은대로 당찬 아가씨로군./60d/n하지만/25d 충분히 의문을 가질 만한 일이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/020"
msgid "근처에/30d 비공정/15d 린 아마디오 III가 기다리고 있으니,/40d/n함께/15d 팬드래건으로 가도록 하지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/021"
msgid "흐음…/55d 오래전 얘기로 거슬러 올라가야 할 것 같으니,/55d/n일단/30d 팬드래건 궁으로 가서 듣지 않겠나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/022"
msgid "세상에나…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmma21e
msgctxt "field|re|art_flmma21e|@kflmma21e/023"
msgid "[클라우제비츠]/n소개 드리겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flmpx01
