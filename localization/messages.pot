msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/003"
msgid "[???]/n애석하지만 그런 것 같군. 자네는 그들의 수하는 아닌 것 같은데 여기는 어떻게 들어 온건가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/004"
msgid "당신은 누구요? 그리고 그들이라니, 주신교회 세력을 말하는 것이오?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/005"
msgid "[???]/n한번에 한가지 질문만 하게나. 자네는 상대에 대한 배려가 부족하군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/006"
msgid "[???]/n일단 나는 주신교회인가 하는 것은 알지 못한다네. 그리고 내 이름은 데이모스라네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/007"
msgid "데이모스라... 들은적이 있는 이름인데... 어쨌거나 당신은 나보다도 이 곳에 갇힌지 훨씬 오래된 것 같군요. 제국령 전역에 위세를 떨치고 있는 주신교를 모르다니."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/008"
msgid "[데이모스]/n아까부터 교회에 대해 강조하는걸 보니 자네는 그 세력에 대항하다 투옥된 모양이로군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/009"
msgid "대항이라... 그런 것이라면 억울 할 것도 없을 거요. 교회 세력의 아버지라 할 수 있는 체사레 추기경은 나의 약혼녀의 아버지였소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/010"
msgid "[데이모스]/n그렇다면 그 추기경에게 크게 해가 될 일을 한 모양이로군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/011"
msgid "그런게 아니오. 난 단지 역사의 진실에 대해 연구하려 했을 뿐이오. 그것이 대체 어떻게 교회에 해가 된단 말이오?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/012"
msgid "[데이모스]/n진실에는 항상 고통이 수반될 따름이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/013"
msgid "[데이모스]/n그런데 역사의 진실이라... 자네는 역사속의 어떤 진실을 밝히려 했다는 말인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/014"
msgid "단지 창세전쟁의 비록이라는 구 제국 현자의 역사서를 연구했을 뿐이오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/015"
msgid "[데이모스]/n호오, 자네가 창세전쟁을 연구했다니. 그렇다면 나에 대해서도 알고 있을지 모르겠군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/016"
msgid "당신을...? 그건 대체 무슨 말이오?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/017"
msgid "[데이모스]/n내 이름을 그 책에서 본 일이 있을 텐데?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/018"
msgid "데이모스라면... 설마...?!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/019"
msgid "당신이 암흑신의 수장이었던 데이모스!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/020"
msgid "[데이모스]/n옛날 얘기지, 그렇지 않은가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/021"
msgid "정말 당신이 암흑신이란 말입니까?/30d 이럴수가... 역시 창세전쟁의 비록은 거짓이 아니었어!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/022"
msgid "[데이모스]/n어쨌거나, 그보다는 아까 하던 자네 얘기를 마저 듣고 싶은데. 혹시나 내가 자네의 그 궁금증을 풀어 줄 수 있을지도 모른다는 생각이 드는군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/023"
msgid "제 누명에 대한 것을?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s04
msgctxt "field|ko|art_ko_fl02_s04|@kfl02_s04/024"
msgid "[데이모스]/n시간이 된 것 같군. 다시 만날 수 있으면 이야기를 자세히 해주지 않겠나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s05
msgctxt "field|ko|art_ko_fl02_s05|@kfl02_s05/000"
msgid "/2c인페르노. 지하감옥."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s05
msgctxt "field|ko|art_ko_fl02_s05|@kfl02_s05/001"
msgid "데이모스라..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s05
msgctxt "field|ko|art_ko_fl02_s05|@kfl02_s05/002"
msgid "어째서 암흑신의 수장인 데이모스가 인페르노 지하에 있는걸까.../10d /n그의 힘을 무력화시킬 정도의 암흑 결계술을 펼칠 수 있는 인간이 있었단 말인가."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s05
msgctxt "field|ko|art_ko_fl02_s05|@kfl02_s05/003"
msgid "....인간?/10d /15d /n아니야, 인간이 아닐지도.../15d /n그러고 보니 창세전쟁 이후에도 살아남은 신이...../15d있지 않았던가."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s05
msgctxt "field|ko|art_ko_fl02_s05|@kfl02_s05/004"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s05
msgctxt "field|ko|art_ko_fl02_s05|@kfl02_s05/005"
msgid "쯧, 더 이상은 기억나지 않는군. /15d /n그나저나 간수들은 그의 존재를 모르고 있어/15d 다행이다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s05
msgctxt "field|ko|art_ko_fl02_s05|@kfl02_s05/006"
msgid "이번에도 기회를 봐서 다시 한번 그를 만나 봐야......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s05
msgctxt "field|ko|art_ko_fl02_s05|@kfl02_s05/007"
msgid "크윽!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s05
msgctxt "field|ko|art_ko_fl02_s05|@kfl02_s05/008"
msgid "쿨럭...쿨럭.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s05
msgctxt "field|ko|art_ko_fl02_s05|@kfl02_s05/009"
msgid "제길...아무래도 시간이 얼마 안남은것 같군./15d어떻게 해서든지 이곳을 빠져 나가야 하는데.../10d크으.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s05
msgctxt "field|ko|art_ko_fl02_s05|@kfl02_s05/010"
msgid "내일.../10d 내일 다시 그가 있는 장소로 가보자."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s06
msgctxt "field|ko|art_ko_fl02_s06|@kfl02_s06/000"
msgid "데이모스, 안녕하셨습니까."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s06
msgctxt "field|ko|art_ko_fl02_s06|@kfl02_s06/001"
msgid "[데이모스]/n음, 자넨가./20d 기다리고 있었다네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s06
msgctxt "field|ko|art_ko_fl02_s06|@kfl02_s06/002"
msgid "지난 번에 제게 말씀하신 일도 있고,/20d 데이모스 님의 일도.../20d 궁금한 점이 있어서 몇가지 여쭈러 왔습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s06
msgctxt "field|ko|art_ko_fl02_s06|@kfl02_s06/003"
msgid "[데이모스]/n그래, 어디 한번 이야기 해볼까?/30d 먼저 자네 이야기부터 들어보지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s06
msgctxt "field|ko|art_ko_fl02_s06|@kfl02_s06/004"
msgid "예, 베라딘의 죽음 이후에..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s06
msgctxt "field|ko|art_ko_fl02_s06|@kfl02_s06/005"
msgid "/2c나는 그가 재차 봉인당하게 된 과정과 그 일을 주도한 인물들, 그리고 이유에 대해서 하나씩 궁금증을 풀어가기 시작했다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s06
msgctxt "field|ko|art_ko_fl02_s06|@kfl02_s06/006"
msgid "/2c그러면서 알게 된 것은 창세전쟁 이후 살아남은 암흑신, 즉 파멸의 유스타시아와 달의 디아블로가 어떤 계획을 진행시키기 위해 데이모스를 봉인 시켰다는 사실이었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s06
msgctxt "field|ko|art_ko_fl02_s06|@kfl02_s06/007"
msgid "/2c하지만 그 계획이 무엇인지 알 수는 없었다./40d 단지, 인류에게 유익할 수는 없는 일이었음을 짐작할 수 있었을 뿐이었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s06
msgctxt "field|ko|art_ko_fl02_s06|@kfl02_s06/008"
msgid "/2c그리고 그는 그의 과거 이야기를 하기 보다 나의 이야기를 더욱 듣고 싶어 했다. 하지만 나는 즐겁지 못했다. 과거의 일을 생각할 때마다 끓어오르는 막연한 분노, 그리고 마지막의 순간에 나를 엄습하는 절망감..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s06
msgctxt "field|ko|art_ko_fl02_s06|@kfl02_s06/009"
msgid "제게는 막연한 고통의 과거 뿐입니다. 기억하고 싶지 않은 고통들..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s06
msgctxt "field|ko|art_ko_fl02_s06|@kfl02_s06/010"
msgid "[데이모스]/n고통을 피하고 싶기 때문에 진실을 아는 것을 두려워하는 건가? 자네는 자네 입으로 더 이상 잃을 것이 없다고 하지 않았던가! 무엇을 두려워 하는 건가."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s06
msgctxt "field|ko|art_ko_fl02_s06|@kfl02_s06/011"
msgid "[데이모스]/n추억을 더듬어 보게나. 가장 아름다웠던 기억을 시작으로 한가닥 실타래 끝을 풀어가듯 따라가보는 걸세."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s06
msgctxt "field|ko|art_ko_fl02_s06|@kfl02_s06/012"
msgid "....../50d 메르..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/000"
msgid "/2c인페르노. 지하감옥."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/001"
msgid "/2c그는 내게 누명이 씌워진 이유를 분석해 주었을 뿐 아니라 역사학과 논리적 추론법 등 많은 지식을 전수해 주었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/002"
msgid "/2c데이모스의 존재,/15d 그리고/10d 메르세데스에 대한 집념./20d 그 두가지가 그 지옥의 생활을 버텨낼 수 있는 이유였다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/003"
msgid "/2c하지만 데이모스를 알게된 후 1년이 지난 어느날,/20d 나의 육체는 한계를 이겨내지 못하고 죽음을 눈앞에 두게 되었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/004"
msgid "으..가슴이.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/005"
msgid "아.../5d안돼../10d여기서../10d.쓰러질 수../5d는.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/006"
msgid "으윽..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/007"
msgid "[간수] /n어이..이리좀 와 보게"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/008"
msgid "[간수]/n무슨일이야? /15d음..?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/009"
msgid "[간수] /n.....이녀석,/15d죽었나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/010"
msgid "[간수] /n그런것 같은데,"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/011"
msgid "[간수] /n질긴 놈이군. 4년씩이나 버티다니."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/012"
msgid "[간수] /n문열고 들어가서 시체나 빨리 처리해. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/013"
msgid "[간수] /n.......!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/014"
msgid "[간수] /n이녀석...아직 목숨이 남아있는데../10d/n어쩌지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/015"
msgid "[간수] /n어쩌긴. 귀찮으니 그냥 처리해버려. /n그 왜, 작년에 지진으로 새로 생긴 구덩이 있잖아."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/016"
msgid "[간수] /n뭐..나야 상관없지./n/10d그럼 자네도 좀 도와주게나.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/017"
msgid "[간수] /n이봐! /15d/n일할시간이다. 어서 일어나!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s07
msgctxt "field|ko|art_ko_fl02_s07|@kfl02_s07/018"
msgid "메르.../15d세데스."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/000"
msgid "[데이모스]/n너무 늦어 버린건 아닐지..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/001"
msgid "[데이모스]/n시라노, 정신차리게나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/002"
msgid "데.../20d...이모스...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/003"
msgid "[데이모스]/n다행이야. /n아직 살아 있었군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/004"
msgid "후../15d 후.../20d 죽기전에 마지막 인사는... 드릴 수 있게 되... 다행입니다..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/005"
msgid "[데이모스]/n약한 소리 하지 말게, 자네는 죽지 않을걸세."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/006"
msgid "......으음...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/007"
msgid "[데이모스]/n나의 마지막 남은 영혼의 힘을 자네에게 주겠네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/008"
msgid "무... 무슨 말씀을..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/009"
msgid "[데이모스]/n내가 지니고 있던 모든 힘은 이전, 흑태자에게 주어 이 육신은 빈껍데기나 마찬가지지만 마지막으로 남은 영혼의 힘이 있다네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/010"
msgid "설...마..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/011"
msgid "[데이모스]/n그 힘이라면 자네의 생명 하나 쯤은 구원할 수 있을 거야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/012"
msgid "그런.../40d /n안됩니다, 데이모스... 당신은... 신..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/013"
msgid "[데이모스]/n그런 소리 말게./n 오랜 시간 동안의 무력과/15d 적막의 고통에 시달리던 나에게/15d 벗이 되어 준 것은 자네뿐 아닌가"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/014"
msgid "[데이모스]/n나의 피와 나의 지식을 물려 받은 자네는 내 친자식이나 다를바 없네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/015"
msgid "[데이모스]/n내 평생, 많은 생명을 창조 했지만 그중 나의 아들이라 할 수 있는 것은 단 두 사람./30d /n흑태자 스타이너와, 자네 시라노 뿐이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/016"
msgid "[데이모스]/n나의 힘은 스타이너에게,/20d 그리고 나의 영혼은 시라노 자네에게 물려주니/20d 자네는 스타이너가 남긴 힘을 찾아내 그 힘을 거두어 주게나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/017"
msgid "그렇지만.../20d 하찮은 이 생명을 유지하기 위해.../20d 당신의 생명을 받을 수는 없습니다..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/018"
msgid "그.../15d런 말씀 마시고.../20d 이 지옥으로부터 벗어날 영혼의 해방을... 축복해 주십시오..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/019"
msgid "[데이모스]/n다른 생각 말고, 내 말을 잘 듣게."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/020"
msgid "[데이모스]/n그 힘은 세상을 위해 필요한 힘./20d 하지만 어디에 어떻게 쓰던 그건 자네 의지에 달려있네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/021"
msgid "[데이모스]/n자네의 뜻이 곧 내 뜻이니."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/022"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/023"
msgid "[데이모스]/n나의 영혼은 자네와 영원히 함께 할걸세."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/024"
msgid "흑태자 스타이너가 남긴 힘은, 대륙 남단의 폭풍도라는 섬에 묻혀있네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s08
msgctxt "field|ko|art_ko_fl02_s08|@kfl02_s08/025"
msgid "폭풍도의 아수라!/15d 아수라를 잊지 말게!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s09
msgctxt "field|ko|art_ko_fl02_s09|@kfl02_s09/000"
msgid "/2c그리고 메디치라고 했던가.../20d 그의 도움이 없었더라면 나는 아직까지도 그 지옥을 헤매고 있었을 것이다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s09
msgctxt "field|ko|art_ko_fl02_s09|@kfl02_s09/001"
msgid "자, 시간이 없다! /n어서 서둘러라!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl02_s09
msgctxt "field|ko|art_ko_fl02_s09|@kfl02_s09/002"
msgid "/2c그리고 나는 지금 이렇게 데이모스가 말한 힘을 얻기 위한 여정을 시작했다"
msgstr ""

