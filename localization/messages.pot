#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber02
msgctxt "field|ko|art_ko_flber02|@kflber02/001"
msgid "허허, 시라노군./15d 미안하지만 나가주지 않으련가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber02
msgctxt "field|ko|art_ko_flber02|@kflber02/001_3"
msgid "허허,시라노군. 미안하지만 나가주지 않으련가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber03
msgctxt "field|ko|art_ko_flber03|@kflber03/000"
msgid "fkfkf"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber03
msgctxt "field|ko|art_ko_flber03|@kflber03/001"
msgid "도련님, 지금은 청소중이예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber03
msgctxt "field|ko|art_ko_flber03|@kflber03/002"
msgid "이런... 오늘은 도련님 약혼 날이예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber03
msgctxt "field|ko|art_ko_flber03|@kflber03/002_3"
msgid "이런... 오늘은 도련님 약혼 날이에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber03
msgctxt "field|ko|art_ko_flber03|@kflber03/003"
msgid "... 약혼을 진심으로 축하드려요. 메르세데스님은 정말 같은 여자로서 한없인 부러운 분이예요. 부디 행복하세요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber03
msgctxt "field|ko|art_ko_flber03|@kflber03/003_3"
msgid "... 약혼을 진심으로 축하드려요. 메르세데스님은 정말 같은 여자로서 한없인 부러운 분이에요. 행복하세요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber04
msgctxt "field|ko|art_ko_flber04|@kflber04/000"
msgid "도련님, 이곳에는 무슨일이시죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber04
msgctxt "field|ko|art_ko_flber04|@kflber04/001"
msgid "루벤이라면 지금 이곳에는 없습니다만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber04
msgctxt "field|ko|art_ko_flber04|@kflber04/002"
msgid "요새 루벤의 태도가 좀 이상하다고 생각하지 않으세요? 아무래도 도련님의 약혼 얘기가 있은 직후부터 이상해진 것 같은데요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber04
msgctxt "field|ko|art_ko_flber04|@kflber04/002_3"
msgid "요새 루벤의 태도가 좀 이상하다고 생각하지 않으세요? 아무래도 도련님의 약혼 발표가 있은 직후부터 이상해 진 것 같은데요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/000"
msgid "오늘은 도련님 약혼식 날이기 때문에 집안의 모든 사람들이 도련님 약혼준비에 바쁩니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/001"
msgid "도련님은 너무나도 의젓하신 분이니까 별 문제없이 잘 해내실 것이라 믿습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/001_3"
msgid "도련님은 너무나 의젓하신 분이니까 별다른 문제없이 잘 해내실 것이라 믿습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/002"
msgid "이제 도련님도 어엿한 성인이자 한 여자를 책임져야 하는 남자. 지금보다도 더욱 자신을 아끼지 않으면 안된답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/003"
msgid "축하해요, 시라노 형. 메르세데스 누나 같은 이쁜 아내를 얻게 되다니... 정말 부러워요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/003_3"
msgid "축하해요, 시라노 형. 메르세데스 누나 같은 이쁜 부인을 얻게 되다니... 정말 부러워요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/004"
msgid "저도 크면 란스와 결혼할 거예요. 그때쯤에는 란스도 지금의 메르세데스 누나같이 멋진 숙녀가 되어 있겠죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/004_3"
msgid "저도 크면 란스와 약혼을 할 꺼에요. 그때즈음에는 란스도 지금의 메르세데스 누나같이 멋진 숙녀가 되어 있겠죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/005"
msgid "어머, 시라노 오빠, 정말로 약혼축하드려요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/005_3"
msgid "어머, 시라노 오빠, 정말로 약혼축하드려요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/006"
msgid "조엘 녀석은 지금의 오빠 나이가 되면 오빠만큼이나 멋진 사람이 될 수 있을까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/007"
msgid "오늘은 번스타인가에 있어서 가장 바쁘고도 기쁜 하루가될 거예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/007_3"
msgid "오늘은 번스타인가에 있어서 가장 바쁘고도 기쁜 하루가될 거에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/008"
msgid "우리는 모두 아름다운 여주인님을 맞게 된다는 사실에 들떠 있답니다. 마님이 세상을 떠나신 이후, 번스타인가는 안주인이 필요했어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/008_3"
msgid "우리는 모두 아름다운 여주인님을 맞게 된다는 사실에 들떠 있답니다. 마님이 세상을 떠난 이후에 번스타인가는 안주인이 필요했어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/009"
msgid "메르세데스 님은 외모뿐 아니라 숙녀 수업도 가장 확실하게 받으신 분으로 유명하시잖아요? 그런 분을 모시게 되는 것은 저희들로서도 영광입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/009_3"
msgid "메르세데스 님은 외모뿐만 아니라 숙녀 수업도 가장 확실하게 받으신 분으로 유명하시잖아요? 그런분을 모시게되는 것은 저희들로서도 영광입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/010"
msgid "하하하... 오늘은 즐거운 날 입니다./20d 도련님께서도 드디어 진정한 사나이로 거듭나게 되는군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/010_3"
msgid "하하하... 오늘은 즐거운 날 입니다. 도련님께서도 드디어 진정한 사나이로 거듭나게 되는군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/011"
msgid "저는 피아노 치는 도련님도 멋지다고 생각하지만, 오늘의 도련님만큼 멋있는 도련님의 모습은 아직까지 본 적이 없습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/011_3"
msgid "저는 피아노 치는 도련님도 좋아하지만, 오늘의 도련님만큼 멋있는 도련님의 모습은 아직까지 본 적이 없군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/012"
msgid "오늘만큼 기쁘고 감격스러운 날이 없었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber05
msgctxt "field|ko|art_ko_flber05|@kflber05/012_3"
msgid "이 루스, 오늘만큼 기쁘고 감격스러운 날이 없습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber06
msgctxt "field|ko|art_ko_flber06|@kflber06/000"
msgid "루벤의 어머니는 예전부터 주인님의 총애를 받았었는데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber06
msgctxt "field|ko|art_ko_flber06|@kflber06/001"
msgid "사실 생각해 보면 예전 마나님은 인자하신 분이었지요... 그런 사실을 알고도..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber06
msgctxt "field|ko|art_ko_flber06|@kflber06/002"
msgid "어머, 어머... 이 방정맞은 입. 호호호... "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber06
msgctxt "field|ko|art_ko_flber06|@kflber06/003"
msgid "왜 시드 있잖아요? 제안의 아들... 그녀석이 글쎄 이웃 마을을 갔다 오는 도중에 납치되었었다고 하던데요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber06
msgctxt "field|ko|art_ko_flber06|@kflber06/004"
msgid "납치된지 3일만에 폴리스에 의해 발견되서 돌아오기는 했지만 정말 이상한 것은 그 3일동안 범인들로 부터 아무 연락도 없었던것이지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber06
msgctxt "field|ko|art_ko_flber06|@kflber06/005"
msgid "정말 이상하지 않아요? 시드가 납치당했던 것은 확실한데 왜 범인들로 부터 아무요구도 없었던 것일까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber06
msgctxt "field|ko|art_ko_flber06|@kflber06/005_3"
msgid "정말 이상하지 않아요? 시드가 납치당했던 것은 확실한데 왜 범인들로 부터 아무연락도 없었던 것일까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber07
msgctxt "field|ko|art_ko_flber07|@kflber07/000"
msgid "시드 녀석이 사라진 3일동안 시드의 어머니인 제안은 거의 이 세상 사람이 아니었답니다. 그런데 도데체 시드는 왜 납치되었던 것일까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber07
msgctxt "field|ko|art_ko_flber07|@kflber07/000_3"
msgid "시드 녀석이 사라진 3일동안 제안은 거의 이세상 사람이 아니었답니다. 그런데 도데체 시드는 왜 납치되었던 것일까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber07
msgctxt "field|ko|art_ko_flber07|@kflber07/001"
msgid "범인들로 부터 몸값을 요구하는 등의 편지도 전혀 없었고, 특별히 시드가 납치될 동기는 없었는데."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber07
msgctxt "field|ko|art_ko_flber07|@kflber07/002"
msgid "여기에는 아마도 다른 어떤 음모가 있는 것이 확실해요. 어떤 음모인지는 몰라도..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber07
msgctxt "field|ko|art_ko_flber07|@kflber07/002_3"
msgid "여기에는 아마도 다른 어떤 음모가 있는 것이 거의 확실해요. 어떤 음모인지는 몰라도..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber07
msgctxt "field|ko|art_ko_flber07|@kflber07/003"
msgid "시드는 아직도 제 정신을 차리지 못한 상태에요. 계속해서 내리 잠만 자고 있어요. 의사 선생님 말로는 어떤 약물이 투여된 것 같다던데요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber07
msgctxt "field|ko|art_ko_flber07|@kflber07/003_3"
msgid "시드는 아직도 제정신을 차리지 못한 상태에요. 계속해서 내리 잠만 자고 있어요. 의사 선생님 말로는 어떤 약물이 투여된 것 같다던데요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber07
msgctxt "field|ko|art_ko_flber07|@kflber07/004"
msgid "시드는 평소부터 호기심이 많은 아이였지요. 도련님을 세상에서 가장 존경하는 아이랍니다. 도련님 같은 학자가 되는 것이 꿈인..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber07
msgctxt "field|ko|art_ko_flber07|@kflber07/004_3"
msgid "시드는 평소부터 호기심이 많은 아이였지요. 도련님을 이세상에서 가장 존경하는 아이랍니다. 나중에는 학자가 되는 것이 꿈인."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/000"
msgid "이런이런... 오늘의 주인공이 어째서 이런 자리에 어슬렁 거리고 있는 것이지? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/000_3"
msgid "이런이런... 오늘의 주인공이 어찌 이런 자리에서 어슬렁 거리고 있는 것이지? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/001"
msgid "잘 해보게나, 메르세데스와./15d 훗... 게이시르의 명망있는 자제들치고 그녀에 대해 생각한번 안해본 사람도 없을테니... 자네는 운도 좋군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/001_3"
msgid "잘 해보게나 메르세데스와. 훗... 게이시르의 명망있는 자제들치고 그녀에대한 꿈을 한번 안 꾼 사람이 없을테니... 자네는 운도 좋군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/002"
msgid "그녀를 울리기라도 하는 날에는 내가 가만두지 않겠어. 알겠나!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/002_3"
msgid "그녀를 울리기라도 하는 날에는 내가 가만히 있지를 않겠어. 알겠나!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/003"
msgid "오, 시라노 군. 난 자네 집에서 들은 시드란 아이의 납치사건에 상당한 흥미를 느끼고 있다네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/004"
msgid "왜 범인들은 그 아이를 납치해서 3일동안 붙잡아 두었을 뿐 더이상 아무 일도 하지 않은 것일까? 또한 어째서 약을 먹여서 지금까지 인사불성인 상태인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/005"
msgid "이 모든것이 의문투성이인 사건이야. 무엇보다도 가장 의심이 가는 것은 그 동기라네. 도데체 왜...? 분명 이 뒤에는 무엇인가 있는데, 그게 뭔지를 모르겠군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/006"
msgid "이 책은...? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/006_3"
msgid "못 보던 책이 하나 꽃혀 있군...? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/007"
msgid "아직 모퉁이를 돌면 기다리고 있을 거야,/n새로운 길, 비밀의 문이./n종종 지나치곤 했지만/n언젠가 그날이 오면/n달 서쪽, 태양의 동쪽으로 나 있는/n숨어 있는 그 길을 걸어가게 될 거야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/007_3"
msgid "/n아직 모퉁이를 돌면 기다리고 있을 거야,/n새로운 길, 비밀의 문이./n종종 지나치곤 했지만/n언젠가 그날이 오면/n달 서쪽, 태양의 동쪽으로 나 있는/n숨어 있는 그 길을 걸어가게 될 거야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/008"
msgid "/n아! 엘베레스 길도니엘!/n실리브렌 펜나 미리엘/n오 메넬 아글가르 엘레나스/n길도니엘,아! 엘베레스!/n우린 기억한다네,/n나무 아래 이 먼 곳에 사는 우리들은,/n서쪽 바다에 비치는 별빚을"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/008_3"
msgid "/n아! 엘베레스 길도니엘!/n실리브렌 펜나 미리엘/n오 메넬 아글가르 엘레나스/n길도니엘,아! 엘베레스!/n우린 기억한다네,/n나무 아래 이 먼 곳에 사는 우리들은,/n서쪽 바다에 비치는 별빚을./n/nby 프로도 배긴스, 반지전쟁 중에서"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/009"
msgid "시드녀석... 이 책을 보고 있었나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber08
msgctxt "field|ko|art_ko_flber08|@kflber08/009_3"
msgid "시드가 보던 책인가...? 못보던 시집이군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber09
msgctxt "field|ko|art_ko_flber09|@kflber09/000"
msgid "호오... 시라노군, 정말 약혼하는 것을 축하하네 그려. 메르세데스는 정말 자네에게 딱 맞는 신부감이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber09
msgctxt "field|ko|art_ko_flber09|@kflber09/001"
msgid "그러나 저러나 자네가 이제 결혼하게 되도 우리 클럽을 잊는 것은 아니겠지? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber09
msgctxt "field|ko|art_ko_flber09|@kflber09/001_3"
msgid "그러나 저러나 자네가 이제 결혼하게 되면 더이상 그곳에는 갈 수 없게 되는 것인가? 자네 설마 그렇게 째째하게 굴 것은 아니겠지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber09
msgctxt "field|ko|art_ko_flber09|@kflber09/002"
msgid "하하하! 어때, 약혼 기념으로 다음 주말에 한번 거하게 마셔 보는 것이 어떻겠어?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber09
msgctxt "field|ko|art_ko_flber09|@kflber09/002_3"
msgid "하하하! 어때, 약혼 기념으로 다음 주말에 한번? 듣자하니 새로 온 사람도 있는 모양인데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber09
msgctxt "field|ko|art_ko_flber09|@kflber09/003"
msgid "흥! 나를 두고 먼저 가버리는 군요? 정말이지... 뭐, 어쩔 수 없죠. 상대가 메르세데스라면."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber09
msgctxt "field|ko|art_ko_flber09|@kflber09/003_3"
msgid "흥! 나를 두고 먼저 가버리는 군요? 정말이지... 뭐, 좋아요. 상대가 메르세데스라면."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber09
msgctxt "field|ko|art_ko_flber09|@kflber09/004"
msgid "당신에게 임자가 생기는 것은 안타깝지만, 메르세데스도 더 이상 게이시르 남자들의 관심의 대상이 될 수 없으니... 그다지 손해랄 것은 없겠지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber09
msgctxt "field|ko|art_ko_flber09|@kflber09/004_3"
msgid "당신이 사라지는 것은 안타깝지만, 메르세데스도 더이상 게이시르 남자들의 관심의 대상이 될 수 없으니... 별로 손해 볼 것은 없겠지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber09
msgctxt "field|ko|art_ko_flber09|@kflber09/005"
msgid "호호호... 과연 메르세데스 뒤를 이을 제 2의 프리마돈나는 누가 될까? 시내에 새로 연 미용실이 있다고 하던데."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber09
msgctxt "field|ko|art_ko_flber09|@kflber09/005_3"
msgid "호호호... 과연 메르세데스 뒤를 이을 제 2의 프리마돈나는 누가될까? 시내에 새로 연 미용실이 있다고 하던데."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber10
msgctxt "field|ko|art_ko_flber10|@kflber10/000"
msgid "앗. 시라노님. 아... 저... 그러니까... "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber10
msgctxt "field|ko|art_ko_flber10|@kflber10/001"
msgid "그, 그게... 시라노 님의 약혼, 축하드려요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber10
msgctxt "field|ko|art_ko_flber10|@kflber10/002"
msgid "어머... 시라노님, 약혼 축하드려요. 이제 곧 결혼하시겠네요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber10
msgctxt "field|ko|art_ko_flber10|@kflber10/003"
msgid "호호... 결혼 하시면 신혼부부 용의 특식을 만들어 드릴 테니, 기대하세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber10
msgctxt "field|ko|art_ko_flber10|@kflber10/004"
msgid "아주 좋 ~ 은 재료료 특별식을 만들어 드릴께요. 호호호."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flber10
msgctxt "field|ko|art_ko_flber10|@kflber10/004_3"
msgid "아주 좋 ~ 은 재료료 특별식을 만들어 드릴께요. 두분 사이 깨가 한말은 나올 수 있도록 말이에요, 호호호."
msgstr ""

