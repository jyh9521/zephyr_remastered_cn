msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltka01
msgctxt "field|ko|art_ko_fltka01|@kfltka01/030_3"
msgid "정말 대단하지 않아요? 용을 죽이다니!! 나도 검술을 열심히 배워서 언젠가는 칼스님처럼 훌륭한 검사가 될 거에요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltka01
msgctxt "field|ko|art_ko_fltka01|@kfltka01/031"
