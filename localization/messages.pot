msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s03
msgctxt "field|ko|art_ko_fl18_s03|@kfl18_s03/006"
msgid "그만둬라, 크리스티나!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s03
msgctxt "field|ko|art_ko_fl18_s03|@kfl18_s03/007"
msgid "에스메랄다...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s03
msgctxt "field|ko|art_ko_fl18_s03|@kfl18_s03/008"
