msgctxt "field|re|art_flinf2f|@kflinf2f/011"
msgid "좋아,/15d 그럼 간다!/40d/n위험하니 전투는 나에게 맡기고 잘 따라오도록!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flinf2f
msgctxt "field|re|art_flinf2f|@kflinf2f/012"
msgid "!!!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_flinf2f
msgctxt "field|re|art_flinf2f|@kflinf2f/013"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/000"
msgid "그 이후 나는/25d 1년이 넘는 시간 동안/25d 그녀에게 팬드래건의 검술을 배우게 되었다./60d/n당대의 검사였던 이올린 팬드래건은/40d 왕국의 검법을 전수해 주었을 뿐 아니라/45d/n많은 마법과 기술을 가르쳐 주었다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/001"
msgid "어떤가. 수련을 받을 마음의 준비는 되었나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/002"
msgid "잘 부탁드립니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/003"
msgid "다녀왔습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/004"
msgid "그럼 이쪽으로 오게."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/005"
msgid "[이올린]/n아직 다음 수업으로 넘어가기에는 수련이 부족해./n더 멀리 갔다 오게나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/006"
msgid "[이올린]/n보다 멀리까지 수련을 나가보도록 하게./n여기서 먼 곳일수록 자네의 수련도 깊어질 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/007"
msgid "[이올린]/n집안의 아이에게 말해놓았으니/n피곤하면 들어가서 쉬도록 하고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/008"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/009"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/010"
msgid "1장 : 검의 종류와 전투의 개념"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/011"
msgid "[이올린]/n그럼, 오늘부터 자네에게 전법에 대해 설명하겠네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/012"
msgid "[이올린]/n나의 가르침만으로 모든 것이 해결되는 건 아니지만/n이론을 무시해서는 안 되는 법이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/013"
msgid "[이올린]/n먼저 검이라는 무기의 체계에 관해 간단히 설명하겠네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/014"
msgid "[이올린]/n검의 종류는 세검, 중검, 장검, 대검으로 분류할 수 있네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/015"
msgid "[이올린]/n세검은 가볍고 날카로운 가는 검을 말하며, 중검은 짧고/n무거운 두터운 검, 장검은 가장 일반적인 긴 검, 대검은/n이름 그대로 길고 넓은 커다란 검을 말하는 것이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/016"
msgid "[이올린]/n이 검 중에서 가장 쓰기 편한 것은 역시 일반적인 장검류/n이지만, 전술적으로 더 중요한 것은 세검과 중검이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/017"
msgid "[이올린]/n대검은 사용할 여건만 된다면 최강의 검이지만,/n좋은 대검을 손에 넣기는 쉽지 않을 걸세."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/018"
msgid "[이올린]/n세검과 중검이 전술적으로 중요한 것은 그 검이 가진/n뚜렷한 개성 때문인데, 세검은 공격시에, 중검은 방어시에 그 위력을 발휘한다네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/019"
msgid "[이올린]/n검의 분류에 대해서는 이 정도로 알아두고,/n세검과 중검에 대해서는 나중에 다시 자세히 설명하겠네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/020"
msgid "[이올린]/n이제 실전에 필요한 몇 가지 주의 사항만 설명하고/n오늘은 마치도록 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/021"
msgid "[이올린]/n첫 번째, 적과의 거리와 방향을 항상 염두에 두게나. 이건 검술뿐이 아니라 어떤 전투 방법에도 통용되는 얘기라네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/022"
msgid "[이올린]/n항상 상대와의 거리를 염두에 두고 상대에게 뒤를 보이지 말게나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/023"
msgid "[이올린]/n상대가 예상대로 공격을 한다면 뒤로부터의 공격도 피해낼 수 있겠지만, 진정한 검사는 매 순간을 항상 자신보다 강한 상대와의 싸움이라 생각하고 전투에 임해야 하네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/024"
msgid "[이올린]/n기사도를 생각한다면 상대의 뒤를 노리는 비겁한 짓은/n해서는 안 되지만, 살아남는 것을 우선시한다면 상대의 뒤를 노리는 것도 간과할 수 없는 전술의 하나라 할 수 있지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/025"
msgid "[이올린]/n두 번째, 적의 강점과 약점을 아는 것이 중요하네./n말은 쉽게 들리겠지만 정작 전투에서 제대로 실천하기가 쉽지는 않지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/026"
msgid "[이올린]/n적의 강점을 알고 있다면 상대에 맞는 방어 방법을 취해/n적의 공격을 막아낼 확률을 높일 수 있고, 적의 약점을 알고 있다면 공격을 성공시킬 확률을 높일 수 있다는 것이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/027"
msgid "[이올린]/n대표적인 예로, 마법사는 마법에 대한 내성이 뛰어나서/n일반적인 마법 공격으로는 쓰러트리기 힘들지만,/n검이나 총탄 앞에는 무력하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/028"
msgid "[이올린]/n또, 사수는 총을 사용하기 때문에 사거리가 길고 공격력도 높지만, 반대로 방어력은 마법사와 별반 다르지 않고 마법 공격에는 턱없이 약하다네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/029"
msgid "[이올린]/n이 외에도 약점은 여러 가지 형태로 표출되기 때문에/n실전을 쌓으면서 많은 연구가 필요할 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/030"
msgid "[이올린]/n일단 이 두 가지를 잊지 않도록 하게./n다음부터는 전투의 기술에 대해 보다 자세히 설명하겠네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/031"
msgid "[이올린]/n조금 실전을 쌓고 돌아오게나./n그러면 마법에 대해 설명해 주지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/032"
msgid "[이올린]/n처음에는 너무 욕심내지 말고/n조금씩 경험을 쌓도록 하게나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/033"
msgid "[이올린]/n아, 그리고 자네에게 지도를 주지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/034"
msgid "[이올린]/n안타리아 대륙 지도라네./n폭풍도도 나와 있으니 도움이 될 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/035"
msgid "감사합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/036"
msgid "[이올린]/n그리고, 여기 단검 한 자루를 줄 테니/n장착하는 것을 잊지 말게나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/037"
msgid "이올린의 가르침을 받아 <color=#FFDE5A>EXP 10</color>이 상승했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/038"
msgid "이올린에게 <color=#6EFDFF>단검</color>을 받았습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/039"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/040"
msgid "2장 : 마법"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/041"
msgid "[이올린]/n실전도 조금은 경험한 것 같으니,/n이제 마법에 대해 설명해 주지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/042"
msgid "[이올린]/n전에 약점에 대해서도 간단히 말했지만,/n다양한 공격 방법을 익히는 것은/n한 가지 기술에 통달하는 것만큼이나 중요한 일이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/043"
msgid "[이올린]/n자네는 마법을 조금 사용할 줄 아는 것 같던데…/n어떤 마법을 사용할 줄 아는가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/044"
msgid "데이모스 님에게 전수받은 암흑 마법을 조금 할 줄 압니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/045"
msgid "[이올린]/n그럼 내 마법을 익히는 것도 어렵지 않을 걸세./n자네에게는 빙한 계열 마법을 전수해 주지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/046"
msgid "[이올린]/n마법을 전수하기 전에 이 땅에 존재하는 마법의 체계에/n대해 설명하겠네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/047"
msgid "[이올린]/n마법은 크게 6가지 계열로 나뉘지. 일명 3원소 마법이라 불리는 화염, 빙한, 전격계의 3가지 계열."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/048"
msgid "[이올린]/n그리고, 암흑신의 힘이 근원이라는 암흑 마법,/n주신의 힘에서 유래했다는 신성 마법,/n신성 마법에서 파생되었다는 보조 마법이 있지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/049"
msgid "[이올린]/n이 중에서 3원소 마법은 서로 물고 물리는 관계로,/n화염은 빙한에 약하고, 빙한은 전격에,/n전격은 화염에 약하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/050"
msgid "[이올린]/n그리고 암흑과 신성 마법은 3원소 마법과는 별개로 서로 상극인 마법이지. 즉, 먼저 공격하는 쪽이 유리하다네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/051"
msgid "[이올린]/n보조 마법은 시공을 건드리는 마법으로,/n다른 5계열 마법과는 어떠한 상관관계도 갖지 않아."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/052"
msgid "[이올린]/n이 마법 계열은 마법으로서 만이 아니라,/n다른 물질의 속성으로 나타나는 경우도 있기 때문에/n꼭 기억해 두고 있어야 하네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/053"
msgid "[이올린]/n가장 흔하게 볼 수 있는 경우는 몬스터의 속성이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/054"
msgid "[이올린]/n예를 들어, 화염 속성을 가진 몬스터를/n빙한 속성의 마법이나 무기로 공격한다면,/n두 배의 피해를 입힐 수 있지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/055"
msgid "[이올린]/n반대로 같은 계열인 화염으로 공격한다면, 피해를 받지/n않고 오히려 흡수해 회복해 버리게 되지. 화염에 약한 전격으로 공격한다면 별로 피해를 주지 못하니 주의하게나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/056"
msgid "[이올린]/n자, 이제 빙한 계열 마법을 전수하겠네./n실전에서 유용하게 써 보게나./n다음 수업 주제는 세검에 대해서라네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/057"
msgid "이올린에게 <color=#E086FF>빙한계열 마법</color>을 배웠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/058"
msgid "이올린의 가르침을 받아 <color=#FFDE5A>EXP 20</color>이 상승했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/059"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/060"
msgid "3장 : 세검"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/061"
msgid "[이올린]/n이번에는 검의 공격과 세검에 대해 설명하겠네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/062"
msgid "[이올린]/n지난번에 세검과 중검에 대해 간단히 설명했는데,/n세검의 특징은 무엇이었는지 기억하는가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/063"
msgid "공격력 중시의 가벼운 검이지만,/n방어에는 약하다고 하셨습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/064"
msgid "[이올린]/n그래. 가벼워서 다루기 쉽고 뛰어난 공격력을 지녀/n치명타 확률도 높지. 하지만 방어를 하기에는 너무 가늘고/n가벼워서 피해를 막기 어렵고, 쉽게 부러져 버리곤 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/065"
msgid "차라리 방어를 하지 않는 쪽이 나을 수도 있겠군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/066"
msgid "[이올린]/n극단적으로 말하면 그렇지. 대신 공격력이 워낙 뛰어나기 때문에, 선제공격이 잘 된다면 적이 제대로 반격하기도/n전에 전투에서 승리할 수도 있지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/067"
msgid "[이올린]/n도박성이 강하다고도 할 수 있지만, 가격에 비해 공격력이 뛰어나기 때문에 돈만 충분하다면 넉넉히 가지고 다니면서 소모품처럼 써버리는 것도 괜찮은 전법일 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/068"
msgid "소모품이라…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/069"
msgid "[이올린]/n검의 교체에 대해서는 다음에 더 자세히 설명해 주겠네./n일단 이 어설트 소드로 세검의 기본적인 전법을/n익혀보게나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/070"
msgid "이올린에게 <color=#6EFDFF>어설트 소드</color>를 받았습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/071"
msgid "이올린의 가르침을 받아 <color=#FFDE5A>EXP 30</color>이 상승했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/072"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/073"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/074"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/075"
msgid "4장 : 초급 방어"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/076"
msgid "[이올린]/n세검을 써보니 어땠나? 쓸만하던가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/077"
msgid "공격력은 굉장히 강했습니다만,/n너무 쉽게 부서져서 오래 사용하지는 못했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/078"
msgid "[이올린]/n그렇지. 그건 바로 \"돌파\" 때문이라네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/079"
msgid "돌파?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/080"
msgid "[이올린]/n적이 공격을 하면 방어자는 그 공격을 막으려고 하는 것이 본성이네. 물론 적의 공격을 완벽하게 막아낼 수 있는/n사람은 존재하지 않지만, 일단 그렇다고 가정을 해 보지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/081"
msgid "[이올린]/n적의 공격은 일단 방어자의 무기에 막히게 되지./n즉, 무기는 적의 공격을 일차적으로 막는 방어벽 역할을/n하는 셈이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/082"
msgid "[이올린]/n그런데, 세상 모든 일이 그렇듯/n여기서도 어느 쪽이 강한지에 따라 결과가 결정되네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/083"
msgid "그렇다면 검이 깨어진 것도/n그 이유 때문이라는 말씀이시군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/084"
msgid "[이올린]/n그렇지. 무기가 견딜 수 있는 최대 공격력을/n무기의 한계력이라고 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/085"
msgid "[이올린]/n무기 한계력 이상의 공격을 막으려 하면,/n방어자는 그를 넘어서는 만큼의 피해를 입고/n무기는 손상을 입게 되는 것이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/086"
msgid "[이올린]/n이렇게 방어자의 무기를 뚫고 피해를 입히는 것을/n\"돌파\"라고 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/087"
msgid "[이올린]/n무기가 돌파당하면 무기의 내구도가 1 감소하게 된다네. 만약 무기 내구도가 0이 되면, 그 무기는 사용할 수 없게 되어 버리는 것이라네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/088"
msgid "[이올린]/n세검은 공격력을 극대화한 검인 반면에 무기 한계력이/n극도로 낮고, 무기 내구도도 1이나 2 밖에 되지 않는다네./n그러니 전투 중 깨지기 쉬운 것이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/089"
msgid "[이올린]/n다행히 무기는 깨어지더라도 수리할 수는 있지만 말일세."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/090"
msgid "그렇다면 세검은 실전에서 쓸모가 없다는 말입니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/091"
msgid "[이올린]/n그렇지는 않네./n세검은 주로 장거리 공격에서 위력을 발휘하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/092"
msgid "[이올린]/n특히 여럿이 함께 싸울 때는 역할 분담을 잘 하면 크게/n유용할 거야. 반대로 혼자서 다수를 상대할 경우에는/n적절하지 않다고 말할 수 있겠지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/093"
msgid "[이올린]/n자, 이제 방어의 개념이 이해되었는가?/n그럼 실전을 통해 지금 배운 것을 체득해 보게./n이번에는 조금 더 멀리 가봐야 할 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/094"
msgid "[이올린]/n그리고 다음 수업은 세검에 반대되는 검인/n중검에 대한 설명과 더불어 방어의 고급을 알려주겠네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/095"
msgid "이올린의 가르침을 받아 <color=#FFDE5A>EXP 40</color>이 상승했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/096"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/097"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/098"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/099"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/100"
msgid "5장 : 중급 방어"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/101"
msgid "[이올린]/n이제 자네도 중급 이상의 검술을 익혔군./n그럼 중검과 방어에 대한 이론을 총정리 해보세."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/102"
msgid "[이올린]/n전에 돌파에 대해 설명하면서 \"방어자가 공격자의 공격을 완벽하게 막아낸다\"고 가정하고 강의했네./n그러나 실전에서는 적의 공격을 전부 방어할 수는 없지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/103"
msgid "예. 적의 공격을 모두 막을 수는 없었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/104"
msgid "[이올린]/n적의 공격을 얼마나 막을 수 있는지는 무기의 종류와/n방어자의 민첩성과 관련이 있지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/105"
msgid "[이올린]/n세검은 무기 자체가 방어에 적합하지 않기 때문에/n많은 공격을 막을 수 없지만, 중검은 무기가 가진 특성이/n적의 공격을 막을 확률을 높여주는 것이라네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/106"
msgid "[이올린]/n또, 무기에는 방어력이라는 특성이 있지./n공격을 막았을 때 무기의 방어력에 따라/n적의 공격을 일정한 비율로 감소시켜 주는 것이네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/107"
msgid "[이올린]/n세검은 방어력이 낮고 중검은 방어력이 높기 때문에,/n같은 공격을 막는다면 중검을 사용하는 쪽이 피해를/n덜 입게 되는 것이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/108"
msgid "그럼, 중검을 사용하는 것이 현명하다는 것입니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/109"
msgid "[이올린]/n검에는 세검과 중검만 있는 것은 아니지만,/n대체로는 그렇다고 할 수 있겠지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/110"
msgid "[이올린]/n다수의 적을 혼자서 상대해야 할 때나, 좁은 공간에서/n싸우는 경우에는 중검을 사용하는 것이 유리할 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/111"
msgid "[이올린]/n이제 방어 자세에 대해 설명하겠네. 적의 공격이 집중된/n상황에서 아군의 도움을 기다리거나, 적의 주의를 끌어야/n할 때는 방어 자세를 취하는 것이 도움이 될 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/112"
msgid "[이올린]/n방어 자세를 취한 상태에서는 적의 공격을 막을 확률이/n두 배가 되지. 만약 자네가 중검을 갖고 있는 상황이라면,/n방어 자세는 자네를 보다 안전하게 만들어 줄 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/113"
msgid "알겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/114"
msgid "[이올린]/n이제 설명도 끝나가는군. 이번에는 동굴로 들어가 보겠나./n지금까지 배운 것들을 잘 생각하면서./n검은… 이걸 사용하게."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/115"
msgid "이올린에게 <color=#6EFDFF>그라디우스</color>를 받았습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/116"
msgid "이올린의 가르침을 받아 <color=#FFDE5A>EXP 50</color>이 상승했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/117"
msgid "[이올린]/n가장 초보적인 중검이지만, 동굴 녀석들의 공격은 충분히 막아낼 수 있을 거야. 다음에는 여럿이 함께 싸울 때/n필요한 전술과 무기 교체에 대해 설명하겠네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/118"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/119"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/120"
msgid "6장 : 전술과 장비 교체"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/121"
msgid "[이올린]/n자네도 이제 혼자 하는 싸움에 대해서는 어느 정도 감을 잡은 것 같군. 하지만 전쟁은 수많은 사람들이 싸우는 것. 앞으로는 자네도 동료와 함께 싸우게 되는 경우도 있을 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/122"
msgid "[이올린]/n동료와 함께 싸울 때는 역할 분담을 하는 것이 중요하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/123"
msgid "[이올린]/n중검을 든 동료를 적진으로 돌격시켜/n적의 공격을 막으면서 적의 시선을 끌게 하면,/n다른 동료는 원활하게 공격을 할 수 있지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/124"
msgid "[이올린]/n동시에 세검이나 공격력이 강한 검을 가진 동료와,/n마법이나 총기 등을 사용하는 동료는 돌격한 동료가/n주의를 끄는 사이에 후방에서 적을 공격해서/n일망타진하는 전법이 유용할 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/125"
msgid "앞으로 돌격한 쪽이 위험하지 않을까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/126"
msgid "[이올린]/n중검류의 방어력이 상당하기 때문에, 적이 압도적으로/n강하지 않은 한 그다지 위험하지는 않을 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/127"
msgid "[이올린]/n다만 중검은 적에게 피해를 입히는 것도 쉽지 않기 때문에, 싸움에서 \"이기기\" 위해서는 동료들의 도움이 필요한/n것이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/128"
msgid "알겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/129"
msgid "[이올린]/n그리고 장비 교체에 대해서 알려주지. 양손을 제외하고,/n두 개의 보조 장비를 착용할 수 있는 것은 잘 알고 있겠지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/130"
msgid "[이올린]/n전투 중에도 손에 든 무기와 보조 장비는 교환이 가능하네. 보통은 무기가 파손된 경우를 대비한 \"보조\"용이지만,/n이것을 이용하면 혼자 싸우면서도 여럿이 같이 싸우는/n효과를 낼 수도 있지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/131"
msgid "특징이 다른 두 가지 이상의 무기를/n동시에 사용하는 방법이군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/132"
msgid "[이올린]/n그렇지. 평소에는 중검과 세검을 같이 들고 다니면서/n적의 수가 적거나 거리가 멀리 떨어져 있으면 세검으로,/n적에게 접근해야 하는 상황이 되면 중검으로 바꿔 쥐며/n싸우는 것이네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/133"
msgid "[이올린]/n검을 바꾼 후에도 이동과 공격이 가능하니, 아주 유용한/n방법이라고 할 수 있지. 특히 세검은 적을 어느 정도/n제압한 후에 마무리용으로 사용하면 좋을 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/134"
msgid "[이올린]/n다만 중검을 사용할 때는 검에 의한 공격보다는/n마법이 효과적인 경우도 있다는 것을 잊지 말게."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/135"
msgid "[이올린]/n이걸로 일반적인 공격에 대한 설명은 모두 마쳤군./n마지막으로, 검의 궁극적 기술이라고 할 수 있는/n필살기에 대한 설명만 남았네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/136"
msgid "[이올린]/n필살기를 적절히 사용하면, 아무리 강한 적도/n자네 상대가 아니라는 것을 알게 될 거야./n이번에는 동굴 깊숙한 곳까지 가보게나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fliyo01
msgctxt "field|re|art_fliyo01|@kfliyo01/137"
msgid "이올린의 가르침을 받아 <color=#FFDE5A>EXP 50</color>이 상승했습니다."
