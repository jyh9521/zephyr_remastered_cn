#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/045"
msgid "데이모스... 당신의 마음을 이제야 이해 할 수 있을 것 같습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/046"
msgid "그렇다면...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/047"
msgid "모두 물러서 주시오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/048"
msgid "어쩔 수 없습니다! 이미 파괴신이 완전히 힘을 쓰기 전에 없애야 합니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/049"
msgid "설마...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl18_s01
msgctxt "field|ko|art_ko_fl18_s01|@kfl18_s01/050"
msgid "데이모스!! 당신의 생명을 저 아이에게 허락해 주십시오!!"
