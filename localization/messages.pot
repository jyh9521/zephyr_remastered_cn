msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s09
msgctxt "field|re|art_fl00_s09|@kfl00_s09/011"
msgid "하지만 이제는/40d/n너의 힘든 일도,/20d 슬픈 일도/35d 내가 함께 하겠어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl00_s09
msgctxt "field|re|art_fl00_s09|@kfl00_s09/012"
