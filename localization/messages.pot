msgctxt "field|ko|art_ko_flmro01|@kflmro01/002"
msgid "보르도는 이곳에서 서쪽에 있는 로우엔시티 북쪽에 있다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmro08
msgctxt "field|ko|art_ko_flmro08|@kflmro08/000"
msgid "로웬숲이다!!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmro08
msgctxt "field|ko|art_ko_flmro08|@kflmro08/001"
msgid "서 - 로우엔 숲"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmro08
msgctxt "field|ko|art_ko_flmro08|@kflmro08/002"
msgid "[지리학회회원]/n우리는 지금 로우엔근처의 숲과 산들을 다시 측량하고 있는 중이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmro08
msgctxt "field|ko|art_ko_flmro08|@kflmro08/003"
msgid "[지리학회회원]/n로우엔으로 가고 싶나? 로우엔으로 가기 위해서는 이곳에서 서쪽으로 간 다음 남쪽으로 내려가서 계속 서쪽 방향으로 나아가면 갈 수 있다네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmro08
msgctxt "field|ko|art_ko_flmro08|@kflmro08/004"
msgid "[지리학회회원]/n로우엔과 게이시르는 상당히 떨어져 있어서, 게이시르에서 로우엔으로 가기 위해서는 게이시를 숲을 통해 이 로우엔산을 지나 다시 로우엔 숲을 거쳐야 하지. 이곳은 게이시르와 로우엔 사이 삼분의 이 지점쯤 되지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmro08
msgctxt "field|ko|art_ko_flmro08|@kflmro08/005"
msgid "[지리학회회원]/n이곳에서 게이시르로 가기 위해서는 남쪽으로 내력 간 다음 계속해서 동쪽으로 숲이 나올때 까지 가서,숲에서는 동쪽으로 가다가 길이 막히면 북쪽으로 계속 올라가면 되지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmro08
msgctxt "field|ko|art_ko_flmro08|@kflmro08/006"
msgid "[지리학회회원]/n이곳에서 계속해서 올라가면 로우엔던젼으로 들어갈 수 있지요. 그곳은 예전부터 다이아몬드 원석의 광산으로 유명한 곳입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmro08
msgctxt "field|ko|art_ko_flmro08|@kflmro08/007"
msgid "[지리학회회원]/n멤피스 마을을 가기 위해서는 게이시르로 가다가 숲속 두번째 갈림길에서 북쪽으로 간 다음 첫번째 갈림길에서 남쪽으로 쭉 내려가면 되지요. 니코시아는 멤피스로 가는 갈림길에서 북쪽으로 간 다음 갈림길에서 동쪽으로 가면 되고요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmro10
msgctxt "field|ko|art_ko_flmro10|@kflmro10/000"
msgid "<< 경고문 >>/n이 던젼은 매우 위험하므로 일반인의 출입을 금함/n        - 로우엔 영주"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_flmro12
msgctxt "field|ko|art_ko_flmro12|@kflmro12/000"
msgid "어려서 검을 잡은지 12년,/n무도의 길은 험난하고 길기만 하네./n하지만,모든 길은 항상 마음속에 있는 법/n번뇌를 일검에 가르니 모든 것이 분명하다./n/n칼 스타이너,이곳에서 검의 도를 얻다. "
msgstr ""

