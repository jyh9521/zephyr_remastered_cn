msgctxt "field|re|art_fl12_s02|@kfl12_s02/032"
msgid "…/35d알았네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl12_s02
