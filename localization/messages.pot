msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/035"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/036"
msgid "게이시르 시티. /n15년만인가..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/037"
msgid "과연 보물을 찾을 수 있을까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/038"
msgid "몸조심 하세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/039"
msgid "빨리 길을 떠나자구요!"
msgstr ""

