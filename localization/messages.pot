msgctxt "field|re|art_fl26_s01|@kfl26_s01/001"
msgid "[에스메랄다]/n에스테를 용서할 수 없었던 것까지는/25d 이해할 수/n있었지만…/50d 크리스티나는/30d 당신이 사랑한 여자의…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl26_s01
msgctxt "field|re|art_fl26_s01|@kfl26_s01/002"
msgid "[실버]/n다들 한가한 소리를 하는군!"
msgstr ""

