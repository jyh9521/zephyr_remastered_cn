#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s00
msgctxt "field|ko|art_ko_fl22_s00|@kfl22_s00/042"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s00
msgctxt "field|ko|art_ko_fl22_s00|@kfl22_s00/043"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s00
msgctxt "field|ko|art_ko_fl22_s00|@kfl22_s00/044"
msgid "다들..좀 무언가 이상하네. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/000"
msgid "이스카리옷..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/001"
msgid "시라노, 정말 오랜 기다림이었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/002"
msgid "무엇을 위해서 나를 배신한 것이었는지 알고 싶군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/003"
msgid "후후.... 옛 친구를 만나니 옛 이야기가 나오는군. 추억을 되살리는 것도 나쁘지는 않겠지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/004"
msgid "하지만, 시라노./40d 그건 너와 나의 싸움이 끝난 후의 이야기다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/005"
msgid "덤벼라, 시라노! 나의 힘을 보여주마!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/006"
msgid "이 정도로는 나를 막을 수 없다, 이스카리옷."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/007"
msgid "역시... 정상적인 힘으로는 너를 이길 수 없어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/008"
msgid "하지만, 내가 얻은 궁극의 힘이라면 이야기가 틀리다!/40d 각오해라, 시라노!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/009"
msgid "후후... 시라노... 최강의 힘을 손에 넣었구나. 내가 얻은 힘보다 훨씬 강한..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/010"
msgid "이스카리옷... 그렇게 괴물이 되어 가면서 까지 힘을 얻고 싶었나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/011"
msgid "그렇기 때문에 자네를 배신할 수 있었던 것 아니겠나...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/012"
msgid "자네도 결국 나와 마찬가지로 괴물이야... 사람들과 공생할 수 없는 사회의 격리자..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/013"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/014"
msgid "나는 그래도... 이렇게 자네 손에 죽을 수 있지만... 자네는... "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/015"
msgid "체사레는 어디 있나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/016"
msgid "파괴신.../30d 부활..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/017"
msgid "파괴신이라면...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/018"
msgid "트리시스 사막 건너의 수중도시에 있다고 한다...  "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s04
msgctxt "field|ko|art_ko_fl22_s04|@kfl22_s04/019"
msgid "그렇다면 체사레는 수중도시로 갔단 말인가!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/000"
msgid "클라우제비츠, 말할 것은 말해야겠소!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/001"
msgid "무슨 일이신지요, 메디치 님."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/002"
msgid "우리 제피르팰컨이 시라노, 저 자의 꼭두각시로 놀아나는 걸 나는 더 이상 견뎌 낼 수가 없소!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/003"
msgid "그게 무슨 소리예요, 메디치 오빠!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/004"
msgid "카나, 너도 현실을 인정해야 해. 저 자는 우리를 자신의 복수를 위한 도구로 이용하고 있을 뿐이라구!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/005"
msgid "메디치 님은 시라노 님의 개인적 원한이라고 하시지만, 결국 목표는 체사레 추기경의 타도. 우리 제피르팰컨의 목표와 부합된다는 사실을 잊지 마십시오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/006"
msgid "젠장, 여기 저기 모두 시라노 편만 들고 있군!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/007"
msgid "제가 감히 참견할 일은 아니겠지만, 시라노 님은 단지 오해를 사고 있을 뿐이라고 생각합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/008"
msgid "오해 건 아니 건 간에, 계속 이대로 갈거라면 난 차라리 제피르팰컨을 탈퇴하고 말겠소!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/009"
msgid "나도 마찬가지야! 시라노가 나가던지 우리 둘을 포기하던지. 둘 중 하나를 선택하라구!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/010"
msgid "시라노, 뭐라고 말 좀 해봐요...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/011"
msgid "메디치는 나의 평생의 은인, 그렇지만 제피르 팰컨의 도움이 없으면 체사레를 잡을 수 없을지도 모른다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/012"
msgid "내가 나가겠소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/013"
msgid "난 나갈 수 없소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/014"
msgid "나 때문에 제피르팰컨이 분열되는 것은 원치 않소./40d 내가 제피르팰컨을 탈퇴하겠소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/015"
msgid "시라노!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/016"
msgid "잘 생각했소, 시라노. 생각했던 것 만큼 꽉 막히진 않았군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/017"
msgid "시라노가 나간다면.../30d 나도 따라 나가겠어요!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/018"
msgid "카나, 그렇게 되면 내가 제피르팰컨을 탈퇴하는 이유가 없어져 버리게 돼./50d 내 의견을 존중해 주길 바래."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/019"
msgid "시라노..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/020"
msgid "에스메랄다는 어떻게 할 거지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/021"
msgid "저는 당연히 시라노 님을 따르겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/022"
msgid "시라노 님, 정말 죄송합니다. 일이 이렇게 되리라고는..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/023"
msgid "내가 들어오기 이 전으로 되돌아가는 것 뿐이니 너무 심려 마시오, 군사."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/024"
msgid "모두 뜻하는 바를 이루길 빌겠소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/025"
msgid "메디치의 말은 옳지 않다고 생각하오./40d 난 제피르팰컨을 그만 둘 수 없소이다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/026"
msgid "뭐라고!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/027"
msgid "확실히, 메디치 님의 말씀은 너무 지나칩니다. 하지만 메디치 님과 리델하트 님이 제피르 팰컨을 그만 두는 것도 결코 바람직하지 않은 일입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/028"
msgid "바람직하지 않다! 뭐 어쩐다!!/40d 헛소리 마라, 네 녀석도 항상 맘에 들지 않았어!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/029"
msgid "메디치 형님이 아니었다면 우리가 이렇게 큰 세력을 지닐 수 있었을 것 같으냐!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/030"
msgid "긴 말할 필요는 없다, 리델하트. 시라노를 선택한 사람들은 여기 남고 나를 선택한 사람들은 나를 따르는 거다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/031"
msgid "굴러온 돌이 박힌 돌 뽑아내는 격이로군!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/032"
msgid "메디치, 어디로... 가실거죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/033"
msgid "에스테도데는 나를 받아 주겠지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/034"
msgid ".....!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/035"
msgid "이자벨, 너도 우리와 함께 갈건가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/036"
msgid "아니.../30d 나는 여기 남겠어..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/037"
msgid "가자, 리델하트!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/038"
msgid "우리 없이 잘 되나 보자구!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/039"
msgid "자, 이러고 있을 시간이 없소. 어서 수중 도시로 향해야 하오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/040"
msgid "수중도시라면 사이럽스 부근의 7대 불가사지가 아닙니까? 그 곳은 무슨 이유로...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/041"
msgid "체사레가 그 곳으로 갔을 거요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/042"
msgid "창세전쟁의 비록에 따르면 그 곳에는 마지막 파괴신의 봉인이 남아 있소. 분명 그 봉인을 풀어 파괴신을 부활 시키려는 의도일 거요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/043"
msgid "알겠습니다, 시라노 님. 주요 병력을 수중 도시 근방으로 이동 시키겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/044"
msgid "이제는 어디로 가실거죠, 시라노?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/045"
msgid "글쎄... 일단은 게이시르 시티로 돌아가 볼까... 뭔가 잊은 것을 찾을 수 있는 것 같아."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/046"
msgid "번스타인가에...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/047"
msgid "에스메랄다는 이미 알고 있었군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/048"
msgid "....."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s05
msgctxt "field|ko|art_ko_fl22_s05|@kfl22_s05/049"
msgid "분명, 그 곳에 가면 잊어버린 뭔가를 찾을 수 있을 거야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl22_s3t
msgctxt "field|ko|art_ko_fl22_s3t|@kfl22_s3t/000"
msgid "[이스카리옷]/n봐라! 이것이 위대한 그리마의 힘이다, 시라노!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/000"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/001"
msgid "....../30d 그 날은 두번 다시 오지 않는다, 시라노."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/002"
msgid "[메르세데스]/n시라노...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/003"
msgid "!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/004"
msgid "여기 있었군요, 시라노./30d 기다렸어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/005"
msgid "메... 메르..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/006"
msgid "메르세데스!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/007"
msgid "아... 에스메랄다..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/008"
msgid "시라노 님... 갑자기 왜 그렇게..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/009"
msgid "미안하오.. 에스메랄다.../30d 잠시..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/010"
msgid "시라노, 무너져 막혀 버린 곳이 많아서 2층으로는 올라 갈 수가 없어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/011"
msgid "아아.. 그런가.../30d 알겠어..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/012"
msgid "....../40d 시라노님..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/013"
msgid "2층의 내 방으로 가야 창세전쟁의 사본을 찾을 수 있을텐데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/014"
msgid "별 수 없는 건가.../30d 나머지 책들은 어디에..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/015"
msgid "음...? 나머지라.../30d 나머지... 나머지..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/016"
msgid "그래!! 남겨진 것!! 베라딘은 7대 불가사지중 마지막인 수중도시의 파괴신을 남겨 놓았었어!/70d 그랬었군.... 체사레...!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/017"
msgid "베라딘이 남긴 파괴신이라뇨? 수중도시라면... 사이럽스 근방의 호수에 있는...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/018"
msgid "그렇소, 체사레는 내가 그 파괴신의 존재에 대해... 알게 되어 공표할 것을 두려워 한 것이었어...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/019"
msgid "사이럽스쪽이라면, 당시 체사레의 힘이 미치지 못하는 영토 였을테니... 그렇군..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/020"
msgid "실버, 사이럽스로 향한다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s01
msgctxt "field|ko|art_ko_fl23_s01|@kfl23_s01/021"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/000"
msgid "메디치 오빠?/20d 설마 리델하트가...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/001"
msgid "제가 어떻게든 손을 써보겠어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/002"
msgid "에... 에스테도데... 그녀가 리델을..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/003"
msgid "에스테도데가?!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/004"
msgid "[에스테도데]/n호호호!/30d 애초에 동료를 배반한 당신 잘못이지. 그 탓을 내게 뒤집어 씌우다니, 정말 어리석군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/005"
msgid "에스테도데, 지금이라도 늦지 않았으니 그를 뒤쫓아가 용서를 구하시오. 나도 당신을 용서하겠소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/006"
msgid "그렇지 않은가요? 디아블로 님?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/007"
msgid "후후후, 벌레만도 못한 것이!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/008"
msgid "괜찮소, 메디치?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/009"
msgid "디아블로... 그리고 체사레 보르자!/40d 나와 내 스승님의 원수를 이렇게 한자리에서 만나게 되다니."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/010"
msgid "하지만, 크리스티나를 얌전히 돌려준다면 목숨만은 살려줄 용의가 있다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/011"
msgid "이거 섭섭하군, 시라노 번스타인군./n생명의 은인을 원수라고 부르다니. 하마터면 통구이가 될뻔했던 자네를, 내가 선처해 주지 않았던가!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/012"
msgid "게다가 디아블로 님께도 그 무슨 망언인가!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/013"
msgid "됐네, 체사레 추기경. 내 감이 틀림 없다면 저녀석의 몸에서 풍기는 기운은 데이모스의 그 것과 같아."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/014"
msgid "어쩐지 몇년 전부터 데이모스의 기운이 느껴지지 않는다 했더니, 네 녀석과 융합한 것이었군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/015"
msgid "흐흐흐, 네 녀석이 크리스티나의 뭐길래 남의 손녀딸을 내 놓으라 말아라 하는 거냐."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/016"
msgid "긴 말은 필요 없다./20d 얌전히 크리스티나를 내놓으면 고통스럽지 않은 죽음을 선사하겠다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/017"
msgid "디아블로 님, 저 녀석은 독에 중독되어 얼마 남지 않은 목숨이니 벌레만도 못한 녀석입니다. 상관치 마시고 의식을 계속 해나가시는 것이..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/018"
msgid "언제까지 망언을 계속 할 수 있나 보겠다, 체사레! 각오해라!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/019"
msgid "같이 죽자! 에스테도데!!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/020"
msgid "우웃!!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/021"
msgid "아니!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/022"
msgid "네 놈은...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/023"
msgid "어딜 감히!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/024"
msgid "왜... 왜 나를 구한거요!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/025"
msgid "생명의 은인을 눈앞에서 개죽음 시킬 수는 없는 일 아니겠소?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/026"
msgid "내가... 당신의...? 은인?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/027"
msgid "3년전 인페르노에서 당신과 함께 탈출한 죄수를 아직까지 기억할런지는 모르겠소만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/028"
msgid "시라노 당신이, 그때 그...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/029"
msgid "그때 당신의 눈은 빛나고 있었소. 그런데 지금은 저런 요녀에게 홀려 광채를 잃어가고 있소./60d 당신의 모습을 보시오, 메디치!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/030"
msgid "으으...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/031"
msgid "메디치!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/032"
msgid "호호, 저런 겁쟁이를 위해서 몸을 내던지다니, 시라노 님도 어지간히 바보로군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/033"
msgid "웃기는 소리도 적당히 해야지, 뭐? 용서를 빌라구?/50d 호호호!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/034"
msgid "디아블로 님이 나를 지켜 주실거다! 용서 같은건 너희들이나 빌어라!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/035"
msgid "디아블로라... 당신이 바로 디아블로였군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/036"
msgid "크리스티나가...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/037"
msgid "이미 늦어 버렸어! 파괴신이... 부활하고 있어요!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/038"
msgid "에스메랄다가 희생해가면서 까지 구해낸 크리스티나가...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/039"
msgid "틀렸어요... 크리스티나의 숨이 점점 약해지고 있어요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/040"
msgid "크리스티나는...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/041"
msgid "수중 도시가 붕괴하고 있으니 우선 이 자리를 피해야 합니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/042"
msgid "그 사이에 크리스티나는 죽어버릴 거예요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/043"
msgid "하지만, 지금으로선 방법이 없습니다. 크리스티나 양은 제가 데리고 최대한 빨리 빠져 나가 보겠습니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/044"
msgid "기다리시오, 그런 방법으로는 크리스티나를 살릴 수 없소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/045"
msgid "데이모스... 당신의 마음을 이제야 이해 할 수 있을 것 같습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/046"
msgid "그렇다면...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/047"
msgid "모두 물러서 주시오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/048"
msgid "어쩔 수 없습니다! 이미 파괴신이 완전히 힘을 쓰기 전에 없애야 합니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/049"
msgid "설마...?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/050"
msgid "데이모스!! 당신의 생명을 저 아이에게 허락해 주십시오!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/051"
msgid "시라노!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/052"
msgid "으응..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/053"
msgid "시라노, 그녀가 살아 났습니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/054"
msgid "으음..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/055"
msgid "크리스티나를... 부탁 하오... 샤른... 아니 클라우제비츠..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/056"
msgid "알고 계셨군요, 시라노 님."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/057"
msgid "샤른호스트... 이미... 시라노는..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/058"
msgid "자신의 생명으로 크리스티나 양을..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/059"
msgid "!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/060"
msgid "도시의 붕괴가 본격화 되기 시작한 것 같습니다, 카나!/50d 크리스티나양은 제가 맡을테니 어서 빠져 나갑시다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/061"
msgid "저는 시라노 곁에 남겠어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/062"
msgid "카나!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/063"
msgid "그는 평생... 사랑하는 사람의 그림자만을 쫓아간 고독한 사람이예요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/064"
msgid "그는 이제야 비로소 안식처를 찾은 거예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/065"
msgid "그의 곁에는 내가 남겠어요. 영원히..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/066"
msgid "...알겠습니다. 행복의 기준은 각자 틀릴 테니까, 제가 그걸 방해할 수는 없겠지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/067"
msgid "진정한 행복을 찾으실 수 있기를 바라겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/068"
msgid "잘도 버티는 구나, 하지만 장난은 여기까지다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/069"
msgid "젠장, 우리 힘으로는 여기까지가 한계인가...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/070"
msgid "시라노... 그가 있었더라면..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/071"
msgid "죽어라!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/072"
msgid "모두들 괜찮소?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/073"
msgid "왜, 우리를 구한 거요! 당신은 더 이상 제피르팰컨도 아니지 않소!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/074"
msgid "내가 비록 이제는 제피르팰컨이 아니지만, 우리는 생사를 함께한 동료였잖소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/075"
msgid "내 몸을 던져서라도 당신들의 목숨을 가벼이 할 수는 없소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/076"
msgid "시라노...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/077"
msgid "시라노, 우리를 버린 것이 아니었군요...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/078"
msgid "내가... 너무 옹졸 했었소, 시라노."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/079"
msgid "과거의 일은 모두 접어두고, 눈앞의 적을 맞아 힘을 모아야 할 때요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/080"
msgid "네 녀석이 시라노라는 놈인가? 과연 데이모스의 생명을 이어 받은 녀석이라 그런지 다른 놈들과는 조금 틀리군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/081"
msgid "...네 녀석이 데이모스의 두번째 원수 디아블로!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/082"
msgid "호오, 나를 알아보는군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/083"
msgid "창세전쟁에서 살아남은 암흑신 중, 이루스는 내 손으로 없애버렸으니 남은 것은 네 놈 뿐일테지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/084"
msgid "저자가 암흑신?!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/085"
msgid "그리고, 체사레... 모든 악의 근원. 내 손으로 제거하겠다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/086"
msgid "허허, 오랜만에 만나 대뜸 살벌한 소리라니./30d 나는 화형대의 한줌 재가 될뻔했던 자네를 선처해준 생명의 은인이 아니던가."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/087"
msgid "허튼 수작은 그만 둬라, 체사레!/20d 개인적인 복수심을 접어둔다 하더라도, 인류를 위해서 결코 너를 용서 할 수 없다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/088"
msgid "누구를 파티에 참여 시키겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/089"
msgid "메디치, 함께 싸웁시다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/090"
msgid "카나, 너의 도움이 필요해!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/091"
msgid "이자벨, 당신과 함께 싸우겠소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/092"
msgid "리델하트, 함께 싸웁시다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/093"
msgid "허허, 자네는 아직도 그 어리석은 고정 관념에서 벗어나지 못하는군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/094"
msgid "내가 하는 행동은 모두 조국을 위한 것이야, 이해까지 바라진 않겠지만 오해는 하지 말게나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/095"
msgid "마키아벨리의 말은 들어서 네 생각은 알고 있다, 하지만 그건 사고의 오류다. 그릇된 수단을 통한 목적 달성은 아무런 의미가 없다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/096"
msgid "인간이나 역사 그 모든 것이, 계속되는 시행착오와 실패, 그리고 성공을 거듭하며 성장하는 것이다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/097"
msgid "역사를 억지로 이끈다는 것은 종국적으로 퇴보를 의미하게 되는 것이다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/098"
msgid "이제와서 자네와 사상에 대한 토론을 벌이게 될 줄은 몰랐네만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/099"
msgid "역사는 이미 흐르고 있어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/100"
msgid "닥쳐라!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/101"
msgid "시간이 없어요!! 이러다가는 파괴신의 부활이...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/102"
msgid "시라노, 함께 저들을 물리칩시다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/103"
msgid "고맙소, 시라노!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/104"
msgid "시라노, 고마워요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/105"
msgid "좋아요, 시라노. 함께 싸워요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/106"
msgid "좋아! 시라노. 나도 당신을 돕겠어!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/107"
msgid "디아블로는 죽었다. 이제는 정말 최후다 체사레."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/108"
msgid "으음..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/109"
msgid "[메르세데스]/n안돼요, 시라노!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl23_s02
msgctxt "field|ko|art_ko_fl23_s02|@kfl23_s02/110"
msgid "!!"
msgstr ""

