msgid "어이,/15d 새로 온 친구./20d/n트리시스 사막은 처음이라고 했던가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl03_s01
msgctxt "field|re|art_fl03_s01|@kfl03_s01/002"
msgid "그렇소이다."
msgstr ""

