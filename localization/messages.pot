#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s01
msgctxt "field|ko|art_ko_fl12_s01|@kfl12_s01/015"
msgid "괜찮아, 모젤은 다루기 쉬운 인물이니. /n이 기회를 잘 이용하면 비프로스트까지 손에 넣을 수 있을거야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s01
msgctxt "field|ko|art_ko_fl12_s01|@kfl12_s01/016"
msgid "프레데릭 공의 반발이 만만치 않을텐데요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s01
msgctxt "field|ko|art_ko_fl12_s01|@kfl12_s01/017"
msgid "걱정하지 말게./15d 그에 대해서는 이미 대책을 세워 둔 바가 있지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s01
msgctxt "field|ko|art_ko_fl12_s01|@kfl12_s01/018"
msgid "과연 언제쯤에야 각하의 통솔아래 제국령을 통일하여 제국의 영광과 평화를 되찾을 수 있을까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s01
msgctxt "field|ko|art_ko_fl12_s01|@kfl12_s01/019"
msgid "이제 곧 멀지 않았네. 우리의 대업을 이룰 날도..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s01
msgctxt "field|ko|art_ko_fl12_s01|@kfl12_s01/020"
msgid "어리석은 녀석들은 지금 당장의 우리들의 위업을 인정하지 않을지도 모르지만 역사는 우리의 업적을 제대로 평가해 줄 걸세."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s01
msgctxt "field|ko|art_ko_fl12_s01|@kfl12_s01/021"
msgid "/2c게이시르 대성당. 추기경 집무실."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s01
msgctxt "field|ko|art_ko_fl12_s01|@kfl12_s01/022"
msgid "그럼 전 이만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s01
msgctxt "field|ko|art_ko_fl12_s01|@kfl12_s01/023"
msgid "흐흐흐.../25d /n조금만...조금만 있으면 나의 야망이 완성된다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s01
msgctxt "field|ko|art_ko_fl12_s01|@kfl12_s01/024"
msgid "제피르팰컨, 프레데릭따위가 나를 막을수는 없지. /n쿡쿡쿡..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s01
msgctxt "field|ko|art_ko_fl12_s01|@kfl12_s01/025"
msgid "하하하하...../10d으하하하하..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s01
msgctxt "field|ko|art_ko_fl12_s01|@kfl12_s01/026"
msgid "이제 곧, 제국은 물론/15d 비프로스트,팬드래건,아스타니아.../20d 전 안타리아가 강력한 하나의 국가로 다시 태어나는 것이다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/000"
msgid "나도 함께 가고 싶은데.../n걱정이 된단 말이예요, 당신 혼자 보내면."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/001"
msgid "오래간만에 팀의 리더로 출동하겠군..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/002"
msgid "이번 임무는 매우 중요합니다. 반드시 성공해 주시기 바랍니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/003"
msgid "이곳은 제피르팰컨의 작전회의실 입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/004"
msgid "꼭 임무를 성공시켜 주십시오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/005"
msgid "쳇.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/006"
msgid "시라노와 함께 일을 하게 될 줄이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/007"
msgid "정말로 보물이 있을까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/008"
msgid "마키아벨리는 뛰어난 학자입니다. /n그러나..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/009"
msgid "이번일은 부탁하지요. /n꼭 성공하시길.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/010"
msgid "보물찾기라.../10d뭐 때로는 좋겠지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/011"
msgid "보물이라..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/012"
msgid "/2c제피르팰컨. 작전회의실."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/013"
msgid "무슨일이지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/014"
msgid "아..오셨군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/015"
msgid "일이 생겼습니다./n체사레 추기경이 니코시아지방에서 일을 벌이고 있나봐요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/016"
msgid "체사레.../10d보르자 말인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/017"
msgid "니코시아 지방에 요새를 세우고 뭔가 일을 꾸미는 것 같다는 정보입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/018"
msgid "하지만, 경비가 삼엄해서 우리 정보원들을 안으로 들여보내는 데에는 실패하였습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/019"
msgid "저와 함께 그곳으로 가서 무슨일을 벌이고 있나 살펴보는 임무에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/020"
msgid "니코시아지방이라면 게이시르시티 남쪽에 있는 조그만 지방입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/021"
msgid "그렇다면 남쪽으로 게이시르시티를 지나야 할겁니다. /15d/n상당히 먼 거리인걸요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/022"
msgid "게이시르 시티라..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/023"
msgid "가본적이 있나? /15d/n옛 제국시절의 수도였지. 지금도 제국 제일의 도시이고,"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/024"
msgid "최근엔 프레데릭공의 로우엔이 더 활기찬것 같던데요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/025"
msgid "현 제국 최강의 프레데릭공의 영지이니까요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/026"
msgid "그쪽은 아직 우리 제피르 팰컨의 손이 닿지 않는 곳이지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/027"
msgid "그럼, 곧 출발하도록 하지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/028"
msgid "이쪽에서도 변동사항이 있으면 전령을 통해 연락을 드리도록 하겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/029"
msgid "저...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/030"
msgid "음..?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/031"
msgid "그 서랍은../15d/n여시면 안됩니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/032"
msgid "....../20d알았네./n이 서랍은 열지 않도록 하지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/033"
msgid "아뭏든...그..그 서랍만은..../120d/n여시면 안됩니다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
