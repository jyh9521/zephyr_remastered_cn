msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/061"
msgid "[지나]/n이봐요, 당신!/15d 당신은 한 연인을 사귀면서 또 다른 연인을 사귈 수 있다고 생각해요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/061_3"
msgid "[ 지나 ]/n이봐요, 당신! 당신은 한 사람을 사귀면서 다른 사람을 또 만날 수 있다고 봐요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/062"
msgid "어떻게 대답하시겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/062_3"
msgid "나 자신의 대답은?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/063"
msgid "그럴 수 있지. 사랑이란 구속이 아니잖소."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/063_3"
msgid "뭐, 그럴수도 있지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/064"
msgid "안돼지. 그건 상대를 배신하는 짓이오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/064_3"
msgid "그럴수는 없지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/065"
msgid "[존]/n거 봐./10d 그럴 수 있다고 하잖아."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/065_3"
msgid "[ 존 ]/n거 봐. 그럴수도 있다고 하잖아."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/066"
msgid "[지나]/n하!/10d 하!/10d 남자들이란!/20d 좋아요, 당신,/10d 이거 가져요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/066_3"
