msgid "이…/15d 이런…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s01
msgctxt "field|re|art_fl10_s01|@kfl10_s01/030"
msgid "공왕!/35d/n당신 지금 큰 실수하고 있는 거요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s01
msgctxt "field|re|art_fl10_s01|@kfl10_s01/031"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s01
msgctxt "field|re|art_fl10_s01|@kfl10_s01/032"
msgid "아무짝에도 쓸모없는 원로원 늙은이들…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s01
msgctxt "field|re|art_fl10_s01|@kfl10_s01/033"
msgid "이번 기회에,/30d 원로원도 폐쇄시켜 버리는 게 좋겠군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s01
msgctxt "field|re|art_fl10_s01|@kfl10_s01/034"
msgid "사실대로 말하는 것이 어떻겠어요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s01
msgctxt "field|re|art_fl10_s01|@kfl10_s01/035"
msgid "제 10 장"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s01
msgctxt "field|re|art_fl10_s01|@kfl10_s01/036"
msgid "리브레빌의 영주"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/000"
msgid "[카나]/n그럼/10d 저쪽에서 합류하는 거네./25d/n길 잃지 말고 잘 찾아오세요!/25d 헤헷."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/001"
msgid "자,/30d 에스테 도데 영주의 리브레빌로 떠나자."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/002"
msgid "[이자벨]/n메디치는 정말…/50d 미인의 의뢰라고 들떠서는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/003"
msgid "[이자벨]/n놀러 가는 게 아니니까,/30d 임무에 지장이 생기면 곤란해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/004"
msgid "[에스메랄다]/n당신에게 마음의 평안이 찾아올 때는 언제일까요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/005"
msgid "[클라우제비츠]/n준비가 되면 바로 출발하세요./45d/n리브레빌의 에스테 저택에서 합류하시죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/006"
msgid "[에스메랄다]/n시라노 님의 안식을 위해 항상 기도하고 있어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/007"
msgid "[리델]/n에데스 테도…/25d 에도 스테도…/30d 에스테 도…/40d/n으아,/45d 이름을 기억 못 하겠다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/008"
msgid "[실버]/n리브레빌은/10d 제국령의 최북단인데도 이상하게 따뜻해서/55d/n살기 좋은 곳이라고 하네요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/009"
msgid "[메디치]/n하하하,/45d 에스테 도데라…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/010"
msgid "[리델]/n에스테 도데…/50d/n미인으로 소문날 정도면 얼마나 미인일까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/011"
msgid "[보르스]/n메디치 대장님을 부탁드립니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/012"
msgid "[루이]/n리브레빌까지는 먼 길입니다./35d/n지도나 표지판을 보고 헤매지 않도록 주의하세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/013"
msgid "[클라우제비츠]/n에스테라는 영주도 보통은 아닌 것 같습니다./60d/n제피르 팰컨을 끌어들일 생각을 하다니…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/014"
msgid "[클라우제비츠]/n그런데,/40d '창세전쟁의 비록'이라는 책을 아십니까?/65d/n아주 흥미로운 책이지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/015"
msgid "제피르 팰컨, 작전회의실"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/016"
msgid "모두 모이셨군요./35d 회의를 시작하기에 앞서서…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/017"
msgid "짐작하셨겠지만,/30d/n여기 있는 크리스 씨를/30d 우리 제피르 팰컨의 일원으로 맞이하기로 했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/018"
msgid "에스테라면…/40d/n리브레빌의 절세 미녀로 유명한/35d 영주 에스테 도데?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/019"
msgid "네,/35d 바로 그 에스테 도데입니다"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/020"
msgid "리브레빌은/25d 제국의 북쪽,/30d 비프로스트와 국경 근처에 있어/35d/n교회 세력의 영향도 크지 않은 곳입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/021"
msgid "그 리브레빌의 영주가 무슨 일이지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/022"
msgid "비프로스트의 공왕이/25d 야심가라는 것은 잘 아시겠지만,/40d/n최근 들어 군비를 계속 늘려오고 있다는 정보입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/023"
msgid "그 군대를 동원해/35d 비프로스트 근방 제국령의 소영주들을/30d 압박하는 모양입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/024"
msgid "리브레빌 입장에서는/40d 교회 세력보다는/30d 이웃 나라의 침략이/25d 더 위협이 된다는 것이겠지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/025"
msgid "그래서/20d 우리 제피르 팰컨에 도움을 요청한 거군요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/026"
msgid "그렇습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/027"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/028"
msgid "흐음…/50d 제국의 영주가 제피르 팰컨에게 도움을 요청하다니,/65d 이상하지 않나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/029"
msgid "그래서 저도/15d 여러모로 조사를 해 봤습니다만,/40d 함정은 아니라고 판단했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/030"
msgid "에스테 영주는/30d 교회나 게이시르 측과는 그렇게 가깝지는 않더군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/031"
msgid "하하하,/40d 미인 영주의 부탁을 무시할 수는 없지./35d/n바로 가볼까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/032"
msgid "…메디치,/30d 당신은 정말…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/033"
msgid "자, 그럼/15d 자세한 이야기는/25d/n리브레빌에 도착한 후에 하시지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/034"
msgid "그 서랍은 절대…/35d 절대로 열지 마세요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/035"
msgid "???"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/036"
msgid "아,/15d 그게…/30d/n열쇠가 없어서…/30d 열 수가 없어요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/037"
msgid "[보르스]/n!!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/038"
msgid "우리 4부대와 함께/20d 카라카스 숲까지 가지 않을래요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/039"
msgid "카나의 부대와 함께 카라카스 숲까지 이동하겠습니까?/n(함께 행동하면 카라카스 숲으로 자동으로 이동합니다.)"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/040"
msgid "그럼, 같이 가지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/041"
msgid "우리는 단독으로 움직이겠어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/042"
msgid "좋아요!/20d 그럼 갑시다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/043"
msgid "그럼,/20d 카나와 카라카스까지 같이 가지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/044"
msgid "이번에는/20d 주변도 조사할 겸 따로 움직이도록 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/045"
msgid "[크리스]/n클라우제비츠 군사님의 지시로/30d/n시라노 씨와 함께 행동하게 되었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/046"
msgid "[크리스]/n앞으로 잘 부탁드립니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/047"
msgid "크리스입니다./35d 잘 부탁드립니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/048"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/049"
msgid "[메디치]/n절세 미녀라고 불릴 정도라니,/35d 기대되는군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/050"
msgid "[실버]/n그곳까지/35d 별 어려움 없이 갈 수 있으면 좋겠군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/051"
msgid "[카나]/n표지판을 잘 살펴보면 괜찮을 거예요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/052"
msgid "[카나]/n절세 미녀라는 에스테 영주는 어떤 사람일까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/053"
msgid "[에스메랄다]/n실버 씨는 너무 멋진 사람인 것 같아요./50d/n의지가 되곤 한답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/054"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/055"
msgid "[실버]/n준비가 되셨으면 출발하시죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/056"
msgid "[메디치]/n평소보다 더 기합이 들어가는 걸?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/057"
msgid "[보르스]/n지켜보고 있지 않으면/25d/n어느새 임무와는 상관없는 일을 하곤 하시니까요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/058"
msgid "[보르스]/n사람들을 돕는 일이다 보니/40d 말릴 수도 없고 말이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/059"
msgid "[리델]/n아니야,/25d 그래도 너무 기대하지는 말아야지./45d/n미인에도 여러 가지가 있으니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/060"
msgid "[이자벨]/n리브레빌로 떠난다고 하지 않았나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/061"
msgid "[루이]/n그런데…/15d/n혹시 비프로스트 최강의 검사에 대해 알고 계시나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/062"
msgid "[루이]/n카타리나라는 여검사라는데,/30d 신경 쓰이는군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/063"
msgid "[크리스]/n다들 유능해 보이는 분들이라,/30d 든든하네요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/064"
msgid "꼬마야,/15d 부탁이니 걸리적거리지는 말라구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/065"
msgid "…뭐,/30d 리델보다는/25d 훨씬 진중한 소년인 것 같은데?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/066"
msgid "뭐야~?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/067"
msgid "제피르 팰컨에 받아주셔서/35d 진심으로 감사드립니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/068"
msgid "자,/20d 그럼 회의를 시작하겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/069"
msgid "조금 전에,/25d 리브레빌의 에스테 영주로부터 전령이 도착했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/070"
msgid "하하,/35d 이자벨의 직설은 아프지만/20d/n항상 맞는 말이긴 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/071"
msgid "아,/5d 형님까지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s02
msgctxt "field|re|art_fl10_s02|@kfl10_s02/072"
msgid "크리스,/35d 자네같이 젊은 실력자가/25d 우리와 뜻을 함께 하겠다니 기쁘군./40d/n앞으로 제피르 팰컨에/15d 활기를 불어넣어 주기를 기대하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s03
msgctxt "field|re|art_fl10_s03|@kfl10_s03/000"
msgid "제피르 팰컨 분들이십니까?/55d/n기다리고 있었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s03
msgctxt "field|re|art_fl10_s03|@kfl10_s03/001"
msgid "다른 사람들은 다 도착했나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s03
msgctxt "field|re|art_fl10_s03|@kfl10_s03/002"
msgid "네,/35d 이미 도착해서 기다리고 계십니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s03
msgctxt "field|re|art_fl10_s03|@kfl10_s03/003"
msgid "시라노 님,/25d 도착하셨습니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s03
msgctxt "field|re|art_fl10_s03|@kfl10_s03/004"
msgid "클라우제비츠 군사님!/30d 기다리고 계셨군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s03
msgctxt "field|re|art_fl10_s03|@kfl10_s03/005"
msgid "늘 그렇듯이,/40d 메디치 님을 제외하고는 모두 모이셨습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s03
msgctxt "field|re|art_fl10_s03|@kfl10_s03/006"
msgid "늘/15d 그렇다고요…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s03
msgctxt "field|re|art_fl10_s03|@kfl10_s03/007"
msgid "후후,/40d 자주 있는 일이지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s03
msgctxt "field|re|art_fl10_s03|@kfl10_s03/008"
msgid "그럼,/25d 영주를 만나보도록 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s03
msgctxt "field|re|art_fl10_s03|@kfl10_s03/009"
msgid "에스테 저택, 로비"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s03
msgctxt "field|re|art_fl10_s03|@kfl10_s03/010"
msgid "메디치 님이 도착하실 때까지는/15d 시간이 걸릴 것 같으니,/35d/n우선 저희가 먼저 에스테 영주의 이야기를 들어보도록 하시지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s03
msgctxt "field|re|art_fl10_s03|@kfl10_s03/011"
msgid "한 분만 빼고 말이지요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/000"
msgid "에스테 님이 나오십니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/001"
msgid "처음 뵙겠습니다./30d/n제가 이곳 리브레빌의 영주,/35d 에스테 도데입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/002"
msgid "저야말로,/25d 제 부탁을 받고 이렇게 와주셔서/40d/n뭐라고 감사를 드려야 할지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/003"
msgid "제국령 최고의 선정 통치로 유명하신 에스테 님께서/45d/n이렇게 초대해 주시다니,/15d 영광입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/004"
msgid "그런데,/40d 최근 곤란한 일이 있으시다고 들었습니다만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/005"
msgid "네…/35d 저희 리브레빌은/30d 지금 매우 어려운 상황에/n놓여 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/006"
msgid "[메디치]/n미인의 입에서/15d 한숨이 나오게 만드는 그 문제가/25d/n대체 무엇입니까!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/007"
msgid "메디치!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/008"
msgid "메디치 오빠!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/009"
msgid "형님!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/010"
msgid "메디치 님?/35d 당신이 바로 메디치 님이시군요!/40d/n뵙게 돼서 정말 기뻐요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/011"
msgid "하하,/30d 여러분 미안./30d/n또 늦어버렸군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/012"
msgid "오는 길에/25d 에스테 님의 영지를 둘러보니,/40d 역시 리브레빌은/20d 정말 온화하고 살기 좋은 곳이라는 생각이 들더군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/013"
msgid "메디치 오빠,/20d 초대를 받아놓고 이렇게 늦으면 실례잖아요!/50d/n거기다 갑자기 끼어들기나 하고!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/014"
msgid "아니요,/35d 저는 괜찮아요./30d/n그렇게 면박 주시지 마세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/015"
msgid "저는/20d 메디치 님을 만난 것만으로도/25d 감격했는걸요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/016"
msgid "하하하,/45d 이거 몸 둘 바를 모르겠군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/017"
msgid "후훗,/35d 신경 쓰지 마세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/018"
msgid "......"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/019"
msgid "다들 먼 길을 오시느라 피곤하실 테니,/40d 일단은 객실로/n안내해 드리겠습니다./40d 만찬 후에 살롱에서 다시 뵙지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/020"
msgid "그럼,/25d 저는 먼저 실례하겠습니다./35d/n부디 편히 쉬어주세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/021"
msgid "손님분들 객실까지 안내해 드리겠습니다./50d/n이쪽으로 와 주세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/022"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/023"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/024"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/025"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s04
msgctxt "field|re|art_fl10_s04|@kfl10_s04/026"
msgid "그래도/20d 기다리시게 한 건 정식으로 사과드립니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/000"
msgid "식사는 잘 하셨는지요?/50d/n음식이 입에 맞으셨는지 모르겠네요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/001"
msgid "누가 대접해 주신 식사인데/25d 여부가 있겠습니까!/30d/n정말 잘 먹었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/002"
msgid "정말 다행이네요./60d/n여러분께 조금이라도 만족을 드렸다니 기쁩니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/003"
msgid "여유 부릴 상황은 아닌 것 같은데,/60d 슬슬 본론을 듣고 싶습니다만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/004"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/005"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/006"
msgid "아아…/55d 네…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/007"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/008"
msgid "말씀이 갑작스러워/20d 부담을 드린 모양입니다만,/40d/n에스테 님을 한시라도 빨리 돕고 싶은 마음에서 그런 것이니/25d 이해해 주십시오./30d/n자,/30d 부디 편하게 고민을 말씀해 주십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/009"
msgid "네,/30d 그렇게 말씀해 주시니 오히려 부담을 덜었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/010"
msgid "그럼/20d 여러분을 모시게 된 이유에 대해/25d/n말씀드리겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/011"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/012"
msgid "아시다시피/25d 저희 리브레빌은/20d 제국령에서도 손에 꼽히는/30d/n살기 좋은 곳이라고 평가를 받고 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/013"
msgid "당연하죠!/35d/n여기는 제국령 최고라고 해도 될 겁니다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/014"
msgid "리델!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/015"
msgid "윽…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/016"
msgid "선대 영주와 주민들은/30d 산지를 개척하고/30d 척박했던 땅을/n깎아 도로를 건설했고,/50d 결국/20d 북방의 비프로스트나/20d/n커티스와의 교역의 중심지로 자리 잡게 되었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/017"
msgid "이 땅은/25d 우리들의 피와 땀이 일구어 낸 결실인 것입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/018"
msgid "그런데…/20d 1년쯤 전의 일일 거예요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/019"
msgid "커티스로 통하는/25d 마을 동쪽 도로의 북쪽 고원 지대가,/40d/n새로운 영지로 분리되어 마을이 들어선 것입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/020"
msgid "혹시,/20d 영지가 분리된 게 곤란하다는 말씀인가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/021"
msgid "그런 건 상관 없어요./40d 문제는/20d 우리 리브레빌의 생명줄이나 다름없는 그 도로를,/55d 그 마을에서/15d 자기들의 소유인 양/10d/n차지하고는 통행세를 받기 시작한 것입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/022"
msgid "정말 염치도 없는 녀석들이군!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/023"
msgid "하지만,/25d 제국령 내에서 그 정도 영토 분쟁은/35d 여기저기서 수없이 벌어지고 있어요./55d/n설마,/30d 그 정도 일로 우리에게 도움을 청한 것은 아니시겠죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/024"
msgid "이자벨 님,/30d 아직 말씀이 끝나지 않은 것 같으니/30d/n조금만 더 들어보시지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/025"
msgid "네,/40d 단지 통행세 정도의 문제라면/40d/n영주들 선에서 해결을 보려고 했는데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/026"
msgid "게다가…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/027"
msgid "게다가…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/028"
msgid "그 도로를 통해 일을 나가던 리브레빌 사람들이,/50d/n언제부턴가 하나둘씩 돌아오지 않는 거예요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/029"
msgid "네…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/030"
msgid "실종?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/031"
msgid "납치라도 당했다고 말씀하고 싶으신 겁니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/032"
msgid "저도/30d 그렇게까지는 생각하고 싶지 않습니다./45d/n하지만/25d 우리 마을 사람들이 돌아오지 않는 것을/30d/n두 손 놓고 보고만 있을 수는 없습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/033"
msgid "그런데…/20d 왜 직접 그들과 싸우지 않는 거죠?/40d/n리브레빌은 사람도 많고 더 발전된 마을이잖아요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/034"
msgid "그건…/45d 그들의 마을이 일반적이지 않기 때문이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/035"
msgid "화력입니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/036"
msgid "화력도 상당히 갖추고 있는 것 같지만…/55d/n그들은/20d 몬스터를 이용하고 있어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/037"
msgid "몬스터를…?/45d 확실히 뭔가 있군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/038"
msgid "얼굴을 드러내지 않고/15d 몬스터를 부려 사람들을 납치하는 영주라…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/039"
msgid "그래서,/20d 우리가 어떻게 해주기를 바라는 거죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/040"
msgid "당연히 이 창으로/20d 그 녀석들을 절단 내길 바라시는 거겠지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/041"
msgid "무고한 사람을 괴롭히는 녀석을/25d 우리 제피르 팰컨이 내버려둘 순 없지!/50d/n영주님의 부탁이 없었더라도,/25d/n이런 사실을 미리 알았다면 우리가 가만있지는 않았을 겁니다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/042"
msgid "그럼…/40d 제 부탁을 들어주시는 거지요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/043"
msgid "잠시만요, 에스테 님./30d/n설마/20d 아무런 대가도 없이/25d 우리 힘을 빌리려는 생각은 아니시겠죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/044"
msgid "물론 사례는 하겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/045"
msgid "무슨 말씀입니까!/50d 영주님께 부담을 드릴 수는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/046"
msgid "옛말에/30d 호의는 거절하는 게 아니라고 했습니다./30d/n에스테 님,/30d 무엇을 준비하셨는지 여쭤봐도 되겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/047"
msgid "그곳의 영주는/25d 외부에 얼굴을 내비치지도 않을뿐더러/40d/n우리 쪽에서 서한을 보내도 아무런 소식이 없습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/048"
msgid "연간 지원금 100만 엘드,/40d 그리고/15d 제피르 팰컨 간부들의/25d/n신분 보장을 약속하겠습니다./50d 제 저택도/25d 자유롭게/n사용하셔도 좋습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/049"
msgid "헉!/25d 100만을 매년…?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/050"
msgid "과연,/35d 최고 영주님 다운 배포이십니다./45d/n성의는 감사히 받겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/051"
msgid "저는 평소부터/25d 제피르 팰컨의 활약을/20d 항상 동경해오고/n있었답니다./45d 도움이 될 수 있다면/20d 작은 일이라도/25d/n마음을 다해 돕겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/052"
msgid "지금 바로/25d 착수금으로 50만 엘드를 드릴 테니,/35d/n잘 부탁드리겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/053"
msgid "정말 고맙습니다./40d 에스테 도데 님!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/054"
msgid "앞으로는/35d 에스테라고 불러주세요,/35d 메디치 님."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/055"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/056"
msgid "대단한 것은 아니지만/45d/n제 성의라고 생각하고 받아주셨으면 합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s05
msgctxt "field|re|art_fl10_s05|@kfl10_s05/057"
msgid "에스테 저택, 살롱"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/000"
msgid "인기척이…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/001"
msgid "카나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/002"
msgid "[카나]/n메디치 오빠?/30d/n안에 있어요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/003"
msgid "흐음…/30d 역시 아직 안 왔나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/004"
msgid "하긴,/20d 메디치 오빠가 약속 시간에 맞춰 나올 리가 없지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/005"
msgid "근데,/20d 갑자기 이런 곳에서 무슨 볼일이 있다는 거지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/006"
msgid "아름다운 꽃 속에 둘러싸이니/40d/n네 아름다움이 더욱 돋보이는구나,/35d 카나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/007"
msgid "메디치 오빠,/20d 또 시작이에요?/30d/n그렇게 아부할 정도로 미안하면/25d 약속 시간에 늦지나 말아요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/008"
msgid "아부라니,/5d 너무하는군./40d/n난 카나에게는 언제나 진심이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/009"
msgid "계속 농담만 하면 상대하지도 않을 거예요./50d/n장난은 그만두고 어서 본론이나 얘기해 봐요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/010"
msgid "네가 정 그렇게/25d 내 말을 가볍게 듣는다면/20d 좋다./45d/n나도/20d 장난하듯이 얘기하지 않겠어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/011"
msgid "이제는 나도/30d 너에 대한 태도를/n확실히 하고 싶어,/15d 카나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/012"
msgid "나의 마음을 받아다오./55d/n카나,/40d 나는 너를…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/013"
msgid "그만, 그만!/20d 됐어요 오빠!/25d 그만해요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/014"
msgid "지금 그 말은 듣지 않은 걸로 할게요./45d/n다른 볼일이 없으면 돌아갈게요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/015"
msgid "카나!/30d 장난이 아니야./20d 나는 진심이야./40d/n너는 아직도 내 마음을 모르는 거야?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/016"
msgid "…/55d나도/15d 오빠를 좋아해요./30d/n존경하고…/30d 친오빠처럼 의지하고 있어요./40d 하지만… "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/017"
msgid "하지만…/50d 연인이 될 수는 없다는 거야?/45d/n나는/20d 너의 사랑을 받을 자격이/30d 없단 말이야?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/018"
msgid "그런 게 아니에요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/019"
msgid "…그리고 나,/55d 좋아하는 사람이 있어요./35d/n아직/15d 그 사람에게 인정받지는 못하고 있지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/020"
msgid "그 자로군…/50d/n그를/20d 좋아한단 말이야?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/021"
msgid "메디치 오빠,/20d 제발 그만해요./30d/n이런 일로 우리 사이를 멀어지게 하긴 싫어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/022"
msgid "대체…/30d 그 자의 어디가 그렇게 좋은 거야?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/023"
msgid "…그래,/15d 그는 강하지…/25d/n나보다…/15d 아니,/30d 어느 누구보다도."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/024"
msgid "[카나]/n오빤 정말 바보야!/35d/n앞으로 오빠하고는 상대하지도 않을 거에요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/025"
msgid "…진짜…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/026"
msgid "카… 카나!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
msgctxt "field|re|art_fl10_s06|@kfl10_s06/027"
msgid "카나,/25d 그래도 나는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl10_s06
