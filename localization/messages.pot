#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/041"
msgid "그래, 군사 말은 체사레가 비프로스트의 군대를 끌어들이려 한다는 말인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/042"
msgid "제 판단엔 거의 확실한 것 같습니다. /n이미, 오래전부터 비프로스트와 교회간의 비밀스런 움직임이 포착되었습니다만, 체사레의 오른팔인 마키아벨리가 직접 비프로스트로 향한 다는 것은 심상찮은 일이라 할수 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/043"
msgid "이번엔 체사레의 오른팔인 마키아벨리가 직접 비프로스트로 향한 다는 것은 심상찮은 일이라 할수 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/044"
msgid "마키아벨리?!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/045"
msgid "아시는 분입니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/046"
msgid "마키아벨리는 사실 학자들 사이에서는 매우 유명한 이름입니다. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/047"
msgid "마키아벨리는 사실 학자들 사이에서는 매우 유명한 이름입니다. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/048"
msgid "새로운 사상을 연구하여 이름을 날리고 있지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/049"
msgid "...어릴때 절친한 친구였지. /n그 친구가 체사레 밑에서 일한다니..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/050"
msgid "현재 군사와 더불어 제국의 두 현자로 유명하죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/051"
msgid "현자라니, 당치도 않은 말씀입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/052"
msgid "어쨌든, 그가 사상과 역사학쪽으로 유명하다면 저는 전략과 전사에 능한 편이지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/053"
msgid "어렸을때 부터 천재였소. 하지만, 가난한 집안 출신으로 야심에 불타고 있었지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/054"
msgid "어쨌든, 그 자가 직접 비프로스트로 향하고 있는 이상 방치할 수 만은 없습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/055"
msgid "좋아, 내가 그자를 뒤쫓도록 하지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/056"
msgid "저도 함께 갈께요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/057"
msgid "아닙니다. 카나님은 따로 부탁드릴 일이 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/058"
msgid "예?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/059"
msgid "얼마전 우연찮게 보물지도를 입수했습니다. /n감식 결과 이것이 과거의 용병집단, 카슈미르가 남긴 진짜 보물지도임이 판명되었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/060"
msgid "그 보물들이 있다면 최근 프레데릭 경에게 타격을 받은 자금과 장비문제를 해결할수 있을 것입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/061"
msgid "좋아, 내가 그자를 뒤쫓도록 하지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/062"
msgid "어렸을때 부터 천재였소. 하지만, 가난한 집안 출신으로 야심에 불타고 있었지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/063"
msgid "이런...나도 가야한다고?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/064"
msgid "예, 이번에는 카나님과 동행해주시기 바랍니다. /n그리고, 이자벨님과 메디치님도 부탁드리겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/065"
msgid "그러면 시라노가 마키아벨리를 추적하는 동안, 우린 보물찾기나 하고 있어야 하나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/066"
msgid "그래요! /n언니도 따라간다면 문제 없을 거여요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/067"
msgid "...../25d뭐, 때로는 잠시 쉬는것도 좋겠지. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/068"
msgid "그리고 리델하트님은 시라노님을 도와 마키아벨리를 추적해 주십시요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/069"
msgid "내가 시라노와!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/070"
msgid "이것은 우리에게 중요한 임무입니다. 사적인 감정은 뒤로 하고 반드시 임무를 성공시켜 주시기 바랍니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/071"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/072"
msgid "그럼 회의는 이것으로 마치겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/073"
msgid "내가 시라노와!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/074"
msgid "마키아벨리가 체사레 밑에서 일하고 있었다니..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/075"
msgid "/2c제피르팰컨. 회의실."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/076"
msgid "비프로스트는 리브레빌을 통해야 해요./n일단은 카라카스숲까지 배웅해 드릴까요? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/077"
msgid "카나들과 함께 카라카스 숲으로 이동할 것인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/078"
msgid "카나와 함께 이동한다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/079"
msgid "근방의 남은 던젼들을 탐색해 본다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/080"
msgid "좋아, 카나들과 함께 카라카스로 가도록 하자!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/081"
msgid "자,그럼 출발해요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/082"
msgid "미안하지만, 나는 이 근방의 던젼들을 좀더 탐색해 보고 싶군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/083"
msgid "할수 없죠..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/084"
msgid "비프로스트접경의 망티고아산에는 유니콘의 정령이 봉인된 동굴이 있다고 합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/085"
msgid "펜드래건의 크리사오르사에서 최근에 개발한 신형검에 관해서 알고 계십니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/086"
msgid "그리 비싸지 않은 가격에 기존의 양산검을 능가하는 성능으로 펜드래건군의 제식검으로 채택되었다고 하더군요./n제국령에는 아직 보급되지 않았지만 검사들 사이에서는 화제의 대상입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/087"
msgid "펜드래건의 신형검? PS-7 '블릿츠'말인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/088"
msgid "투르족의 광검에 대항하기 위해 제작되었다고 하더군./n일반적인 금속이 아닌 특수합금으로 제작되어 열이나 충격에 강하고 방어력과 공격력이 뛰어난 최고의 병기라고 하던데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl12_s02
msgctxt "field|ko|art_ko_fl12_s02|@kfl12_s02/089"
msgid "아무래도 이 임무에는 실버님의 도움이 필요할 듯 싶습니다."
msgstr ""

