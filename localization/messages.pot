#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/003"
msgid "이제와서 결투를 신청한 이유를 물어도/45d/n대답할 리 없을테지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/004"
msgid "잘 알고 있군./50d/n짐작가는 것이 있다면,/30d 그것이 답이다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/005"
msgid "그렇다면/40d 긴 말은 필요 없겠지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/006"
msgid "…/80d명불허전이로군./55d 과연 제국 최강의 검사…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/007"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/008"
msgid "내 목숨을 원한다고 했지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/009"
msgid "…한가지 묻고 싶은 것이 있소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/010"
msgid "15년 전,/45d 당신과의 결투로 목숨을 잃은/40d 루크 번스타인이라는 남자를 기억하시오?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/011"
msgid "루크 번스타인이라면…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/012"
msgid "…/40d기억하고 있소./40d/n아마 죄목은/30d 악마 숭배와 반란 혐의였지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/013"
msgid "당신은 그를 죽인 일을 후회하고 있소?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/014"
msgid "후회라…/55d/n그에게 씌워진 죄목은/25d 뻔한 누명이었겠지만,/50d 내가 한 일을/20d 후회한 적은 없소./45d/n그건/40d 단순한 결투가 아니었소./40d 전쟁이었소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/015"
msgid "그리고/40d 그 전쟁을 일으킨 주범은/35d 루크 번스타인./55d/n내가 한 일은/35d 희생을 줄이기 위한 정당한 행동이었소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/016"
msgid "그 일에 대해,/50d 후회는 하지 않소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/017"
msgid "…/40d그런가."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/018"
msgid "…/50d당신은/45d 루크 번스타인의 죽음에 대한 보상으로/50d 내 목숨을 원한 것이었군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/019"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/020"
msgid "미안하지만,/45d 내 생각에는 변함이 없소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/021"
msgid "당신에게는 미련은 없나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/022"
msgid "미련 없는 죽음을 맞이할 수 있는 사람이/45d 세상에 있겠소?/60d/n아내와 딸이 슬퍼할 것을 생각하면/45d 비굴해질지도 모르지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/023"
msgid "…아내…/10d라…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/024"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/025"
msgid "메르세데스…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/026"
msgid "……!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/027"
msgid "당신의 아내는…/60d 나의 메르세데스였소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/028"
msgid "…/45d그게 무슨…/25d 윽!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/029"
msgid "신이 세상에 사랑을 주었고,/75d 그것을 질투한/35d 악마가 있었지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/030"
msgid "……!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/031"
msgid "당신이 그들의 죗값을 대신 치러야 할 이유는 없지./80d/n어서 산을 내려가시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/032"
msgid "결투에 앞서 무기나 점검해 볼까..."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/033"
msgid "…결투에 앞서 장비나 한번 점검할까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/034"
msgid "장비를 점검하겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/035"
msgid "장비를 점검한다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/036"
msgid "이대로 기다린다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/037"
msgid "프레데릭은 준비도 없이 맞설만한 상대는 아니야./30d/n장비를 확인해야겠어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/038"
msgid "장비 점검이 끝났습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/039"
msgid "아직 부족해. 한 번 더 확인한다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/040"
msgid "이 정도면 충분해. 이대로 기다린다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/041"
msgid "준비는 충분해. 언제든지 와라, 프레데릭!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/042"
msgid "자,/40d 어서 가져가시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/043"
msgid "어서 목숨을 가져가시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/044"
msgid "…당신은…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/045"
msgid "…번스타인…/100d/n시라노…/45d 번스타인…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl15_s02
msgctxt "field|re|art_fl15_s02|@kfl15_s02/046"
