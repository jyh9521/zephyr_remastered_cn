#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/073"
msgid "미안하지만, 바빠서 안되겠는걸."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/074"
msgid "좋아, 샤론을 만난다면 꼭 싸인을 받아다 주지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/075"
msgid "정말이죠?/10d 그럼 약속한거예요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/076"
msgid "미안하지만, 바빠서 안되겠는걸."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/077"
msgid "그리고 그런 것은 직접 받아야 의미있는 것이란다./20d 남에게 부탁하지 말고 직접 샤론을 찾아 보렴."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/078"
msgid "이잉... 너무해.../10d 난 여행하기엔 아직 어리단 말예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/079"
msgid "고마워요./n 싸인 받아다 주신다는 약속은 잊으시면 안돼요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/080"
msgid "이잉... 샤론의 싸인이 갖고 싶은데...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/081"
msgid "비록 화려하지는 않지만 평화롭고 잔잔한 삶을 살고 있다고 자부하고 있답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/082"
msgid "[브리앙 웨어링]/n비켜,  저리 가! 제발 날 혼자 내 버려두란 말이야!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/083"
msgid "그만 둔 것인지, 아니면 어떤 이유가 있는 것인지..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/084"
msgid "[브리앙 웨어링]/n그 증세가 처음 발생한 것은 작년 가을이었죠. 마을 축제가 있던 날 저녁, 저는 술에 만취했었습니다./10d정신없이 먹고 마시다 정신을 차려보니 집안이었어요./10d 숙취로 아픈 머리를 식히기 위해서 세면실에 갔었는데, 제 손에 피가..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/085"
msgid "[브리앙 웨어링]/n저는 제가 어디 다친것이 아닌가 해서 온 몸을 살펴봤었지만, 전혀 다친곳은 없었어요. 그런데 그 다음날, 우리마을 농장에 늑대가 들어서 닭과 가축들을 죽이고 달아났다는 이야기를 들었지요./10d하지만, 하지만, 전 그게 늑대가 아니라는 것을 직감했었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/086"
msgid "[브리앙 웨어링]/n처음에는 단순히 무서운 꿈을 꾸었을 뿐이라고 나 자신을 설득했었지요. 하지만, 이 증세는 그 뒤로도 계속 되었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/087"
msgid "[브리앙 웨어링]/n이제는 잠에서 깨기가 두려워요. 자고 일어나보면 방안이 마구 흩어져 있거나 제 손이 피로 물들어 있는 것을 발견한 그때는 정말이지, 정말이지 저 자신이 두려워집니다./10d두려워요.../10d 두려워... 이제는 잠자는 것 자체가 두려워요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/088"
msgid "[브리앙 웨어링]/n결혼! 하, 하하하! 어느날 눈을 떠 보면, 그때 그 사랑스러운 다이아나를 제손으로... 안돼, 안돼요, 그것만은 절대로! 난 결혼할 수 없습니다./10d 이 저주스러운 피가 제 몸속에 흐르는 한, 절대로. 흐 흐흐흐..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/089"
msgid "[댄 웨어링]/n... 우리 집안은 전통적으로 정신병이 있지. 과거에 친족혼을 통해 혈통을 보존한 죄의 댓가야... 이런 씨는 이 세상에서 없어져야 해. 그렇지않나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/090"
msgid "[다이아나]/n브리앙이 미쳤다고요? 그건 말도 안돼요! 그는 일년전만 해도 정말이지 아무 이상도 없었다고요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/091"
msgid "[다이아나]/n저와 그는 게이시르 학술원에서 처음 만났죠. 마침 저도 조용한 시골 마을을 찾고 있었기 때문에 이곳으로 이사온 것이고, 그와는 여기 온지 일년쯤 뒤에 약혼했어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/092"
msgid "[헤이슨]/n하지만, 다이아나. 원래 미친 사람은 언제나 그런 것이 아니라 일시적으로 발작이 일어나는 법이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/093"
msgid "[다이아나]/n아니에요, 아니에요! 정말로, 정말로 그가 정상이 아닌 것이라면 왜 의사의 진찰도 받으려 하지 않는거죠? 병이 난 것이면 고칠수 있는 것 아닌가요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/094"
msgid "[헤이슨]/n그건, 고칠 수 있는 병이 아니야. 그 집안의 유전이지... 다이아나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/095"
msgid "[다이아나]/n그렇지 않아요, 그렇지 않아. 절대 그럴리 없어! 내가, 내가 고쳐보이겠어요, 그의 병을, 무슨 수를 써서라도, 내가!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/096"
msgid "웨어링 집안 말인가? 그 집안은 예로부터 저주받은 집안이지. 그 집안 사람들 치고 정상적으로 죽은 사람이 없다니까."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/097"
msgid "단적으로, 댄씨의 부모님도 실종되었고, 댄 씨의 부인은 댄씨와 물놀이를 즐기다가 보트가 뒤집어지는 사고로 유명을 달리하지 않았냔 말이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/098"
msgid "댄 씨의 부인이 죽었을 때, 마을에서는 댄 씨가 부인을 밀어서 호수에 빠뜨린 것이라는 소문이 퍼졌었지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/099"
msgid "이제는 그 아들인가? 불쌍하게도..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/100"
msgid "그 집안은 정말로 그렇게 유전적으로 문제가 있는 집안인가 보군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/101"
msgid "그렇다고 볼 수 있겠죠. 하지만 진정한 원인은 그 집안이 너무 잘살고 있다는 것이 아닐까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/102"
msgid "너무 잘살기 때문에 정신병에 걸렸다는 것인가요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/103"
msgid "그렇다기 보다는... 그 집안은 옛부터 유산과 상속권을 둘러싸고 갖은 음모가 난무했었지. 그 영향이 아닐까? 그집 사람들이 이상한 것은 말이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/104"
msgid "그러고 보니, 전에 브리앙이 댄 씨의 자손이 맞는지 의문시되었던 적이 있잖아?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/105"
msgid "그렇습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/106"
msgid "그러다 보니, 친족혼으로 분쟁을 줄이려고 했고, 그러다가 가전의 정신병이 생겼다는 것인가... 그러고 보면 돈이 많다고 좋은 것은 아닌 것 같아, 정말로."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/107"
msgid "[댄 웨어링]/n난 내 아들놈의 결혼을 처음부터 반대하고 있었어. 결코 안될 말이었지. 큭큭큭..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/108"
msgid "실례합니다. 댄 씨 집을 찾아가려고 하는데, 무엇을 좀 사다드리려고 합니다. 어떤 것이 좋을까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/109"
msgid "음모가 가득찬 집안이라... 그 집안에 대한 정보를 조금 더 얻고 싶은데. 다른 사람들이 더 설명해 줄 수 있지 않을까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/110"
msgid "[약국주인]/n아, 댄 웨어링씨 말이지요? 그분은 요새 눈이 안 좋으시다면서 가시독말풀로 만든 약을 복용하시고 계십니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/111"
msgid "[약국주인]/n요새 아드님 일로 정신없으셔서 그런지는 몰라도, 사실 때가 되었는데도 안 오시더라고요. 사다드리면 좋을 것 같습니다만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/112"
msgid "가시독말풀이라면... 꽤나 위험한 독약이 아닙니까."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/113"
msgid "[약국주인]/n괜찮습니다. 그분은 그 약을 오래 복용하고 계셨기 때문에 복용량을 잘 알고 계시죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/114"
msgid "그렇습니까..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/115"
msgid "[약국주인]/n잠,잠깐만요. 약은요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/116"
msgid "아아... 나중에 다시 오지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/117"
msgid "결국... 그가 이 일의 원인이었나. 웨어링씨 댁으로 가 보자... 이 일은 해결을 봐야겠어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/118"
msgid "실례합니다. 웨어링 집안에 대해서 좀 알고 계십니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/119"
msgid "웨어링 집안이요? 알다마다요! 그 집안은 옛날부터 말썽이 끊이지 않는 집안이었다니까요, 내 그 집에 레이첼이 시집갈 때 부터 알아봤다니까. 글쎄 그 집안의 결혼은 항상 불안하기만 하지 뭐유, 이번 결혼만 해도...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/120"
msgid "(그냥 계속 말하게 하면 끝이 없겠군)/n아... 아주머니. 그 레이첼 이란 사람은 누구죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/121"
msgid "레이첼? 댄 씨의 부인 아니유. 사실 그 부인은 헤이슨 씨도 좋아했었지요. 댄 씨와 레이첼이 결혼하자 상심한 헤이슨 씨는 멀리 여행을 떠나지 않았겠어요. 헤이슨 씨가 돌아온지는 얼마 안된다우. 그런데, 헤이슨 씨가 떠나고 얼마 안 되서 문제가 발생했지 뭐유."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/122"
msgid "어떤 문제였지요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/123"
msgid "레이첼이 브리앙을 낳았는데, 생각보다 좀 일찍 태어났거든. 사람들은 브리앙이 정말 댄 씨의 자손이 맞냐고 수근댔었지. 나중에 본인이 공개적으로 그렇다고 밝히기는 했었지만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/124"
msgid "사람들은 레이첼과 헤이슨 씨의 관계를 의심하긴 했지만, 뭐 헤이슨 씨 본인이 없었기 때문에 결국 흐지부지 되고 말았지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/125"
msgid "뭐, 꼭 그렇기 보다는.... 그럴수도 있다는 것 아니겠어요? 어머, 어머. 내가 초면인 사람을 두고 못하는 소리가 없지.... 그럼."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/126"
msgid "재미있군. 광기어린 집안에, 내력은 또 왜 이리 복잡한 거지? 이렇게 되면 아버지란 사람이 의심가는데... 좀더 조사를 해 보자."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/127"
msgid "[브리앙 웨어링]/n이 미치광이에게 볼일이라도 있습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/128"
msgid "미치광이라... 어떻게 보면 세상 사람들 중 제정신인 사람이 있을까? 하지만, 자네는 정상이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/129"
msgid "[브리앙 웨어링]/n무슨... 무슨 말입니까, 제가 정상이라니."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/130"
msgid "[다이아나]/n브리앙!난 당신을 버릴 수 없어요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/131"
msgid "[약국주인]/n어서오세요. 무엇을 드릴까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/132"
msgid "이곳이 이 동네 약국이군. 만약, 브리앙 웨어링씨가 인위적으로 이상해진 것이라면, 이곳에서 단서를 얻을 수 있지 않을까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/133"
msgid "저 잠시 여쭈어 볼 것이 있습니다만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/134"
msgid "처음 보는 분이군요. 우리 마을에 처음 오신 것 같은데, 맞죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/135"
msgid "네. 이곳은 처음 와 봅니다. 그런데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/136"
msgid "어떤  것에 대해서 물어볼까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/137"
msgid "웨어링 집안에 대해서 설명듣고 싶다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/138"
msgid "[다이아나]/n약 일년전 부터 그가 점점 우울해지더니, 급기야 점점 이상한 소리를 한 것은 사실이에요. 하지만, 제가 보기에 그는 지극히 정상이에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/139"
msgid "다이아나에 대해 물어보자."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/140"
msgid "이 사건 자체의 배경이 듣고 싶다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/141"
msgid "그 말은, 브리앙 웨어링 씨가 댄 웨어링 씨의 아들이 아닐수도 있다는 것입니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/142"
msgid "어떤 문제 시죠? 도와드릴 수 있는 것은 도와드리겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/143"
msgid "자, 이제 어떻게 질문한다?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/144"
msgid "최근에 극약을 산 사람 명단이 궁금하군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/145"
msgid "댄 웨어링 씨가 좋아할 만한 선물은?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/146"
msgid "실례인 줄은 압니다만, 최근에 극약을 사간 사람의 명단을 얻을 수 있을까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/147"
msgid "[약국주인]/n.... 당신, 조그만 마을의 약국이라고 우리를 우습게 보는 것인가? 우리도 가게로서의 윤리가 있지, 생전 처음 보는 사람한테 턱 하니 그런것을 보여줄 것 같나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/148"
msgid "[약국주인]/n그런 질문이나 할 생각이면, 썩 이곳에서 나가시오!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/149"
msgid "아니, 전 저... 이런. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/150"
msgid "이런... 타지사람이라고 푸대접 하는군.... 하긴, 내가 왜 내 일도 아닌 일에 참견하고 있는가지? 내 일이나 하자."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/151"
msgid "[헤이슨 씨]/n다이아나, 이러면 안돼. 빨리 집으로 돌아가자."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/152"
msgid "아니오, 오히려 잘 되었습니다. 여기서 제 말을 좀 들어주십시오, 헤이슨 씨, 그리고 다이아나 양."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/153"
msgid "일단, 브리앙 웨어링 씨는 정신병자가 아니라는 것 부터 밝혀야 겠군요. 그는 미친것이 아닙니다. 단지, 그를 미친 사람처럼 보이게 하고 싶어했던 사람의 함점에 빠졌을 뿐이죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/154"
msgid "[브리앙 웨어링]/n내가... 내가 미치지 않았다고?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/155"
msgid "[댄 웨어링]/n무슨 소리인가!아들은 절대 안정이 필요해!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/156"
msgid "[헤이슨 씨]/n그게... 그게 진실입니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/157"
msgid "헤이슨 씨는 오래동안 여행을 다녔었다고 하더군요. 여행하는 도중 가시독말풀 이란 풀에 대해서 들어보신 적이 있겠죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/158"
msgid "[헤이슨 씨]/n가시독말풀이라면, 환각작용을 일으키는 맹독이 아닙니까. 많이 먹으면 죽을수도 있는..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/159"
msgid "[브리앙 웨어링]/n이제는 먹고 마시는 것 하나하나 다 맛을 모르겠어요. 항상 머리는 무겁고 입맛은 씁쓸하고..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/160"
msgid "그렇죠. 그리고 가시독말풀은 그 씁쓸한 맛과 환각이 풀린 뒤에도 끊임없이 두통과 어지러움을 동반하지요./n 브리앙 웨어링 씨는 요새 계속해서 씁쓸한 입맛과 어지러움을 호소하지 않았던가요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/161"
msgid "[브리앙 웨어링]/n그러고 보니...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/162"
msgid "그리고, 댄 웨어링씨, 당신은 요새 가시독말풀로 된 약을 복용하고 계시지 않으신가요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/163"
msgid "!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/164"
msgid "!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/165"
msgid "!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/166"
msgid "[댄 웨어링]/n무슨 소리야... 내가 가시독말풀로 만든 약을 먹기는 하지만, 왜 내가 내 아들을 해치려 하겠어..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/167"
msgid "만약, 그가 당신 아들이 아니라 해도?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/168"
msgid "[브리앙 웨어링]/n무슨 말을...!그는 확실히 내 아버님이요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/169"
msgid "그것에 대한 대답은 헤이슨 씨가 더 잘 아실 것 같군요. 안그렇습니까, 헤이슨 씨?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/170"
msgid "[헤이슨 씨]/n그... 그건..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/171"
msgid "[댄 웨어링]/n쿡. 쿡쿡.. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/172"
msgid "[브리앙 웨어링]/n아, 아버지.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/173"
msgid "[댄 웨어링]/n왜, 왜 너는 나를 아버지라고 부르는 것이지? 레이첼이, 레이첼이 임신했다고 말했을때 나의 당혹감과 분노를 누가 알겠어! 나는 후손을 낳을 수 없는 상태였단 말이다..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/174"
msgid "[브리앙 웨어링]/n그, 그런."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/175"
msgid "[댄 웨어링]/n네 어머니는... 네 어머니는, 호숫가에서 내가 이손으로, 아니, 아니야. 그건 내가 아니였어! 그녀가 뛰어든거야! 그래, 그녀가 뛰어들었어!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/176"
msgid "당신은 그 원한 때문에 당신 아들에게 독을 먹여서 환각상태로 만들고 그런 연극을 꾸민것인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/177"
msgid "헤이슨 씨, 당신이 브리앙 씨의 진짜 아버지가 아닌가요? 댄 씨는 자신의 질투 때문에 브리앙 씨에게 가시독말풀을 먹여서 환각상태로 만들고, 그가 미친것 처럼 꾸미는 연극을 했던 것이죠. 아마 그의 어머니도 단순한 사고는 아니었을 것입니다. 안그렇습니까, 댄 웨어링씨?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/178"
msgid "[댄 웨어링]/n빌어먹을, 머리가 아프군! 약국에 가서 약을 좀 사먹어야 겠어!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/179"
msgid "[브리앙 웨어링]/n아버지!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/180"
msgid "기다려!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/181"
msgid "댄 웨어링 씨는... 나름대로의 해결책을 찾기위해 나간 것일 쎄. 쫓아가면 안돼..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/182"
msgid "그럼, 브리앙 씨는 이곳을 떠나실 것인가요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/183"
msgid "[브리앙 웨어링]/n예.당분간, 여행을 다니면서 머리를 식히고 싶습니다. 물론, 사랑스런 저의 다이아나도 함께... 아, 그리고 잠시만, 이리로 와 주시겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/184"
msgid "[브리앙 웨어링]/n이건 우리 집안의 가보입니다. 우리에게는 슬픈 추억이 깃든 것입니다만, 당신에게라면 틀림없이 기쁜 추억이 될 수 있을 것 같군요. 받아주신다면 감사하겠습니다만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/185"
msgid "블러디 스톤을 얻었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/186"
msgid "[브리앙 웨어링]/n그럼... 안녕히..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/187"
msgid "다이아나 양 집이다. 지금은 여행을 떠나고 없겠군..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/188"
msgid "웨어링 집안이다. 지금은 여행을 떠나고 없겠군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/189"
msgid "혹시 다이아나 씨에 대해서 알고 있습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/190"
msgid "다이아나씨? 약 이년전 쯔음 해서 게이시르로 유학갔었던 브리앙을 따라 이 마을로 왔지. 브리앙이 유학시절에 사귄 여자 같아."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/191"
msgid "그렇지만, 그녀는 타고난 미모와 외향적이고 밝은 성격으로 마을에 오자마자 모든 남자의 관심을 받았지.뭐, 그당시에는 약혼한 관계가 아니었으니까..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/192"
msgid "흥... 사실 그녀는 마을 청년 전원에게 구애를 받았다고 해도 과언이 아닐 껄요? 하여튼 남자들이란..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/193"
msgid "[주점주인]/n그렇지만 이상한건, 다이아나 라는 여자의 배경은 아무도 아는 사람이 없다는 것 아니겠어? 그녀는 지금도 혼자살고 있고..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/194"
msgid "그러고 보니, 소문에 의하면 마을의 한 청년이 파티장 뒷편에서 그녀에게 구애하다가 굉장히 쌀쌀맞게 거절당했다는 이야기를 들은적이 있어요. \"너같은 힘도, 돈도 없는 녀석과는 상대하기 싫어!\"라고 했다던가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/195"
msgid "내가 알기로는 그 사건은 그 남자가 강제로 그녀를 끌고 가려고 했기 때문에 그녀가 내친 거라고 하던데? 소문인 이상하게 퍼져버렸지만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/196"
msgid "[주점주인]/n누가 알 수 있을까? 여자의 마음속을... "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/197"
msgid "브리앙 웨어링 씨의 파혼에 대한 이야기를 듣고 싶습니다만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/198"
msgid "그 사건이요? 다이아나와 브리앙이 약혼한 것은 약 일년쯤 되었지요. 그런데, 얼마전에 갑작 브리앙이 파혼을 선언한 것이죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/199"
msgid "그 이유는 자신의 정신병! 마을에서 상당히 센세이션을 일으킨 사건이죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/200"
msgid "[주점주인]/n당사자들을 제외하곤 아무도 반기는 약혼은 아니었지, 솔직히. 그 아버지의 광기야 유명한 것이고, 마을 사람 누구도 웨어링 가의 재산이 바깥 사람에게 돌아가는 것을 환영하지는 않았었잖아?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/201"
msgid "그렇지만, 정말로 브리앙은 정신병이 생긴 것일까? 그가 요즘 태도가 상당히 이상하기는 했지만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/202"
msgid "근래에 들어 각 농장의 가축들이 살상당하는 사고가 잦았던 것은 사실이고, 그것이 모두 브리앙의 소행이었다고 하잖아? 그게 제정신인 사람이 할 일인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/203"
msgid "[주점주인]/n좀 석연치 않은 구석이 있는 것은 사실이긴 하지만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/204"
msgid "그럼 그 브리앙 웨어링과 댄 웨어링 부자는 원래부터 좀 이상한 구석이 있었나보죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/205"
msgid "[브리앙 웨어링]/n여행중에 만나게 될 지도 모르겠군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/206"
msgid "정말로 놀랄 일이에요. 범인이 댄 웨어링 씨 였다니."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/207"
msgid "자, 행복해진 다이아나 씨를 위해서 건배..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/208"
msgid "어서오세요, 이 집의 주인님이신 다이아나 님의 뜻에 따라 집에 오시는 손님은 무료로 재워드립니다. 주무시겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/209"
msgid "안녕히 주무세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/210"
msgid "안녕히 가세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/211"
msgid "[다이아나]/N이제, 그와, 그와 이세상 어디라도 함께 할 거에요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01
msgctxt "field|ko|art_ko_fltfa01|@kfltfa01/212"
msgid "정말, 정말 고마워요, 싸인을 받아다 줘서!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/000"
msgid "파로 마을"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/001"
msgid "이 곳은 파로 마을이에요. 지리적으로는 게이시르 시티에 가까운 편이지만, 문화적으로는 많은 차이가 있지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/002"
msgid "우리마을은 시끄러운 외부와는 달리 평화롭고 조용한 곳이에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/003"
msgid "정말 끔찍한 일이에요. 마을 제일의 호남자인 그가 정신병에 걸리다니... 더군다나 약혼자도 있는데."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/004"
msgid "이곳은 상당히 외진 마을이라 사람들의 발걸음이 뜸해요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/005"
msgid "그런데 얼마전에 외부에서 요리사 한 명이 이사왔어요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/006"
msgid "고급 요리에 쓰일 신선한 재료를 찾고 있는데 이 곳이 깨끗해서 맘에 들었다나요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/007"
msgid "전에 한번 게이시르 시티에 초대받아 가 본 적이 있어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/008"
msgid "눈이 빙빙 돌아가도록 넓의 길과 아름다운 건물, 멋진 사람들이 사는 곳이었지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/009"
msgid "이런 시골 마을에서 사는 것 보다 훨씬 더 멋질 거에요, 도시에서 사는 것은..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/010"
msgid "우리같이 작은 마을은 오히려 산적들에게 시달림을 받는것이 더 걱정이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/011"
msgid "이게 다 우리 게이시르 제국을 무너뜨린 실버애로우 때문이야. 그들이 과거에 우리 황가의 맥을 끊지만 않았어도."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/012"
msgid "늦은 감은 있지만, 이제 우리도 하나의 국가나 연합체를 형성해야 하지 않는가! 언제까지 이런 어수선한 채로 남아있을거지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/013"
msgid "그럴 줄 알았어요! 내가 늘 그랬잖아요, 댄 웨어링 씬 제정신인 사람이 아니라고!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/014"
msgid "브리앙 씬 역시 생긴대로 미남에, 부자에, 머리좋고 운동 잘하고... 어쩌면 그렇게 멋있을까!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/015"
msgid "아... 다이아나 양이 정말로 부럽네요. 좋겠어요, 그들은..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/016"
msgid "우리 마을의 영주님은 아이들을 정말 좋아하시나 봐요. 영주님 집 안에는 상당히 많은 아이들이 있답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/017"
msgid "하지만, 이상하게도 다 여자아이들 뿐이에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/018"
msgid "영주님은 꽃도 좋아하셔서, 정원에는 꽃이 대단히 많다고 해요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/019"
msgid "나도 샤론의 공연을 본 적이 있어요./20d 정말 이쁜 언니였어요... 춤도 잘 추고."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/020"
msgid "그 언니의 싸인을 받고 싶었는데, 오빠들이 다 새치기 하는 바람에 하나도 못 받았어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/021"
msgid "혹시, 샤론을 만나시면 싸인 하나만 받아다 주실 수 있으시겠어요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/022"
msgid "[댄 웨어링]/n우리 집안은 저주받은 집안이지./15d 나는 아들의 결혼을 반대하고 있었어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/023"
msgid "[댄 웨어링] /n최근 일련의 사건으로 아들놈도 우리집안의 피를 깨달은 모양이야./10d 클클클..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/024"
msgid "[댄 웨어링] /n이 것으로 이 저주받은 집안의 대도 끊기는 거야.../10d 쿡쿡쿡..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/025"
msgid "[브리앙 웨어링]/n난 끝났어요. 내 손으로 그런 끔찍한 짓을 하다니..../20d 결혼?/10d 그런 희망을 품은 내가 바보지!/15d 하하하!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/026"
msgid "[브리앙 웨어링]/n위로의 말 따위는 필요없어. 나를 설득시키려고 하지도 마./20d 나에게 남은것은 단지 죽음뿐..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/027"
msgid "[다이아나] /n아니에요, 그가 미쳤을 리가 없어요. 정말이에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/028"
msgid "[다이아나] /n이건, 무엇인가 잘못되어 있어요.../20d 브리앙은 무엇인가를 착각하고 있는 거라고요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/029"
msgid "[다이아나]/n이건 현실이 아니야..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/030"
msgid "[헤이슨]/n이거, 시라노씨군요. 저는 잘 지내고 있습니다. 아, 브리앙과 다이아나가 안부 전해달랍니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/031"
msgid "[헤이슨]/n댄 그 친구... 어렸을 때는 그렇게까지 이상하지 않았었는데. 쾌할하고, 만능스포츠맨에 머리좋고..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/032"
msgid "[헤이슨]/n정말로 안타까운 일이오. 지금 생각해 보면."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/033"
msgid "우리도 하나의 통일된 국가를 이루어야 하지 않을까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/034"
msgid "지금같은 권력공백 상태에서는 어떤일이 일어난다 해도 이상할 것이 없지요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/035"
msgid "더 충격적인 것은 그 조각들이 휴 씨의 방 안의 자루에서 발견되었다는 거에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/036"
msgid "어서오세요. 우리집은 다른 것은 몰라도 양은 많이 드립니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/037"
msgid "팬드래건의 왕위계승 서열 1위인 라시드 3세는 도대체 어디로 가서 숨어버린 것일까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/038"
msgid "뭐, 라시드 대왕이 워낙 정정하니 쉽게 왕위를 물려받지도 못하겠지만... 언제고 우리집에 오면 서비스 안주를 많이 줄 용의가 있는데.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/039"
msgid "이 근처에 있는 카라카스 라는 곳에는 내 동생인 카그가 요리점을 경영하고 있지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/040"
msgid "그 녀석은 솜씨는 좋은데 지나치게 완벽주의자인 것이 문제야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/041"
msgid "그 놈은 틈만 나면 나한테도 좋은 재료를 구해달라고 성화라니까. 허허..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/042"
msgid "호호호.. 당신은 과연 근시일내에 제국을 장악할 패자가 등장 할 수 있을거라 생각하나요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/043"
msgid "제국의 패자가 되기 위해서는, 체사레 보르자를 제압할 만한 세력이 있어야 하지 않을까요? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/044"
msgid "제국의 패자를 결정한다는 아수라 검을 누군가가 뽑았다는 소문이지만... 어디까지나 소문은 소문일 뿐 아니겠어요? 호호호"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/045"
msgid "어서오십시오. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/046"
msgid "지난번 공연에서 샤론의 싸인을 얻어왔어요. 훗훗훗... 우리 마을에서는 저만이 갖고 있지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/047"
msgid "이건 아무리 많은 돈을 주어도 팔지 않을 거에요./15d 우리집 가보로 물려줄 거라구요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/048"
msgid "흠... 아주 좋은 물건을 가져 온다면 생각해 보겠지만... 예를 들어 아스모데우스의 파편이라던지..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/049"
msgid "다이아나는 마을 최고의 미인이죠. 마을 전체 남성들의 선망의 대상이 된."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/050"
msgid "그런 그녀가 또한 마을 여자 전체의 선망의 대상이었던 브리앙 하고 결혼한다고 발표를 했을 때 얼마나 말이 많았었는지..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/051"
msgid "어떻게 보면 누구도 환영하지 않던 약혼이었어요. 본인 둘을 제외하고는.../20d 질투의 대상이었죠..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/052"
msgid "어서오세요. 어떤 물건을 찾으십니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/053"
msgid "파로 약국"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/054"
msgid "저희 상점을 이용해 주셔서 감사합니다. 안녕히 가세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/055"
msgid "어머.../10d 이건 샤론 언니의 싸인!/20d 꺅~~~!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/056"
msgid "이거 저 주시는 거죠?/10d 어머~ 좋아라."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/057"
msgid "대신 저도 뭐 하나 드릴께요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/058"
msgid "얼음의 반지를 손에 넣었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/059"
msgid "얼마전에 숲속에서 주은 반지에요! 이쁘죠!/20d 싸인 고마워요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/060"
msgid "이건 내가 얼마전에 카라카스 근처의 숲에서 얻은 사랑의 향초일세."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/061"
msgid "진정한 사랑이 싹 튼 곳에서만 핀다는 꽃인데, 굉장히 귀한 향초니까 잘 보관했다가 내 동생에게 전해주게나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/062"
msgid "사랑의 향초를 얻었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/063"
msgid "주무시겠어요? 저희 주인님께서는 집에 찾아온 손님은 접대해 드린답니다. 주무시겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/064"
msgid "그럼 안녕히 주무세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/065"
msgid "안녕히 가세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/066"
msgid "몸 조심해서 가세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/067"
msgid "[폴]/n이번에 좋은 무기를 하나 입수했어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/068"
msgid "마을 잡화점"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/069"
msgid "그럼, 다음에도 좋은 물건을 드릴께요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/070"
msgid "현상수배 : 로베르토 데 메디치 /n죄목 : 방화, 살인. /n현상금 : 1000000Eld"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/071"
msgid "소녀의 부탁을 받아 샤론의 싸인을 받아다 주시겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/072"
msgid "샤론을 만난다면 꼭 싸인을 받아다 주지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/073"
msgid "미안하지만, 바빠서 안되겠는걸."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/074"
msgid "좋아, 샤론을 만난다면 꼭 싸인을 받아다 주지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/075"
msgid "정말이죠?/10d 그럼 약속한거예요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/076"
msgid "미안하지만, 바빠서 안되겠는걸."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/077"
msgid "그리고 그런 것은 직접 받아야 의미있는 것이란다./20d 남에게 부탁하지 말고 직접 샤론을 찾아 보렴."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/078"
msgid "이잉... 너무해.../10d 난 여행하기엔 아직 어리단 말예요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/079"
msgid "고마워요./n 싸인 받아다 주신다는 약속은 잊으시면 안돼요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/080"
msgid "이잉... 샤론의 싸인이 갖고 싶은데...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/081"
msgid "비록 화려하지는 않지만 평화롭고 잔잔한 삶을 살고 있다고 자부하고 있답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/082"
msgid "[브리앙 웨어링]/n비켜,  저리 가! 제발 날 혼자 내 버려두란 말이야!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/083"
msgid "어떻게 보면 교회세력이 그런 면에서 치안유지 역할을 하고 있는 것이 아닐까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/084"
msgid "[브리앙 웨어링]/n그 증세가 처음 발생한 것은 작년 가을이었죠. 마을 축제가 있던 날 저녁, 저는 술에 만취했었습니다./10d정신없이 먹고 마시다 정신을 차려보니 집안이었어요. 숙취로 아픈 머리를 식히기 위해서 세면실에 갔었는데, 제 손에 피가..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/085"
msgid "[브리앙 웨어링]/n저는 제가 어디 다친것이 아닌가 해서 온 몸을 살펴봤었지만, 전혀 다친곳은 없었어요. 그런데 그 다음날, 우리마을 농장에 늑대가 들어서 닭과 가축들을 죽이고 달아났다는 이야기를 들었지요./10d하지만, 하지만, 전 그게 늑대가 아니라는 것을 직감했었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/086"
msgid "[브리앙 웨어링]/n처음에는 단순히 무서운 꿈을 꾸었을 뿐이라고 나 자신을 설득했었지요. 하지만, 이 증세는 그 뒤로도 계속 되었습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/087"
msgid "[브리앙 웨어링]/n이제는 잠에서 깨기가 두려워요. 자고 일어나보면 방안이 마구 흩어져 있거나 제 손이 피로 물들어 있는 것을 발견한 그때는 정말이지, 정말이지 저 자신이 두려워집니다./10d두려워요.../10d 두려워... 이제는 잠자는 것 자체가 두려워요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/088"
msgid "[브리앙 웨어링]/n결혼! 하, 하하하! 어느날 눈을 떠 보면, 그때 그 사랑스러운 다이아나를 제손으로... 안돼, 안돼요, 그것만은 절대로! 난 결혼할 수 없습니다./10d 이 저주스러운 피가 제 몸속에 흐르는 한, 절대로. 흐 흐흐흐..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/089"
msgid "[댄 웨어링]/n... 우리 집안은 전통적으로 정신병이 있지. 과거에 친족혼을 통해 혈통을 보존한 죄의 댓가야... 이런 씨는 이 세상에서 없어져야 해. 그렇지않나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/090"
msgid "[다이아나]/n브리앙이 미쳤다고요? 그건 말도 안돼요! 그는 일년전만 해도 정말이지 아무 이상도 없었다고요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/091"
msgid "[다이아나]/n저와 그는 게이시르 학술원에서 처음 만났죠. 마침 저도 조용한 시골 마을을 찾고 있었기 때문에 이곳으로 이사온 것이고, 그와는 여기 온지 일년쯤 뒤에 약혼했어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/092"
msgid "[헤이슨]/n하지만, 다이아나. 원래 미친 사람은 언제나 그런 것이 아니라 일시적으로 발작이 일어나는 법이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/093"
msgid "[다이아나]/n아니에요, 아니에요! 정말로, 정말로 그가 정상이 아닌 것이라면 왜 의사의 진찰도 받으려 하지 않는거죠? 병이 난 것이면 고칠수 있는 것 아닌가요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/094"
msgid "[헤이슨]/n그건, 고칠 수 있는 병이 아니야. 그 집안의 유전이지... 다이아나."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/095"
msgid "[다이아나]/n그렇지 않아요, 그렇지 않아. 절대 그럴리 없어! 내가, 내가 고쳐보이겠어요, 그의 병을, 무슨 수를 써서라도, 내가!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/096"
msgid "웨어링 집안 말인가? 그 집안은 예로부터 저주받은 집안이지. 그 집안 사람들 치고 정상적으로 죽은 사람이 없다니까."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/097"
msgid "단적으로, 댄씨의 부모님도 실종되었고, 댄 씨의 부인은 댄씨와 물놀이를 즐기다가 보트가 뒤집어지는 사고로 유명을 달리하지 않았냔 말이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/098"
msgid "댄 씨의 부인이 죽었을 때, 마을에서는 댄 씨가 부인을 밀어서 호수에 빠뜨린 것이라는 소문이 퍼졌었지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/099"
msgid "이제는 그 아들인가? 불쌍하게도..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/100"
msgid "그 집안은 정말로 그렇게 유전적으로 문제가 있는 집안인가 보군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/101"
msgid "그렇다고 볼 수 있겠죠. 하지만 진정한 원인은 그 집안이 너무 잘살고 있다는 것이 아닐까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/102"
msgid "너무 잘살기 때문에 정신병에 걸렸다는 것인가요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/103"
msgid "그렇다기 보다는... 그 집안은 옛부터 유산과 상속권을 둘러싸고 갖은 음모가 난무했었지. 그 영향이 아닐까? 그집 사람들이 이상한 것은 말이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/104"
msgid "그러고 보니, 전에 브리앙이 댄 씨의 자손이 맞는지 의문시되었던 적이 있잖아?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/105"
msgid "그렇습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/106"
msgid "그러다 보니, 친족혼으로 분쟁을 줄이려고 했고, 그러다가 가전의 정신병이 생겼다는 것인가... 그러고 보면 돈이 많다고 좋은 것은 아닌 것 같아, 정말로."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/107"
msgid "[댄 웨어링]/n난 내 아들놈의 결혼을 처음부터 반대하고 있었어. 결코 안될 말이었지. 큭큭큭..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/108"
msgid "실례합니다. 댄 씨 집을 찾아가려고 하는데, 무엇을 좀 사다드리려고 합니다. 어떤 것이 좋을까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/109"
msgid "음모가 가득찬 집안이라... 그 집안에 대한 정보를 조금 더 얻고 싶은데. 다른 사람들이 더 설명해 줄 수 있지 않을까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/110"
msgid "[약국주인]/n아, 댄 웨어링씨 말이지요? 그분은 요새 눈이 안 좋으시다면서 가시독말풀로 만든 약을 복용하시고 계십니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/111"
msgid "[약국주인]/n요새 아드님 일로 정신없으셔서 그런지는 몰라도, 사실 때가 되었는데도 안 오시더라고요. 사다드리면 좋을 것 같습니다만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/112"
msgid "가시독말풀이라면... 꽤나 위험한 독약이 아닙니까."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/113"
msgid "[약국주인]/n괜찮습니다. 그분은 그 약을 오래 복용하고 계셨기 때문에 복용량을 잘 알고 계시죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/114"
msgid "그렇습니까..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/115"
msgid "[약국주인]/n잠,잠깐만요. 약은요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/116"
msgid "아아... 나중에 다시 오지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/117"
msgid "결국... 그가 이 일의 원인이었나. 웨어링씨 댁으로 가 보자... 이 일은 해결을 봐야겠어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/118"
msgid "실례합니다. 웨어링 집안에 대해서 좀 알고 계십니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/119"
msgid "웨어링 집안이요? 알다마다요! 그 집안은 옛날부터 말썽이 끊이지 않는 집안이었다니까요, 내 그 집에 레이첼이 시집갈 때 부터 알아봤다니까. 글쎄 그 집안의 결혼은 항상 불안하기만 하지 뭐유, 이번 결혼만 해도...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/120"
msgid "(그냥 계속 말하게 하면 끝이 없겠군)/n아... 아주머니. 그 레이첼 이란 사람은 누구죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/121"
msgid "레이첼? 댄 씨의 부인 아니유. 사실 그 부인은 헤이슨 씨도 좋아했었지요. 댄 씨와 레이첼이 결혼하자 상심한 헤이슨 씨는 멀리 여행을 떠나지 않았겠어요. 헤이슨 씨가 돌아온지는 얼마 안된다우. 그런데, 헤이슨 씨가 떠나고 얼마 안 되서 문제가 발생했지 뭐유."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/122"
msgid "어떤 문제였지요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/123"
msgid "레이첼이 브리앙을 낳았는데, 생각보다 좀 일찍 태어났거든. 사람들은 브리앙이 정말 댄 씨의 자손이 맞냐고 수근댔었지. 나중에 본인이 공개적으로 그렇다고 밝히기는 했었지만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/124"
msgid "사람들은 레이첼과 헤이슨 씨의 관계를 의심하긴 했지만, 뭐 헤이슨 씨 본인이 없었기 때문에 결국 흐지부지 되고 말았지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/125"
msgid "뭐, 꼭 그렇기 보다는.... 그럴수도 있다는 것 아니겠어요? 어머, 어머. 내가 초면인 사람을 두고 못하는 소리가 없지.... 그럼."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/126"
msgid "재미있군. 광기어린 집안에, 내력은 또 왜 이리 복잡한 거지? 이렇게 되면 아버지란 사람이 의심가는데... 좀더 조사를 해 보자."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/127"
msgid "[브리앙 웨어링]/n이 미치광이에게 볼일이라도 있습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/128"
msgid "미치광이라... 어떻게 보면 세상 사람들 중 제정신인 사람이 있을까? 하지만, 자네는 정상이야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/129"
msgid "[브리앙 웨어링]/n무슨... 무슨 말입니까, 제가 정상이라니."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/130"
msgid "[다이아나]/n브리앙!난 당신을 버릴 수 없어요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/131"
msgid "[약국주인]/n어서오세요. 무엇을 드릴까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/132"
msgid "이곳이 이 동네 약국이군. 만약, 브리앙 웨어링씨가 인위적으로 이상해진 것이라면, 이곳에서 단서를 얻을 수 있지 않을까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/133"
msgid "저 잠시 여쭈어 볼 것이 있습니다만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/134"
msgid "처음 보는 분이군요. 우리 마을에 처음 오신 것 같은데, 맞죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/135"
msgid "네. 이곳은 처음 와 봅니다. 그런데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/136"
msgid "어떤  것에 대해서 물어볼까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/137"
msgid "웨어링 집안에 대해서 설명듣고 싶다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/138"
msgid "[다이아나]/n약 일년전 부터 그가 점점 우울해지더니, 급기야 점점 이상한 소리를 한 것은 사실이에요. 하지만, 제가 보기에 그는 지극히 정상이에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/139"
msgid "다이아나에 대해 물어보자."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/140"
msgid "이 사건 자체의 배경이 듣고 싶다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/141"
msgid "그 말은, 브리앙 웨어링 씨가 댄 웨어링 씨의 아들이 아닐수도 있다는 것입니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/142"
msgid "어떤 문제 시죠? 도와드릴 수 있는 것은 도와드리겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/143"
msgid "자, 이제 어떻게 질문한다?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/144"
msgid "최근에 극약을 산 사람 명단이 궁금하군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/145"
msgid "댄 웨어링 씨가 좋아할 만한 선물은?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/146"
msgid "실례인 줄은 압니다만, 최근에 극약을 사간 사람의 명단을 얻을 수 있을까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/147"
msgid "[약국주인]/n.... 당신, 조그만 마을의 약국이라고 우리를 우습게 보는 것인가? 우리도 가게로서의 윤리가 있지, 생전 처음 보는 사람한테 턱 하니 그런것을 보여줄 것 같나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/148"
msgid "[약국주인]/n그런 질문이나 할 생각이면, 썩 이곳에서 나가시오!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/149"
msgid "아니, 전 저... 이런. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/150"
msgid "이런... 이래서야 약국에서는 자료 확보가 불가능 하겠군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/151"
msgid "[헤이슨 씨]/n다이아나, 이러면 안돼. 빨리 집으로 돌아가자."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/152"
msgid "아니오, 오히려 잘 되었습니다. 여기서 제 말을 좀 들어주십시오, 헤이슨 씨, 그리고 다이아나 양."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/153"
msgid "일단, 브리앙 웨어링 씨는 정신병자가 아니라는 것 부터 밝혀야 겠군요. 그는 미친것이 아닙니다. 단지, 그를 미친 사람처럼 보이게 하고 싶어했던 사람의 함점에 빠졌을 뿐이죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/154"
msgid "[브리앙 웨어링]/n내가... 내가 미치지 않았다고?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/155"
msgid "[댄 웨어링]/n무슨 소리인가!아들은 절대 안정이 필요해!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/156"
msgid "[헤이슨 씨]/n그게... 그게 진실입니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/157"
msgid "헤이슨 씨는 오래동안 여행을 다녔었다고 하더군요. 여행하는 도중 가시독말풀 이란 풀에 대해서 들어보신 적이 있겠죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/158"
msgid "[헤이슨 씨]/n가시독말풀이라면, 환각작용을 일으키는 맹독이 아닙니까. 많이 먹으면 죽을수도 있는..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/159"
msgid "[브리앙 웨어링]/n이제는 먹고 마시는 것 하나하나 다 맛을 모르겠어요. 항상 머리는 무겁고 입맛은 씁쓸하고..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/160"
msgid "그렇죠. 그리고 가시독말풀은 그 씁쓸한 맛과 환각이 풀린 뒤에도 끊임없이 두통과 어지러움을 동반하지요./n 브리앙 웨어링 씨는 요새 계속해서 씁쓸한 입맛과 어지러움을 호소하지 않았던가요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/161"
msgid "[브리앙 웨어링]/n그러고 보니...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/162"
msgid "그리고, 댄 웨어링씨, 당신은 요새 가시독말풀로 된 약을 복용하고 계시지 않으신가요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/163"
msgid "!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/164"
msgid "!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/165"
msgid "!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/166"
msgid "[댄 웨어링]/n무슨 소리야... 내가 가시독말풀로 만든 약을 먹기는 하지만, 왜 내가 내 아들을 해치려 하겠어..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/167"
msgid "만약, 그가 당신 아들이 아니라 해도?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/168"
msgid "[브리앙 웨어링]/n무슨 말을...!그는 확실히 내 아버님이요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/169"
msgid "그것에 대한 대답은 헤이슨 씨가 더 잘 아실 것 같군요. 안그렇습니까, 헤이슨 씨?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/170"
msgid "[헤이슨 씨]/n그... 그건..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/171"
msgid "[댄 웨어링]/n쿡. 쿡쿡.. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/172"
msgid "[브리앙 웨어링]/n아, 아버지.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/173"
msgid "[댄 웨어링]/n왜, 왜 너는 나를 아버지라고 부르는 것이지? 레이첼이, 레이첼이 임신했다고 말했을때 나의 당혹감과 분노를 누가 알겠어! 나는 후손을 낳을 수 없는 상태였단 말이다..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/174"
msgid "[브리앙 웨어링]/n그, 그런."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/175"
msgid "[댄 웨어링]/n네 어머니는... 네 어머니는, 호숫가에서 내가 이손으로, 아니, 아니야. 그건 내가 아니였어! 그녀가 뛰어든거야! 그래, 그녀가 뛰어들었어!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/176"
msgid "당신은 그 원한 때문에 당신 아들에게 독을 먹여서 환각상태로 만들고 그런 연극을 꾸민것인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/177"
msgid "헤이슨 씨, 당신이 브리앙 씨의 진짜 아버지가 아닌가요? 댄 씨는 자신의 질투 때문에 브리앙 씨에게 가시독말풀을 먹여서 환각상태로 만들고, 그가 미친것 처럼 꾸미는 연극을 했던 것이죠. 아마 그의 어머니도 단순한 사고는 아니었을 것입니다. 안그렇습니까, 댄 웨어링씨?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/178"
msgid "[댄 웨어링]/n빌어먹을, 머리가 아프군! 약국에 가서 약을 좀 사먹어야 겠어!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/179"
msgid "[브리앙 웨어링]/n아버지!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/180"
msgid "기다려!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/181"
msgid "댄 웨어링 씨는... 나름대로의 해결책을 찾기위해 나간 것일 쎄. 쫓아가면 안돼..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/182"
msgid "그럼, 브리앙 씨는 이곳을 떠나실 것인가요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/183"
msgid "[브리앙 웨어링]/n예.당분간, 여행을 다니면서 머리를 식히고 싶습니다. 물론, 사랑스런 저의 다이아나도 함께... 아, 그리고 잠시만, 이리로..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/184"
msgid "[브리앙 웨어링]/n이건 우리 집안의 가보입니다. 우리에게는 슬픈 추억이 깃든 것입니다만, 당신에게라면 틀림없이 기쁜 추억이 될 수 있을 것 같군요. 받아주신다면 감사하겠습니다만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/185"
msgid "블러디 스톤을 얻었다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/186"
msgid "[브리앙 웨어링]/n그럼... 안녕히..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/187"
msgid "다이아나 양 집이다. 지금은 여행을 떠나고 없겠군..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/188"
msgid "웨어링 집안이다. 지금은 여행을 떠나고 없겠군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/189"
msgid "혹시 다이아나 씨에 대해서 알고 있습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/190"
msgid "다이아나씨? 약 이년전 쯔음 해서 게이시르로 유학갔었던 브리앙을 따라 이 마을로 왔지. 브리앙이 유학시절에 사귄 여자 같아."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/191"
msgid "그렇지만, 그녀는 타고난 미모와 외향적이고 밝은 성격으로 마을에 오자마자 모든 남자의 관심을 받았지.뭐, 그당시에는 약혼한 관계가 아니었으니까..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/192"
msgid "흥... 사실 그녀는 마을 청년 전원에게 구애를 받았다고 해도 과언이 아닐 껄요? 하여튼 남자들이란..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/193"
msgid "[주점주인]/n그렇지만 이상한건, 다이아나 라는 여자의 배경은 아무도 아는 사람이 없다는 것 아니겠어? 그녀는 지금도 혼자살고 있고..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/194"
msgid "그러고 보니, 소문에 의하면 마을의 한 청년이 파티장 뒷편에서 그녀에게 구애하다가 굉장히 쌀쌀맞게 거절당했다는 이야기를 들은적이 있어요. \"너같은 힘도, 돈도 없는 녀석과는 상대하기 싫어!\"라고 했다던가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/195"
msgid "내가 알기로는 그 사건은 그 남자가 강제로 그녀를 끌고 가려고 했기 때문에 그녀가 내친 거라고 하던데? 소문인 이상하게 퍼져버렸지만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/196"
msgid "[주점주인]/n누가 알 수 있을까? 여자의 마음속을... "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/197"
msgid "브리앙 웨어링 씨의 파혼에 대한 이야기를 듣고 싶습니다만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/198"
msgid "그 사건이요? 다이아나와 브리앙이 약혼한 것은 약 일년쯤 되었지요. 그런데, 얼마전에 갑작 브리앙이 파혼을 선언한 것이죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/199"
msgid "그 이유는 자신의 정신병! 마을에서 상당히 센세이션을 일으킨 사건이죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/200"
msgid "[주점주인]/n당사자들을 제외하곤 아무도 반기는 약혼은 아니었지, 솔직히. 그 아버지의 광기야 유명한 것이고, 마을 사람 누구도 웨어링 가의 재산이 바깥 사람에게 돌아가는 것을 환영하지는 않았었잖아?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/201"
msgid "그렇지만, 정말로 브리앙은 정신병이 생긴 것일까? 그가 요즘 태도가 상당히 이상하기는 했지만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/202"
msgid "근래에 들어 각 농장의 가축들이 살상당하는 사고가 잦았던 것은 사실이고, 그것이 모두 브리앙의 소행이었다고 하잖아? 그게 제정신인 사람이 할 일인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/203"
msgid "[주점주인]/n좀 석연치 않은 구석이 있는 것은 사실이긴 하지만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/204"
msgid "그럼 그 브리앙 웨어링과 댄 웨어링 부자는 원래부터 좀 이상한 구석이 있었나보죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/205"
msgid "[브리앙 웨어링]/n여행중에 만나게 될 지도 모르겠군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/206"
msgid "정말로 놀랄 일이에요. 범인이 댄 웨어링 씨 였다니. 이제 그럼 웨어링 가문의 실질적인 피는 끊긴 샘이군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/207"
msgid "자, 행복해진 다이아나 씨를 위해서 건배... 그리고 남겨진 사람들을 위해..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/208"
msgid "어서오세요, 이 집의 주인님이신 다이아나 님의 뜻에 따라 집에 오시는 손님은 무료로 재워드립니다. 주무시겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/209"
msgid "안녕히 주무세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/210"
msgid "안녕히 가세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/211"
msgid "웨어링 집안이군. 이 집의 주인인 브리앙 웨어링씨는 다이아나와 함께 여행중이니, 아무도 없이 잠겨있군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltfa01_
msgctxt "field|ko|art_ko_fltfa01_|@kfltfa01_/212"
msgid "아잉... 샤론의 싸인이 갖고 싶은데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/000"
msgid "구 제국의 수도였던 게이시르 시티이니만큼 아무리 지금은 옛 영화가 사라졌었도 걷는 세수는 장난이 아니지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/001"
msgid "이곳은 본래 제국의 제1공신이였던 번스타인 가문의 영지였습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/002"
msgid "게이시르의 대 성당은 10여년 전에 완공된 것이지. 상당히 오랜 기간이 걸려서 완공된 대 공사였던 것으로 기억하네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/003"
msgid "이곳이 교회령이 된 이후에는 종교 재판이 전혀 없었지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/004"
msgid "어서오세용"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/005"
msgid "가장 최근에 있었던 샤론양의 공연은 이곳 게이시르 시티에서 였었죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/006"
msgid "우리 옆집에 사는 누나는 좀 이상해요. 어떨때는 한없이 상냥하다가 때로는 굉장히 난폭해진다니까요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/007"
msgid "최근에 사막에서는 도적 떼들이 설치고 있다네. 덕택에 나도 이번에 죽을 위기를 많이 넘겼다고."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/008"
msgid "상당히 더운 곳에서 사는 사람들은 대체로 성격이 느긋해 지지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/009"
msgid "사이럽스를 가기 위해서는 트리시스 사막을 건너야 한다네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/010"
msgid "게이시르 대성당이 완공되던 해에, 공사에 가장 많은 기부를 한 번스타인 가문이 멸문당한 것은 아이러니라 아니 할 수 없지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/010_3"
msgid "게이시르 대성당이 완공되던 해에, 공사에 가장 많은 기부를 한 번스타인 가문이 멸문당한 것은 아이러니라 할 수 없지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/011"
msgid "이 근처 숲에서는 옛날에 용이 살았었다는 굴로 가는 길이 있습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/012"
msgid "샤른호스트가 이근방에도 나타났다는 소문이..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/013"
msgid "게이시르 대성당 아래에는 이전에 매설되었던 지하수로가 있답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/014"
msgid "펜드래건과 투르족의 전쟁은 최근 소강상태에 빠졌다고 하더군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/015"
msgid "뭐, 지하수로나 용의 굴이나 다 소문속에서나 나오는 지역이니 실제하는지는 아무도 모르지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/016"
msgid "투르족의 과학기술은 상상이상이라 하더군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/017"
msgid "그 누나는 어렸을 때 부터 성격이 좀 이상했었던 모양이에요.... 어머니가 그러시던데요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/018"
msgid "훗, 나는 중년의 낭만을 즐기는 한가로운 귀족이라네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/019"
msgid "번스타인 가문의 멸문은 어쩌면 이미 예정되어 있는 것이였는지도 모르지. 그 가문은 체사레 공의 야심과는 맞지 않는 편이었거든."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/020"
msgid "호호호"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/021"
msgid "의붓아버지한테 난폭한 일을 당한 뒤로 그렇다는 이야기를 아주머니들이 하는 것을 들었어요. 어떤일인지 물어봤다가 되게 혼나기는 했지만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/022"
msgid "이곳은 리브레빌 시티입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/023"
msgid "음악가 니카차씨를 아시나요? 사이럽스의 인기인 이랍니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/024"
msgid "게이시르 시티는 현재 체사레 추기경의 다스림을 받지요. 당연히 교회령에 들어가 있는 상황이고요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/025"
msgid "게이시르시티 "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/026"
msgid "이곳 게이시르는 점점 쇄퇴해 가는 것이 느껴지는 도시에요. 무엇보다 사람들이 늘지를 않아요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/027"
msgid "왜 그럴까요? 게이시르 시티는 다른 도시에 비해서 교회세력이 횡포를 부리는 정도도 훨씬 적은데도...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/028"
msgid "게이시르 시티에서 점점 사람들이 빠져나가고 있는 것은 시 자체가 젊은 기운을 잃어 버렸기 때문이 아닐까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/029"
msgid "팬드래건과 투르족은 정말로 오랫동안 전쟁을 하고 있지. 투르족의 막강한 화력을 막아내는 것은 물량이라는 말이 있지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/030"
msgid "팬드래건의 물량공세 앞에 투르족의 공세도 주춤했다고 들었네만."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/031"
msgid "샌더 장군은 퇴역한 군인이래요. 최근에 이곳 게이시르 시티로 이사왔지요. 보통 퇴역군인은 '군인의 도시'인 로우엔으로 가기 마련인데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/032"
msgid "샌더 장군에게는 4명의 딸이 있는데, 하나같이 전부 미인이라고 하더군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/033"
msgid "그 장군은 과거 군인시절에는 대단한 다혈질이었나 봐요. 지금도 그 성격은 어느정도 남아있다고 하던데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/034"
msgid "샌더 장군의 집은 자주 파티를 여는 것으로 유명하죠. 샌더 장군은 이 고풍스러운 전통의 도시에 어울리는 분임에 틀림없어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/035"
msgid "당신들도 샌더 장군의 파티에는 꼭 한번 가 보셔야 하는데... "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/036"
msgid "그분 집에는 상당히 많은 사람들이 모인답니다. 샌더 장군은 이곳저곳에 아는 사람이 많은 것 같아요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/037"
msgid "뭐, 아직도 모험을 좋아한다면 한번 그 굴을 찾으러 다니는 것도 나쁘지는 않겠지요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/038"
msgid "저도 어렸을 때는 곧잘 용의 동굴을 찾아서 돌아다니고는 했답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/039"
msgid "그 이후로 상당한 시간이 지났지만, 그녀의 공연 소식은 다시는 들리지 않아요. 이유가 무엇일까요? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/040"
msgid "나의 우상 샤론 누나의 공연을 다시한번 보고 싶은데... 설마 소문대로 가수를 그만 둔다는 것은 아니겠죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/041"
msgid "게이시르 시티 방어병력의 일원으로서 가장 자랑스러울 때는 일년에 한번 있는 사열식이죠."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/042"
msgid "이 게이시르시가를 행군할 때는 정말이지 과거에 흑태자님이 살아계실때 했다던 사열식이 어떤것인지 짐작이 간다니까요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/043"
msgid "물론 지금의 작은 군세를 갖고는 전 안타리아를 호령했던 당시의 화려함과는 거리가 있겠지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/044"
msgid "이곳 게이시르 시티의 치안 상태는 상당히 좋은 편입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/045"
msgid "아직까지 제피르 팰컨등의 불순한 세력의 영향력이 대단히 약한 상태이기 때문에, 우리 게이시르의 치안은 안심해도 좋지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/046"
msgid "가장 치안이 위험했던 것은 10여년 전의 번스타인 가문 멸문당시였죠. 당시, 번스타인 가문의 잔당들이 계속해서 저항했었으니까..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/047"
msgid "과거에 나는 번스타인 가문의 문장을 달았었던 군인이었지. 10년전 번스타인 가문이 멸문당할때 난 휴가중이었어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/048"
msgid "번스타인 가문의 도련님께서 종교재판을 받는다는 소리를 들었을 때 재빨리 게이시르 시티로 돌아왔었지만...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/049"
msgid "그때는 이미 모든 상황이 끝난 뒤였지. 나의 군인생활중에 가장 치욕스런일이었다. 아군이 전멸당할동안 나는 전장에 없었다는 것이..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/050"
msgid "나는 이스카리옷 님의 학원에서 마법을 공부하는 마법사라네. 자료를 구하기 위해 팬드래건령 다카마 항까지 갔다가 왔지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/051"
msgid "다카마 항을 가보니 팬드래건의 경제가 많이 어려워 졌다는 것을 알 수 있겠더군. 아무래도 투르족과의 전쟁이 힘들긴 힘든것 같아."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/052"
msgid "이럴때에 우리 제국의 힘이 하나로 뭉쳐 있다면.... 아아... 흑태자님..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/053"
msgid "샌더 장군이요? 그 집의 3째 누나를 우리형이 좋아하지요. 그 집안의 딸들은 상당히 미인이에요. 샌더 장군은 못생겼는데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/054"
msgid "그 누나들의 어머니는 상당히 아름다운 분이셨겠죠? 그렇지만 솔직히 그 샌더 장군은 마음에 안 드는 사람이에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/055"
msgid "우리형은 의사에요. 내가 이런 이야기를 하면 '쪼그만게'하지만, 나도 사람보는 눈은 꽤 날카롭다고 자부하거든요? 형은 언제고 큰코다칠껄요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/056"
msgid "[ 더스틴 ]/n 난 의사지요. 얼마전에 만난 샌더 장군의 셋째딸인 프리실라를 사랑하게 되었답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/057"
msgid "[ 더스틴 ]/n그런데 얼마전에 프리실라가 마약복용 혐의로 잡혀온 것을 보았소. 의사인 나의 보증으로 풀려나기는 했었지만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/058"
msgid "[ 더스틴 ]/n프리실라는 분명히 나쁜 놈들의 꼬임에 빠져있는 것이 분명해요! 어떻게 그녀를 도와 줄 방법이 없을까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/059"
msgid "우리 가게 주인은 단 과자를 편집광적으로 좋아하는 것이 단점이라면 단점이지요. "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/060"
msgid "이 가게는 주인의 집안 대대로 전해 내려오는 가게지요. 주인은 전 주인만큼 가게에 대한 애정이 없는 것 같아요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/061"
msgid "아버지는 무기상점을 하기에는 취향이 맞지를 않는 편이에요. 무엇보다도 아버지가 좋아하는 것은 요리인걸요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/062"
msgid "지금 카운터를 보고 있는 것은 아버지의 사촌이죠. 아버지는 잠시 출장을 나가셨답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/063"
msgid "도데체가! 아들놈은 이 집안 대대로 물려 내려오는 유서깊은 가게에 대한 애착이 전혀 없어! 날마다 먹는 것에나 신경쓰고..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/064"
msgid "당신들 칼스님이 용을 죽이고 봉인해 놓은 화룡굴에 대해 알고 있소?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/065"
msgid "화룡굴은 이 도시 남쪽에 있다고 하더군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/066"
msgid "[루츠양]/n어서오세요. 우리 여관은 가장 깨끗하고 깔끔한 서비스를 제공합니다. 저희 여관의 숙박비용은 80Eld 입니다. 주무시겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/066_3"
msgid "[ 루츠양 ]/n어서오세요. 우리 여관은 가장 깨끗하고 깔끔한 서비스를 제공합니다. 주무시겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/067"
msgid "감사합니다. 편안히 쉬세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/068"
msgid "다음에 다시 들려 주세요. 저희는 언제나 최상의 서비스를 제공합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/069"
msgid "저희 여관을 이용해 주셔서 감사합니다. 다음에 또 들려 주세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/070"
msgid "[ 올드필드 씨 ] 어서오십쇼! 세계에서 최상의 무기만 모아놓았습니다! 마음껏 보다 가세요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/071"
msgid "올드필드 상점"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/072"
msgid "좋은 무기는 위기의 순간에 생명을 구합니다. 다음에 또 이용해 주십시오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/073"
msgid "[ 올드필드 부인 ]/n어서오세요. 저는 남편을 도와서 무기중의 총포류를 판매한답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/074"
msgid "올드필드 상점"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/075"
msgid "저희 상점의 물건을 구입해 주셔서 감사합니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/076"
msgid "[ 레이몬드 군 ]/n어서오세요, 우리는 최고의 물품만을 취급합니다! 일단한번 구입해 보십시오!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/077"
msgid "악세사리 상점 '메서스'"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/078"
msgid "안녕히 가세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/079"
msgid "이 근처에는 용의 굴이 있는데 가끔가다 그곳에서 귀한 옛 보물을 가져 나오는 사람들이 있답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/080"
msgid "단지, 그곳에 들어가면 돌아올 수 없다는 소문이 파다하니만큼, 들어가 보시지는 않는것이 좋겠군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/081"
msgid "[ 행상 듀란트 씨 ]/n자, 팔다팔다 남은 물건들 떨이로 가져가세요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/082"
msgid "듀란트씨의 약국"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/083"
msgid "감사합니다, 감사합니다. 다음번 다카마행에서는 더 좋은 물품으로 여러분께 보답하겠습니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/084"
msgid "흥, 듀란트씨는 별로 물건을 싸게 팔지도 않으면서 떨이라고 그런다니까요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/085"
msgid "저는 깨달음을 얻기 위한 여행중이에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/086"
msgid "얼마전에 보리수 나무 밑에서 신비한 빛이 저에게 말했답니다. \"떠나라\"라고."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/087"
msgid "깨달음을 얻기 전에는 돌아가지 않을 거에요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/088"
msgid "요즘 젊은 것들은 패기가 없어! 그런 면에서 보면 로우엔의 프레데릭경은 젊은이들의 귀감이라고 할 수 있지!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/089"
msgid "자네, 남의 일 때문에 자신의 일을 소흘히 하지는 않나? 세상에서 제일 중요한 것은 자기만족 이라네. 자신을 만족시키며 살아야해."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/090"
msgid "그런 것으로 말하자면 난 너무 방탕하게 살았지... 내 고향 프리토리아가 그립군..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/091"
msgid "최근의 이스카리웃의 제국학술원은 마법의 극한을 연구하는 것 같더군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/092"
msgid "난 당신의 정체를 알고 있소. 내가 나이는 괜히 먹은 줄 알고 있는가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/093"
msgid "당신은 모니터를 보면서 마우스를 클릭하는자. 시간을 따라 방랑하는  자가 아닌가..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/094"
msgid "게이시르 저택에 얽힌 전설을 아세요? "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/095"
msgid "그 저택에는 10년전에 번스타인가가 살고 있었지요. 그런데 그 가문은 멸문당했어요...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/096"
msgid "그 이후에는 아무도 살지 않는답니다. 그 이유는...."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/097"
msgid "요새 이곳저곳을 떠돌아 다니는 행상의 숫자가 이상하리만큼 증가하지 않았어요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/098"
msgid "각지의 영주들 때문에 파산한 집이 늘면서 생계를 위해서 행상을 하는 집이 많답니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/099"
msgid "그래도 게이시르 시티는 사정이 좋은 편에 속하니까... 저는 얼마나 다행인지 몰라요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/100"
msgid "언제나 지하실에는 무엇인가 있을 줄 알고 내려오는 것은 상당히 바보같은 짓이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/101"
msgid "이곳에는 절대로 아무것도 없어."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/102"
msgid "요새는 정말로 장사가 안되는 편이에요. 사람들이 전부 다 가진 돈이 어디로 간 것인지..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/103"
msgid "그나마 사정이 좋다는 게이시르 시티도 사정이 이러니.... 다른 곳이야 어떻겠어요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/104"
msgid "흑태자님이 살아계실 때만 해도 경제가 이렇지는 않았었지. 그런데 지금은 이게 무언가!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/105"
msgid "이 제국은 기필코 하나로 통합되어야 해! 그리고 그것을 이룰 사람은 우리 체사레 추기경님 뿐이다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
msgctxt "field|ko|art_ko_fltga01|@kfltga01/106"
msgid "흥... 내 미모가 보고 싶다면 밝은 곳에서는 곤란해요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltga01
