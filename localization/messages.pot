msgctxt "field|re|art_fl22_s00|@kfl22_s00/029"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/030"
msgid "에스메랄다의 사진을 입수했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/031"
msgid "…/30d다시 넣어두는 게 좋겠군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/032"
msgid "뭔가 소중한 물건이 들어있는 것 같던데…/50d/n보르스 몰래 함부로 열어볼 수는 없지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/033"
msgid "음?/30d 바닥에 뭐가 떨어져 있군?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/034"
msgid "다이아몬드 젬을 입수하였습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/035"
msgid "체사레가 크리스티나를 부추긴 것이 틀림없어./65d/n체사레…/50d 자신의 손녀까지 이용하다니…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/036"
msgid "[메디치]/n크리스가 적이 될 줄이야…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/037"
msgid "[클라우제비츠]/n그래도 크리스티나와 직접 부딪치는 일은 피하고 싶군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/038"
msgid "[리델]/n그 녀석과는 싸우고 싶지 않은걸."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/039"
msgid "[이자벨]/n이번 일로 다들 동요하고 있어요./45d/n물론/30d 원인은 당신이지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/040"
msgid "[이자벨]/n자신의 행동에 잘못이 없다면,/30d 당당하세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/041"
msgid "[실버]/n크리스의 마음을 이해하지 못하는 건 아니지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/042"
msgid "[카나]/n크리스…/30d 동생처럼 생각했었는데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/043"
msgid "[에스메랄다]/n이 무슨 운명일까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/044"
msgid "[이자벨]/n당신이 올바른 사람이라면,/30d 나도 힘을 보태줄 테니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/055"
msgid "[메디치]/n그 젊은 나이에 최고 지휘관이 되어 군을 이끈다니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/056"
msgid "[클라우제비츠]/n지금은 우리에 대한 적개심을 불태우고 있습니다만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/057"
msgid "[리델]/n모두에게 인정받겠다고/30d 항상 열심히 했는데 말이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/058"
msgid "[실버]/n칼 끝이 이쪽을 향하니,/30d 기분이 좋지는 않네요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/059"
msgid "[카나]/n이렇게 될 줄은 몰랐어요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/060"
msgid "[에스메랄다]/n이런 일이 생겨버리다니…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/061"
msgid "[메디치]/n재능있다고는 생각했지만,/40d 타고난 지도자라는 건가."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/062"
msgid "[클라우제비츠]/n그래도 모두에게 사랑받는 동료였으니까요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/063"
msgid "[리델]/n쳇,/30d 누구 때문에 이렇게 되어 버린거야?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/064"
msgid "[실버]/n그 아이와 마주치면,/30d/n저도/45d 그 아이에게 칼을 겨누어야 하겠죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/065"
msgid "[카나]/n다음에 크리스를 만나면,/30d 어떻게 해야 하지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/066"
msgid "[에스메랄다]/n신은 바른 사람의 편이시지요./55d 분명 길이 열릴거예요. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/067"
msgid "제 20 장"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s00
msgctxt "field|re|art_fl22_s00|@kfl22_s00/068"
msgid "떠나는 자와 남는 자"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/000"
msgid "이스카리옷…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/001"
msgid "시라노,/40d 정말 오랜 기다림이었다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/002"
msgid "무엇을 위해 나를 배신한건지 묻고 싶군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/003"
msgid "옛 친구를 만나니/30d 불쾌했던 옛날이 떠오르는군./55d/n뭐,/25d 추억을 되새기는 것도 나쁘진 않겠지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/004"
msgid "하지만 시라노,/45d 그건 너와 나의 싸움이 끝난 후의 이야기다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/005"
msgid "덤벼라, 시라노!/45d 나의 힘을 보여주마!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/006"
msgid "이 정도로 나를 막을 수 있을 줄 알았나,/15d 이스카리옷!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/007"
msgid "크크…/60d 역시 인간의 힘으로는 무리였나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/008"
msgid "하지만 내가 만들어 낸 궁극의 힘이라면 이야기가 다르다!/90d/n똑똑히 봐 둬라,/45d 시라노!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/009"
msgid "시라노…/45d 최강의 힘을 손에 넣었군./90d/n내가 만들어 낸 힘보다/30d 훨씬 강한…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/010"
msgid "이스카리옷…/45d/n그렇게 추악한 괴물이 되면서까지/30d 힘을 얻고 싶었나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/011"
msgid "큭,/30d 너한테 그런 말을 듣다니…/100d/n그래,/60d 그러기 위해서/30d 너를 배신한 거다…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/012"
msgid "하지만…/30d 너도 결국 나와 같은…/45d 괴물이야…/60d/n평범한 사람들과 공생할 수 없는…/60d 사회의 격리자…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/013"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/014"
msgid "나는 그래도…/45d 이렇게 네 손에 죽을 수 있지만…/75d/n불쌍하게도 너는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/015"
msgid "체사레는 어디에 있나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/016"
msgid "파괴신…/45d 부활…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/017"
msgid "파괴신이라고…?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/018"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s04
msgctxt "field|re|art_fl22_s04|@kfl22_s04/019"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/000"
msgid "클라우제비츠,/60d 할 말은 해야겠소!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/001"
msgid "무슨 말씀이십니까,/15d 메디치 님."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/002"
msgid "우리 제피르 팰컨이/15d 시라노 저 자의 꼭두각시로 놀아나는 걸/15d/n더 이상 보고만 있을 수는 없어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/003"
msgid "그게 무슨 소리예요,/15d 메디치 오빠!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/004"
msgid "카나,/30d 너도 현실을 봐야 해./30d/n저 자는 우리를 자신의 복수의 도구로 이용하고 있을 뿐이야!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/005"
msgid "시라노 님에게/15d 개인적인 원한이 없다고는 할 수 없습니다./65d/n하지만 목표는 체사레 추기경의 타도./n/55d우리의 목적과 일치한다는 사실에는 변함이 없습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/006"
msgid "젠장,/30d 여기저기 모두 시라노 편만 들고있군!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/007"
msgid "오해하고 계신 거 같아요./50d/n시라노 님께선 복수를 중요하게 여기는 건 맞지만,/60d 그걸 우선시하고 계시진 않아요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/008"
msgid "오해든 아니든,/30d 이대로 저 자를 내버려 둘거라면/45d 나는 차라리 제피르 팰컨을 탈퇴하겠어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/009"
msgid "나도 마찬가지야!/40d/n시라노를 쫓아내든지/15d 우리 둘을 포기하든지,/45d 둘 중 하나를 선택해!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/010"
msgid "시라노,/15d 뭐라고 이야기 좀 해봐요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/011"
msgid "메디치는 나의 은인이다./n하지만 제피르 팰컨의 도움 없이는 체사레를 잡을 수 없을지 모른다./n어떻게 할까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/012"
msgid "내가 나가겠소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/013"
msgid "나는 나갈 수 없소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/014"
msgid "나 때문에 제피르 팰컨이 분열되는 것을/15d 원하지 않소./60d/n내가 탈퇴하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/015"
msgid "시라노!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/016"
msgid "그래,/15d 잘 생각했소./30d/n생각보다 꽉 막히진 않았군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/017"
msgid "시라노가 나간다면,/15d 나도 따라 나갈거예요!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/018"
msgid "카나,/30d 그러면 내가 제피르 팰컨을 탈퇴하는 의미가/n없어져 버리게 돼."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/019"
msgid "시라노…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/020"
msgid "에스메랄다 님은 어떻게 할 거야?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/021"
msgid "저도/15d 시라노 님을 따라가겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/022"
msgid "시라노 님,/15d 죄송합니다./40d 일이 이렇게까지 되리라고는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/023"
msgid "내가 들어오기 전으로 돌아가는 것 뿐이니,/45d/n너무 심려 마시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/024"
msgid "모두/30d 뜻하는 바를 이루길 빌겠소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/025"
msgid "메디치의 말대로 할 수는 없어./45d/n나는/25d 제피르 팰컨을 그만둘 수 없소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/026"
msgid "뭐라고?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/027"
msgid "확실히,/30d 메디치 님의 말씀은 너무 지나칩니다./50d/n하지만/25d 메디치 님과 리델 님이 제피르 팰컨을 탈퇴하는 것도 바람직하지 않습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/028"
msgid "바람직하지 않다,/15d 어쩐다!/20d/n헛소리 마라,/25d 네 녀석도 항상 마음에 들지 않았어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/029"
msgid "메디치 형님이 아니었다면/45d 우리가 이렇게 큰 세력이 될 수 있었을 것 같아?!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/030"
msgid "긴말 할 필요는 없어, 리델./40d/n시라노를 선택한 사람들은 남고,/30d 나를 선택하는 사람들은 나를 따르면 그만이야!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/031"
msgid "굴러온 돌이 박힌 돌 뽑아내는 격이로군!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/032"
msgid "메디치,/30d 그만두면…/45d 어디로 갈 생각이지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/033"
msgid "리브레빌로 간다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/034"
msgid "……!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/035"
msgid "이자벨,/30d 너도 우리와 함께 갈 건가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/036"
msgid "…아니,/30d 나는 여기 남겠어…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/037"
msgid "가자,/30d 리델!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/038"
msgid "어디,/30d 우리 없이 얼마나 잘 되나 두고 보자구!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/039"
msgid "체사레가 파괴신을 부활시키려 한다면,/45d/n우리도 어서 수중도시로 향해야 해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/040"
msgid "수중도시라면,/40d 사이럽스 부근의 7대 불가사지 아닙니까./55d 그곳에 뭔가 있습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/041"
msgid "창세전쟁의 비록에 따르면/45d 그곳에는 마지막 파괴신의 봉인이 남아 있소./60d/n그 봉인을 풀고 파괴신을 부활시키려는 것이 틀림없어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/042"
msgid "체사레는/30d 분명 그곳으로 갔을 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/043"
msgid "알겠습니다, 시라노 님./40d/n주요 병력을 수중도시 근방으로 이동시키겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/044"
msgid "시라노,/30d 이제 어디로 가실 생각이죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/045"
msgid "일단/45d 게이시르 시티로 돌아가 볼까 한다./45d/n거기 가면 잊어버린 것을 찾을 수 있을지도 몰라."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/046"
msgid "번스타인가 저택에…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/047"
msgid "에스메랄다는 이미 알고 있었군…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/048"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/049"
msgid "이제부터 무엇을 하든…/45d/n그곳에서는 잊고 있던 무언가를 떠올릴 수 있을 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/050"
msgid "제가 이야기하는 것은/15d 주제넘은 일인지 모르겠지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/051"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/052"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/053"
msgid "에스테는 나를 받아주겠지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/054"
msgid "쳇,/30d 너도 마찬가지군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/055"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/056"
msgid "이 다음의 선택에 따라 앞으로의 내용과 결말이 달라지게 됩니다./n이곳에서 저장하시겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/057"
msgid "저장한다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s05
msgctxt "field|re|art_fl22_s05|@kfl22_s05/058"
msgid "저장하지 않는다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl22_s3t
msgctxt "field|re|art_fl22_s3t|@kfl22_s3t/000"
msgid "[이스카리옷]/n이것이 위대한 그리마의 힘이다!/60d/n자,/10d 덤벼라!/20d 시라노 번스타인!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/000"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/001"
msgid "…그 날은 두번 다시 돌아오지 않는다,/10d 시라노."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/002"
msgid "[메르세데스]/n시라노…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/003"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/004"
msgid "여기 있었군요,/15d 시라노./25d 기다렸어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/005"
msgid "메…/30d 메르…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/006"
msgid "메르세데스!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/007"
msgid "아…/40d 에스메랄다…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/008"
msgid "시라노 님…/40d 무슨 일이라도 있었나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/009"
msgid "미안하오, 에스메랄다…/30d 잠시 감상에 빠진 것 같군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/010"
msgid "시라노,/20d 무너져 버린 곳이 많아서/n2층으로는 올라갈 수가 없어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/011"
msgid "아아,/30d 그런가…/45d 알겠어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/012"
msgid "…시라노 님…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/013"
msgid "2층 내 방으로 가면/30d 창세전쟁의 비록 사본을/n찾을 수 있을 텐데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/014"
msgid "할 수 없나./30d 남은 책들은 어디에…/45d/n아직 단서가 될 만한 것들이 남아 있을 텐데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/015"
msgid "남아있는 것…/45d 남겨진 것…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/016"
msgid "체사레가 노린 것은 그것이었구나!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/017"
msgid "베라딘이 남긴 파괴신이요?/50d/n수중도시라면,/25d 사이럽스 근처 호수에 있는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/018"
msgid "…/40d맞소./30d 체사레는/15d 내가 그 파괴신의 존재를 알게 되어,/30d/n그것이 알려지는 것을 두려워 했던 거야!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/019"
msgid "사이럽스라면/40d 당시에는 체사레의 힘이 미치지 못하는/n영토였을테니…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/020"
msgid "실버,/25d 사이럽스로 향한다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/021"
msgid "……"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/025"
msgid "그래, 맞아!/40d/n베라딘은/15d 7대 불가사지 중 마지막인/15d 수중도시의 파괴신을 남겨 놓았어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl23_s01
msgctxt "field|re|art_fl23_s01|@kfl23_s01/026"
