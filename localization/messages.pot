#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/010"
msgid "두목...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/011"
msgid "그동안 두목과의 즐거웠던 일들... 잊지 못할 겁니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/012"
msgid "두목이 떠난다니... 저희도 이제는 해적질 그만 둬야겠군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/013"
msgid "그럼 작별이다./20d 다시 만날 날이 있겠지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/014"
msgid "부디 행복하시길 바라겠습니다, 두목!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/015"
msgid "후후, 저 바보 녀석들을 두고 떠나자니 걱정이 앞서는걸."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/016"
msgid "그럴 생각은 없습니다./15d 저는 한번 마음먹은 일을 손바닥 뒤집듯이 번복하는 사람은 아닙니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/017"
msgid "내키지 않는다면 무리해서 따라올 필요는 없어. 사이럽스에 데려다 준것만으로도 애초의 약속은 지킨 것이니."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/018"
msgid "그런가.../30d /n그럼, 앞으로 잘 부탁하겠다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/019"
msgid "예, 시라노!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/020"
msgid "트리시스 사막을 건너 일단 게이시르 시티 근처로 가자."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/021"
msgid "두목이 기다리던 사람이 바로 저 사람이란 말인가..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/022"
msgid "평소부터 자신을 꺾어줄 사람을 기다리더니만, 결국은 찾아냈군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/023"
msgid "휴... 두목 실력이면 평생 가도 못찾을 줄 알았는데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/024"
msgid "그동안 두목만 섬기던 우린 뭐지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/025"
msgid "뭐긴요~/15d 개밥에 도토리..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/026"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/027"
msgid "윽...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s04
msgctxt "field|ko|art_ko_fl05_s04|@kfl05_s04/028"
msgid "에라, 밑천은 두둑하니 장사나 시작해 볼까..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl05_s2b
msgctxt "field|ko|art_ko_fl05_s2b|@kfl05_s2b/000"
msgid "왠지 이 곳은 들어가지 말아야 할것 같다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/000"
msgid "드디어 제국령에 도착했군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/001"
msgid "이제 어떻게 하실 생각이시죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/002"
msgid "내가 떠난 이후 바뀐 제국의 사정에 관해 여러가지 알아봐야겠지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/003"
msgid "기억으로는 이곳은 카라카스 지방일텐데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/004"
msgid "앗, 저기...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/005"
msgid "후후후, 기다리고 있었다. 카나 밀라노비치!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/006"
msgid "제피르팰컨의 부대장이라니 생각보다 큰 수확인걸!/30d 이제는 순순히 투항하시지!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/007"
msgid "이런, 역시 함정이었나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/008"
msgid "하지만 공작의 영지로 가는 길은 이곳뿐인데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/009"
msgid "엇! 어이 여기예요, 여기! 이 녀석들의 옆을 쳐요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/010"
msgid "아니, 저 쪽에도 일당이 있다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/011"
msgid "좋아, 녀석들도 놓치지 말고 일망타진 하자!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/012"
msgid "뭐야, 저 아가씨는!/20d 멀쩡한 사람을 끌어 들이다니!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/013"
msgid "훗, 저 아가씨 함부로 위험한 짓을.../20d 하지만 병사들이 길을 막는다면 굳이 피할 것까지는 없겠지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/014"
msgid "미안해요, 갑자기 끌어들여서."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/015"
msgid "흥, 차라리 칼 꽂고서 미안하다고 하시지!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/016"
msgid "이것으로 병사들은 모두 해치운 셈인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/017"
msgid "도와줘서 정말 감사합니다만, 바빠서 이만 가봐야 겠군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/018"
msgid "그럼."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/019"
msgid "뭐야, 정말 무례한 아가씨로군요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/020"
msgid "뭐, 고향으로 돌아온 인사라고 생각하지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/021"
msgid "자, 그보다는 이 근방에 조그만 마을이 있을 거야./30d 오늘은 그곳에서 묵도록 하자."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/022"
msgid "!!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/023"
msgid "칫, 매복하고 있었군!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s01
msgctxt "field|ko|art_ko_fl06_s01|@kfl06_s01/024"
msgid "/2c제국령 카라카스 지방"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/000"
msgid "카라카스 영주의 행차인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/001"
msgid "[병사]/n영주님의 행차시다! 길을 비켜라!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/002"
msgid "[마을 주민]/n쳇...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/003"
msgid "설마... 루벤...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/004"
msgid "왜 그러세요? 아는 사람입니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/005"
msgid "죽어도 잊지 못할 얼굴이지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/006"
msgid "저 유명한 루벤 번스타인 공작을 모르세요?/30d 외지에서 오신 분 이시군요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/007"
msgid "실례지만 이 곳 영주님의 성함이 어떻게 되는지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/008"
msgid "실버, 마차의 뒤를 쫓자!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/009"
msgid "루벤의 뒤를 쫓겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/010"
msgid "오늘은 일단 쉬고 내일의 화형식에 참석하자."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/011"
msgid "마차를 뒤쫓기에는 너무 늦은 것 같으니, 저 영주가 참석한다는 내일 화형식까지 기다려 보는 것은 어떨까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/012"
msgid "그래, 실버./20d 내일 화형식에 참석해 확실한 기회를 살피는 것이 좋겠군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/013"
msgid "아무래도 내일있을 화형식에는 우리도 참석해야 겠어./30d 일단 오늘 묵을 여관을 찾아보자."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/014"
msgid "유명하다고?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/015"
msgid "잔혹하기로 유명한 영주죠./20d 오늘 이곳에 행차 한것도 자신이 집도할 내일의 화형식을 준비 시키기 위해서라구요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s02
msgctxt "field|ko|art_ko_fl06_s02|@kfl06_s02/016"
msgid "루벤 번스타인...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/000"
msgid "도대체 데이빗이 무슨 죄를 졌다고..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/001"
msgid "제피르팰컨 사람들을 도와준 것이 화근이지 뭐."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/002"
msgid "제길, 녀석들이 제피르팰컨을 못당하니 우리에게 화풀이군 그래!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/003"
msgid "쉿! 누가 들으면 어쩌려고 그래?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/004"
msgid "휴우... 우리마을에도 제피르팰컨들이 나타났으면..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/005"
msgid "제피르팰컨이라..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/006"
msgid "제피르팰컨이라면.../30d 몇년전부터 제국령에 출몰한다는 반란군으로 요사이 유명해진 것 같더군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/007"
msgid "들어본 기억이 있는것 같은데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/008"
msgid "루벤 공작님께서 납신다! 모두들 정숙하도록!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/009"
msgid "루벤...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/010"
msgid "시라노, 지금 칠까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/011"
msgid "어떻게 하시겠습니까?  "
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/012"
msgid "좋아, 실버. 정면 돌파다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/013"
msgid "아직 안돼, 기다려."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/014"
msgid "어리석은 녀석, 악마를 믿고 반란군에 동조하다니..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/015"
msgid "이런 대역죄는 절대 용서할수 없다. 극형으로 다스려 국법의 무서움을 보여주어야 한다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/016"
msgid "화형식 준비를 모두 끝마쳤습니다. 루벤 공작님."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/017"
msgid "좋아, 지금이다 실버. 정면 돌파다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/018"
msgid "아직은 안돼./30d 화형식이 시작되어 녀석이 완전히 경계를 풀 때까지 기다린다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/019"
msgid "녀석은 그렇게 만만한 놈이 아니야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/020"
msgid "식을 멈춰라, 루벤!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/021"
msgid "!!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/022"
msgid "무고한 사람들을 괴롭히는 악덕영주 루벤공작! /10d/n제피르팰컨이 당신을 처단하러 왔소!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/023"
msgid "제피르팰컨이다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/024"
msgid "영주를 처단하라!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/025"
msgid "제피르팰컨, 우리를 도와줘요!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/026"
msgid "뭣들하는 거냐!! 놈들을 막아라!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/027"
msgid "맙소사, 또 저 아가씬가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/028"
msgid "잘못하면 루벤을 놓치겠군. 어서 녀석을 잡도록 하자!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s03
msgctxt "field|ko|art_ko_fl06_s03|@kfl06_s03/029"
msgid "/2c다음날. 화형식장."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/000"
msgid "웬... 웬 놈들이냐!!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/001"
msgid "흥! 불쌍한 영민들을 괴롭히는 사악한 영주! 너를 심판하기 위해 제피르팰컨에서 왔다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/002"
msgid "경비병, 경비병! 어서 녀석들을 체... 체포하라!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/003"
msgid "하하, 경비병들이 아직까지 남아 있을 것 같은가? 이미 이 근방의 경비병은 모두 처리했다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/004"
msgid "으으..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/005"
msgid "잠깐... 뭔가 이상한걸?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/006"
msgid "??"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/007"
msgid "과연.../40d 속았군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/008"
msgid "속았다니, 무슨 말이죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/009"
msgid "이 자는 절대 루벤이 아니야."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/010"
msgid "설마, 루벤이 자기 대신 내세운 가짜란 말인가요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/011"
msgid "당신 말대로요. 이 자는 루벤의 허수아비에 불과해."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/012"
msgid "하지만, 어떻게 알아 볼 수가 있죠? 내가 보기엔 바로 이 자가 루벤 같은걸요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/013"
msgid "절대 아니오. 그가 백골이 되어도 나는 알아 볼 수 있을 거요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/014"
msgid "실버, 우리가 지금 이러고 있을 때가 아니야. 녀석의 뒤를 쫓는다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/015"
msgid "어디로 도망쳤는지 짐작되는 곳이 있으신가요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/016"
msgid "자신의 영지를 두고 그렇게 멀리 도망칠 놈은 아니야. 분명히 근방의 영주에게 도움을 청하러 갔겠지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/017"
msgid "그럼 어서 뒤를 쫓아가요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/018"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/019"
msgid "?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/020"
msgid "지금부터는 제피르팰컨과는 상관없는 일일텐데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/021"
msgid "루벤은 영지를 버리고 도망을 갔으니 제피르팰컨의 목적은 이미 달성했지않나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/022"
msgid "그야...그렇지만,"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/023"
msgid "그럼 더이상 따라오지 말도록."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/024"
msgid "예? /10d/n하지만..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/025"
msgid "그럼 이만.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/026"
msgid "기..기다려요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/027"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/028"
msgid "......"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/029"
msgid "아..알았어요./10d/n어딜가던지 마음대로 하라구요. 나하고는 상관없는 일이니."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/030"
msgid "아..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/031"
msgid "[루밴] /n저..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/032"
msgid "가짜 아저씨는 또 뭐에요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/033"
msgid "[루밴] /n아니..그게.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/034"
msgid "아저씬 눈앞에서 어슬렁거리지 말고 빨리 집으로 돌아가요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s04
msgctxt "field|ko|art_ko_fl06_s04|@kfl06_s04/035"
msgid "[루밴] /n그럼..저도 이만.."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s05
msgctxt "field|ko|art_ko_fl06_s05|@kfl06_s05/000"
msgid "이런, 경비병을 상대하는사이 도망가 버렸군...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s05
msgctxt "field|ko|art_ko_fl06_s05|@kfl06_s05/001"
msgid "아쉽게 놓쳐버렸군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s05
msgctxt "field|ko|art_ko_fl06_s05|@kfl06_s05/002"
msgid "할수 없지. 저택으로 쳐들어 가는 수 밖에."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s05
msgctxt "field|ko|art_ko_fl06_s05|@kfl06_s05/003"
msgid "잠깐만요, 공작의 저택에 정면으로 쳐들어 가는 것은 무모한 일이예요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s05
msgctxt "field|ko|art_ko_fl06_s05|@kfl06_s05/004"
msgid "훗, 설마 경비병들 때문에 무모한 일이라는 건 아니겠지?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s05
msgctxt "field|ko|art_ko_fl06_s05|@kfl06_s05/005"
msgid "그래요, 당신들 실력을 보니 경비병 쯤은 어렵지 않게 상대 할 수 있겠죠./40d 하지만 당신들이 경비병을 상대하고 있을 동안 공작은 또 도망가 버리고 말걸요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s05
msgctxt "field|ko|art_ko_fl06_s05|@kfl06_s05/006"
msgid "간단히 말합시다. 아가씨가 원하는게 뭔가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s05
msgctxt "field|ko|art_ko_fl06_s05|@kfl06_s05/007"
msgid "후훗, 이제야 말이 좀 통하는 군요./30d 우리 정보원 중 한명이 저택으로 통하는 비밀통로를 발견했어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s05
msgctxt "field|ko|art_ko_fl06_s05|@kfl06_s05/008"
msgid "그 곳을 통해 들어간다면 루벤공작도 꼼짝없이 당할거여요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s05
msgctxt "field|ko|art_ko_fl06_s05|@kfl06_s05/009"
msgid "우리는 서로 원하는 것이 같은 것 같으니 제 말에 따라 우리일에 협조한다면 당신들에게 비밀통로를 가르쳐 드리겠어요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s05
msgctxt "field|ko|art_ko_fl06_s05|@kfl06_s05/010"
msgid "어려울 것 없지./30d /n그럼 그 곳으로 안내하시오."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s05
msgctxt "field|ko|art_ko_fl06_s05|@kfl06_s05/011"
msgid "좋아요, 이 쪽으로 따라오세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_s05
msgctxt "field|ko|art_ko_fl06_s05|@kfl06_s05/012"
msgid "이 나무뒤로 들어가면 하수구가 있어요./30d 그 쪽으로..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/000"
msgid "드디어 제국령에 도착했군."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/001"
msgid "이제 어떻게 하실 생각이시죠?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/002"
msgid "내가 떠난 이후 바뀐 제국의 사정에 관해 여러가지 알아봐야겠지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/003"
msgid "기억으로는 이곳은 카라카스 지방일텐데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/004"
msgid "앗, 저기...!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/005"
msgid "후후후, 기다리고 있었다. 카나 밀라노비치!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/006"
msgid "제피르팰컨의 부대장이라니 생각보다 큰 수확인걸!/30d 이제는 순순히 투항하시지!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/007"
msgid "이런, 역시 함정이었나?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/008"
msgid "하지만 공작의 영지로 가는 길은 이곳뿐인데..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/009"
msgid "엇! 어이 여기예요, 여기! 이 녀석들의 옆을 쳐요!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/010"
msgid "아니, 저 쪽에도 일당이 있다!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/011"
msgid "좋아, 녀석들도 놓치지 말고 일망타진 하자!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/012"
msgid "뭐야, 저 아가씨는!/20d 멀쩡한 사람을 끌어 들이다니!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/013"
msgid "훗, 저 아가씨 함부로 위험한 짓을.../20d 하지만 병사들이 길을 막는다면 굳이 피할 것까지는 없겠지."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/014"
msgid "미안해요, 갑자기 끌어들여서."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/015"
msgid "흥, 차라리 칼 꽂고서 미안하다고 하시지!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/016"
msgid "이것으로 병사들은 모두 해치운 셈인가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/017"
msgid "도와줘서 정말 감사합니다만, 바빠서 이만 가봐야 겠군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/018"
msgid "그럼."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fl06_xx
msgctxt "field|ko|art_ko_fl06_xx|@kfl06_xx/019"
