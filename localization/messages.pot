msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/026"
msgid "[에드워드 씨]/n 어서오십시오. 저희 여관에서는 1박당 90 Eld를 받습니다. 주무시겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/026_3"
msgid "[ 에드워드 씨 ]/n 어서오십시오. 저희 여관에서는 1박당 90Gold를 받습니다. 주무시겠습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/027"
msgid "감사합니다. 편안한 밤 되세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/028"
msgid "다음번에는 꼭 이용해 주세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/029"
msgid "이용해 주셔서 감사합니다. 다음번에도 또 이용해 주세요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/030"
msgid "우리 술집은 최고의 재료로 최고의 술과 안주만을 드립니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/031"
msgid "허허허... 이곳 여주인은 친절할 뿐 더러 요리 솜씨도 좋아서 난 이곳을 애용한다네."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/032"
msgid "[ 샤론 ]/n샤론이라... 그건 분명 제 이름이지만 더이상 저는 가수가 아니므로 가수 샤론이라고 불릴수는 없네요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/032_3"
msgid "[ 샤론 ]/n싸인이라고요? 당신들도 나를 괴롭히려고 온 사람들인가요? 제발 나를 그냥 놔 둬요..."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/033"
msgid "... 저희가 당신의 싸인을 받을 수 있을까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/033_3"
msgid "아닙니다. 저희는 단지 당신의 싸인을 애타게 찾는 한 소녀의 바램을 전달해주고 싶었을 뿐입니다."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/034"
msgid "[ 샤론 ]/n싸인이라... 사람들은 왜 그렇게 유명한 사람들의 싸인을 못 얻어서 안달인것이죠? 이해할 수가 없군요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/034_3"
msgid "[ 샤론 ]/n... 그런가요... 그렇다면 싸인을 해 드리지요."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/035"
msgid "혹시... 당신이 가수인 샤론 씨가 맞습니까?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/035_3"
msgid "샤론씨? 저기, 싸인 하나만 받을 수 있을까요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/036"
msgid "[ 신 아저씨 ] 무엇 필요한 물건 이라도 있는가?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/037"
msgid "신's 상점"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/038"
msgid "찾아주어서 고맙네. 다음에 또 보자구."
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/039"
msgid "집 만한 곳은 없다고 그러잖아요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/040"
msgid "이곳 게이시르 령에는 더이상 눈, 비가 오지 않는다는 것을 아세요?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltni01
msgctxt "field|ko|art_ko_fltni01|@kfltni01/041"
