#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/059"
msgid "[존]/n(뜨끔)!!/n보다니./10d 보다니./10d 어디서?/10d 어디서 나를 보았는데?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/059_3"
msgid "[ 존 ]/n(뜨끔)!!/n보다니. 보다니. 어디서? 어디서 나를 보았는데?"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/060"
msgid "[지나]/n그것은.../20d 차마 입에 담질 못하겠네, 어이구!"
msgstr ""

#. group=field; variant=ko; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.ko_assets_all_6a1bcc61388aca28c75aef10ee7f439f.bundle; object=art_ko_fltat01
msgctxt "field|ko|art_ko_fltat01|@kfltat01/060_3"
