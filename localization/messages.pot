msgctxt "field|re|art_fl26_s01|@kfl26_s01/003"
msgid "[실버]/n상대는 파괴신이었어!/45d/n자칫하다가는 우리가 당했을거라고!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl26_s01
msgctxt "field|re|art_fl26_s01|@kfl26_s01/004"
msgid "[클라우제비츠]/n시라노 님,/40d 당신에 대한 모두의 믿음이 흔들리고 있습니다./50d/n크리스티나를 구하지 않은 것에는/35d 저도 놀랐습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl26_s01
msgctxt "field|re|art_fl26_s01|@kfl26_s01/005"
msgid "…!!"
msgstr ""

