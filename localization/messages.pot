#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/013"
msgid "현 사이럽스 시장인 샤를르 씨는 그라나다 상단 근처에서/n머무는 것으로 알고 있는데… 우리 선장과는 사이가 안 좋지요./n출항 금지가 풀리려면 시장의 재가가 있어야 하는데..."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/013_2"
msgid "현 사이럽스 시장인 샤를르 씨는/n그라나다 상단 근처에서 머무는 것으로 알고 있는데...."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/013_3"
msgid "현 사이럽스 시장인 샤를르 씨는/n그라나다 상단 근처에서 머무는 것으로 알고 있는데...."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/014"
msgid "흥! 그 돼지같은 작자에게 부탁해 보았자 아니겠나!/n그 놈은 우리 선장님을 어지간히 싫어하는 것이 아닌 걸!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/015"
msgid "뭐, 덕택에 좀 쉬는 것이지..."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/016"
msgid "[선장]/n어떻게 감사를 드려야 할지 모르겠습니다. 루스 씨."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/017"
msgid "[루스]/n별 말씀을./35d/n잘못되어 있는 일을 바로 잡았을 뿐이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/017_2"
msgid "[ 루스 ]/n별 말씀을. 전 단지 잘못되어 있는 일을 바로 잡았을 뿐이랍니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/017_3"
msgid "[ 루스 ]/n별 말씀을./n전 단지 잘못되어 있는 일을 바로 잡았을 뿐이랍니다. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/018"
msgid "[루스]/n아무리 시장이라지만/30d 개인적인 원한으로 항로를/n폐쇄하다니…/50d 정말 말도 안 되는 일이지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/019"
msgid "안녕하십니까,/5d 선장님."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/020"
msgid "[선장]/n오,/25d 당신이 시라노 씨로군요./35d/n루스 씨에게 이야기는 들었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/021"
msgid "다카마항까지 잘 부탁드립니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/022"
msgid "[선장]/n걱정 마십시오./30d/n아,/15d 루스 씨가 여비도 처리해 주셨으니/40d/n편히 지내셔도 됩니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/023"
msgid "루스 씨,/35d 정말 감사합니다./30d/n이 은혜는 잊지 않겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/024"
msgid "[루스]/n후후,/30d 정 고마우시면/30d 다음에 술 한잔 사주세요./60d/n폭풍도를 다녀온 뒤에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/025"
msgid "[선장]/n자,/25d 이제 다카마로 출항이다!/40d/n모두 출항 준비!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy01
msgctxt "field|re|art_fltcy01|@kfltcy01/030"
msgid "[루스]/n당신의 여정에/15d 행운이 함께 하기를/25d 기도하겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/000"
msgid "사이럽스시티"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/001"
msgid "젠장, 게이시르 전역에서 교회세력이 점점 확장되면서/n힘들어 지는 것은 우리 같은 상인들이라고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/001_2"
msgid "젠장, 게이시르 전역에서 교회세력이 점점 확장되면서 힘들어 지는 것은 우리같은 상인들이라고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/001_3"
msgid "젠장, 게이시르 전역에서 교회세력이 점점 확장되면서 힘들어 지는 것은 우리같은 상인들이라고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/002"
msgid "교회 녀석들은 하는 일 없이 감놔라, 배놔라/n보면 볼수록 가관이 아니냔 말이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/003"
msgid "시장은 다카마행 선장과 사이가 상당히 좋지 않아./n얼마 전에도 대판 싸웠지 않아?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/003_2"
msgid "그렇지만 어쩌겠어? 누가 교회세력을 저지할 수 있겠냐고?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/003_3"
msgid "그렇지만 어쩌겠어? 누가 교회세력을 저지할 수 있겠냐고?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/004"
msgid "늑대라 할 지라도 양의 탈을 써야 하는 것이/n요 놈의 세상을 살아가는 지혜라니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/004_2"
msgid "늑대라 할 지라도 양의 탈을 써야하는 것이 요놈의 세상을 살아가는 지혜라니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/004_3"
msgid "늑대라 할 지라도 양의 탈을 써야하는 것이 요놈의 세상을 살아가는 지혜라니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/005"
msgid "교회에 원한을 품은 사람들이 점점 늘어나면 늘어날수록/n제피르 팰컨에 딱 붙어 버리는 사람도 느는 법이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/005_2"
msgid "교회에 원한을 품은 사람들이 점점 늘어나면 늘어날수록 제피를 팰컨에 딱 붙어 버리는 사람도 느는 법이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/005_3"
msgid "교회에 원한을 품은 사람들이 점점 늘어나면 늘어날수록 제피를 팰컨에 딱 붙어 버리는 사람도 느는 법이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/006"
msgid "시장 관저는 이 도시 서쪽 지역으로/n들어가자 마자 첫번째 집이지./n그 집도 제피르 팰컨의 목표가 되지 않을까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/006_2"
msgid "그나마 제피르 팰컨이라도 없으면 교회세력은 더 자기세상인 듯이 행세할걸?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/006_3"
msgid "그나마 제피르 팰컨이라도 없으면 교회세력은 더 자기세상인 듯이 행세할걸?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/007"
msgid "요새요? 죽을 맛이라구요./n물가는 오르지, 여기저기서 도둑은 들끓지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/008"
msgid "그렇지 않아도 벌리지 않는 판에/n교회에서는 성금을 더 걷고 있지 뭐에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/008_2"
msgid "그렇지 않아도 벌리지 않는 판에 교회에서는 성금을 더 걷고 있지 무어에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/008_3"
msgid "그렇지 않아도 벌리지 않는 판에 교회에서는 성금을 더 걷고 있지 무어에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/009"
msgid "주로 그라나다 상점 옆의 주점에서 한잔씩 걸치고는 하지./n정치인 치고는 격이 없는 사람이라, 말하기가 편해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/010"
msgid "요새는 사막에 도둑이 들끓어서/n정말로 이짓도 해 먹기 힘들더군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/011"
msgid "사막 건너기가 어려워진 만큼 물건값도 뛰어서/n사막만 건너면 한탕 크게 할 수 있다고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/012"
msgid "이 도시 서쪽의 들어가자 마자 있는 시장 관저의/n샤를르 시장도 옛날에는 사막대상 출신이라더군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/012_2"
msgid "얼마전에 사막을 건너던 대상들이 도적단의 습격을 받아서 전멸했다는 소리를 들은적이 있다고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/012_3"
msgid "얼마전에 사막을 건너던 대상들이 도적단의 습격을 받아서 전멸했다는 소리를 들은적이 있다고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/013"
msgid "사막만 도둑이 들끓고 있다면 오산이야./n현재 바다에 출몰하는 해적들은/n그 어느 때보다도 지독하다고!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/014"
msgid "이게 다 그 빌어먹을 투르족 때문 아니겠어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/015"
msgid "이 도시 서쪽의 시장 관저에 사는 샤를르 시장이/n좀 더 보안조치를 취해주지 않는 이상 항상 같을껄!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/015_2"
msgid "다카마까지 가는 항로의 일기는 최상인데, 보안은 최악이야. 우리야 말로 목숨걸고 빌어먹고 있는 거라구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/015_3"
msgid "다카마까지 가는 항로의 일기는 최상인데, 보안은 최악이야. 우리야 말로 목숨걸고 빌어먹고 있는 거라구."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/016"
msgid "다카마? 그곳은 지금 세계의 해적이란 해적은/n모두 집결해서 활동중인 곳 아니야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/017"
msgid "해적들도 투르족의 군선을 만나면 도망치기 바쁘다더군./n그런 놈들하고 팬드래건은 어떻게 전쟁을 벌이는 거지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/018"
msgid "다카마에서 세력을 잡는 해적이 전 바다를 지배한다./n이것이 요즘 해적들이 읊고 다니는 말이지. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/019"
msgid "현재 유력한 왕위계승자인 라시드 2세의/n아들인 라시드 3세가 팬드래건의 왕성을/n비운 지도 벌써 몇 년째지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/020"
msgid "팬드래건 왕가야 원래 역마살이 낀 것으로 유명하긴 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/021"
msgid "라시드 3세?/n로빈과 라시드 대왕 사이의 핏줄을 잇는 유일한 손자니까,/n라시드 대왕의 절대적인 지지를 얻는 것도 무리는 아니지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/022"
msgid "로빈을 모른다는 것은 아니겠죠?/n라시드 대왕의 첫번째 부인이자,/n그가 가장 사랑했었다는 부인 말이에요. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/023"
msgid "라시드 대왕은 로빈을 신분의 차와/n중신들의 절대적인 반대를 무릅쓰고/n정실로 맞아들였답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/024"
msgid "라시드 대왕의 정실이었던 로빈 비는/n대왕이 젊은시절 팬드래건 재건을 위한/n모험중에 만나 이루어진 사랑이라잖아요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/025"
msgid "이곳은 악세사리 상점입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/026"
msgid "게이시르 전역에서 가장 목이 좋은 곳은/n역시 다카마가 아닐까./n구 제국이 있을 때는 이곳도 괜찮았지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/027"
msgid "과거 제국이 있던 시절이 정말 그립다네./n그때는 우리에게도 희망이 있고,/n야망이 있고 사람들은 활기에 넘쳤지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/028"
msgid "그때는 물론, 지금과 같이 교회따위가/n설치는 것은 상상도 못했었다고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/029"
msgid "어머, 어머?/n상당히 매력있는 분이시네요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/030"
msgid "천년에 한번씩 화룡산의 용이 깨어난다는 전설을 아세요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/031"
msgid "모른다고요?/n당연하죠! 지금 내가 지어낸 말이거든요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/032"
msgid "이 근처의 수중도시가 있는 사이럽스 호는/n전설과 함께 멋진 경치로 유명해요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/033"
msgid "아… 나도 우리 그이한테서 청혼받은 장소는/n그 수중도시가 보이는 호수였지요…/n그 때는 정말 행복했답니다…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/034"
msgid "지금도 그 때 생각만 하면 얼굴이 붉어져요, 호호호."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/035"
msgid "어머니께선 허구한날 아버지 이야기 뿐이 없어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/036"
msgid "우리를 버리고 가버린 아버지 따위가 뭐 좋다고 도대체!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/036_2"
msgid "우리를 버리고 가버린 아버지 따위가 뭐 좋다고 도데체!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/036_3"
msgid "우리를 버리고 가버린 아버지 따위가 뭐 좋다고 도데체!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/037"
msgid "난 커서는 절대로 아버지같은 사람은 되지 않겠어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/038"
msgid "어머, 이곳에는 처음 오셨나보죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/039"
msgid "그래 뭐 좋은 일이라도 있어요?/n얼굴에 그렇게 씌여 있는데요?/n난 세상에서 제일 행복한 사람, 이라고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/040"
msgid "호호호호! 멋진 연인을 두신게 분명해!/n아.. 얼마나 좋을까, 나도 그 나이라면…/n그래 어디 어떤 분인데요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/041"
msgid "아무리 내 부인이지만, 정말 말이 많아서 문제요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/042"
msgid "그놈의 입은 어떻게 그렇게 쉬지도 않고/n떠들 수 있는 것이지?/n이해를 할 수가 없어…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/043"
msgid "국어 사전을 찾아 보도록."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/044"
msgid "우리 형수님이 좀 말씀이 많으시다는 것은/n자타가 공인한 사실이죠./n그렇지만 속마음은 좋은 분이랍니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/045"
msgid "좋아요, 좋아./n내 백번 양보해서 우리 형수님이/n말이 많을 뿐더러 실수도 많다는 것을 인정하죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/046"
msgid "알았어요. 알았어./n내가 이 집에서 얻어먹는 신세만 아니라도…/n나같으면 우리 형수님 같은 사람하고는 같이 못 살꺼에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/047"
msgid "우리 어머니가 말씀이 좀 과하시다는 것은 알지만,/n그 정도는 이해해 줄 수 있는 것 아닌가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/048"
msgid "살림하는 여자들이야 그정도 수다도 없이/n어떻게 스트레스를 풀겠어요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/049"
msgid "아무리 누가 뭐라 그래도 어머니는 어머니인걸요…/n욕할 수는 없어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/050"
msgid "흥! 지까짓 것들이 무언데 날 괄시하냐고?/n나는 말이야, 흑태자님이 계실 때만 해도/n제국군에서 날리던 사람이여!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/051"
msgid "흑태자님만 살아계셨어도,/n이곳이 이 모양 이 꼴이 되지는 않았을게야!/n어흐흐… 흑태자님…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/052"
msgid "우리 주인님은 정신이 좀 이상하세요./n약간은 망령이 들었죠 뭐."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/053"
msgid "그렇지만 이 집은 편해요./n쉬엄쉬엄 일해도 되고…/n무엇보다도 돈도 많이 주거든요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/054"
msgid "근처의 노인집의 하녀에 대해서는 별로 평판이 좋지 않아."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/054_2"
msgid "그런데 그거 들어 보셨수? 근처에 노인이 사는 집의 하녀하고 노인이 그렇고 그런 관계라면서요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/054_3"
msgid "그런데 그거 들어 보셨수? 근처에 노인이 사는 집의 하녀하고 노인이 그렇고 그런 관계라면서요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/055"
msgid "하녀가 행실이 나쁘고,/n무엇보다도 주인을 속인다는 소문이 있어…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/055_2"
msgid "그 노인과 하녀 말이우? 글쎄, 이상한 소문이 있는 것은 사실이지만, 하녀가 노인에게 독을 먹이고 있다고…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/055_3"
msgid "그 노인과 하녀 말이우? 글쎄, 이상한 소문이 있는 것은 사실이지만, 하녀가 노인에게 독을 먹이고 있다고…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/056"
msgid "이곳에 이렇게 서 있으면/n제가 여태까지 살아온 나날들을 다시 돌아보게 되요. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/057"
msgid "인페르노 근처의 프리토리아 라는 곳을/n가 본 적이 있답니다.  "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/058"
msgid "그곳 근처의 산에서는 이상한 기운이/n흘러나오는 것을 느낄 수 있었어요./n동굴도 마찬가지로…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/059"
msgid "사이럽스는 구 제국령 바깥쪽에 위치한 편이지만,/n실제로는 이곳에 있으면 각 지역의 소식들을/n대단히 쉽게 접할 수 있죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/060"
msgid "구 제국령을 돌아다닌 다는 것은/n산과 숲을 타고 다닌다는 것과 같은 말이죠. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/061"
msgid "평야지대가 없기는 해도 우리들이 먹고 살 수 있는 것은/n비교적 깔끔하게 정리된 무역로 때문 이였죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/062"
msgid "이번 사이럽스 시티 시장은 과연 누가 될지가 궁금해요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/063"
msgid "루스씨가 과연 4번째 도전에서 시장이 될 것인지/n아니면 샤를르 씨의 수성일지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/064"
msgid "주로 여성들은 루스씨를 편든답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/065"
msgid "그런데 그거 들어 보셨수? "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/065_2"
msgid "그런데 그거 들어 보셨수? 근처에 노인이 사는 집의 하녀하고 노인이 그렇고 그런 관계라면서요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/065_3"
msgid "그런데 그거 들어 보셨수? 근처에 노인이 사는 집의 하녀하고 노인이 그렇고 그런 관계라면서요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/066"
msgid "흠… 현 시장인 샤를르는 밥맛없는 놈이지만,/n이번 선거 후보인 루스씨는 사람이 괜찮지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/067"
msgid "샤를르 시장님의 저택은 그라나다 상점 근처에 있지요./n그렇지만 만나고 싶지는 않은 사람이에요. 정.말.로."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/068"
msgid "흠… 두 후보는 성격이 판이하게 틀리지./n루스씨는 주로 주점에서 사람들을 만나기 좋아하는 반면,/n샤를르씨는 그라나다 옆 자신의 집에서 꽁 박혀 있거든."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/069"
msgid "[ 배티 아주머니 ]/n어서오세요. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/070"
msgid "악세사리점 '주크주크'"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/071"
msgid "안녕히 가세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/072"
msgid "이 집에는 아무도 살지 않는 것 같군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/073"
msgid "손님, 그리로 들어오시면 안됩니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/074"
msgid "엇! 네 놈은 라시드 팬드래건이냐!/n이리와! 나의 칼 맛을 보여주지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/075"
msgid "이 집은 들어갈 수 없는 것 같음."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/076"
msgid "저는… 이제 곧 이 세상을 떠날 거에요./n세상을 떠나는 마당에 장신구가 무슨 필요가 있겠어요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/077"
msgid "골드 잼을 획득했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/078"
msgid "그 보석을 가지고 잘 사용하세요…/n그럼 안녕, 잘생긴 분."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/079"
msgid "저는, 떠나버린 그를 7년간 기다렸어요./n이제 저는 죽을 거에요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/080"
msgid "이 도시 서쪽 구역 들어가자 마자/n첫 번째 집인 시장 관저에나 도둑이 들면 좋겠어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/081"
msgid "그는 저를 배신했어요. 저만이 이세상에서 그의 사랑이라고 하고는,/n어저께 내 친구였던 다른 여자와 결혼을 했지요./n저는… 저는 이제 살 가치가 있는 여자일까요?/n이제 저에게 남은 건 죽음뿐… 편히 쉬고 싶어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/082"
msgid "무엇인가 말을 해 줘야 할 텐데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/083"
msgid "다른 남자를 찾아보라고 하자."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/084"
msgid "남자를 편들어준다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/085"
msgid "그런 사람을 봤나…/n하지만 아가씨, 세상에는 많은 남자들이 있습니다./n꼭 그만이 당신의 모든것은 아니지 않습니까?/n그런 것 가지고 세상을 버릴려고 한다면 말이 되겠습니까!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/086"
msgid "그보다 더 행복해지는 것이 그에게 복수하는 것 아니겠습니까./n용기를 가지고 살아가야죠…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/087"
msgid "[시라노] (이 정도면 감동하지 않았을까…)"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/088"
msgid "…. /30d 당신도 똑같은 남자군요./n당신과는 할말 없으니 저리 가세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/089"
msgid "그도… 그도, 당신을 떠나야 할 어떤 이유가 있었던 것이 아닐까요?/n그냥 그를 놓아주고, 용서해 주는 것이 어떨까요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/090"
msgid "…/30d 당신, 당신도 가슴에 슬픔을 담고 있는 것 같군요./n전 그를 미워하지 않는답니다./n아니, 미워할 수 없지요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/091"
msgid "단지… 제가. 제 자신이 싫고 미울 뿐…/n/20d 아. 당신 이거 가지세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/092"
msgid "브레스 젬을 얻었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/093"
msgid "그 보석은 제가 그에게 선물로 주었던 것이죠…/n결혼식 전날 그가 저를 불러서 돌려준 것이에요./n하지만 제가 갖고 있을 수는 없군요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/094"
msgid "어차피 그 보석은 버릴거에요…/n그러니 아무말도 하지말고 가세요. 빨리."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/095"
msgid "말은 그렇게 하면서도, 난 나의 마음을 정리하지 못하고 있다./n훗, 그에게는 어떤 이유가 있을 거라고?/n웃기구나 시라노 번스타인…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/096"
msgid "검은 크기에 따라 나뉘기도 하지만/n특성에 따라 나뉘기도 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/097"
msgid "예를 들어 특수한 용도로 특화된/n공격검과 방어검이 이에 해당하는데,/n공격검은 다른 특성치를 철저히 무시한 채/n공격력만 강화된 검이고,/n방어검은 공격력은 무시한 채 /n방어 용도로 제작된 검들이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/098"
msgid "공격검으로는 카산드라와 그람이 대표적이고,/n방어검은 크리사오르 기리엄이나/n바스타드 소드가 대표적이라네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/099"
msgid "[전술연구회 회원]/n전투는 기본적으로 공격과 방어로 구성되게 됩니다./n두가지 전부 무기에 의해 가장 큰 영향을 받게 됩니다./n공격과 방어의 메커니즘은 다음과 같습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/100"
msgid "[전술연구회 회원]/n일단 공격./n공격은 공격자의 완력과 무기의 공격력에 의해 결정됩니다. 당연히 두 가지가 다 높은 경우가 전체 공격력을 올리게 되지요. 명중의 계산은 공격자 무기 명중률에 관련이 깊습니다. 총의 경우에는 \"총\"에 명중률이, \"탄약\"에 공격력이 실리게 됩니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/101"
msgid "[전술연구회 회원]/n방어는 좀 복잡해서…/n다른 사람이 설명해 줄 것입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/102"
msgid "[전술연구회 회원]/n방어에 대해 설명드리지요./n공격이 성공하고, 적의 공격력이 결정되면, 이번에는 방어의 여부가 결정됩니다. 방어의 여부를 결정짓는 확률 변수인 방어율은 방어자가 장착한 무기가 갖고 있지요. 방어가 실패하게 되면, 적의 공격을 그대로 맞게 되고, 성공하면 무기 방어 계산에 들어갑니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/103"
msgid ""
"[전술연구회 회원]/n방어에 성공하면, 일단 적의 공격력에서 방어자 무기의 방어력의 /3c퍼센트/5c만큼을 뺀 공격력이 방어자의 무기에 적용됩니다. 그 적용된 공격력이 방어자 무기의 한계력보다 낮을 경우는 적의 공격력은 방어자에게 아무런 영향을 미치지 못합니다. 즉, HP가 변화가 없습"
"니다. 예를 들어, 적의 공격력이 1000인데 내 무기의 방어력이 30이면 1000에서 30퍼센트를 뺀 700이 내 무기에 맞게 되지요. 만약 내 무기의 한계력이 800이라면 저는 아무 피해없이 넘어갑니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/104"
msgid ""
"[전술연구회 회원]/n그런데, 방어자의 무기에 적용된 공격력이 그 무기의 한계력보다 크면 적의 공격력은 내 무기를 뚫고 들어오게 됩니다. 그렇게 적의 공격력이 방어자 무기를 뚫고 들어오게 되면 방어 무기의 내구도가 1 감소되고 (만약, 방어 무기 내구도가 0이 되면 무기가 부서져서 없어"
"집니다.) 방어 무기에 적용된 공격력에서 방어 무기의 한계력을 뺀 피해가 방어자에게 적용됩니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/105"
msgid ""
"[마법연구회 회원]/n마법에 대해 알고싶습니까?/n마법 공격력은 해당 마법의 공격력과 마법을 쓰는 사람의 지력에 의해 결정되게 되는데, 중요한 요소는 지력이지요. 지력에 따라 같은 마법도 개인에 따라 상당한 공격력의 차이를 보이게 됩니다. 물론, 해당 마법을 쓰기 위한 최소한의 지력도 "
"있어서, 지력이 오르지 못하면 쓸 수 없기도 하지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/106"
msgid "[마법연구회 회원]/n마법은 전부 자신의 고유 속성을 갖고 있습니다. 화염, 전격, 물, 암흑, 빛의 5가지 속성을 갖고 있는데, 적 몬스터가 역시 그 5가지 속성중 하나를 갖고 있는 경우에는 피해 계산이 약간 달라지게 됩니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/107"
msgid "[마법연구회 회원]/n단, 마법은 MP가 없으면 당연히 쓸 수 없습니다./n사람에 따라 MP가 절대로 오를 수 없는 사람도 있지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/108"
msgid "- 제국학술원 사이럽스 지부 -"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/109"
msgid "- 사이럽스 시티 안내 -/n그라나다 상단 : 시티 서부/n시장관저 : 시티 서부"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/110"
msgid "[검 연구회 회원]/n공격과 방어에 대해서는 확실히 이해하셨나요?/n그렇다면 검의 종류에 대해서 약간 알려드릴께요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/111"
msgid "[검 연구회 회원]/n검은 4종류로 나뉘는데 그중 세검과 중검이라는 종류가 상당히 중요합니다. 세검은 강한 공격력 대신 방어력이 약하고 쉽게 부서지기 때문에 레벨이 낮을 때 사용하는 것은 위험하지요. 적을 죽이기도 쉽지만 그만큼 자신도 빨리 내구도가 소모되고, 유지비가 많이 들어가기 때문이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/112"
msgid "[검 연구회 회원]/n중검의 경우는 방어력이 높고 쉽게 파괴되지 않는 대신에 공격력이 낮은 단점이 있지요. 하지만, 중검을 하나쯤 들고 다니지 않으면 세검이 다 부서졌을 때 전투를 진행할 수 없게 될 수도 있죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy02
msgctxt "field|re|art_fltcy02|@kfltcy02/113"
msgid "- 종류에 따른 검의 분류 -/n세검 : 스틸레토, 레이피어, 샤벨/n중검 : 그라디우스, 소드브레이커/n/n제국학술원 산하 검 연구회"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/000"
msgid "큰일났어요. 미인박명이라는데…/n저 오래 못살면 어떻게 하죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/001"
msgid "이곳에서 게이시르 시티로 가기/n위해서는 사막을 건너야 해요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/002"
msgid "사막은 피부 미용에 안 좋거든요,/n그래서 저는 게이시르로 갈 수가 없네요, 호호호"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/003"
msgid "안녕하십니까, 날씨 참 좋지 않습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/004"
msgid "가끔 가다 비라도 오면 좋을텐데…/n왜 이리 날씨는 항상 똑같은지 모르겠어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/005"
msgid "아아… 찢어지게 파란하늘과 흐드러지게 핀 구름을 보시오…/n로우엔의 유성검과 같이 맑은 저 하늘은 나를 울리는 구나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/006"
msgid "사이럽스는 제국의 각종 소식과 팬드래건의 각종 소식이/n한꺼번에 들어오는 곳이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/007"
msgid "특히 그라나다 상단은 취급하는 물건의 다양함으로 유명하죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/008"
msgid "가끔 가다 이상한 물건을 들여 놓기도 하는데,/n상점에서는 안 판다고 하더군요. 따로 구해야 해요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/009"
msgid "이곳 사이럽스에도 참 오랜만에 들러보는군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/010"
msgid "뒤에 보이는 것이 제국 최대의 상점인 그라나다요. 정말 크지. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/011"
msgid "그라나다에는 없는 것이 없다는 말도 있지만,/n실제로 그것은 '여러 가지' 의미를 갖고 있지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/012"
msgid "며칠 전에 정말로 이쁜 언니를 본 적이 있어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/012_2"
msgid "며칠 전에 정말로 이쁜 누나를 본 적이 있어. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/012_3"
msgid "며칠 전에 정말로 이쁜 누나를 본 적이 있어. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/013"
msgid "머리는 파랗고, 눈도 파랗고, 피부는 하얀…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/014"
msgid "지금 주점에 있는 루스 씨의/n젊은 시절 사진을 보는 듯 했다니까요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/014_2"
msgid "나도 크면 그런 미인이 되어야지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/014_3"
msgid "나도 크면 그런 미인이 되어야지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/015"
msgid "어? 당신 머리 위에 이상한 안개가…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/016"
msgid "아무래도 악운이 있는 것 같은데요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/017"
msgid "악운을 제거하려면 로우엔으로 가 보세요./n그곳에 산다는 이상한 점쟁이 할머니가/n당신의 운세를 봐줄 거에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/018"
msgid "보물섬에 대한 전설을 들어 본 적이 있습니까?/n전설의 해적 '키드'가 숨겨놓았다고 하는데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/019"
msgid "그곳에 묻힌 보석의 양은 상상을 초월한다고 하더군요./n그곳만 갈 수 있다면…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/020"
msgid "난 이런 항구도시가 싫어요. 천하고, 난잡해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/021"
msgid "제 친구 한 명이 리브레빌로 이사갔다는데,/n그곳은 굉장히 살기 좋다는 연락이 왔었답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/022"
msgid "지금 주점에 있는 루스 씨가 시장이된다면/n우리 도시도 리브레빌 만큼 살기 좋은 곳이 될 수 있을까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/022_2"
msgid "그 애 집이 조금 이상한 집안이기는 했지만…/n리브레빌에 가게되면 안부좀 전해주실래요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/022_3"
msgid "그 애 집이 조금 이상한 집안이기는 했지만…/n리브레빌에 가게되면 안부좀 전해주실래요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/023"
msgid "대륙 내부에서는 제피르 팰컨이라는/n도둑 떼가 극성이라고 하던데요? "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/024"
msgid "그렇지 않아도 살기 힘든 세상인데… 큰일이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/025"
msgid "이 주점 안에 있는 루스 씨가 시장이 되면/n치안이 조금 더 괜찮아 질까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/025_2"
msgid "도대체 귀족들은 돈도 많으면서/n사람들의 안전을 지킬 생각은 없는 것일까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/025_3"
msgid "도대체 귀족들은 돈도 많으면서/n사람들의 안전을 지킬 생각은 없는 것일까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/026"
msgid "내 친구 제인은 지금 카라카스라는/n내륙의 시골 마을에 가 있어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/027"
msgid "어머니가 사냥꾼이라 항상 그 아이는 혼자였어요./n지금은 잘 있을지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/028"
msgid "그녀가 보고 싶어요… "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/029"
msgid "아버지를 따라서 로우엔이라는 곳에 가본 적이 있어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/030"
msgid "굉장히 먼 곳이었는데…/n그곳을 가는 도중에 게이시르 시티 근처의 숲에서/n이상한 동굴에 들어간 적이 있어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/031"
msgid "일정 이상은 들어갈 수 없는 동굴이었어요./n다음 번에 가면 꼭 마저 탐험을 해 봐야지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/032"
msgid "지난 주에 아파서 수중도시로 가는 소풍에 가지 못했어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/033"
msgid "존이 거기서 저한테 고백할 생각이었다는 것을/n다른 아이를 통해 들었어요. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/034"
msgid "너무나 안타깝고 원통해요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/035"
msgid "상당히 맑은 하늘이군./n이런 날이라면 폭풍도까지도 문제 없겠는걸."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/036"
msgid "폭풍도에 대한 전설은 들어 본 적이 있겠지?/n그곳에 박혀있는 아수라 검을 뽑으면/n제국의 지배자가 될 수 있다는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/037"
msgid "그렇지만 폭풍도 근처는 워낙 물살이 세고/n기상 변화가 심해서 쉽게 접근하기가 어려워."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/038"
msgid "폭풍도에 가는 배가 있다면/n개인이 자신의 배로 가던지,/n아니면 팬드래건의 연락선 뿐입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/039"
msgid "팬드래건의 연락선이요?/n그야 당연히 라시드 대왕이 보내는 보급물자 아니겠소?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/040"
msgid "폭풍도를 넘어서 더 멀리 가면/n보물섬으로 가는 항로를 볼 수 있다는 전설이 있죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/041"
msgid "내 친구중에 파즈라는 사람이 있어요./n그 사람을 찾으면 당신들에게 많은 도움을 줄 것입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/042"
msgid "그는 전직 검사였지만 칼 쓰는 실력보다는/n칼을 수리하는 실력이 더 뛰어나요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/043"
msgid "당신들도 보아하니 검사 같으니…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/044"
msgid "항로가 평화롭지 않은 이상/n사이럽스의 발전은 제한적일 수 밖에 없어./n이거 문제야…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/045"
msgid "사이럽스 시티"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/046"
msgid "이곳은 이 사이럽스 최고의 주점이지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/047"
msgid "우리 집의 술 맛은 투르족 놈들이라도/n이곳을 잊지 못하게 만들 정도라고!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/048"
msgid "선원 놈들은 제 정신이 박힌 놈들이 없다니까!/n이놈이고 저놈이고 흘끔흘끔 보기나 하고!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/049"
msgid "흥, 그래도 꼴에 보는 눈은 있어서…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/050"
msgid "여자들이란 얼마나 콧대가 높은 존재들인지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/051"
msgid "어서오세요, 이곳은 사이럽스 여관입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/052"
msgid "감사합니다. 편안한 시간 되십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/053"
msgid "다음에는 꼭 이용해 주십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/053_2"
msgid "자지도 않을 거면 묻기는 왜 물어?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/053_3"
msgid "자지도 않을 거면 묻기는 왜 물어?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/054"
msgid "감사합니다. 다음에 또 이용해 주십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/055"
msgid "저는 사이럽스를 통해서 여행을 가려고 한답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/056"
msgid "제 옆 방에 묵고 있는 여자 손님은/n저의 마음에 불을 지르는 군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/057"
msgid "이곳 사이럽스에서는 각양 각색의 사람들이 다 모이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/058"
msgid "우리 여관도 마찬가지고, 우리 여관의 손님들도/n여러 종류의 사람들이 오고 가지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/059"
msgid "이 여관은 저와 저의 남편의 소유지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/060"
msgid "어서오세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/061"
msgid "아버님이 잠시 가게를 비워서/n우리가 대신 가게를 보고 있어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/062"
msgid "물건 값은 정확히 알고 있으니 염려 놓으세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/063"
msgid "이곳 사이럽스에는 예로 부터 유명한 도둑 길드가 있었죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/064"
msgid "요새 같이 사람들 사정이 어려운 시점에서는/n도둑 길드도 힘들답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/065"
msgid "우리는 터미와 터펜스 부부지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/066"
msgid "제피르 팰컨 특수 임무 수행중입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/067"
msgid "특수 임무를 위해서 부부로 위장중이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/068"
msgid "이곳은 무기 상점입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/069"
msgid "우리 부부는 비교적 일찍이 장사에 눈을 떠서,/n이렇게 아미고 백화점에까지 세를 얻을 수 있었죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/070"
msgid "흥… 지들이 아무리 잘났다 하더라도/n결국 이 가게는 내 재산으로 시작한 것이라고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/071"
msgid "흥. 지들이 아무리 잘났다 하더라도/n결국 이 가게는 내 자본금으로 시작한 것이라고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/072"
msgid "여기까지 오는 것도 상당히 힘이 들었었죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/073"
msgid "중반에 우연히 게이시르 숲 용의 굴 근처에서/n기인을 만나서 장사 밑천을 벌 수 있었어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/074"
msgid "특수 임무가 무엇이냐고요? 그것은 비.밀. 이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/075"
msgid "같이 오랫동안 임무를 수행하다 보니 그가 좋아졌어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/076"
msgid "우리 임무는 비밀임무입니다. 알려드릴 수는 없어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/077"
msgid "오랫동안 같은 임무를 수행하다 보니/n점점 그녀가 좋아지더군요./n처음에는 참 호흡도 안 맞았었는데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/078"
msgid "지금은 탐정 일을 하고 있답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/079"
msgid "어떤 어려운 일 같은 것이 있으면 우리에게 맡기세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/080"
msgid "어떻게 그렇게 잘 아느냐고요?/n우리는 사립 탐정 터미와 터팬스 거든요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/081"
msgid "우리 아버지는 터미씨하고 굉장히 친해요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/082"
msgid "하지만 실제적으로 이 여관은/n제 힘으로 세운 것이나 다름없답니다./n바보같은 우리 남편은 문이나 여닫았죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/083"
msgid "하지만 정작 본인은 그걸 몰라요. 자신이 대단한 줄 알죠./n뭐 그렇게 알고 있는다고 제가 손해보는 것도 아니니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/084"
msgid "우리 주인님도 참 이상한 사람이죠./n실제적인 여관의 관리는 안주인님이 하시지만,/n폼을 잡는 것은 주인님이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/085"
msgid "저도 이곳 사이럽스에는 이번이 처음입니다만,/n저렇게 아름다운 여인은 본 적이 없어요. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/086"
msgid "이번 기회를 놓지면 다시 안 오겠죠?/n과감히 나의 마돈나에게 돌진해서 사랑을 쟁취하겠소!/n기다리오 나의 사랑!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/087"
msgid "옆 방에 묵고 있는 젊은 청년은 제법 호감이 가는 사람이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/088"
msgid "저는 이번 여행을 끝으로 다시는/n이 구 제국령에는 돌아오지 않을 생각이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/089"
msgid "그녀들의 콧대를 꺾으려면 무엇이 제일일까!/n돈? 명예? 잘생긴 얼굴?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/090"
msgid "결국 여자들을 감동시키는 것은 아주 작은, 아주 작은 정성./n나는 나의 그녀에게 어떻게 하면 나의 작은 정성을/n보여줄 수 있을지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/091"
msgid "지금 저기 계신 루스 씨 같은 분이 시장이 되서,/n그런 머리에 뭐만 든 녀석들은 다 잡아 가두어야 해요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/091_2"
msgid "뭐, 사실 내 미모면 이런 곳에서/n시중이나 들고 있는게 아깝기는 하죠,/n호호호."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/091_3"
msgid "뭐, 사실 내 미모면 이런 곳에서/n시중이나 들고 있는게 아깝기는 하죠,/n호호호."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/092"
msgid "술 맛의 비결은 정성이지./n최고를 위해서 모든 것을 희생할 수 있는 정성!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/093"
msgid "항구의 평화를 위해서는/n지금의 무제한적인 자유 무역 지대에/n제한을 걸지 않으면 안돼."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/094"
msgid "지나친 자유는 사람을 바보로 만들거든."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/095"
msgid "나는 이 사이럽스의 현 시장인 샤를르다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/096"
msgid "루스따위 어린 놈에게 이 시장자리를 내줄 생각은 없다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/097"
msgid "당신이 이곳 사이럽스의 시장입니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/098"
msgid "[샤를르 시장]/n그렇소만,/15d 무슨 일인가?/35d/n당신도 시장 선거를 앞두고/30d/n루스 따위와 나를 비교하러 왔나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/099"
msgid "시장 선거에는 관심 없소./50d/n다카마행 배의 출항 금지가/25d/n언제쯤 풀릴지 알고 싶을 뿐입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/100"
msgid "[샤를르 시장]/n훗…/45d 출항 금지가 언제 풀리느냐고?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/101"
msgid "항로를 폐쇄하기라도 할 생각입니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/102"
msgid "[샤를르 시장]/n항로 폐쇄라!/40d 그거 괜찮군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/103"
msgid "[샤를르 시장]/n그만 돌아가게./30d/n그 항로에 대해선 더 할 말 없네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/104"
msgid "[루스]/n게이시르 제국의 부흥을 위해!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/105"
msgid "실례지만/30d 루스라는 분을 아십니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/106"
msgid "[루스]/n찾으시는 게 루스 그랜트라면,/30d/n바로 저입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/107"
msgid "음?/35d 당신이 루스…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/108"
msgid "[루스]/n후후,/20d 놀라셨나요?/40d/n사이럽스는 처음이신가 보네요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/109"
msgid "[루스]/n그런데,/15d 저는 무슨 일로 찾으셨지요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/110"
msgid "저는 다카마항으로 가야만 합니다./45d/n그런데 시장이 항로를 금지시켜 버려서…/60d/n혹시 금지령을 풀 방법은 없습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/111"
msgid "[루스]/n어머,/65d 저는 시장 후보이지만/30d 일개 시민일 뿐,/25d/n그럴 권한은 없답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/112"
msgid "아니오./35d/n마을 사람들이 당신에게 기대하는/n모습을 보면 알 수 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/113"
msgid "[루스]/n글쎄요…/85d/n그런데,/25d 당신은 왜 그렇게 다카마항에 가려는 건가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/114"
msgid "그것은…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/115"
msgid "어떤 대답을 하지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/116"
msgid "솔직히 말한다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/117"
msgid "적당히 얼버무린다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/118"
msgid "사실 저는/30d 폭풍도에 있는/10d/n마검 아수라에 볼 일이 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/119"
msgid "[루스]/n마검/30d 아수라…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/120"
msgid "아니요./40d/n검의 힘이 필요한 건 사실이지만,/45d/n명성 따위를 얻으러 가는 건 절대로 아닙니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/121"
msgid "[루스]/n아수라를 찾아/15d 그 섬으로 떠난 사람들은 많았지만,/60d/n무사히 돌아온 사람들은 없다더군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/122"
msgid "그건…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/123"
msgid "[루스]/n상당히 흥미로운 이야기군요./45d/n그런데,/25d 저에게 그런 이야기까지 하셔도 괜찮은가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/124"
msgid "…다카마에 계시는 저희 어머님께서/40d/n위독하다는 연락을 받아서…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/125"
msgid "[루스]/n하하하,/55d 너무 뻔한 거짓말을 하는군요!/50d/n얼굴에 거짓말이라고 쓰여 있는걸요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/125_2"
msgid "아하하하! 당신, 너무 보이는 거짓말을 하는군요!/n얼굴에 거짓말이라고 씌여 있는데, 어떻게 당신을 믿지요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/125_3"
msgid "아하하하! 당신, 너무 보이는 거짓말을 하는군요!/n얼굴에 거짓말이라고 씌여 있는데, 어떻게 당신을 믿지요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/126"
msgid "[루스]/n저는 정직하지 않은 사람과는/45d/n이야기하고 싶지 않습니다./45d/n이만 비켜주시겠어요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/126_2"
msgid "[루스]/n저는 정직하지 않은 사람은 싫어한답니다./n죄송하지만 비켜주시겠어요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/126_3"
msgid "[루스]/n저는 정직하지 않은 사람은 싫어한답니다./n죄송하지만 비켜주시겠어요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/127"
msgid "…루스 씨,/30d 결례를 사과드립니다./45d/n부디 도와주실 수 없겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/128"
msgid "[루스]/n진실되지 못한 사람에게/50d/n호의를 베풀 이유는 없답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/129"
msgid "상대의 선의를 기대할 때는,/45d/n스스로 진실해야 한다고 생각했습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/130"
msgid "[루스]/n후후,/35d 좋아요./40d/n당신의 진심은 전해졌으니,/40d 저도 보답을 해야겠지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/131"
msgid "그럼…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/132"
msgid "[루스]/n도움을 드리도록 할테니,/30d 부두에서 뵙지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/133"
msgid "…사실을 말씀드리면,/50d 저는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/134"
msgid "[루스]/n그런 것이었군요…/75d/n그런데,/25d 그런 이야기를 저에게 하셔도 괜찮은가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/135"
msgid "이미 한번 거짓을 말해 결례를 범했는데,/55d/n또 그런 실수를 할 순 없으니까요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/136"
msgid "[루스]/n후후,/65d 자신의 잘못을 인정하는 사람./70d/n싫진 않아요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/137"
msgid "정말입니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/138"
msgid "[루스]/n당신의 진심이 전해졌으니,/30d 저도 진실로 답해야죠./45d/n물론/20d 전 어느 공자님과는 달리/25d 거짓말을 말하지는/n않는답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/139"
msgid "나는 다카마항으로 가야한다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/140"
msgid "[ 캐시 ]/n어머, 어서오세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/141"
msgid "사이럽스 잡화상"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/142"
msgid "이용해 주셔서 고마워요. 감사합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/143"
msgid "어서오세요./n이곳은 사이럽스 상점입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/144"
msgid "무기상점 '칼날'"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/145"
msgid "안녕히 가세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/146"
msgid "이 집은 아무도 안 사는 것 같은데…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/147"
msgid "아직 포기하기엔 이르다./45d/n다시 한 번 루스 씨와 이야기를 해 보자."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/148"
msgid "루스라는 사람을 찾아 보아야 할 것 같군…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/149"
msgid "여기가 시장 관저인가…/60d/n샤를르 시장은 별로 평판이 좋지 않은 것 같은데."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/150"
msgid "주로 주점에 있는 루스 씨 도/n언젠가 그 보물섬에 대한 이야기를 하더군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/151"
msgid "사이럽스 시장관저"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/153"
msgid "[루스]/n명성이 목적이 아니라면,/40d/n무엇을 위해서 그런 위험을 무릅쓰려는 것이지요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/155"
msgid "[루스]/n저를 처음 보는 사람은,/30d/n저 샤를르 시장에 맞서는 사람이/n/25d여자라는 것에/20d놀라곤 하죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/156"
msgid "[샤를르 시장]/n그 항로는/10d 해적이 출몰하는 위험한 항로라,/40d/n당분간 출항 금지라네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/157"
msgid "[샤를르 시장]/n어차피 다카마항은/15d 최악의 경제 상황이고 하니,/50d/n그 쪽과의 무역에서 우리가 얻을 것도 없으니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/159"
msgid "분명 당신이라면/35d/n나를 도와줄 방법이 있지 않겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/161"
msgid "그를 위해/30d 다카마항에서 폭풍도로 가는 배를 타야하죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/162"
msgid "[루스]/n음…/30d 알겠어요./50d 도움을 드리겠습니다./30d/n부두에서 뵙도록 하죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltcy03
msgctxt "field|re|art_fltcy03|@kfltcy03/165"
msgid "[루스]/n당신도 검의 위력을 빌려/45d/n헛된 명성을 좇으려는 사람인가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda01
msgctxt "field|re|art_fltda01|@kfltda01/000"
msgid "이곳은 다카마항, 대 팬드래건 왕국의 무역항입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda01
msgctxt "field|re|art_fltda01|@kfltda01/000_2"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda01
msgctxt "field|re|art_fltda01|@kfltda01/000_3"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda01
msgctxt "field|re|art_fltda01|@kfltda01/001"
msgid "당신같은 외국인은 도시 내부로는 들어갈 수 없을 것입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda01
msgctxt "field|re|art_fltda01|@kfltda01/002"
msgid "이번 항해에는 해적이나 폭풍을 만나지 말아야 할 텐데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda01
msgctxt "field|re|art_fltda01|@kfltda01/003"
msgid "[ 선장 ]/n흠… 무슨 일이지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda01
msgctxt "field|re|art_fltda01|@kfltda01/004"
msgid "이곳에서 다카마로 가는 배를 탈 수 있다고 들었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda01
msgctxt "field|re|art_fltda01|@kfltda01/005"
msgid "[ 선장 ]/n흠… 무슨 일이지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda01
msgctxt "field|re|art_fltda01|@kfltda01/006"
msgid "[ 선장 ]/n그렇소. 그렇지만 요새 다카마로 가는 항로는/n대단히 위험하기 때문에 우리도/n출항을 연기하고 있는 상황이오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda01
msgctxt "field|re|art_fltda01|@kfltda01/007"
msgid "출항 연기… 라고요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda01
msgctxt "field|re|art_fltda01|@kfltda01/008"
msgid "[ 선장 ]/n 그렇소 우리도 지금으로서는 언제 출항을 할 수 있을지 의문이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda01
msgctxt "field|re|art_fltda01|@kfltda01/009"
msgid "그런… "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda01
msgctxt "field|re|art_fltda01|@kfltda01/010"
msgid "다카마항, 부두"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/000"
msgid "이곳까지가 자유무역지대입니다./n허가증이 없으면 나갈 수 없습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/001"
msgid "이곳까지가 자유무역지대입니다./n허가증이 없으면 나갈 수 없습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/002"
msgid "이곳까지가 자유무역지대입니다./n허가증이 없으면 나갈 수 없습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/003"
msgid "요새 같은 불경기는 살다 살다 처음 보았소./n지금 문 연 가게는 거의 없지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/004"
msgid "이게 다 정책적인 실패 때문이야./n그놈의 투르족 놈들 때문에/n도저히 장사를 할 수가 없다고!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/005"
msgid "바보같은 중앙의 관리들과 귀족 놈들/n때문에 될 일도 안된다니까!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/006"
msgid "지금의 어려움은 일시적인 현상에 불과해./n그렇게까지 흥분할 필요 없다고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/007"
msgid "이 꼬마 녀석이 도대체 어디 간 거지?/n감히 숙녀의 엉덩이를 치고 도망가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/008"
msgid "내 손에 잡히기만 해 봐라,/n다시는 그딴 짓 못하도록 혼찌검을 내줄 테다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/009"
msgid "아악! 지독한 누나 같으니라고!/n정말 지겹게도 쫓아다니시는군!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/010"
msgid "세상 모든 여자가 다 저 따위라면/n정말 세상 어떻게 살아갈 수 있을까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/011"
msgid "누가 저 누나 좀 말려주어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/012"
msgid "흥… 이곳이 과연 최고의 항구 다카마 지역이란 말인가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/013"
msgid "가게란 가게는 다 문을 닫고 우리는 하늘만/n쳐다보며 사는 이 시점은 도대체 무엇이야?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/014"
msgid "이곳 저곳 떠돌아 다니는 행상들은/n언젠가 정착할 그날들을 기다리며 살아가죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/015"
msgid "그렇지만 재미있는 것은 정작 정착할 수 있게 되면/n그들은 얼마 못 견디고 떠나버리게 되죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/016"
msgid "역마살이라고나 할까요…/n저희 아버님도 같은 운명이었죠./n지금은 어느 곳에 계실지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/017"
msgid "라시드 대왕의 손자인 라시드 3세는/n아직도 궁에 없다더군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/018"
msgid "이번에는 상당히 오랫동안 궁을 비울 생각인가 봐요./n하기사, 그런 복잡한 문제에 얽매어 있으면/n아무리 궁전에 머물러도 가시방석 같겠지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/019"
msgid "그렇지만 그의 검은 머리는 정말로 매력적인 포인트인데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/020"
msgid "지금은 성스런 안식 주간입니다./n예배당은 문을 열지 않아요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/021"
msgid "흥… 이곳이 과연 최고의 항구 다카마 지역이란 말인가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/022"
msgid "이게 다 정책적인 실패 때문이야./n그놈의 투르족 놈들 때문에/n도저히 장사를 할 수가 없다고!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/023"
msgid "자신이 현재 할 수 있는 일에 최선을 다하는 것이/n가장 중요해요. 미래는 아무도 모르는 것이니까요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/024"
msgid "현재 이곳에서 할 수 있는 일이/n대단히 제한되어 있다 하더라도,/n열심히 찾아보면 무엇인가가 더 있지 않겠어요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/025"
msgid "우리 여관에 오신 것을 환영합니다./n우리 여관의 숙박료는 100 ELD입니다./n숙박하시겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/025_2"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/025_3"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/026"
msgid "감사합니다. 편안히 쉬다 가시기 바랍니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/027"
msgid "경기도 어려운데, 이런 손님만 늘면 곤란해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/028"
msgid "감사합니다. 다음에 또 오십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/029"
msgid "우리 주인은 괴물 할아버지요./n그 나이에 새벽 4시에 일어났다가 자정까지 일한다니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/030"
msgid "주인이 열심이면 결국 피곤해지는 것은 종업원이야…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/031"
msgid "…정말이지 가끔은 주인 영감이 어떻게/n되어 버렸으면 하는 생각이 든다니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/032"
msgid "나는 비프로스트의 학자입니다./n이곳 다카마는 자료 조사차 와 있지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/033"
msgid "하필 시간을 내서 자료 조사를 하러 오니까/n이렇게 경기가 경직되어 있어서…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/034"
msgid "뭐, 자료 조사하는데에 문제야 없겠지만,/n사람이 밥만 먹고 사는 것도 아니고,/n이거 도대체 자료 조사 외에는 아무것도 할 수 없으니…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/035"
msgid "난 커티스의 장교요./n이곳에는 연락할 사람이 있어서 왔지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/036"
msgid "자세한 것은 군사 기밀이라 가르쳐 줄 수 없소만,/n투르 제국과의 싸움에 결정적인 도움을 줄 수 있는 정보요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/037"
msgid "며칠 정도 머무르다가 통행증이 나오면/n팬드래건의 수도로 곧장 갈 생각이오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/038"
msgid "나는 귀화한 투르족 마법사요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/039"
msgid "이제 귀화한지 1년이 다 되가오. 1년이 지나면/n팬드래건 내로 들어갈 수 있는 허가증이 나오지. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/040"
msgid "왜 투르족을 버리고 팬드래건으로 귀화했느냐고?/n사랑을 위해서요. 나는 그녀를 위해서는/n목숨도 버릴 수 있거늘, 하물며 국적이야…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/041"
msgid "이곳은 액세서리 상점입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/042"
msgid "이곳은 세계 최고의 악세사리 상점이야!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/043"
msgid "난 평생을 이곳에서 일했어./n돈도 꽤 모았고, 이제 손녀딸에게/n이 가게를 물려주려고 하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/044"
msgid "하지만, 역시 여자 혼자서 가게를 운영하는 것은 어려워./n손녀딸의 남편감을 찾아야 하는데…/n어디 좋은 남자 없을까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/045"
msgid "할아버지는 왜 언니를 그렇게 시집보내지 못해 안달인 거지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/046"
msgid "이곳까지가 자유무역지대입니다./n허가증이 없으면 나갈 수 없습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/047"
msgid "라시드 대왕이 매년 폭풍도로/n연락선을 보내는 이유는 무엇일까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/047_2"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/047_3"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/048"
msgid "실례합니다./35d/n혹시 폭풍도에 대해 알고 계십니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/049"
msgid "폭풍도라고?/n자네는 누군데 그곳에 관심을 가지는 것이지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/050"
msgid "폭풍도라고?/45d/n왜 그런 곳에 관심을 가지시오?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/050_2"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/050_3"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/051"
msgid "저는 어떻게든/30d 그곳에 가야 할 이유가 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/052"
msgid "수십 년 전만 해도/30d 헛된 꿈을 품고/30d/n그 섬을 찾아간 사람이 꽤나 있었지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/053"
msgid "아직도 그런 사람이 있을 줄이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/053_2"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/053_3"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/054"
msgid "잘은 모르지만,/30d 팬드래건 왕실에서/35d 가끔씩 그 섬으로/25d/n연락선을 보내고 있다고 하더군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/054_2"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/054_3"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/055"
msgid "곧 출항하는 배가 있는 것 같던데,/40d/n한번 알아보시게."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/056"
msgid "안녕하세요, 무엇을 찾으십니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/057"
msgid "잡화점 '드래건 브레스'"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/058"
msgid "저희 상점을 이용해 주셔서 감사합니다. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/059"
msgid "여관에 있는 아저씨는 옛날 이야기를/n상당히 많이 알고 있어요. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/059_2"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/059_3"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/060"
msgid "가끔가다 그 아저씨한테서 이 이야기/n저 이야기 많이 듣고는 한답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/060_2"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/060_3"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/061"
msgid "이곳은 문이 잠긴 것 같군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/061_2"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/061_3"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/062"
msgid "이곳까지가 자유무역지대입니다./n허가증이 없으면 나갈 수 없습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/063"
msgid "이번에는 상당히 오랫동안 궁을 비울 생각인가 봐요./n하기사, 그런 복잡한 문제에 얽매어 있으면/n아무리 궁전에 머물러도 가시방석 같겠지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltda02
msgctxt "field|re|art_fltda02|@kfltda02/064"
msgid "그분은 전에는 이곳 저곳을 돌아다니는/n음유시인이었다고 하더군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/000"
msgid "파로 마을"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/001"
msgid "이곳은 파로 마을이에요./n지리적으로는 게이시르 시티에 가까운 편이지만,/n문화적으로는 많은 차이가 있지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/001_3"
msgid "이곳은 파로마을이에요./n지리적으로는 게이시르 시티에 가까운 편이지만,/n문화적으로는 많은 차이가 있지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/002"
msgid "우리 마을은 시끄러운 외부와는 달리/n평화롭고 조용한 곳이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/002_3"
msgid "우리마을은 평화롭고 조용하게 살아오는 것을/n미덕으로 알고 있었죠. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/003"
msgid "정말 끔찍한 일이에요./n마을 제일의 호남자인 그가 정신병에 걸리다니…/n더군다나 약혼자도 있는데."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/004"
msgid "이곳은 상당히 외진 마을이라 사람들의 발걸음이 뜸해요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/005"
msgid "그런데 얼마전에 외부에서 요리사 한 명이 이사왔어요. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/006"
msgid "고급 요리에 쓰일 신선한 재료를 찾고 있는데/n이곳이 깨끗해서 맘에 들었다나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/006_3"
msgid "고급 요리에 쓰일 신선한 재료를 찾고 있는데/n이곳이 깨끗해서 맘에 들었다나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/007"
msgid "전에 한번 게이시르 시티에 초대받아 가본 적이 있어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/008"
msgid "눈이 빙빙 돌아가도록 넓은 길과 아름다운 건물,/n멋진 사람들이 사는 곳이었지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/009"
msgid "이런 시골 마을에서 사는 것 보다 훨씬 더 멋질 거에요./n도시에서 사는 것은…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/010"
msgid "우리 마을은 너무 작아서 영주도 신경을 쓰지 않지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/011"
msgid "후후…덕택에 자유롭게 잘 살고 있어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/012"
msgid "게이시르 시티? 훗, 도시 생활이란 허상이지./n그곳은 겉으로만 화려할 뿐 실제적인 자유는 없어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/012_3"
msgid "게이시르 시티? 흣, 도시 생활이란 허상이지./n그곳은 겉으로만 화려할 뿐 실제적인 자유는 없어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/013"
msgid "역시 제 말이 옳았다니까요./n그 약혼은 잘못된 것이었다고요!/n그 집안은 아주 결혼을 시키지 말았어야 정상이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/013_3"
msgid "역시 제 말이 옳았다니까요,/n그 약혼은 잘못된 것이었다고요!/n그 집안은 아주 결혼을 시키지 말았어야 정상이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/014"
msgid "브리앙 씨에겐 미안한 말이지만,/n결국 결과는 양쪽이 다 불행해 지는 것이/n되고 말았잖아요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/014_3"
msgid "휴 씨에겐 미안한 말이지만,/n결국 결과는 양쪽이 다 불행해 지는 것이 되고 말았잖아요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/015"
msgid "그 집안은 저주받은 집안이에요…/n아무리 그 집안이 파로 최고의 부자 집안이라고 해도,/n우리 마을의 평화와는 관련이 없는 집안이라고요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/015_3"
msgid "웨어링 집안은 파로 마을의 제일 부자이지만,/n집안 자체는 굉장히 불행하지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/016"
msgid "우리 마을의 영주님은 아이들을 정말 좋아하시나 봐요./n영주님 집 안에는 상당히 많은 아이들이 있답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/017"
msgid "하지만, 이상하게도 다 여자아이들 뿐이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/018"
msgid "영주님은 꽃도 좋아하셔서,/n정원에는 꽃이 대단히 많다고 해요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/018_3"
msgid "아, 내 친구중에 한명이 마치 여자애 같이 이쁜 아이가 있었는데,/n그애도 지금은 영주님 집에 가 있어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/019"
msgid "나, 샤론의 공연을 본 적이 있어요./n춤도 잘 추고, 정말 예쁘고 멋진 언니였어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/019_3"
msgid "나도 샤론의 공연을 본 적이 있어요./n정말 이쁜 누나였어요… 춤도 잘 추고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/020"
msgid "꼭 사인을 받고 싶었는데…/n오빠들이 다 새치기하는 바람에 못 받았지 뭐예요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/020_3"
msgid "그 누나의 사인을 받고 싶었는데,/n오빠들이 다 새치기 하는 바람에 하나도 못 받았어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/021"
msgid "혹시, 샤론을 만나게 된다면/n저 대신 사인을 받아다 주실 수 없을까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/021_3"
msgid "혹시, 샤론을 만나시면/n사인 하나만 받아다 주실 수 있어요? "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/022"
msgid "[댄 웨어링]/n우리 집안은 저주받은 집안이지./15d/n나는 아들의 결혼을 반대하고 있었어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/022_3"
msgid "[ 찰스 웨어링 ]/n우리 집안은 저주받은 집안이지./n나는 아들의 결혼을 반대하고 있었어. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/023"
msgid "[댄 웨어링] /n최근 일련의 사건으로 아들놈도/n우리 집안의 피를 깨달은 모양이야./10d 클클클…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/023_3"
msgid "[ 찰스 웨어링 ] /n최근 일련의 사건으로 아들놈도/n우리집안의 피를 깨달은 모양이야. 클클클…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/024"
msgid "[댄 웨어링] /n이것으로 이 저주받은 집안의 대도 끊기는 거야…/n/10d쿡쿡쿡…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/024_3"
msgid "[ 찰스 웨어링 ] /n이것으로 이 저주받은 집안의 대도 끊기는 거야…/n쿡쿡쿡…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/025"
msgid "[브리앙 웨어링]/n난 끝났어요. 내 손으로 그런 끔찍한 짓을 하다니…/20d/n결혼?/10d 그런 희망을 품은 내가 바보지!/15d 하하하!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/025_3"
msgid "[ 휴 웨어링 ]/n난 끝났어요. 내 손으로 그런 끔찍한 짓을 하다니…/n결혼? 그런 희망을 품은 내가 바보지! 하하하!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/026"
msgid "[브리앙 웨어링]/n위로의 말 따위는 필요없어./n나를 설득시키려고 하지도 마./20d/n나에게 남은것은 단지 죽음뿐…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/026_3"
msgid "[ 찰스 ] /n위로의 말 따위는 필요없어./n나를 설득시키려고 하지도마./n나에게 남은것은 단지 죽음뿐…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/027"
msgid "[다이아나] /n아니에요, 그가 미쳤을 리가 없어요./n정말이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/027_3"
msgid "[ 다이아나 ] /n말도 안돼요,/n어제까지 멀쩡하던 사람이 갑자기 정신병이라면서 파혼이라니!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/028"
msgid "[다이아나] /n이건, 무엇인가 잘못되어 있어요…/20d/n브리앙은 무엇인가를 착각하고 있는 거라고요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/028_3"
msgid "[ 다이아나 ] /n이건, 무엇인가 잘못되어 있어요./n휴는 무엇인가를 착각하고 있는 거라고요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/029"
msgid "[다이아나]/n이건 현실이 아니야…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/029_3"
msgid "[ 다이아나 ]/n이건 사실이 아니야. 분명히…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/030"
msgid "[헤이슨]/n나는 댄 하고는 오랜 친구인/n헤이슨 이라고 하오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/030_3"
msgid "[ 프로비셔 ]/n나는 다이아나의 아버지 되는 사람이요./n찰스하고는 오랜 친구사이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/031"
msgid "[헤이슨]/n친구의 아들이 불행해지는 것을 막기 위해/n다이아나 씨를 설득하려고 합니다만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/031_3"
msgid "[ 프로비셔 ]/n 아버지가 된 입장으로서는/n딸이 불행하게 되는것은 차마 눈 뜨고 볼 수가 없소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/032"
msgid "[헤이슨]/n그렇지만, 그녀는 계속해서 막무가내군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/032_3"
msgid "[ 프로비셔 ]/n그렇지만, 지금으로서는 곤란하오./n딸이 결혼을 해도, 결혼을 하지 않아도 불행해질 것 같구려."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/033"
msgid "이상한 것은, 요즘에는 샤론이라는 가수의 소식이/n전혀 들려오지 않고 있다는 것이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/034"
msgid "상당히 팬도 많고, 인기도 있는 가수인데,/n왜 갑자기 소식이 없어진 것이지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/035"
msgid "더 충격적인 것은 그 조각들이/n휴 씨의 방 안의 자루에서 발견되었다는 거에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/035_3"
msgid "더 충격적인 것은 그 떨어저 나간 것들이/n휴 씨의 방 안의 자루에서 발견되었다는 거에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/036"
msgid "어서오세요./n우리집은 다른 것은 몰라도 양은 많이 드립니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/037"
msgid "팬드래건의 왕위계승 서열 1위인 라시드 3세는/n도대체 어디로 가서 숨어버린 것일까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/037_3"
msgid "팬드래건의 왕위계승 서열 3위인 라시드 3세는/n도대체 어디로 가서 숨어버린 것일까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/038"
msgid "뭐, 라시드 대왕이 워낙 정정하니/n쉽게 왕위를 물려받지도 못하겠지만…/n언제고 우리집에 오면/n서비스 안주를 많이 줄 용의가 있는데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/038_3"
msgid "뭐, 라시드 대왕이 워낙 장수하고 있으니 쉽게 왕위를 물려받지도 못하겠지만…/n언제고 우리집에 오면 서비스 안주를 많이 줄 용의가 있는데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/039"
msgid "이 근처에 있는 카라카스라는 곳에는/n내 동생 카그가 요리점을 경영하고 있지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/039_3"
msgid "이 근처에있는 카라카스 라는 곳에는/n내 동생인 카그가 요리점을 경영하고 있지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/040"
msgid "그 녀석, 솜씨는 좋지만/n지나치게 완벽주의자인 것이 문제야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/040_3"
msgid "그 녀석은 솜씨는 좋은데 지나치게 완벽주의자인 것이 문제야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/041"
msgid "틈만 나면 나한테도 좋은 재료를 구해달라고 성화라니까./n허허…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/041_3"
msgid "그 놈은 틈만 나면 나한테도/n좋은 재료를 구해달라고 성화라니까. 허허…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/042"
msgid "호호호…/n당신은 과연 근시일내에 제국을 장악할 패자가/n등장할 수 있을거라 생각하나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/042_3"
msgid "호호호…/n당신은 과연 제국에 패자가 등장 할 수 있을거라 생각하나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/043"
msgid "제국의 패자가 되기 위해서는,/n체사레 보르자를 제압할 만한 세력이/n있어야 하지 않을까요? "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/044"
msgid "제국의 패자를 결정한다는 아수라 검을/n누군가가 뽑았다는 소문이지만…/n어디까지나 소문은 소문일 뿐 아니겠어요? 호호호"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/045"
msgid "어서오십시오. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/046"
msgid "지난번 공연에서 샤론의 사인을 얻어왔어요./n훗훗훗… 우리 마을에서는 저만이 갖고 있지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/047"
msgid "이건 아무리 많은 돈을 주어도 팔지 않을 거에요./15d/n우리집 가보로 물려줄 거라구요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/047_3"
msgid "이건 아무리 많은 돈을 주어도 팔지 않을 거에요./n우리집 가보로 물려줄 거라고요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/048"
msgid "흠…/n아주 좋은 물건을 가져 온다면 생각해 보겠지만…/n예를 들어 아스모데우스의 파편이라던지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/048_3"
msgid "흠… 아주 좋은 물건을 가져 온다면 생각해 보겠지만…/n예를 들어 아스모데우스의 파편이라던지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/049"
msgid "다이아나는 마을 최고의 미인이죠./n마을 전체 남성들의 선망의 대상이 된."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/050"
msgid "그런 그녀가 또한 마을 여자 전체의 선망의 대상이었던/n브리앙 하고 결혼한다고 발표를 했을 때/n얼마나 말이 많았었는지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/050_3"
msgid "그런 그녀가 또한 마을 여자 전체의/n선망의 대상이었던 휴하고 결혼한다고 발표를 했을 때/n얼마나 많은 말이 있었는지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/051"
msgid "어떻게 보면 누구도 환영하지 않던 약혼이었어요./n본인 둘을 제외하고는…/20d/n질투의 대상이었죠…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/051_3"
msgid "어떻게 보면 누구도 환영하지 않던 약혼이었어요./n본인 둘을 제외하고는. 질투의 대상이었죠…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/052"
msgid "어서오세요./n어떤 물건을 찾으십니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/053"
msgid "파로 약국"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/054"
msgid "저희 상점을 이용해 주셔서 감사합니다./n안녕히 가세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/055"
msgid "아… 아앗!!/n이건 샤론 언니의 사인! 꺄아악!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/055_3"
msgid "어머…/n이건 샤론 언니의 사인! 꺅~~~!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/056"
msgid "이거, 저 주시는 거죠?/n정말 고마워요! 너무 기뻐요!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/056_3"
msgid "이거 저 주시는 거죠? 어머~ 좋아라."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/057"
msgid "대신 저도 뭐 하나 드릴게요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/058"
msgid "얼음의 반지를 손에 넣었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/059"
msgid "전에 숲에서 주운 반지예요! 너무 예쁘죠?/n사인 정말 고마워요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/059_3"
msgid "얼마전에 숲속에서 주은 반지에요! 이쁘죠!/n사인 고마워요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/060"
msgid "이건 내가 얼마 전에/n카라카스 근처 숲에서 구한 사랑의 향초인데,/n진정한 사랑이 싹튼 곳에서만 핀다는 꽃이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/060_3"
msgid "이건 내가 얼마전에 카라카스 근처의 숲에서 얻은/n사랑의 향초일쎄."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/061"
msgid "굉장히 귀한 향초니까,/n잘 보관했다가 동생에게 전해주지 않겠나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/061_3"
msgid "진정한 사랑이 싹 튼 곳에서만 핀다는 꽃인데,/n굉장히 귀한 향초니까 잘 보관했다가 동생주게나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/062"
msgid "사랑의 향초를 얻었다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/063"
msgid "주무시겠어요? 저희 주인님께서는/n집에 찾아온 손님은 접대해 드린답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/064"
msgid "그럼 안녕히 주무세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/065"
msgid "안녕히 가세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/066"
msgid "몸 조심해서 가세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/067"
msgid "[폴]/n이번에 좋은 무기를 하나 입수했어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/068"
msgid "마을 잡화점"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/069"
msgid "그럼, 다음에도 좋은 물건을 드릴께요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/070"
msgid "현상수배 : 로베르토 데 메디치 /n죄목 : 방화, 살인. /n현상금 : 1,000,000 ELD"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/071"
msgid "소녀의 부탁을 받아 샤론의 사인을 받아다 주겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/072"
msgid "샤론을 만난다면 꼭 사인을 받아다 주지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/073"
msgid "미안하지만, 약속할 수는 없겠는데."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/074"
msgid "좋아, 샤론을 만난다면 꼭 사인을 받아다 주지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/075"
msgid "정말이죠? 그럼, 약속한 거예요! 꼭이요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/076"
msgid "미안하지만, 약속할 수는 없겠는데."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/077"
msgid "그리고, 그런 것은 직접 받아야 의미가 있는 거야./n직접 샤론을 찾아보는 게 어떻겠니?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/078"
msgid "그건 그렇지만…/n난 여행하기엔 아직 어리단 말이에요. 힝…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/079"
msgid "고마워요!/n사인 받아다 주신다는 약속 잊으시면 안 돼요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/080"
msgid "아~ 샤론의 사인 갖고 싶다…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/081"
msgid "비록 화려하지는 않지만 평화롭고 잔잔한 삶을/n살고 있다고 자부하고 있답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/082"
msgid "[브리앙 웨어링]/n비켜,  저리 가!/n제발 날 혼자 내버려두란 말이야!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/083"
msgid "그만 둔 것인지, 아니면 어떤 이유가 있는 것인지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/084"
msgid "[브리앙 웨어링]/n그 증세가 처음 발생한 것은 작년 가을이었죠./n마을 축제가 있던 날 저녁, 저는 술에 만취했었습니다./10d/n정신없이 먹고 마시다 정신을 차려보니 집안이었어요./10d/n숙취로 아픈 머리를 식히기 위해서 세면실에 갔었는데,/n제 손에 피가…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/085"
msgid "[브리앙 웨어링]/n저는 제가 어디 다친것이 아닌가 해서/n온 몸을 살펴봤었지만, 전혀 다친곳은 없었어요./n그런데 그 다음날, 우리마을 농장에 늑대가 들어서/n닭과 가축들을 죽이고 달아났다는 이야기를 들었지요./n/10d하지만, 하지만, 전 그게 늑대가 아니라는 것을/n직감했었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/086"
msgid "[브리앙 웨어링]/n처음에는 단순히 무서운 꿈을 꾸었을 뿐이라고/n나 자신을 설득했었지요./n하지만, 이 증세는 그 뒤로도 계속 되었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/087"
msgid "[브리앙 웨어링]/n이제는 잠에서 깨기가 두려워요./n자고 일어나보면 방안이 마구 흩어져 있거나/n제 손이 피로 물들어 있는 것을 발견한 그때는/n정말이지, 정말이지 저 자신이 두려워집니다./n/10d두려워요…/10d 두려워…/n이제는 잠자는 것 자체가 두려워요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/088"
msgid "[브리앙 웨어링]/n결혼! 하, 하하하! 어느날 눈을 떠 보면,/n그때 그 사랑스러운 다이아나를 제손으로…/n안돼, 안돼요, 그것만은 절대로! 난 결혼할 수 없습니다./10d/n이 저주스러운 피가 제 몸속에 흐르는 한, 절대로./n흐…흐흐흐…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/089"
msgid "[댄 웨어링]/n…우리 집안은 전통적으로 정신병이 있지./n과거에 친족혼을 통해 혈통을 보존한 죄의 댓가야…/n이런 씨는 이 세상에서 없어져야 해. 그렇지않나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/090"
msgid "[다이아나]/n브리앙이 미쳤다고요?/n그건 말도 안돼요!/n그는 일년전만 해도 정말이지 아무 이상도 없었다고요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/091"
msgid "[다이아나]/n저와 그는 게이시르 학술원에서 처음 만났죠./n마침 저도 조용한 시골 마을을 찾고 있었기 때문에/n이곳으로 이사온 것이고,/n그와는 여기 온지 일년쯤 뒤에 약혼했어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/092"
msgid "[헤이슨]/n하지만, 다이아나./n원래 미친 사람은 언제나 그런 것이 아니라/n일시적으로 발작이 일어나는 법이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/093"
msgid "[다이아나]/n아니에요, 아니에요! 정말로,/n정말로 그가 정상이 아닌 것이라면/n왜 의사의 진찰도 받으려 하지 않는거죠?/n병이 난 것이면 고칠수 있는 것 아닌가요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/094"
msgid "[헤이슨]/n그건, 고칠 수 있는 병이 아니야./n 그 집안의 유전이지… 다이아나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/095"
msgid "[다이아나]/n그렇지 않아요, 그렇지 않아./n절대 그럴리 없어!/n내가, 내가 고쳐보이겠어요, 그의 병을,/n무슨 수를 써서라도, 내가!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/096"
msgid "웨어링 집안 말인가?/n그 집안은 예로부터 저주받은 집안이지./n그 집안 사람들 치고 정상적으로 죽은 사람이 없다니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/097"
msgid "단적으로, 댄씨의 부모님도 실종되었고,/n댄 씨의 부인은 댄씨와 물놀이를 즐기다가/n보트가 뒤집어지는 사고로/n유명을 달리하지 않았냔 말이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/098"
msgid "댄 씨의 부인이 죽었을 때,/n마을에서는 댄 씨가 부인을 밀어서/n호수에 빠뜨린 것이라는 소문이 퍼졌었지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/099"
msgid "이제는 그 아들인가? 불쌍하게도…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/100"
msgid "그 집안은 정말로 그렇게 유전적으로/n문제가 있는 집안인가 보군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/101"
msgid "그렇다고 볼 수 있겠죠./n하지만 진정한 원인은 그 집안이/n너무 잘 살고 있다는 것이 아닐까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/102"
msgid "너무 잘 살기 때문에/n정신병에 걸렸다는 것인가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/103"
msgid "그렇다기 보다는…/n그 집안은 옛부터 유산과 상속권을 둘러싸고/n갖은 음모가 난무했었지. 그 영향이 아닐까?/n그 집 사람들이 이상한 것은 말이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/104"
msgid "그러고 보니, 전에 브리앙이 댄 씨의 자손이 맞는지/n의문시되었던 적이 있잖아?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/105"
msgid "그렇습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/106"
msgid "그러다 보니, 친족혼으로 분쟁을 줄이려고 했고,/n그러다가 가전의 정신병이 생겼다는 것인가…/n그러고 보면 돈이 많다고 좋은 것은 아닌 것 같아, 정말로."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/107"
msgid "[댄 웨어링]/n난 내 아들놈의 결혼을 처음부터 반대하고 있었어./n결코 안될 말이었지. 큭큭큭…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/108"
msgid "실례합니다./n댄 씨 집을 찾아가려고 하는데,/n무엇을 좀 사다드리려고 합니다./n어떤 것이 좋을까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/109"
msgid "음모가 가득찬 집안이라…/n그 집안에 대한 정보를 조금 더 얻고 싶은데./n다른 사람들이 더 설명해 줄 수 있지 않을까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/110"
msgid "[약국주인]/n아, 댄 웨어링씨 말이지요?/n그 분은 요새 눈이 안 좋으시다면서/n가시독말풀로 만든 약을 복용하시고 계십니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/111"
msgid "[약국주인]/n요새 아드님 일로 정신없으셔서 그런지는 몰라도,/n사실 때가 되었는데도 안 오시더라고요./n사다드리면 좋을 것 같습니다만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/112"
msgid "가시독말풀이라면…/n꽤나 위험한 독약이 아닙니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/113"
msgid "[약국주인]/n괜찮습니다./n그 분은 그 약을 오래 복용하고 계셨기 때문에/n복용량을 잘 알고 계시죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/114"
msgid "그렇습니까…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/115"
msgid "[약국주인]/n잠, 잠깐만요. 약은요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/116"
msgid "아아… 나중에 다시 오지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/117"
msgid "결국… 그가 이 일의 원인이었나./n웨어링씨 댁으로 가 보자…/n이 일은 해결을 봐야겠어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/118"
msgid "실례합니다./n웨어링 집안에 대해서 좀 알고 계십니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/119"
msgid "웨어링 집안이요? 알다마다요! 그 집안은 옛날부터/n말썽이 끊이지 않는 집안이었다니까요./n내 그 집에 레이첼이 시집갈 때 부터 알아봤다니까./n글쎄 그 집안의 결혼은 항상 불안하기만 하지 뭐유,/n이번 결혼만 해도…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/120"
msgid "(그냥 계속 말하게 하면 끝이 없겠군)/n아… 아주머니. 그 레이첼 이란 사람은 누구죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/121"
msgid "레이첼? 댄 씨의 부인 아니유./n사실 그 부인은 헤이슨 씨도 좋아했었지요./n댄 씨와 레이첼이 결혼하자 상심한 헤이슨 씨는/n멀리 여행을 떠나지 않았겠어요./n헤이슨 씨가 돌아온지는 얼마 안된다우./n그런데, 헤이슨 씨가 떠나고 얼마 안 되서/n문제가 발생했지 뭐유."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/122"
msgid "어떤 문제였지요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/123"
msgid "레이첼이 브리앙을 낳았는데/n생각보다 좀 일찍 태어났거든. 사람들은/n브리앙이 정말 댄 씨의 자손이 맞냐고 수근댔었지./n나중에 본인이 공개적으로 그렇다고 밝히기는 했었지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/124"
msgid "사람들은 레이첼과 헤이슨 씨의 관계를 의심하긴 했지만,/n뭐 헤이슨 씨 본인이 없었기 때문에/n결국 흐지부지 되고 말았지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/125"
msgid "뭐, 꼭 그렇기 보다는… 그럴수도 있다는 것 아니겠어요?/n어머, 어머. 내가 초면인 사람을 두고/n못하는 소리가 없지…그럼."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/126"
msgid "재미있군. 광기어린 집안에, 내력은 또 왜 이리 복잡한 거지?/n이렇게 되면 아버지란 사람이 의심가는데…/n좀 더 조사를 해 보자."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/127"
msgid "[브리앙 웨어링]/n이 미치광이에게 볼일이라도 있습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/128"
msgid "미치광이라…/n어떻게 보면 세상 사람들 중 제정신인 사람이 있을까?/n하지만, 자네는 정상이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/129"
msgid "[브리앙 웨어링]/n무슨… 무슨 말입니까, 제가 정상이라니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/130"
msgid "[다이아나]/n브리앙! 난 당신을 버릴 수 없어요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/131"
msgid "[약국주인]/n어서오세요. 무엇을 드릴까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/132"
msgid "이곳이 이 동네 약국이군./n만약, 브리앙 웨어링씨가 인위적으로 이상해진 것이라면,/n이곳에서 단서를 얻을 수 있지 않을까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/133"
msgid "저 잠시 여쭈어 볼 것이 있습니다만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/134"
msgid "처음 보는 분이군요./n우리 마을에 처음 오신 것 같은데, 맞죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/135"
msgid "네. 이곳은 처음 와 봅니다./n그런데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/136"
msgid "어떤  것에 대해서 물어볼까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/137"
msgid "웨어링 집안에 대해서 설명듣고 싶다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/138"
msgid "[다이아나]/n약 일년전 부터 그가 점점 우울해지더니,/n급기야 점점 이상한 소리를 한 것은 사실이에요./n하지만, 제가 보기에 그는 지극히 정상이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/139"
msgid "다이아나에 대해 물어보자."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/140"
msgid "이 사건 자체의 배경이 듣고 싶다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/141"
msgid "그 말은, 브리앙 웨어링 씨가/n댄 웨어링 씨의 아들이 아닐수도 있다는 것입니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/142"
msgid "어떤 문제시죠?/n도와드릴 수 있는 것은 도와드리겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/143"
msgid "자, 이제 어떻게 질문한다?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/144"
msgid "최근에 극약을 산 사람 명단이 궁금하군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/145"
msgid "댄 웨어링 씨가 좋아할 만한 선물은?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/146"
msgid "실례인 줄은 압니다만,/n최근에 극약을 사간 사람의 명단을 얻을 수 있을까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/147"
msgid "[약국주인]/n…당신, 조그만 마을의 약국이라고/n우리를 우습게 보는 것인가?/n우리도 가게로서의 윤리가 있지,/n생전 처음 보는 사람한테/n턱 하니 그런것을 보여줄 것 같나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/148"
msgid "[약국주인]/n그런 질문이나 할 생각이면, 썩 이곳에서 나가시오!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/149"
msgid "아니, 전 저… 이런. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/150"
msgid "이런… 타지사람이라고 푸대접 하는군…/n하긴, 내가 왜 내 일도 아닌 일에 참견하고 있는가지?/n내 일이나 하자."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/151"
msgid "[헤이슨 씨]/n다이아나, 이러면 안돼. 빨리 집으로 돌아가자."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/152"
msgid "아니오, 오히려 잘 되었습니다./n여기서 제 말을 좀 들어주십시오,/n헤이슨 씨, 그리고 다이아나 양."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/153"
msgid "일단, 브리앙 웨어링 씨는 정신병자가/n아니라는 것 부터 밝혀야 겠군요./n그는 미친것이 아닙니다./n단지, 그를 미친 사람처럼 보이게 하고 싶어했던/n사람의 함정에 빠졌을 뿐이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/154"
msgid "[브리앙 웨어링]/n내가… 내가 미치지 않았다고?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/155"
msgid "[댄 웨어링]/n무슨 소리인가!/n아들은 절대 안정이 필요해!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/156"
msgid "[헤이슨 씨]/n그게…그게 진실입니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/157"
msgid "헤이슨 씨는 오래동안 여행을 다녔었다고 하더군요./n여행하는 도중 가시독말풀 이란 풀에 대해서/n들어보신 적이 있겠죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/158"
msgid "[헤이슨 씨]/n가시독말풀이라면,/n환각작용을 일으키는 맹독이 아닙니까./n많이 먹으면 죽을수도 있는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/159"
msgid "[브리앙 웨어링]/n이제는 먹고 마시는 것 하나하나 다 맛을 모르겠어요./n항상 머리는 무겁고 입맛은 씁쓸하고…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/160"
msgid "그렇죠. 그리고 가시독말풀은 그 씁쓸한 맛과/n환각이 풀린 뒤에도 끊임없이 두통과 어지러움을 동반하지요./n브리앙 웨어링 씨는 요새 계속해서/n씁쓸한 입맛과 어지러움을 호소하지 않았던가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/161"
msgid "[브리앙 웨어링]/n그러고 보니…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/162"
msgid "그리고, 댄 웨어링씨,/n당신은 요새 가시독말풀로 된 약을 복용하고 계시지 않으신가요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/163"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/164"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/165"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/166"
msgid "[댄 웨어링]/n무슨 소리야…/n내가 가시독말풀로 만든 약을 먹기는 하지만,/n왜 내가 내 아들을 해치려 하겠어…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/167"
msgid "만약, 그가 당신 아들이 아니라 해도?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/168"
msgid "[브리앙 웨어링]/n무슨 말을…!/n그는 확실히 내 아버님이요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/169"
msgid "그것에 대한 대답은 헤이슨 씨가 더 잘 아실 것 같군요./n안 그렇습니까, 헤이슨 씨?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/170"
msgid "[헤이슨 씨]/n그…그건…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/171"
msgid "[댄 웨어링]/n쿡. 쿡쿡… "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/172"
msgid "[브리앙 웨어링]/n아, 아버지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/173"
msgid "[댄 웨어링]/n왜, 왜 너는 나를 아버지라고 부르는 것이지?/n레이첼이, 레이첼이 임신했다고 말했을 때/n나의 당혹감과 분노를 누가 알겠어!/n나는 후손을 낳을 수 없는 상태였단 말이다…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/174"
msgid "[브리앙 웨어링]/n그, 그런."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/175"
msgid "[댄 웨어링]/n네 어머니는…네 어머니는, 호숫가에서 내가 이 손으로,/n아니, 아니야. 그건 내가 아니였어!/n그녀가 뛰어든거야! 그래, 그녀가 뛰어들었어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/176"
msgid "당신은 그 원한 때문에 당신 아들에게 독을 먹여서 환각상태로 만들고 그런 연극을 꾸민것인가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/177"
msgid "헤이슨 씨, 당신이 브리앙 씨의 진짜 아버지가 아닌가요?/n댄 씨는 자신의 질투때문에 브리앙 씨에게/n가시독말풀을 먹여서 환각상태로 만들고,/n그가 미친것 처럼 꾸미는 연극을 했던 것이죠./n아마 그의 어머니도 단순한 사고는 아니었을 것입니다./n안 그렇습니까, 댄 웨어링씨?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/178"
msgid "[댄 웨어링]/n빌어먹을, 머리가 아프군!/n약국에 가서 약을 좀 사먹어야 겠어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/179"
msgid "[브리앙 웨어링]/n아버지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/180"
msgid "기다려!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/181"
msgid "댄 웨어링 씨는…/n나름대로의 해결책을 찾기위해 나간 것일세./n쫓아가면 안돼…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/182"
msgid "그럼, 브리앙 씨는 이곳을 떠나실 것인가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/183"
msgid "[브리앙 웨어링]/n예. 당분간, 여행을 다니면서 머리를 식히고 싶습니다./n물론, 사랑스런 저의 다이아나도 함께…/n아, 그리고 잠시만, 이리로 와 주시겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/184"
msgid "[브리앙 웨어링]/n이건 우리 집안의 가보입니다./n우리에게는 슬픈 추억이 깃든 것입니다만,/n당신에게라면 틀림없이 기쁜 추억이 될 수 있을 것 같군요./n받아주신다면 감사하겠습니다만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/185"
msgid "블러디 스톤을 얻었다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/186"
msgid "[브리앙 웨어링]/n그럼… 안녕히…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/187"
msgid "다이아나 양 집이다./n지금은 여행을 떠나고 없겠군…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/188"
msgid "웨어링 집안이다./n지금은 여행을 떠나고 없겠군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/189"
msgid "혹시 다이아나 씨에 대해서 알고 있습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/190"
msgid "다이아나씨?/n약 2년전 즈음해서 게이시르로 유학갔었던/n브리앙을 따라 이 마을로 왔지./n브리앙이 유학시절에 사귄 여자 같아."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/191"
msgid "그렇지만, 그녀는 타고난 미모와/n외향적이고 밝은 성격으로/n마을에 오자마자 모든 남자의 관심을 받았지./n뭐, 그 당시에는 약혼한 관계가 아니었으니까…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/192"
msgid "흥…/n사실 그녀는 마을 청년 전원에게 구애를 받았다고 해도/n과언이 아닐껄요? 하여튼 남자들이란…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/193"
msgid "[주점주인]/n그렇지만 이상한건, 다이아나 라는 여자의 배경은/n아무도 아는 사람이 없다는 것 아니겠어?/n그녀는 지금도 혼자 살고 있고…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/194"
msgid "그러고 보니, 소문에 의하면 마을의 한 청년이/n파티장 뒷편에서 그녀에게 구애하다가 굉장히 쌀쌀맞게/n거절당했다는 이야기를 들은적이 있어요./n\"너같은 힘도, 돈도 없는 녀석과는 상대하기 싫어!\"/n라고 했다던가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/195"
msgid "내가 알기로는 그 사건은/n그 남자가 강제로 그녀를 끌고 가려고 했기 때문에/n그녀가 내친 거라고 하던데?/n소문인 이상하게 퍼져버렸지만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/196"
msgid "[주점주인]/n누가 알 수 있을까?/n여자의 마음속을… "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/197"
msgid "브리앙 웨어링 씨의 파혼에 대한 이야기를/n듣고 싶습니다만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/198"
msgid "그 사건이요?/n다이아나와 브리앙이 약혼한 것은 약 1년쯤 되었지요./n그런데, 얼마전에 갑작 브리앙이 파혼을 선언한 것이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/199"
msgid "그 이유는 자신의 정신병!/n마을에서 상당히 센세이션을 일으킨 사건이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/200"
msgid "[주점주인]/n당사자들을 제외하곤 아무도 반기는 약혼은 아니었지, 솔직히./n그 아버지의 광기야 유명한 것이고,/n마을 사람 누구도 웨어링 가의 재산이/n바깥 사람에게 돌아가는 것을 환영하지는 않았었잖아?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/201"
msgid "그렇지만, 정말로 브리앙은 정신병이 생긴 것일까?/n그가 요즘 태도가 상당히 이상하기는 했지만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/202"
msgid "근래에 들어 각 농장의 가축들이/n살상당하는 사고가 잦았던 것은 사실이고,/n그것이 모두 브리앙의 소행이었다고 하잖아?/n그게 제정신인 사람이 할 일인가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/203"
msgid "[주점주인]/n좀 석연치 않은 구석이 있는 것은 사실이긴 하지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/204"
msgid "그럼 그 브리앙 웨어링과 댄 웨어링 부자는/n원래부터 좀 이상한 구석이 있었나보죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/205"
msgid "[브리앙 웨어링]/n여행중에 만나게 될 지도 모르겠군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/206"
msgid "정말로 놀랄 일이에요./n범인이 댄 웨어링 씨 였다니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/207"
msgid "자, 행복해진 다이아나 씨를 위해서 건배…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/208"
msgid "어서오세요, 이 집의 주인님이신 다이아나 님의 뜻에 따라/n집에 오시는 손님은 무료로 재워드립니다./n주무시겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/209"
msgid "안녕히 주무세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/210"
msgid "카그라는 요리사의 부탁으로 좋은 식재료를 찾고 있다고?/n실은 내가 그 녀석의 형이라네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/211"
msgid "[다이아나]/n이제, 그와,/n그와 이세상 어디라도 함께 할 거에요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01
msgctxt "field|re|art_fltfa01|@kfltfa01/212"
msgid "사인 받아주셔서 정말 정말 고마워요!/n소중히 간직할 거예요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/000"
msgid "파로 마을"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/001"
msgid "이곳은 파로 마을이에요./n지리적으로는 게이시르 시티에 가까운 편이지만,/n문화적으로는 많은 차이가 있지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/002"
msgid "우리 마을은 시끄러운 외부와는 달리/n평화롭고 조용한 곳이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/003"
msgid "정말 끔찍한 일이에요./n마을 제일의 호남자인 그가 정신병에 걸리다니…/n더군다나 약혼자도 있는데."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/004"
msgid "이곳은 상당히 외진 마을이라 사람들의 발걸음이 뜸해요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/005"
msgid "그런데 얼마전에 외부에서 요리사 한 명이 이사왔어요. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/006"
msgid "고급 요리에 쓰일 신선한 재료를 찾고 있는데/n이곳이 깨끗해서 맘에 들었다나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/007"
msgid "전에 한번 게이시르 시티에 초대받아 가본 적이 있어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/008"
msgid "눈이 빙빙 돌아가도록 넓은 길과 아름다운 건물,/n멋진 사람들이 사는 곳이었지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/009"
msgid "이런 시골 마을에서 사는 것 보다 훨씬 더 멋질 거에요./n도시에서 사는 것은…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/010"
msgid "우리 같이 작은 마을은/n오히려 산적들에게 시달림을 받는 것이 더 걱정이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/011"
msgid "이게 다 우리 게이시르 제국을 무너뜨린/n실버애로우 때문이야./n그들이 과거에 우리 황가의 맥을 끊지만 않았어도."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/012"
msgid "늦은 감은 있지만, 이제 우리도 하나의 국가나/n연합체를 형성해야 하지 않는가!/n언제까지 이런 어수선한 채로 남아있을거지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/013"
msgid "그럴 줄 알았어요! 내가 늘 그랬잖아요,/n댄 웨어링 씨는 제정신인 사람이 아니라고!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/014"
msgid "브리앙 씬 역시 생긴대로 미남에, 부자에,/n머리 좋고 운동 잘하고…어쩌면 그렇게 멋있을까!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/015"
msgid "아… 다이아나 양이 정말로 부럽네요./n좋겠어요, 그들은…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/016"
msgid "우리 마을의 영주님은 아이들을 정말 좋아하시나 봐요./n영주님 집 안에는 상당히 많은 아이들이 있답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/017"
msgid "하지만, 이상하게도 다 여자아이들 뿐이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/018"
msgid "영주님은 꽃도 좋아하셔서,/n정원에는 꽃이 대단히 많다고 해요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/019"
msgid "나, 샤론의 공연을 본 적이 있어요./n춤도 잘 추고, 정말 예쁘고 멋진 언니였어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/020"
msgid "꼭 사인을 받고 싶었는데…/n오빠들이 다 새치기하는 바람에 못 받았지 뭐예요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/021"
msgid "혹시, 샤론을 만나게 된다면/n저 대신 사인을 받아다 주실 수 없을까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/022"
msgid "[댄 웨어링]/n우리 집안은 저주받은 집안이지./15d/n나는 아들의 결혼을 반대하고 있었어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/023"
msgid "[댄 웨어링] /n최근 일련의 사건으로 아들놈도/n우리 집안의 피를 깨달은 모양이야./10d 클클클…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/024"
msgid "[댄 웨어링] /n이것으로 이 저주받은 집안의 대도 끊기는 거야…/n/10d쿡쿡쿡…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/025"
msgid "[브리앙 웨어링]/n난 끝났어요. 내 손으로 그런 끔찍한 짓을 하다니…/20d/n결혼?/10d 그런 희망을 품은 내가 바보지!/15d 하하하!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/026"
msgid "[브리앙 웨어링]/n위로의 말 따위는 필요없어./n나를 설득시키려고 하지도 마./20d/n나에게 남은것은 단지 죽음뿐…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/027"
msgid "[다이아나] /n아니에요, 그가 미쳤을 리가 없어요./n정말이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/028"
msgid "[다이아나] /n이건, 무엇인가 잘못되어 있어요…/20d/n브리앙은 무엇인가를 착각하고 있는 거라고요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/029"
msgid "[다이아나]/n이건 현실이 아니야…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/030"
msgid "[헤이슨]/n이거, 시라노씨군요./n저는 잘 지내고 있습니다./n아, 브리앙과 다이아나가 안부 전해달랍니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/031"
msgid "[헤이슨]/n댄 그 친구…/n어렸을 때는 그렇게까지 이상하지 않았었는데./n쾌활하고, 만능 스포츠맨에 머리 좋고…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/032"
msgid "[헤이슨]/n정말로 안타까운 일이오. 지금 생각해 보면."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/033"
msgid "우리도 하나의 통일된 국가를 이루어야 하지 않을까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/034"
msgid "지금같은 권력 공백 상태에서는/n어떤 일이 일어난다 해도 이상할 것이 없지요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/035"
msgid "더 충격적인 것은 그 조각들이/n휴 씨의 방 안의 자루에서 발견되었다는 거에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/036"
msgid "어서오세요./n우리집은 다른 것은 몰라도 양은 많이 드립니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/037"
msgid "팬드래건의 왕위계승 서열 1위인 라시드 3세는/n도대체 어디로 가서 숨어버린 것일까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/038"
msgid "뭐, 라시드 대왕이 워낙 정정하니/n쉽게 왕위를 물려받지도 못하겠지만…/n언제고 우리집에 오면/n서비스 안주를 많이 줄 용의가 있는데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/039"
msgid "이 근처에 있는 카라카스라는 곳에는/n내 동생 카그가 요리점을 경영하고 있지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/040"
msgid "그 녀석, 솜씨는 좋지만/n지나치게 완벽주의자인 것이 문제야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/041"
msgid "틈만 나면 나한테도 좋은 재료를 구해달라고 성화라니까./n허허…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/042"
msgid "호호호…/n당신은 과연 근시일내에 제국을 장악할 패자가/n등장할 수 있을거라 생각하나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/043"
msgid "제국의 패자가 되기 위해서는,/n체사레 보르자를 제압할 만한 세력이/n있어야 하지 않을까요? "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/044"
msgid "제국의 패자를 결정한다는 아수라 검을/n누군가가 뽑았다는 소문이지만…/n어디까지나 소문은 소문일 뿐 아니겠어요? 호호호"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/045"
msgid "어서오십시오. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/046"
msgid "지난번 공연에서 샤론의 사인을 얻어왔어요./n훗훗훗… 우리 마을에서는 저만이 갖고 있지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/047"
msgid "이건 아무리 많은 돈을 주어도 팔지 않을 거에요./15d/n우리집 가보로 물려줄 거라구요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/048"
msgid "흠…/n아주 좋은 물건을 가져 온다면 생각해 보겠지만…/n예를 들어 아스모데우스의 파편이라던지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/049"
msgid "다이아나는 마을 최고의 미인이죠./n마을 전체 남성들의 선망의 대상이 된."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/050"
msgid "그런 그녀가 또한 마을 여자 전체의 선망의 대상이었던/n브리앙 하고 결혼한다고 발표를 했을 때/n얼마나 말이 많았었는지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/051"
msgid "어떻게 보면 누구도 환영하지 않던 약혼이었어요./n본인 둘을 제외하고는…/20d/n질투의 대상이었죠…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/052"
msgid "어서오세요./n어떤 물건을 찾으십니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/053"
msgid "파로 약국"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/054"
msgid "저희 상점을 이용해 주셔서 감사합니다./n안녕히 가세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/055"
msgid "아… 아앗!!/n이건 샤론 언니의 사인! 꺄아악!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/056"
msgid "이거, 저 주시는 거죠?/n정말 고마워요! 너무 기뻐요!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/057"
msgid "대신 저도 뭐 하나 드릴게요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/058"
msgid "얼음의 반지를 손에 넣었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/059"
msgid "전에 숲에서 주운 반지예요! 너무 예쁘죠?/n사인 정말 고마워요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/060"
msgid "이건 내가 얼마 전에/n카라카스 근처 숲에서 구한 사랑의 향초인데,/n진정한 사랑이 싹튼 곳에서만 핀다는 꽃이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/061"
msgid "굉장히 귀한 향초니까,/n잘 보관했다가 동생에게 전해주지 않겠나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/062"
msgid "사랑의 향초를 얻었다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/063"
msgid "주무시겠어요? 저희 주인님께서는/n집에 찾아온 손님은 접대해 드린답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/064"
msgid "그럼 안녕히 주무세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/065"
msgid "안녕히 가세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/066"
msgid "몸 조심해서 가세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/067"
msgid "[폴]/n이번에 좋은 무기를 하나 입수했어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/068"
msgid "마을 잡화점"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/069"
msgid "그럼, 다음에도 좋은 물건을 드릴께요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/070"
msgid "현상수배 : 로베르토 데 메디치 /n죄목 : 방화, 살인. /n현상금 : 1,000,000 ELD"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/071"
msgid "소녀의 부탁을 받아 샤론의 사인을 받아다 주겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/072"
msgid "샤론을 만난다면 꼭 사인을 받아다 주지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/073"
msgid "미안하지만, 약속할 수는 없겠는데."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/074"
msgid "좋아, 샤론을 만난다면 꼭 사인을 받아다 주지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/075"
msgid "정말이죠? 그럼, 약속한 거예요! 꼭이요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/076"
msgid "미안하지만, 약속할 수는 없겠는데."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/077"
msgid "그리고, 그런 것은 직접 받아야 의미가 있는 거야./n직접 샤론을 찾아보는 게 어떻겠니?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/078"
msgid "그건 그렇지만…/n난 여행하기엔 아직 어리단 말이에요. 힝…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/079"
msgid "고마워요!/n사인 받아다 주신다는 약속 잊으시면 안 돼요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/080"
msgid "아~ 샤론의 사인 갖고 싶다…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/081"
msgid "비록 화려하지는 않지만 평화롭고 잔잔한 삶을/n살고 있다고 자부하고 있답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/082"
msgid "[브리앙 웨어링]/n비켜,  저리 가!/n제발 날 혼자 내버려두란 말이야!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/083"
msgid "그만 둔 것인지, 아니면 어떤 이유가 있는 것인지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/084"
msgid "[브리앙 웨어링]/n그 증세가 처음 발생한 것은 작년 가을이었죠./n마을 축제가 있던 날 저녁, 저는 술에 만취했었습니다./10d/n정신없이 먹고 마시다 정신을 차려보니 집안이었어요./10d/n숙취로 아픈 머리를 식히기 위해서 세면실에 갔었는데,/n제 손에 피가…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/085"
msgid "[브리앙 웨어링]/n저는 제가 어디 다친것이 아닌가 해서/n온 몸을 살펴봤었지만, 전혀 다친곳은 없었어요./n그런데 그 다음날, 우리마을 농장에 늑대가 들어서/n닭과 가축들을 죽이고 달아났다는 이야기를 들었지요./n/10d하지만, 하지만, 전 그게 늑대가 아니라는 것을/n직감했었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/086"
msgid "[브리앙 웨어링]/n처음에는 단순히 무서운 꿈을 꾸었을 뿐이라고/n나 자신을 설득했었지요./n하지만, 이 증세는 그 뒤로도 계속 되었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/087"
msgid "[브리앙 웨어링]/n이제는 잠에서 깨기가 두려워요./n자고 일어나보면 방안이 마구 흩어져 있거나/n제 손이 피로 물들어 있는 것을 발견한 그때는/n정말이지, 정말이지 저 자신이 두려워집니다./n/10d두려워요…/10d 두려워…/n이제는 잠자는 것 자체가 두려워요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/088"
msgid "[브리앙 웨어링]/n결혼! 하, 하하하! 어느날 눈을 떠 보면,/n그때 그 사랑스러운 다이아나를 제손으로…/n안돼, 안돼요, 그것만은 절대로! 난 결혼할 수 없습니다./10d/n이 저주스러운 피가 제 몸속에 흐르는 한, 절대로./n흐…흐흐흐…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/089"
msgid "[댄 웨어링]/n…우리 집안은 전통적으로 정신병이 있지./n과거에 친족혼을 통해 혈통을 보존한 죄의 댓가야…/n이런 씨는 이 세상에서 없어져야 해. 그렇지않나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/090"
msgid "[다이아나]/n브리앙이 미쳤다고요?/n그건 말도 안돼요!/n그는 일년전만 해도 정말이지 아무 이상도 없었다고요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/091"
msgid "[다이아나]/n저와 그는 게이시르 학술원에서 처음 만났죠./n마침 저도 조용한 시골 마을을 찾고 있었기 때문에/n이곳으로 이사온 것이고,/n그와는 여기 온지 일년쯤 뒤에 약혼했어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/092"
msgid "[헤이슨]/n하지만, 다이아나./n원래 미친 사람은 언제나 그런 것이 아니라/n일시적으로 발작이 일어나는 법이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/093"
msgid "[다이아나]/n아니에요, 아니에요! 정말로,/n정말로 그가 정상이 아닌 것이라면/n왜 의사의 진찰도 받으려 하지 않는거죠?/n병이 난 것이면 고칠수 있는 것 아닌가요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/094"
msgid "[헤이슨]/n그건, 고칠 수 있는 병이 아니야./n 그 집안의 유전이지… 다이아나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/095"
msgid "[다이아나]/n그렇지 않아요, 그렇지 않아./n절대 그럴리 없어!/n내가, 내가 고쳐보이겠어요, 그의 병을,/n무슨 수를 써서라도, 내가!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/096"
msgid "웨어링 집안 말인가?/n그 집안은 예로부터 저주받은 집안이지./n그 집안 사람들 치고 정상적으로 죽은 사람이 없다니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/097"
msgid "단적으로, 댄씨의 부모님도 실종되었고,/n댄 씨의 부인은 댄씨와 물놀이를 즐기다가/n보트가 뒤집어지는 사고로/n유명을 달리하지 않았냔 말이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/098"
msgid "댄 씨의 부인이 죽었을 때,/n마을에서는 댄 씨가 부인을 밀어서/n호수에 빠뜨린 것이라는 소문이 퍼졌었지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/099"
msgid "이제는 그 아들인가? 불쌍하게도…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/100"
msgid "그 집안은 정말로 그렇게 유전적으로/n문제가 있는 집안인가 보군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/101"
msgid "그렇다고 볼 수 있겠죠./n하지만 진정한 원인은 그 집안이/n너무 잘 살고 있다는 것이 아닐까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/102"
msgid "너무 잘 살기 때문에/n정신병에 걸렸다는 것인가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/103"
msgid "그렇다기 보다는…/n그 집안은 옛부터 유산과 상속권을 둘러싸고/n갖은 음모가 난무했었지. 그 영향이 아닐까?/n그 집 사람들이 이상한 것은 말이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/104"
msgid "그러고 보니, 전에 브리앙이 댄 씨의 자손이 맞는지/n의문시되었던 적이 있잖아?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/105"
msgid "그렇습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/106"
msgid "그러다 보니, 친족혼으로 분쟁을 줄이려고 했고,/n그러다가 가전의 정신병이 생겼다는 것인가…/n그러고 보면 돈이 많다고 좋은 것은 아닌 것 같아, 정말로."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/107"
msgid "[댄 웨어링]/n난 내 아들놈의 결혼을 처음부터 반대하고 있었어./n결코 안될 말이었지. 큭큭큭…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/108"
msgid "실례합니다./n댄 씨 집을 찾아가려고 하는데,/n무엇을 좀 사다드리려고 합니다./n어떤 것이 좋을까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/109"
msgid "음모가 가득찬 집안이라…/n그 집안에 대한 정보를 조금 더 얻고 싶은데./n다른 사람들이 더 설명해 줄 수 있지 않을까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/110"
msgid "[약국주인]/n아, 댄 웨어링씨 말이지요?/n그 분은 요새 눈이 안 좋으시다면서/n가시독말풀로 만든 약을 복용하시고 계십니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/111"
msgid "[약국주인]/n요새 아드님 일로 정신없으셔서 그런지는 몰라도,/n사실 때가 되었는데도 안 오시더라고요./n사다드리면 좋을 것 같습니다만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/112"
msgid "가시독말풀이라면…/n꽤나 위험한 독약이 아닙니까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/113"
msgid "[약국주인]/n괜찮습니다./n그 분은 그 약을 오래 복용하고 계셨기 때문에/n복용량을 잘 알고 계시죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/114"
msgid "그렇습니까…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/115"
msgid "[약국주인]/n잠, 잠깐만요. 약은요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/116"
msgid "아아… 나중에 다시 오지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/117"
msgid "결국… 그가 이 일의 원인이었나./n웨어링씨 댁으로 가 보자…/n이 일은 해결을 봐야겠어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/118"
msgid "실례합니다./n웨어링 집안에 대해서 좀 알고 계십니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/119"
msgid "웨어링 집안이요? 알다마다요! 그 집안은 옛날부터/n말썽이 끊이지 않는 집안이었다니까요./n내 그 집에 레이첼이 시집갈 때 부터 알아봤다니까./n글쎄 그 집안의 결혼은 항상 불안하기만 하지 뭐유,/n이번 결혼만 해도…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/120"
msgid "(그냥 계속 말하게 하면 끝이 없겠군)/n아… 아주머니. 그 레이첼 이란 사람은 누구죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/121"
msgid "레이첼? 댄 씨의 부인 아니유./n사실 그 부인은 헤이슨 씨도 좋아했었지요./n댄 씨와 레이첼이 결혼하자 상심한 헤이슨 씨는/n멀리 여행을 떠나지 않았겠어요./n헤이슨 씨가 돌아온지는 얼마 안된다우./n그런데, 헤이슨 씨가 떠나고 얼마 안 되서/n문제가 발생했지 뭐유."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/122"
msgid "어떤 문제였지요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/123"
msgid "레이첼이 브리앙을 낳았는데/n생각보다 좀 일찍 태어났거든. 사람들은/n브리앙이 정말 댄 씨의 자손이 맞냐고 수근댔었지./n나중에 본인이 공개적으로 그렇다고 밝히기는 했었지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/124"
msgid "사람들은 레이첼과 헤이슨 씨의 관계를 의심하긴 했지만,/n뭐 헤이슨 씨 본인이 없었기 때문에/n결국 흐지부지 되고 말았지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/125"
msgid "뭐, 꼭 그렇기 보다는… 그럴수도 있다는 것 아니겠어요?/n어머, 어머. 내가 초면인 사람을 두고/n못하는 소리가 없지…그럼."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/126"
msgid "재미있군. 광기어린 집안에, 내력은 또 왜 이리 복잡한 거지?/n이렇게 되면 아버지란 사람이 의심가는데…/n좀 더 조사를 해 보자."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/127"
msgid "[브리앙 웨어링]/n이 미치광이에게 볼일이라도 있습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/128"
msgid "미치광이라…/n어떻게 보면 세상 사람들 중 제정신인 사람이 있을까?/n하지만, 자네는 정상이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/129"
msgid "[브리앙 웨어링]/n무슨… 무슨 말입니까, 제가 정상이라니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/130"
msgid "[다이아나]/n브리앙! 난 당신을 버릴 수 없어요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/131"
msgid "[약국주인]/n어서오세요. 무엇을 드릴까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/132"
msgid "이곳이 이 동네 약국이군./n만약, 브리앙 웨어링씨가 인위적으로 이상해진 것이라면,/n이곳에서 단서를 얻을 수 있지 않을까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/133"
msgid "저 잠시 여쭈어 볼 것이 있습니다만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/134"
msgid "처음 보는 분이군요./n우리 마을에 처음 오신 것 같은데, 맞죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/135"
msgid "네. 이곳은 처음 와 봅니다./n그런데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/136"
msgid "어떤  것에 대해서 물어볼까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/137"
msgid "웨어링 집안에 대해서 설명듣고 싶다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/138"
msgid "[다이아나]/n약 일년전 부터 그가 점점 우울해지더니,/n급기야 점점 이상한 소리를 한 것은 사실이에요./n하지만, 제가 보기에 그는 지극히 정상이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/139"
msgid "다이아나에 대해 물어보자."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/140"
msgid "이 사건 자체의 배경이 듣고 싶다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/141"
msgid "그 말은, 브리앙 웨어링 씨가/n댄 웨어링 씨의 아들이 아닐수도 있다는 것입니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/142"
msgid "어떤 문제시죠?/n도와드릴 수 있는 것은 도와드리겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/143"
msgid "자, 이제 어떻게 질문한다?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/144"
msgid "최근에 극약을 산 사람 명단이 궁금하군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/145"
msgid "댄 웨어링 씨가 좋아할 만한 선물은?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/146"
msgid "실례인 줄은 압니다만,/n최근에 극약을 사간 사람의 명단을 얻을 수 있을까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/147"
msgid "[약국주인]/n…당신, 조그만 마을의 약국이라고/n우리를 우습게 보는 것인가?/n우리도 가게로서의 윤리가 있지,/n생전 처음 보는 사람한테/n턱 하니 그런것을 보여줄 것 같나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/148"
msgid "[약국주인]/n그런 질문이나 할 생각이면, 썩 이곳에서 나가시오!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/149"
msgid "아니, 전 저… 이런. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/150"
msgid "이런… 타지사람이라고 푸대접 하는군…/n하긴, 내가 왜 내 일도 아닌 일에 참견하고 있는가지?/n내 일이나 하자."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/151"
msgid "[헤이슨 씨]/n다이아나, 이러면 안돼. 빨리 집으로 돌아가자."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/152"
msgid "아니오, 오히려 잘 되었습니다./n여기서 제 말을 좀 들어주십시오,/n헤이슨 씨, 그리고 다이아나 양."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/153"
msgid "일단, 브리앙 웨어링 씨는 정신병자가/n아니라는 것 부터 밝혀야 겠군요./n그는 미친것이 아닙니다./n단지, 그를 미친 사람처럼 보이게 하고 싶어했던/n사람의 함정에 빠졌을 뿐이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/154"
msgid "[브리앙 웨어링]/n내가… 내가 미치지 않았다고?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/155"
msgid "[댄 웨어링]/n무슨 소리인가!/n아들은 절대 안정이 필요해!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/156"
msgid "[헤이슨 씨]/n그게…그게 진실입니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/157"
msgid "헤이슨 씨는 오래동안 여행을 다녔었다고 하더군요./n여행하는 도중 가시독말풀 이란 풀에 대해서/n들어보신 적이 있겠죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/158"
msgid "[헤이슨 씨]/n가시독말풀이라면,/n환각작용을 일으키는 맹독이 아닙니까./n많이 먹으면 죽을수도 있는…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/159"
msgid "[브리앙 웨어링]/n이제는 먹고 마시는 것 하나하나 다 맛을 모르겠어요./n항상 머리는 무겁고 입맛은 씁쓸하고…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/160"
msgid "그렇죠. 그리고 가시독말풀은 그 씁쓸한 맛과/n환각이 풀린 뒤에도 끊임없이 두통과 어지러움을 동반하지요./n브리앙 웨어링 씨는 요새 계속해서/n씁쓸한 입맛과 어지러움을 호소하지 않았던가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/161"
msgid "[브리앙 웨어링]/n그러고 보니…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/162"
msgid "그리고, 댄 웨어링씨,/n당신은 요새 가시독말풀로 된 약을 복용하고 계시지 않으신가요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/163"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/164"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/165"
msgid "!!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/166"
msgid "[댄 웨어링]/n무슨 소리야…/n내가 가시독말풀로 만든 약을 먹기는 하지만,/n왜 내가 내 아들을 해치려 하겠어…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/167"
msgid "만약, 그가 당신 아들이 아니라 해도?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/168"
msgid "[브리앙 웨어링]/n무슨 말을…!/n그는 확실히 내 아버님이요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/169"
msgid "그것에 대한 대답은 헤이슨 씨가 더 잘 아실 것 같군요./n안 그렇습니까, 헤이슨 씨?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/170"
msgid "[헤이슨 씨]/n그…그건…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/171"
msgid "[댄 웨어링]/n쿡. 쿡쿡… "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/172"
msgid "[브리앙 웨어링]/n아, 아버지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/173"
msgid "[댄 웨어링]/n왜, 왜 너는 나를 아버지라고 부르는 것이지?/n레이첼이, 레이첼이 임신했다고 말했을 때/n나의 당혹감과 분노를 누가 알겠어!/n나는 후손을 낳을 수 없는 상태였단 말이다…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/174"
msgid "[브리앙 웨어링]/n그, 그런."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/175"
msgid "[댄 웨어링]/n네 어머니는…네 어머니는, 호숫가에서 내가 이 손으로,/n아니, 아니야. 그건 내가 아니였어!/n그녀가 뛰어든거야! 그래, 그녀가 뛰어들었어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/176"
msgid "당신은 그 원한 때문에 당신 아들에게 독을 먹여서 환각상태로 만들고 그런 연극을 꾸민것인가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/177"
msgid "헤이슨 씨, 당신이 브리앙 씨의 진짜 아버지가 아닌가요?/n댄 씨는 자신의 질투때문에 브리앙 씨에게/n가시독말풀을 먹여서 환각상태로 만들고,/n그가 미친것 처럼 꾸미는 연극을 했던 것이죠./n아마 그의 어머니도 단순한 사고는 아니었을 것입니다./n안 그렇습니까, 댄 웨어링씨?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/178"
msgid "[댄 웨어링]/n빌어먹을, 머리가 아프군!/n약국에 가서 약을 좀 사먹어야 겠어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/179"
msgid "[브리앙 웨어링]/n아버지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/180"
msgid "기다려!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/181"
msgid "댄 웨어링 씨는…/n나름대로의 해결책을 찾기위해 나간 것일세./n쫓아가면 안돼…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/182"
msgid "그럼, 브리앙 씨는 이곳을 떠나실 것인가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/183"
msgid "[브리앙 웨어링]/n예. 당분간, 여행을 다니면서 머리를 식히고 싶습니다./n물론, 사랑스런 저의 다이아나도 함께…/n아, 그리고 잠시만, 이리로 와 주시겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/184"
msgid "[브리앙 웨어링]/n이건 우리 집안의 가보입니다./n우리에게는 슬픈 추억이 깃든 것입니다만,/n당신에게라면 틀림없이 기쁜 추억이 될 수 있을 것 같군요./n받아주신다면 감사하겠습니다만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/185"
msgid "블러디 스톤을 얻었다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/186"
msgid "[브리앙 웨어링]/n그럼… 안녕히…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/187"
msgid "다이아나 양 집이다./n지금은 여행을 떠나고 없겠군…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/188"
msgid "웨어링 집안이다./n지금은 여행을 떠나고 없겠군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/189"
msgid "혹시 다이아나 씨에 대해서 알고 있습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/190"
msgid "다이아나씨?/n약 2년전 즈음해서 게이시르로 유학갔었던/n브리앙을 따라 이 마을로 왔지./n브리앙이 유학시절에 사귄 여자 같아."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/191"
msgid "그렇지만, 그녀는 타고난 미모와/n외향적이고 밝은 성격으로/n마을에 오자마자 모든 남자의 관심을 받았지./n뭐, 그 당시에는 약혼한 관계가 아니었으니까…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/192"
msgid "흥…/n사실 그녀는 마을 청년 전원에게 구애를 받았다고 해도/n과언이 아닐껄요? 하여튼 남자들이란…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/193"
msgid "[주점주인]/n그렇지만 이상한건, 다이아나 라는 여자의 배경은/n아무도 아는 사람이 없다는 것 아니겠어?/n그녀는 지금도 혼자 살고 있고…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/194"
msgid "그러고 보니, 소문에 의하면 마을의 한 청년이/n파티장 뒷편에서 그녀에게 구애하다가 굉장히 쌀쌀맞게/n거절당했다는 이야기를 들은적이 있어요./n\"너같은 힘도, 돈도 없는 녀석과는 상대하기 싫어!\"/n라고 했다던가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/195"
msgid "내가 알기로는 그 사건은/n그 남자가 강제로 그녀를 끌고 가려고 했기 때문에/n그녀가 내친 거라고 하던데?/n소문인 이상하게 퍼져버렸지만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/196"
msgid "[주점주인]/n누가 알 수 있을까?/n여자의 마음속을… "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/197"
msgid "브리앙 웨어링 씨의 파혼에 대한 이야기를/n듣고 싶습니다만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/198"
msgid "그 사건이요?/n다이아나와 브리앙이 약혼한 것은 약 1년쯤 되었지요./n그런데, 얼마전에 갑작 브리앙이 파혼을 선언한 것이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/199"
msgid "그 이유는 자신의 정신병!/n마을에서 상당히 센세이션을 일으킨 사건이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/200"
msgid "[주점주인]/n당사자들을 제외하곤 아무도 반기는 약혼은 아니었지, 솔직히./n그 아버지의 광기야 유명한 것이고,/n마을 사람 누구도 웨어링 가의 재산이/n바깥 사람에게 돌아가는 것을 환영하지는 않았었잖아?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/201"
msgid "그렇지만, 정말로 브리앙은 정신병이 생긴 것일까?/n그가 요즘 태도가 상당히 이상하기는 했지만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/202"
msgid "근래에 들어 각 농장의 가축들이/n살상당하는 사고가 잦았던 것은 사실이고,/n그것이 모두 브리앙의 소행이었다고 하잖아?/n그게 제정신인 사람이 할 일인가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/203"
msgid "[주점주인]/n좀 석연치 않은 구석이 있는 것은 사실이긴 하지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/204"
msgid "그럼 그 브리앙 웨어링과 댄 웨어링 부자는/n원래부터 좀 이상한 구석이 있었나보죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/205"
msgid "[브리앙 웨어링]/n여행중에 만나게 될 지도 모르겠군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/206"
msgid "정말로 놀랄 일이에요./n범인이 댄 웨어링 씨 였다니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/207"
msgid "자, 행복해진 다이아나 씨를 위해서 건배…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/208"
msgid "어서오세요, 이 집의 주인님이신 다이아나 님의 뜻에 따라/n집에 오시는 손님은 무료로 재워드립니다./n주무시겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/209"
msgid "안녕히 주무세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/210"
msgid "카그라는 요리사의 부탁으로 좋은 식재료를 찾고 있다고?/n실은 내가 그 녀석의 형이라네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/211"
msgid "웨어링 집안… 문이 잠겨있군./n주인인 브리앙 씨는 다이아나와 여행을 떠난 모양이다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltfa01_
msgctxt "field|re|art_fltfa01_|@kfltfa01_/212"
msgid "사인 받아주셔서 정말 정말 고마워요!/n소중히 간직할 거예요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/000"
msgid "구 제국의 수도였던 게이시르 시티이니만큼/n아무리 지금은 옛 영화가 사라졌어도/n걷히는 세수는 장난이 아니지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/001"
msgid "이곳은 본래 제국의 제1공신이였던/n번스타인 가문의 영지였습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/002"
msgid "게이시르의 대성당은 10여년 전에 완공된 것이지./n상당히 오랜 기간이 걸려서 완공된/n대 공사였던 것으로 기억하네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/003"
msgid "이곳이 교회령이 된 이후에는 종교 재판이 전혀 없었지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/004"
msgid "어서오세용"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/005"
msgid "가장 최근에 있었던 샤론양의 공연은/n이곳 게이시르 시티에서 였었죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/006"
msgid "우리 옆집에 사는 누나는 좀 이상해요./n어떨 때는 한없이 상냥하다가/n때로는 굉장히 난폭해 진다니까요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/007"
msgid "최근에 사막에서는 도적 떼들이 설치고 있다네./n덕택에 나도 이번에 죽을 위기를 많이 넘겼다고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/008"
msgid "상당히 더운 곳에서 사는 사람들은 대체로 성격이 느긋해 지지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/009"
msgid "사이럽스를 가기 위해서는 트리시스 사막을 건너야 한다네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/010"
msgid "게이시르 대성당이 완공되던 해에,/n공사에 가장 많은 기부를 한 번스타인 가문이/n멸문당한 것은 아이러니라 아니 할 수 없지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/010_3"
msgid "게이시르 대성당이 완공되던 해에,/n공사에 가장 많은 기부를 한 번스타인 가문이/n멸문당한 것은 아이러니라 할 수 없지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/011"
msgid "이 근처 숲에서는 옛날에 용이/n살았었다는 굴로 가는 길이 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/012"
msgid "샤른호스트가 이 근방에도 나타났다는 소문이…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/013"
msgid "게이시르 대성당 아래에는 이전에/n매설되었던 지하 수로가 있답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/014"
msgid "펜드래건과 투르족의 전쟁은/n최근 소강 상태에 빠졌다고 하더군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/015"
msgid "뭐, 지하수로나 용의 굴이나/n다 소문 속에서나 나오는 지역이니/n실재하는 지는 아무도 모르지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/016"
msgid "투르족의 과학 기술은 상상 이상이라 하더군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/017"
msgid "그 누나는 어렸을 때부터/n성격이 좀 이상했었던 모양이에요…./n어머니가 그러시던데요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/018"
msgid "훗, 나는 중년의 낭만을 즐기는 한가로운 귀족이라네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/019"
msgid "번스타인 가문의 멸문은 어쩌면 이미/n예정되어 있던 것이었는지도 모르지./n그 가문은 체사레 공의 야심과는 맞지 않는 편이었거든."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/020"
msgid "호호호"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/021"
msgid "의붓 아버지한테 난폭한 일을 당한 뒤로 그렇다는/n이야기를 아주머니들이 하는 것을 들었어요./n어떤 일인지 물어봤다가 되게 혼나기는 했지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/022"
msgid "이곳은 리브레빌 시티입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/023"
msgid "음악가 니카차씨를 아시나요?/n사이럽스의 인기인 이랍니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/024"
msgid "게이시르 시티는 현재 체사레 추기경의 다스림을 받지요./n당연히 교회령에 들어가 있는 상황이고요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/025"
msgid "게이시르 시티 "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/026"
msgid "이곳 게이시르는 점점 쇠퇴해 가는 것이 느껴지는 도시에요./n무엇보다 사람들이 늘지를 않아요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/027"
msgid "왜 그럴까요?/n게이시르 시티는 다른 도시에 비해서/n교회세력이 횡포를 부리는 정도도 훨씬 적은데도…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/028"
msgid "게이시르 시티에서 점점 사람들이 빠져나가고 있는 것은/n시 자체가 젊은 기운을 잃어 버렸기 때문이 아닐까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/029"
msgid "팬드래건과 투르족은 정말로 오랫동안 전쟁을 하고 있지./n투르족의 막강한 화력을 막아내는 것은/n물량이라는 말이 있지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/030"
msgid "팬드래건의 물량 공세앞에/n투르족의 공세도 주춤했다고 들었네만."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/031"
msgid "샌더 장군은 퇴역한 군인이래요./n최근에 이곳 게이시르 시티로 이사왔지요./n보통 퇴역군인은 '군인의 도시'인 로우엔으로 가기 마련인데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/032"
msgid "샌더 장군에게는 4명의 딸이 있는데,/n하나같이 전부 미인이라고 하더군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/033"
msgid "그 장군은 과거 군인시절에는 대단한 다혈질이었나 봐요./n지금도 그 성격은 어느정도 남아있다고 하던데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/034"
msgid "샌더 장군의 집은 자주 파티를 여는 것으로 유명하죠./n샌더 장군은 이 고풍스러운 전통의 도시에 어울리는/n분임에 틀림없어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/035"
msgid "당신들도 샌더 장군의 파티에는 꼭 한번 가 보셔야 하는데… "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/036"
msgid "그 분 집에는 상당히 많은 사람들이 모인답니다./n샌더 장군은 이곳 저곳에 아는 사람이 많은 것 같아요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/037"
msgid "뭐, 아직도 모험을 좋아한다면/n한번 그 굴을 찾으러 다니는 것도 나쁘지는 않겠지요. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/038"
msgid "저도 어렸을 때는 곧잘 용의 동굴을/n찾아서 돌아다니고는 했답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/039"
msgid "그 이후로 상당한 시간이 지났지만,/n그녀의 공연 소식은 다시는 들리지 않아요./n이유가 무엇일까요? "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/040"
msgid "나의 우상 샤론 누나의 공연을 다시 한 번 보고 싶은데…/n설마 소문대로 가수를 그만 둔다는 것은 아니겠죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/041"
msgid "게이시르 시티 방어 병력의 일원으로서/n가장 자랑스러울 때는 일 년에 한번 있는 사열식이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/042"
msgid "이 게이시르시가를 행군할 때는 정말이지/n과거에 흑태자님이 살아 계실 때 했다던/n사열식이 어떤 것인지 짐작이 간다니까요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/043"
msgid "물론 지금의 작은 군세를 갖고는/n전 안타리아를 호령했던 당시의 화려함과는 거리가 있겠지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/044"
msgid "이곳 게이시르 시티의 치안 상태는 상당히 좋은 편입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/045"
msgid "아직까지 제피르 팰컨등의 불순한 세력의/n영향력이 대단히 약한 상태이기 때문에,/n우리 게이시르의 치안은 안심해도 좋지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/046"
msgid "가장 치안이 위험했던 것은/n10여년 전의 번스타인 가문 멸문 당시 였죠./n당시, 번스타인 가문의 잔당들이 계속해서 저항했었으니까…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/047"
msgid "과거에 나는 번스타인 가문의 문장을 달았었던 군인이었지./n10년 전 번스타인 가문이 멸문당할 때 난 휴가중이었어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/048"
msgid "번스타인 가문의 도련님께서/n종교 재판을 받는다는 소리를 들었을 때/n재빨리 게이시르 시티로 돌아왔었지만…."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/049"
msgid "그때는 이미 모든 상황이 끝난 뒤였지./n나의 군인생활 중에 가장 치욕스런 일이었다./n아군이 전멸당할 동안 나는 전장에 없었다는 것이…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/050"
msgid "나는 이스카리옷 님의 학원에서 마법을 공부하는 마법사라네./n자료를 구하기 위해 팬드래건령 다카마 항까지 갔다가 왔지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/051"
msgid "다카마 항을 가보니 팬드래건의 경제가/n많이 어려워 졌다는 것을 알 수 있겠더군./n아무래도 투르족과의 전쟁이 힘들긴 힘든것 같아."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/052"
msgid "이럴 때에 우리 제국의 힘이 하나로 뭉쳐 있다면…/n아아… 흑태자님…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/053"
msgid "샌더 장군이요? 그 집의 셋째 누나를 우리형이 좋아하지요./n그 집안의 딸들은 상당히 미인이에요./n샌더 장군은 못 생겼는데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/054"
msgid "그 누나들의 어머니는 상당히 아름다운 분이셨겠죠?/n그렇지만 솔직히 그 샌더 장군은 마음에 안 드는 사람이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/055"
msgid "우리 형은 의사에요./n내가 이런 이야기를 하면 '쪼그만 게' 하지만,/n나도 사람보는 눈은 꽤 날카롭다고 자부하거든요?/n형은 언제고 큰 코 다칠껄요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/056"
msgid "[ 더스틴 ]/n 난 의사지요./n얼마 전에 만난 샌더 장군의 셋째 딸인/n프리실라를 사랑하게 되었답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/057"
msgid "[ 더스틴 ]/n그런데 얼마 전에 프리실라가/n마약 복용 혐의로 잡혀온 것을 보았소./n의사인 나의 보증으로 풀려나기는 했었지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/058"
msgid "[ 더스틴 ]/n프리실라는 분명히 나쁜 놈들의/n꼬임에 빠져있는 것이 분명해요!/n어떻게 그녀를 도와 줄 방법이 없을까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/059"
msgid "우리 가게 주인은 단 과자를 편집광적으로/n좋아하는 것이 단점이라면 단점이지요. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/060"
msgid "이 가게는 주인의 집안 대대로 전해 내려오는 가게지요./n주인은 전 주인만큼 가게에 대한 애정이 없는 것 같아요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/061"
msgid "아버지는 무기 상점을 하기에는/n취향이 맞지를 않는 편이에요./n무엇보다도 아버지가 좋아하는 것은 요리인 걸요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/062"
msgid "지금 카운터를 보고 있는 것은 아버지의 사촌이죠./n아버지는 잠시 출장을 나가셨답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/063"
msgid "도대체가! 아들 놈은 이 집안 대대로 물려 내려오는/n유서깊은 가게에 대한 애착이 전혀 없어!/n날마다 먹는 것에나 신경쓰고…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/064"
msgid "당신들 칼스님이 용을 죽이고/n봉인해 놓은 화룡굴에 대해 알고 있소?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/065"
msgid "화룡굴은 이 도시 남쪽에 있다고 하더군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/066"
msgid "[루츠양]/n어서오세요./n우리 여관은 가장 깨끗하고 깔끔한 서비스를 제공합니다./n저희 여관의 숙박비용은 80 ELD 입니다./n주무시겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/066_3"
msgid "[ 루츠양 ]/n어서오세요./n우리 여관은 가장 깨끗하고 깔끔한 서비스를 제공합니다./n주무시겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/067"
msgid "감사합니다. 편안히 쉬세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/068"
msgid "다음에 다시 들러주세요./n저희는 언제나 최상의 서비스를 제공합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/069"
msgid "저희 여관을 이용해 주셔서 감사합니다./n다음에 또 들러주세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/070"
msgid "[ 올드필드 씨 ] 어서오십쇼! 세계에서 최상의 무기만 모아놓았습니다!/n마음껏 보다 가세요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/071"
msgid "올드필드 상점"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/072"
msgid "좋은 무기는 위기의 순간에 생명을 구합니다./n다음에 또 이용해 주십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/073"
msgid "[ 올드필드 부인 ]/n어서오세요./n저는 남편을 도와서 무기들 중에서 총포류를 판매 한답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/074"
msgid "올드필드 상점"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/075"
msgid "저희 상점의 물건을 구입해 주셔서 감사합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/076"
msgid "[ 레이몬드 군 ]/n어서오세요, 우리는 최고의 물품만을 취급합니다!/n일단 한 번 구입해 보십시오!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/077"
msgid "악세사리상점 '메서스'"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/078"
msgid "안녕히 가세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/079"
msgid "이 근처에는 용의 굴이 있는데 가끔가다 그곳에서/n귀한 옛 보물을 가져 나오는 사람들이 있답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/080"
msgid "단지, 그곳에 들어가면 돌아올 수/n없다는 소문이 파다하니만큼,/n들어가 보시지는 않는 것이 좋겠군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/081"
msgid "[ 행상 듀란트 씨 ]/n자, 팔다팔다 남은 물건들 떨이로 가져가세요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/082"
msgid "듀란트씨의 약국"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/083"
msgid "감사합니다, 감사합니다./n다음번 다카마행에서는 더 좋은 물품으로/n여러분께 보답하겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/084"
msgid "흥, 듀란트씨는 별로 물건을 싸게 팔지도 않으면서/n떨이라고 그런다니까요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/085"
msgid "저는 깨달음을 얻기 위한 여행중이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/086"
msgid "얼마전에 보리수 나무 밑에서/n신비한 빛이 저에게 말했답니다./n\"떠나라\"라고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/087"
msgid "깨달음을 얻기 전에는 돌아가지 않을 거에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/088"
msgid "요즘 젊은 것들은 패기가 없어!/n그런 면에서 보면 로우엔의 프레데릭경은/n젊은이들의 귀감이라고 할 수 있지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/089"
msgid "자네, 남의 일 때문에 자신의 일을 소흘히 하지는 않나?/n세상에서 제일 중요한 것은 자기만족 이라네./n자신을 만족시키며 살아야 해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/090"
msgid "그런 것으로 말하자면 난 너무 방탕하게 살았지…/n내 고향 프리토리아가 그립군…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/091"
msgid "최근의 이스카리웃의 제국 학술원은/n마법의 극한을 연구하는 것 같더군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/092"
msgid "난 당신의 정체를 알고 있소./n내가 나이는 괜히 먹은 줄 알고 있는가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/093"
msgid "당신은 모니터를 보면서 마우스를 클릭하는 자./n시간을 따라 방랑하는 자가 아닌가…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/094"
msgid "게이시르 저택에 얽힌 전설을 아세요? "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/095"
msgid "그 저택에는 10년 전에 번스타인가가 살고 있었지요./n그런데 그 가문은 멸문당했어요…."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/096"
msgid "그 이후에는 아무도 살지 않는답니다. 그 이유는…."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/097"
msgid "요새 이곳 저곳을 떠돌아 다니는 행상의 숫자가/n이상하리 만큼 증가하지 않았어요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/098"
msgid "각지의 영주들 때문에 파산한 집이 늘면서/n생계를 위해서 행상을 하는 집이 많답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/099"
msgid "그래도 게이시르 시티는 사정이 좋은 편에 속하니까…/n저는 얼마나 다행인지 몰라요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/100"
msgid "언제나 지하실에는 무엇인가 있을 줄 알고/n내려오는 것은 상당히 바보같은 짓이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/101"
msgid "이곳에는 절대로 아무것도 없어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/102"
msgid "요새는 정말로 장사가 안되는 편이에요./n사람들이 전부 다 가진 돈이 어디로 간 것인지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/103"
msgid "그나마 사정이 좋다는 게이시르 시티도 사정이 이러니…./n다른 곳이야 어떻겠어요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/104"
msgid "흑태자님이 살아계실 때만 해도 경제가 이렇지는 않았었지./n그런데 지금은 이게 무언가!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/105"
msgid "이 제국은 기필코 하나로 통합되어야 해!/n그리고 그것을 이룰 사람은 우리 체사레 추기경님 뿐이다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/106"
msgid "흥… 내 미모가 보고 싶다면 밝은 곳에서는 곤란해요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/107"
msgid "화장이 다 드러나 보이거든요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/108"
msgid "하여튼 상인들의 말은 절대로 믿으면 안된다니까!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/109"
msgid "오늘 전 휴가를 나와서 제 고향인/n게이시르 시티로 돌아왔습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/110"
msgid "저의 본 부대는 카라카스 건너편 쪽에 있지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/111"
msgid "이곳에는 제 친구 하나가 근무를 서고 있어요. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/112"
msgid "이 집은 문이 잠겨있군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/112_3"
msgid "이 집은 아무도 없는 것 같군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/113"
msgid "이 방에는 들어갈 수 없습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/114"
msgid "[보르스의 선조]/n당신은 들어와서는 안 될 방에 들어왔습니다./n이 방을 나가고 싶으면 다음 질문에 대답해 보시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/115"
msgid "보르스의 성은 무엇입니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/116"
msgid "셰피르"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/117"
msgid "앙드레아"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/118"
msgid "알렉스"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/119"
msgid "전"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/120"
msgid "[보르스의 선조]/n우리 가문의 이름도 모르다니,/n당신은 장검을 가질 자격이 없어!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/121"
msgid "[보르스의 선조]/n그래도 여기서 나갈 수는 있게 해 주지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/122"
msgid "[보르스의 선조]/n우리 가문의 이름으로, 당신은 이 방을 나갈 수 있습니다./n부디 우리 보르스를 잘 부탁합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/123"
msgid "[병사]/n무인으로서 가장 중요한 것은 역시 체력이지!/n이 도시를 3바퀴 돌면 브레스젬 2개를,/n10바퀴 돌면 다이아몬드젬을 주겠어!/n단, 이 구역을 벗어나면 처음부터 다시야! 그럼 출발!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/124"
msgid "[ 병사 ] 좋아, 서쪽 게이트를 통과했군!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/125"
msgid "[ 병사 ] 좋아, 남쪽 게이트를 통과했군!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/126"
msgid "[ 병사 ] 좋아, 동쪽 게이트를 통과했군!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/127"
msgid "[ 병사 ] 좋아, 북쪽 게이트를 통과했군!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/128"
msgid "[ 병사 ] 수고했군! 한 바퀴 돌았어! 계속 돌게나!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/129"
msgid "[ 병사 ] 10바퀴 다 돌았군! 이리 오게! 선물을 주지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/130"
msgid "[병사]/n좋아! 군기가 확실히 들어갔군!/n내 이걸 주지!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/131"
msgid "다이아몬드젬을 받았다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/132"
msgid "[병사]/n자, 자네는 이제 졸업이야!/n앞으로도 체력을 갈고 닦는 것을 잊지 말게!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/133"
msgid "현재 구 제국령의 숲은 대단히 울창하므로,/n여행시에는 지도 작성을 요함."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/134"
msgid "위대한 도시 게이시르 시티의 중앙 광장"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/135"
msgid "북쪽 - 카라카스 지방"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/136"
msgid "[ 병사 ] 3바퀴 돌았군! 지금오면 브레스젬 2개를 주겠네! 더 돌면 다이아몬드젬이야!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/137"
msgid "[병사]/n3바퀴 돌았군. 약속대로 이걸 주겠네!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/138"
msgid "브레스젬 2개를 받았다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/139"
msgid "[병사]/n자, 그럼 다시 처음부터다! 열심히 뛰도록!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/140"
msgid "[ 병사 ] 5바퀴 돌았군. 지금 오면 브레스젬을 주겠네!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/141"
msgid "[병사]/n군인의 기본은 어디까지나 체력이지!/n언제나 체력 단련을 잊지 않도록 하게!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/142"
msgid "[병사]/n나가면 처음부터 다시 돌아야 하네!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01
msgctxt "field|re|art_fltga01|@kfltga01/144"
msgid "우리의 목적은 보물 찾기다./35d/n화룡굴에 가야 해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01b
msgctxt "field|re|art_fltga01b|@kfltga01b/000"
msgid "게이시르 시티"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01b
msgctxt "field|re|art_fltga01b|@kfltga01b/001"
msgid "기회는 지금 뿐이야./45d 게이시르 대성당으로 가야 해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga01b
msgctxt "field|re|art_fltga01b|@kfltga01b/002"
msgid "대성당은 도시 동쪽에 있다./60d 체사레는/30d 그곳에 있을 거야!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/000"
msgid "당신도 이 구절처럼 겉모습에 현혹돼서/n진실을 못 보지 않습니까? 사람들은/n교회에 대해 욕을 하지만 실체는 틀립니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/001"
msgid "이곳은 본래 제국의 제1공신이었던/n번스타인 가문의 영지였습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/002"
msgid "옆에 있는 번스타인 가문의 폐허에는/n벌써 10년째 아무도 살고 있지 않아."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/003"
msgid "모든 것을 여러 각도에서 보는 능력을 기르십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/004"
msgid "어서오세용"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/005"
msgid "당신의 머리 위에는 이상한 구름이 떠돌고 있군요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/006"
msgid "엇, 저 아저씨는 내가 10년 전에 봤던/n사람하고 너무 비슷하게 생겼는걸?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/007"
msgid "최근에 사막에서는 도적 떼들이 설치고 있다네./n덕택에 나도 이번에 죽을 위기를 많이 넘겼다고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/008"
msgid "상당히 더운 곳에서 사는 사람들은 대체로 성격이 느긋해지지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/009"
msgid "사이럽스를 가기 위해서는/n트리시스 사막을 건너야 한다네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/010"
msgid "일가가 몰살당한 저런 곳에/n어떻게 사람이 들어갈 수 있겠나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/011"
msgid "로우엔 근처의 숲과 산에는/n이상한 칼이 박혀 있다는 소문이 있어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/012"
msgid "샤른호스트가 이근방에도 나타났다는 소문이…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/013"
msgid "게이시르에서 조금 내려가면/n로우엔으로 들어갈 수 있어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/014"
msgid "팬드래건과 투르족의 전쟁은/n최근 소강상태에 빠졌다고 하더군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/015"
msgid "니코시아라는 곳은 교회의 세력이/n굉장히 강한 곳입니다. 전통적으로 말이죠. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/016"
msgid "저는 비밀 임무 수행 중입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/017"
msgid "10년 전의 사실을 제가 기억하고 있는 것은,/n얼마 전에 머리에 충격을 받은 이후에 갖게 된 능력이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/018"
msgid "훗, 나는 중년의 낭만을 즐기는 한가로운 귀족이라네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/019"
msgid "그곳 사람들은 상당히 고통을 받으면서도 이상하리만큼/n교회를 따르는 것 같아요. 이유가 무엇일까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/020"
msgid "호호호"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/021"
msgid "안녕하세요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/022"
msgid ""
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/023"
msgid "음악가 니카차 씨를 아시나요?/n사이럽스의 인기인이랍니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/024"
msgid "반짝이는 모든 것은 금이 아니다./n이 말은 제가 가장 좋아하는 책의 한 구절입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/025"
msgid "게이시르 시티 서부"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/026"
msgid "저는 얼마 전에 파혼당했어요. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/027"
msgid "단순히 친척 중에 마녀로 몰린 사람이/n있다는 이유 때문이었죠. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/028"
msgid "저는 교회가 정말 싫어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/029"
msgid "교회는 정말이지 하는 일 없이 돈만 잘 버는 것 같군요./n그들이 무엇을 만들어 내기나 하나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/030"
msgid "우리 친척이 카라카스에 사는데/n상당히 고통이 심한 모양이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/031"
msgid "모든 사람은 진실을 제대로 보지 못하고 있어요./n사람들이 보는 것은 자신만의 진실일 뿐이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/032"
msgid "이 교회령의 중심인 게이시르 시티는 평화롭고,/n비교적 교회에 대한 비판도 자유롭지만,/n과연 그것이 진실일까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/033"
msgid "상당히 불안과 불길을 내포하고 있어요./n무슨 일일까…."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/034"
msgid "좋은 것 하나 알려드릴까요?/n이곳 게이시르 시티에도 이곳 저곳에/n교회의 감시의 눈이 번뜩이고 있습니다. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/035"
msgid "언뜻 보기에는 상당히 자유로운 곳 같지만/n실제로는 조심해야 하는 곳입니다. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/036"
msgid "샤론이라는 가수는 상당히 인기가 있는 모양이더군."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/037"
msgid "우리 아들놈이 그 가수 팬인데,/n얼마 전에 이곳 근처에서 본 적이 있지./n아마도 남쪽으로 가는 모양이었어."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/038"
msgid "샤론, 샤론. 아 샤론은 나의 우상! "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/039"
msgid "얼마 전에 그녀를 본 것만으로도 저는… 엉엉엉… "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/040"
msgid "흥… 이 도시는 죽어가고 있어요. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/041"
msgid "다들 교회 세력이 암암리에 이곳을/n이미 장악하고 있는 것을 몰라요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/042"
msgid "얼마 전에 제 친구 하나가 갑자기 실종되었죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/043"
msgid "그 친구 평소에 교회에 대한 반론을/n많이 펴고 다니던 녀석이었는데…. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/044"
msgid "어머니한테서 체사레 추기경 님의 부인/n이야기를 들은적이 있어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/045"
msgid "억울한 죽음을 당했다고 하는 것 같은데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/046"
msgid "저희 어머님과 체사레 추기경 님은/n상당히 친한 관계에 있었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/047"
msgid "아무래도 상당히 오랫동안 알아오신 것 같았는데/n자세한 이야기를 해 주신 적은 없지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/048"
msgid "난 분명히 누군가를 죽이라는 지령을 받았소."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/049"
msgid "그런데, 사고로 머리를 다친 뒤로는/n그게 누구인지 생각이 나지 않아."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/050"
msgid "누구지! 혹시 당신인가!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/051"
msgid "어서오게나/n이곳은 게이시르 최고의 주점이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/052"
msgid "저 이상한 암살자는 며칠 전에/n강물에 빠진 것을 구해준 거야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/053"
msgid "게이시르 발전의 영광을 위해!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/054"
msgid "그를 위해서는 체사레 님이 정권을/n잡아야 하는 것이 당연한 것 아닌가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/055"
msgid "그렇지만 로우엔의 프레데릭 경의 태도는 문제가 있어…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/056"
msgid "엉엉… 제 친구가 글쎄 제 남자 친구를 빼앗아 가 버렸어요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/057"
msgid "복수하겠어. 결단코"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/058"
msgid "흥… 그이는 내가 맘에 들어서/n나를 선택한 것 뿐이 없다고요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/059"
msgid "내가 친구의 남자친구를 빼앗아 갔다는 것은 말이 안되죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/060"
msgid "제발… 그 두 여자 이야기는 하지 마십시오./n머리 아픕니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/061"
msgid "서로 나를 자신의 것이라고 하는 통에…/n정신이 하나도 없어요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/062"
msgid "이 집은 문이 잠긴 것 같다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/063"
msgid ""
"번스타인가 : 이 건물은 과거 게이시르 시티의 영주이던 번스타인 가문의 집이다. 고풍스러움과 현대적인 감각이 같이 살아있는 건물로서 그 화려함과 웅장함은 전형적인 영주의 저택 모습을 보여주고 있다. 현재는 아무도 살지 않으며, 사적으로 지정될 만한 건물이나 번스타인가의 멸문 당시 가문에"
" 씌워진 악마 혐의 때문에 사적 지정이/n안 돼서 건물의 보존은 전혀 안 된 상태이다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/064"
msgid "현상 수배 : 카나 밀라노비치/n현상금 : 10,000 ELD/n- 체사레 추기경 -"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/065"
msgid "아들은 악마 숭배로 처벌당하고,/n아버지는 프레데릭 경과의 결투에서 목숨을 잃고……/n번스타인가의 최후도 정말 비참했지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/066"
msgid "[전술학회 회원]/n적들과 싸울 때는 적들의 상성에 특히 주의하셔야 합니다. 특히 아군이 속성이 있는 무기를 사용하거나 마법을/n사용할 때, 적의 생김새를 잘 보시고, 또한 경험상 적의 상성을 잘 기억하고 공격을 하셔야 합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/067"
msgid "[전술학회 회원]/n처음보는 몬스터가 출현한다면, 그 몬스터에/n대한 특성을 확실히 인지해 두는 것이/n게임을 무리없이 진행하는데 도움을 줄 것입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02
msgctxt "field|re|art_fltga02|@kfltga02/076"
msgid "우리의 목적은 보물 찾기다./35d/n화룡굴에 가야 해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02b
msgctxt "field|re|art_fltga02b|@kfltga02b/000"
msgid "게이시르 대성당"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02b
msgctxt "field|re|art_fltga02b|@kfltga02b/001"
msgid "[사제]/n제발, 목숨만 살려줘!/n팔라는 대로 다 팔테니까!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02b
msgctxt "field|re|art_fltga02b|@kfltga02b/002"
msgid "도망가는 사제의 상점"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02b
msgctxt "field|re|art_fltga02b|@kfltga02b/003"
msgid "이… 이제 가도 되는 건가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02b
msgctxt "field|re|art_fltga02b|@kfltga02b/004"
msgid "[사제]/n으악! 사…. 사람살려!/n뭐든지 드릴테니 목숨만…!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02b
msgctxt "field|re|art_fltga02b|@kfltga02b/005"
msgid "도망가는 사제의 상점"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga02b
msgctxt "field|re|art_fltga02b|@kfltga02b/006"
msgid "이… 이제 가도 되는 건가?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga03
msgctxt "field|re|art_fltga03|@kfltga03/000"
msgid "대성당은 아무나 들어갈수 없다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga03
msgctxt "field|re|art_fltga03|@kfltga03/001"
msgid "지금 대성당에 들어갈 수 있는 사람은 제한되어 있습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga03
msgctxt "field|re|art_fltga03|@kfltga03/002"
msgid "대성당은 신성스러운 성지. 결코 아무나 들어갈 수 있는 곳이 아닙니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga03
msgctxt "field|re|art_fltga03|@kfltga03/002_3"
msgid "대성당은 신성스러운 성지. 결단코 아무나 들어갈 수 있는 곳이 아닙니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga03
msgctxt "field|re|art_fltga03|@kfltga03/003"
msgid "이런이런.... 요즘 사람들은 신심이 너무 약한 것이 문제점이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga03
msgctxt "field|re|art_fltga03|@kfltga03/004"
msgid "더 강한 믿음을 믿게할 수 있도록 강력한 신성성이 발현되어야 해."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga03
msgctxt "field|re|art_fltga03|@kfltga03/005"
msgid "믿음에 의심을 갖는 사람은 믿음이 없다는 증거! 곧 악에 현혹되어 있음이야."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga03
msgctxt "field|re|art_fltga03|@kfltga03/006"
msgid "무조건적인 믿음이야 말로 신에대한 진정한 사랑인 것! 믿어야 해!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltga05
msgctxt "field|re|art_fltga05|@kfltga05/000"
msgid "이곳이 과거의 그 정원인가...."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/000"
msgid "이곳은 카라카스 마을입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/001"
msgid "이곳은 숲으로 둘러싸인 조용한 시골마을이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/001_3"
msgid "이곳은 숲으로 둘러쌓인 조용한 시골 마을이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/002"
msgid "남쪽에 있는 게이시르 시티에 가 본 적이 있어요?/n난 한번 가봤는데 정말 멋진 곳이었어요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/002_3"
msgid "남쪽에 있는 게이시르 시티에 가 본 적이 있어요? /n 한 번 가 봤는데 정말 아름다운 곳이었어요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/003"
msgid "우리 주점의 요리사인 카그 씨는 좀 이상한 사람이에요./n/15d 항상 새로운 요리를 위한 재료를 찾기위해서/n이곳 저곳을 여행하고는 한답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/003_3"
msgid "우리 주점의 요리사인 카그씨는 좀 이상한 사람이에요./n항상 새로운 요리를 위한 재료를 찾기위해서/n이곳 저곳을 여행하고는 한답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/004"
msgid "구 제국의 칼스 장군은 최강의 암흑룡을 물리쳐/n드래건 슬레이어라는 칭호를 얻었었다죠?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/004_3"
msgid "우리들의 칼스님 께서 용을 처치한 적이/n있다는 말을 들어본 적 있나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/005"
msgid "안녕하"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/006"
msgid "빠이"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/007"
msgid "최근에 사막에서는 도적 떼들이 설치고 있다네./n덕분에 나도 이번에 죽을 위기를 많이 넘겼다고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/007_3"
msgid "최근에 사막에서는 도적 떼들이 설치고 있다네./n덕택에 나도 이번에 죽을 위기를 많이 넘겼다고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/008"
msgid "사막에서 길을 잃기는 대단히 쉬워도 찾기는 대단히 어렵지./n특히나 좋은 안내자 없이는 더더욱…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/008_3"
msgid "사막에서 길을 잃기는 대단히 쉬워도 찾기는 대단히 어렵지./n특히나 좋은 가이드가 없이는 더더욱…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/009"
msgid "이루스님이 칼을 쓰는 것을 보신적이 있나요?/n얼마나 박력있다고요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/010"
msgid "어? 당신들은 처음 보는 사람들인데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/011"
msgid "데이빗이요?/n나쁜 악마를 숨겨주었다가 들켰다던데요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/012"
msgid "이 구 게이시르령 이곳 저곳의 던전에는/n과거 귀족들이 숨겨놓은 보물들이 많아요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/013"
msgid "차라리 교회가 있는 것이 더 좋을수도 있다고./n지금은 너무 루벤님 마음대로 처분하는 것 같아."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/014"
msgid "누가 듣지는 않았겠지?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/015"
msgid "보통 교회는 마을 근처에는 없어요./n일반적으로 산속 깊숙히 수도원을 짓죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/016"
msgid "그러면 뭐해요?/n대부분의 성직자들은 마을을 왔다갔다 하면서 간섭한답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/016_3"
msgid "그럼 무엇해요?/n대부분의 성직자들은 마을을 왔다갔다 하면서 간섭한답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/017"
msgid "쉿… 교회 눈에 잘못 들면 살아남지 못해요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/017_3"
msgid "쉿… 교회 눈에 잘못 들면 살 수가 없답니다…. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/018"
msgid "훗, 나는 중년의 낭만을 즐기는 한가로운 귀족이라네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/019"
msgid "풍류와 낭만이야 말로 이곳 안타리아에서/n살아가는 진정한 낙이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/019_3"
msgid "풍류와 낭만이야 말로/n이곳 안타리아에서 살아가는 진정한 낙이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/020"
msgid "루벤 녀석의 부하들은 모두 비겁해./n가장 체력이 적은 적부터 공격하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/021"
msgid "프리토리아에서 볼일이 있어서 이곳까지 왔답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/021_3"
msgid "프리토리아에서 볼 일이 있어서 이곳에 왔답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/022"
msgid "듣자하니 사막에서는 해가 하도 오랫동안 떠 있어서/n일정 위치에 고정된 것 같다던데요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/023"
msgid "프리토리아의 영주인 라몬은/n평소부터 이상한 행동으로 이름이 높아요./n이곳의 루벤공작도 만만치 않지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/023_3"
msgid "프리토리아의 영주인 라몬은/n평소부터 이상한 행동으로 이름이 높아요./n이곳의 루벤공작도 만만치 않지만…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/024"
msgid "카라카스 마을"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/025"
msgid "그래서 종종 가게를 비울 때도 있어요./n하지만 요리 하나는 정말 맛있게 한답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/026"
msgid "[ 요리사 카그 ]/n진정한 요리란, 좋은 재료, 요리사의 실력, 그리고/n정성에서 나오게 되지./n혹시 좋은 재료를 구해 온다면 사례는 후하게 하겠네. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/027"
msgid "[요리사 카그] /n좋은 재료가 없으면/n아무리 좋은 요리 솜씨도/n소용이 없단 말이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/028"
msgid "[요리사 카그]/n아직도 좋은 재료를 찾지 못했단 말이야?/n정말이지…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/029"
msgid "[요리사 카그]/n우리 집안은 요리사 집안이지./n내 형제들은 이곳 저곳에 많이 퍼져있지./n만나게 되면 안부 좀 전해 주게나."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/030"
msgid "정말 대단하지 않아요?/n검 한자루로 암흑룡을 죽이다니!!/n/20d나도 검술을 열심히 배워서 언젠가는/n칼스 장군같은 훌륭한 검사가 될 거에요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/030_3"
msgid "정말 대단하지 않아요? 용을 죽이다니!!/n나도 검술을 열심히 배워서 언젠가는 칼스님처럼 훌륭한 검사가 될 거에요!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/031"
msgid "그런데…./n용은 굉장한 보석들을 숨겨 둔다고 하지 않던가요?/n/20d칼스 장군도 그 보석들을 발견했을까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/031_3"
msgid "그런데…. 용은 굉장한 보석들을/n숨겨 둔다고 하지 않던가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/032"
msgid "저는 아버지가 떠돌이 행상이기 때문에/n이곳 저곳을 많이 돌아 다닌답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/032_3"
msgid "저는 아버지가 떠돌이 행상이기 때문에/n이곳 저곳을 많이 돌아 다닌답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/033"
msgid "동북쪽으로 계속 가면 리브레빌이란 도시에 가게 돼요./n그곳은 상당히 이상한 곳이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/033_3"
msgid "동북쪽으로 계속 가면 리브레빌이란 도시에 가게 돼요./n그곳은 상당히 이상한 곳이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/034"
msgid "으흐흐… 당신들 그거 알아?/n난 정말로 죽여주는 보물을 찾은 적이 있다고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/034_3"
msgid "키득키득… 당신들 그거 알아?/n난 정말로 죽여주는 보물을 찾은 적이 있다고."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/035"
msgid "그런데, 그곳은 한번 간뒤에 다시는 갈 수가 없어!/n/15d 어떡하지?/5d어떡하지?/5d 어떡하지?/5d 내 보물!/5d 내 보물!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/035_3"
msgid "그런데, 그곳은 한번 간 뒤에는 다시는 갈 수 없었어!/n어떡하지? 어떡하지? 어떡하지? 내 보물! 내 보물!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/036"
msgid "분명히,/10d 분명히,/10d/n그건 여기 근처 어디였던것 같은데… "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/036_3"
msgid "분명히, 분명히 그건 여기 근처 어디였던것 같은데… "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/037"
msgid "사막에서는 자신을 믿게나./n/10d자신을 의심하기 시작하면/n더 이상 사막에서 살아남을 수 없다네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/037_3"
msgid "사막에서는 자신을 믿게나./n자신을 의심하기 시작하면 더이상 사막에서 살 수가 없다네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/038"
msgid "[제인]/n흥… 아직도 이곳에 있나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/038_3"
msgid "[제인]/n흥… 아직도 이곳에 있나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/039"
msgid "[제인]/n아아… 잔소리라면 질색이라고…/n이래봬도 할 건 다 하니까 걱정하지 말아요…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/040"
msgid "[제인]/n쉿! 오늘은 무슨 건수가 하나 있을 것 같은데…?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/041"
msgid "[제인]/n뭐야, 당신들은?/n이런데 오면 안된다는 둥 잔소리를 하려면은 꺼져버려!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/042"
msgid "제인 녀석이요? 착한 아이였었는데/n어머니가 실종된 이후로는 계속 저 모양이에요./n가엾게도…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/043"
msgid "동굴안에 들어가기 위해서는 목숨을 걸어야 한다죠…/n상당히 위험하거든요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/043_3"
msgid "동굴안에 들어가기 위해서는 목숨을 걸어야 할 것 같은데…/n상당히 위험하거든요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/044"
msgid "정말 무서운 것은 던전 안의 적들보다,/n장비가 다 떨어지는 것이죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/045"
msgid "이곳은 여관입니다. "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/046"
msgid "이곳은 투기장입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/047"
msgid "이곳은 상점입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/048"
msgid "이곳은 우리 어머니가 운영하시는 가게에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/048_3"
msgid "이곳은 우리 어머니가 운영하시는 가게에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/049"
msgid "더 필요한 것은 없으신가요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/050"
msgid "비프로스트의 여검사 카타리나 씨는 우리 먼 친척이에요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/051"
msgid "이곳은 아이템 상점 입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/052"
msgid "뭐 더 필요한 것 있어요? "
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/053"
msgid "좋은 것 가져오면 저도 좋은 것 드릴께요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/054"
msgid "1:1 물물교환만 해요, 저는."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/055"
msgid "우리 마을 근처의 숲은 상당히 많은 마을로 통합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/056"
msgid "심지어는 사막 건너 사이럽스로 가는 길도 있죠./n하지만 사막은 안 가는게 좋아요. 죽기 딱 좋거든요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/057"
msgid "리브레빌은 정말로 이상한 도시죠./n그렇게 북쪽에 있는데도 불구하고 항상 포근한 날씨거든요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/057_3"
msgid "리브레빌은 정말로 이상한 도시죠./n그렇게 북쪽에 있는 데도 불구하고 상당히 따뜻하거든요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/058"
msgid "이곳은 무기 상점입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/058_3"
msgid "이곳은 무기 상점입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/059"
msgid "카라카스 여관에 오신것을 환영합니다./n주무시겠습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/060"
msgid "감사합니다. 편안히 쉬다 가시길…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/061"
msgid "이용도 안할 거면서 말을 거는 이유는 뭐죠?/n저한테 관심이라도 있나요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/062"
msgid "이용해 주셔서 감사합니다./n다음에 또 오세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/063"
msgid "오오… 이것은 궁극의 버섯!/n사람의 손이 닿지 않는 동굴 깊숙한 곳에만 자란다는 그것이 아닙니까!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/064"
msgid "정말, 정말 감사합니다./n가만있자 저도 댓가로 무언가를 드려야 할 텐데…."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/065"
msgid "다음중에 하나 골라서 가지세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/066"
msgid "아이템 #1"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/067"
msgid "아이템 #2"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/068"
msgid "[ 요리사 카그씨 ]/n오오… 이것은 사랑의 향초가 아닙니까!/n진정한 사랑이 싹튼 곳에서만 그 정기를 먹고/n싹을 틔운다는 이 귀한 향신료!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/068_3"
msgid "오오… 이것은 사랑의 향초가 아닙니까!/n진정한 사랑이 싹튼 곳에서만 그 정기를 먹고/n싹을 틔운다는 이 귀한 향신료!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/069"
msgid "[ 요리사 카그 씨 ]/n감사합니다, 정말로 감사합니다!/n대신 이것을 드리겠습니다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/069_3"
msgid "감사합니다, 정말로 감사합니다!/n대신 이것을 드리겠습니다!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/070"
msgid "헉! 이것은…. 궁극의 향신료 히가시!/n투르족의 전설상의 향신료가 아닙니까…/n어디서 구하셨죠 이 귀한걸?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/071"
msgid "구해주셔서 대단히 감사합니다…/n저도 보답으로 하나 드려야 할 텐데…"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/072"
msgid "이 근처에는 먹을만한 열매가 많이 자라죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/073"
msgid "존이 얼마전에 이상한 버섯을 따 왔어요./n마을 근처의 동굴 깊숙한 곳에서 따 왔다고 하는데…/n정말 향기가 좋던데요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/074"
msgid "일단 묵을 곳부터 찾아보는 게 좋겠는걸."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/075"
msgid "카라카스 마을"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/076"
msgid "[몬크리프 양]/n 어서오세요, 우리 여관에 오신 것을 감사드립니다./n주무시겠습니까? 가격은 80 ELD입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/076_3"
msgid "[ 몬크리프 양 ]/n어서오세요, 우리 여관에 오신 것을 감사드립니다./n주무시겠습니까? 가격은 80 ELD입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/077"
msgid "감사합니다. 편안히 쉬세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/078"
msgid "이런… 다음에 다시 이용해 주세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/079"
msgid "우리 여관을 이용해 주셔서 감사합니다./n다음에 또 오세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/080"
msgid "[엘지]/n 어서오세요, 찾으시는 물건이 있습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/080_3"
msgid "[ 엘지 ]/n 어서오세요, 찾으시는 물건이 있습니까?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/081"
msgid "악세사리점 '따뜻한 겨울'"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/082"
msgid "저희 상점에 들려 주셔서 감사합니다./n다음에 또 와 주세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/083"
msgid "[ 조지프 씨 ] /n어서오십시오. 무엇을 도와드릴까요?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/084"
msgid "카라카스 약국"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/085"
msgid "감사합니다. 안녕히 가세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/086"
msgid "[심슨 부인]/n 어서오세요. 저희 가게의 명품은 소드브레이커 입니다./n가격대 성능비가 대단히 좋은 검이므로/n꼭 한자루 정도는 구입하세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/086_3"
msgid "[ 심슨 부인 ]/n 어서오세요. 원하시는 무기를 골라보세요./n우리 가게는 가격도 싸고 무기도 좋답니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/087"
msgid "무기상점 '천일야화'"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/088"
msgid "좋은 무기는 무사의 기본이죠. 감사합니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/089"
msgid "[심슨 씨]/n어서오세요. 우리 상점에 잘 오셨습니다./n창검류를 구입하시려면  제 아내에게 문의하십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/089_3"
msgid "[ 심슨 씨]/n어서오세요. 우리 상점에 잘 오셨습니다./n천천히 골라 보시죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/090"
msgid "무기상점 '천일야화'"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/091"
msgid "저희 제품은 믿을만 합니다. 다음에 또 오십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/091_3"
msgid "저희 제품은 믿을 만 합니다. 다음에 또 오십시오."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/092"
msgid "뭐 먹을 것 좀 더 없나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/093"
msgid "실버젬을 얻었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/093_3"
msgid "장검을 얻었습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/094"
msgid "[ 투기장 주인 ]/n하하하! 남자라면 힘을 길러야지!/n우리 투기장에 한번 들어 가 보게나!/n단, 실전이니 죽어도 난 모른다네."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/095"
msgid "어, 그 쪽에 가면 안돼!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/096"
msgid "현재 우리 가게에서 팔 물건들은/n전부 악세사리 상점으로 옮겨 놓은 상태입니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/097"
msgid "[에르큘씨]/n하하하!/n우리 마을의 투기장은 실전 단련에는 최고격인 곳이지!/n남자라면, 모름지기 힘이 있어야하지 않겠나!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/098"
msgid "투기장 '네메아의 사자'"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/099"
msgid "고맙네! 기회가 된다면 로우엔의/n우리 형이 운영하는 투기장에도 가보게나!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/100"
msgid "[ 투기장 점원 ]/n들어가시려면 표를 내고 들어가세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/101"
msgid "표는 저 놈한테 내슈."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/102"
msgid "1회용 패스군요. 들어가시죠."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/103"
msgid "평생 이용권이군요. 들어가세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/104"
msgid "XP가 상승하면 해당 캐릭터의 공격력과 방어력이 동시에 상승합니다. XP는 방어시에도 상승하므로, 전투시에 불리하면 방어를 해서 버티십시오./n-게이시르 학술원 산하 전술연구회-"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/105"
msgid "각 무기들은 무기의 특성에 따라 대단히 잘 부서지므로, 항상 여유분의 무기를 준비해 다닐 것/n-게이시르 학술원 산하 전술연구회 -"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/106"
msgid "현재 구 제국령 지역의 지도는 부정확 함. 숲이나 산길을 다닐 때에는 반드시 스스로 지도를 만들어 다닐 것./n- 게이시르 학술원 산하 제국 지리학회 -"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/107"
msgid "불쌍하게도… 데이빗만 불쌍하게 되었지./n화형이라니."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/108"
msgid "데이빗은 제피르 팰컨을 숨겨 주었다는/n죄목으로 화형당하게 되었어. 불쌍하게도."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/109"
msgid "[칼]/n어서오세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/110"
msgid "카라카스 약국"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/111"
msgid "감사합니다. 다음에 또 들러주세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/112"
msgid "손님, 이곳은 표가 없으면 들어갈 수 없습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/113"
msgid "표를 주시오. 표가 없으면 들어갈 수 없습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/114"
msgid "무기 정보의 뜻은 다음과 같습니다./n무기 내구도 : 무기 자체의 내구도. 자신의 한계력을 넘어선 대미지가 무기에 가해지면 무기 내구도가 1이 저하되며, 무기 내구도가 0이 되면 그 무기는 파괴됩니다. 무기 내구도는 수리를 하면 회복됩니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/115"
msgid "공격력 : 무기의 공격력 입니다. 캐릭터의 공격력은 무기 공격력과 자신의 완력이 결합되어 나타나게 됩니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/116"
msgid "방어력 : 방어력은 무기로 적의 공격을 막았을 때의 적이 입힌 피해를 해당 퍼센트 만큼 줄여줍니다. 수치가 아니라 퍼센트라는 것을 명심하십시오!"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/117"
msgid "저 친구에게 앞의 내용은 들으셨나요?/n그럼 다음 수치를 설명해 드릴께요./n한계력은 무기가 자신의 내구도에 손상을 입지 않고 견딜 수 있는 한계 대미지입니다. 결국, 무기의 방어력과 한계력, 그리고 내구도 3개의 수치가 무기의 수명을 결정하지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/118"
msgid "그리고 명중률 입니다. 명중률은 무기 자체의 공격 명중률이죠. 표시는 되지 않지만 무기는 방어 성공률이 있기 때문에 전투시 방어하는 확률도 다르죠. 방어하면 대미지를 무기가 입게 되므로, 방어율이 높은 무기는 부서지기도 쉽지요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/119"
msgid "우리 게이시르 학술원 검 연구학회 지부가/n이곳 카라카스 서부에 있어요./n한 번 들러 보세요."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/120"
msgid "아늑한 분위기의 마을이군./45d/n우선/20d 마을 사람들 이야기나 들어볼까."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/121"
msgid "흥… 루벤놈 부하들은 다 비겁한 겁쟁이지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/122"
msgid "놈들은 전투시에는 가장 약한 아군 파티를 공격한다./n아주 비겁하지."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fltka01
msgctxt "field|re|art_fltka01|@kfltka01/123"
