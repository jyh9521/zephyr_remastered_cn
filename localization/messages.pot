msgctxt "field|re|art_fl05_s01|@kfl05_s01/014"
msgid "그분이 사용하시던 망토이니,/50d/n아수라의 주인이 된 자네에게/30d 어울리겠지./65d/n소중히/30d 간직해 줄 수 있겠나?"
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl05_s01
msgctxt "field|re|art_fl05_s01|@kfl05_s01/015"
msgid "…/40d알겠습니다."
msgstr ""

#. group=field; variant=re; bundle=ZephyrRemastered_Data/StreamingAssets/aa/StandaloneWindows64/fieldtext.re_assets_all_289a30d75d4cf39579a250647a71d81b.bundle; object=art_fl05_s01
msgctxt "field|re|art_fl05_s01|@kfl05_s01/016"
